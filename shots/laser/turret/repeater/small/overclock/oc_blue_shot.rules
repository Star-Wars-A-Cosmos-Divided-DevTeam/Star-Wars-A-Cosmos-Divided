BASE       = &<../base_shot.rules>
OC_BASE    = &<../overclock/oc_base_shot.rules>
COLOR_BASE = &<../blue_shot.rules>

ID = "SW.repeater_turret_small_laser_blue_overclock"
Range = &OC_BASE/Range
IdealRange = &OC_BASE/IdealRange
IdealRadius = &OC_BASE/IdealRadius
Speed = &OC_BASE/Speed
ReceivableBuffs = &OC_BASE/ReceivableBuffs

Components : &OC_BASE/Components
{
	Hit : ^/0/Hit
	{
		HitOperational : ^/0/HitOperational
		{
			MediaEffects = &COLOR_BASE/Components/Hit/HitOperational/MediaEffects
		}

		HitStructural : ^/0/HitStructural
		{
			MediaEffects = &COLOR_BASE/Components/Hit/HitStructural/MediaEffects
		}
	}

	Sprite : ^/0/Sprite
	{
		Animation : ^/0/Animation
		{
			AtlasSprite : ^/0/AtlasSprite
			{
				Texture
				{
					File = "blue_laser.png"
					SampleMode = Linear
					MipLevels = max
				}
			}
		}
	}

	GlowSprite : ^/0/GlowSprite
	{
		Sprite : ^/0/Sprite
		{
			VertexColor = [0, 0, 255]
		}
	}
}
