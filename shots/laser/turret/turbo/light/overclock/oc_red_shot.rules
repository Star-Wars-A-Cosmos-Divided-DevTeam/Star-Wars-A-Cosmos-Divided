// LOCATION: shots/laser/turret/turbo/light/overclock/oc_red_shot.rules
// PURPOSE: Overclocked Red variant (OC stats/behavior from oc_base_shot; visuals from non-OC red)

BASE_OC = &<oc_base_shot.rules>
RED    = &<../red_shot.rules>

ID           = SW.turbolaser_turret_light_laser_red_shot_overclock
Range        = &BASE_OC/Range
IdealRange   = &BASE_OC/IdealRange
IdealRadius  = &BASE_OC/IdealRadius
Speed        = &BASE_OC/Speed
ReceivableBuffs = &BASE_OC/ReceivableBuffs

Components : &BASE_OC/Components
{
	// Re-apply RED hit/flash/sparks media (keep OC damage model)
	Hit : ^/0/Hit
	{
		HitOperational : ^/0/HitOperational
		{
			MediaEffects
			[
				&<particles/laser_bolt_large_overclock_hit_red.rules>
				&<particles/laser_bolt_large_overclock_flash.rules>
				&<particles/laser_bolt_large_overclock_sparks.rules>
				
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["sounds/heavy_laser_overclocked_impact_01.wav",
									"sounds/heavy_laser_overclocked_impact_02.wav",
									"sounds/heavy_laser_overclocked_impact_03.wav"]
					Volume = 1
					SpeedVariation = .05
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .06
					Duration = .3
				}
			]
		}
		HitShield : ^/0/HitShield
		{
			MediaEffects = &~/RED/Components/Hit/HitOperational/MediaEffects
		}
		PenetratingOperational : ^/0/PenetratingOperational
		{
			MediaEffects = &~/RED/Components/Hit/HitOperational/MediaEffects
		}
		FinishedPenetratingStructural : ^/0/FinishedPenetratingStructural
		{
			MediaEffects = &~/RED/Components/Hit/HitOperational/MediaEffects
		}
	}

	// Reuse the RED textures & glow tuning
	Sprite : ^/0/Sprite
	{
		Animation : ^/0/Animation
		{
			AtlasSprite : ^/0/AtlasSprite
			{
				Texture : ^/0/Texture
				{
					File = &~/RED/Components/Sprite/Animation/AtlasSprite/Texture/File
				}
			}
		}
	}

	MediaEffects
	{
		Type = MediaEffects
		//Offset = [-0.5, 0]
		FactorEffectsWith = Hit
		FactorEffectsExponent = 0.5
		MediaEffects
		[
			&<particles/laser_bolt_large_overclock_lightning_red.rules>
		]
	}

	GlowSprite : ^/0/GlowSprite
	{
		Sprite : ^/0/Sprite
		{
			VertexColor            = &~/RED/Components/GlowSprite/Sprite/VertexColor
			_litReflectiveStrength = &~/RED/Components/GlowSprite/Sprite/_litReflectiveStrength
			_litAdditiveStrength   = &~/RED/Components/GlowSprite/Sprite/_litAdditiveStrength
			_unlitAdditiveStrength = &~/RED/Components/GlowSprite/Sprite/_unlitAdditiveStrength
		}
	}

}
