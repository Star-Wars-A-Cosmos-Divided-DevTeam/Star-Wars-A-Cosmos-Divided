// LOCATION: shots/laser/turret/turbo/light/base_shot.rules
// USED IN: shots/laser/turret/turbo/light/blue_shot.rules, shots/laser/turret/turbo/light/red_shot.rules, shots/laser/turret/turbo/light/green_shot.rules
// BASE FOR: Turbolaser Light Turret Shots
// STRINGKEY: NONE

//Base Stats
DAMAGE_SHIELD_BASE 				= 0 						// &~/DAMAGE_SHIELD_BASE
DAMAGE_BASE						= 1000						// &~/DAMAGE_BASE
DAMAGE_STRUCT_BASE 				= (&~/DAMAGE_BASE)/2 		// &~/DAMAGE_STRUCT_BASE
DAMAGE_EXPLOSIVE_BASE 			= 0 						// &~/DAMAGE_EXPLOSIVE_BASE
AREA_DAMAGE_BASE 				= 0 						// &~/AREA_DAMAGE_BASE 
DAMAGE_POOL_BASE 				= 0 						// &~/DAMAGE_POOL_BASE 
IMPULSE_BASE 					= 15						// &~/IMPULSE_BASE
IMPULSE_SHIELD_BASE 			= (&~/IMPULSE_BASE)*75% 	// &~/IMPULSE_SHIELD_BASE
IMPULSE_STRUCT_BASE 			= (&~/IMPULSE_BASE)/2		// &~/IMPULSE_STRUCT_BASE
IMPULSE_EXPLOSIVE_BASE 			= 0							// &~/IMPULSE_EXPLOSIVE_BASE
PENETRATION_DAMAGE_BASE 		= (&~/DAMAGE_STRUCT_BASE)	// &~/PENETRATION_DAMAGE_BASE
PENETRATION_BASE 				= 0							// &~/PENETRATION_BASE
PENETRATION_SPEED_BASE 			= 0							// &~/PENETRATION_SPEED_BASE					
ARMOR_PENETRATION_FACTOR_BASE 	= 0							// &~/ARMOR_PENETRATION_FACTOR_BASE
DRAIN_BATTERY_BASE      		= 0							// &~/DRAIN_BATTERY_BASE      
DRAIN_DURATION_BASE 			= 0							// &~/DRAIN_DURATION_BASEDRAIN_DURATION_BASE
DRAIN_PER_SECOND_BASE 			= 0							// &~/DRAIN_DURATION_BASEDRAIN_DURATION_BASE
SHIELD_DRAIN_PER_SECOND_BASE 	= 0							// &~/SHIELD_DRAIN_PER_SECOND_BASE
DAMAGE_RADIUS_BASE 				= 0							// &~/DAMAGE_RADIUS_BASE
DAMAGE_SLICES_BASE 				= 0							// &~/DAMAGE_SLICES_BASE
HEALTH_BASE 					= 1000						// &~/HEALTH_BASE
RANGE_BASE						= 400						// &~/RANGE_BASE
SPEED_BASE						= 140 //*2						// &~/SPEED_BASE
IDEAL_RADIUS_BASE				= [5, 50]					// &~/IDEAL_RADIUS_BASE 

ID = "SW.turbolaser_turret_light_laser_base" 
// OtherIDs = [""]
Range =  &~/RANGE_BASE
IdealRange = [120,  &~/RANGE_BASE]
IdealRadius = &~/IDEAL_RADIUS_BASE
Speed = &~/SPEED_BASE
ReceivableBuffs = [ElectronBuff]

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.2
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}

	Targetable
	{
		Type = Targetable
		Health = &~/HEALTH_BASE
		TargetCategory = "laser"
	}

	Hit
	{
		Type = PenetratingHit
		FactorEffectsWith = Targetable

		FriendlyShipLowCollisions = false
		CrewCollisions = {Enemies=true; Junk=true}
		HitCrew = &HitOperational

		HitShield = &HitOperational
		HitOperational
		{
			Offset = [-0.15, 0]

			HitEffects
			[
				{ Type = Damage;  Damage  = { BaseValue = &~/DAMAGE_BASE; BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent=1; } }  // was 20000
				{ Type = Impulse; Impulse = { BaseValue = &~/IMPULSE_BASE; EffectScaleExponent = 1 } }
			]

		}
		HitStructural
		{
			HitEffects
			[
				{ Type = Damage;  Damage  = { BaseValue =  &~/DAMAGE_STRUCT_BASE; BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent=1; } }  // was 20000
				{ Type = Impulse; Impulse = { BaseValue =  &~/IMPULSE_STRUCT_BASE; EffectScaleExponent = 1 } }
			]
		}

		PenetratingOperational
		{
			ReduceEffectsByPenetration = true

			HitEffects
			[
				{ Type = Damage;  Damage  = { BaseValue = &~/PENETRATION_DAMAGE_BASE; BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent=1; } }  // was 20000
				{ Type = Impulse; Impulse = { BaseValue = &~/IMPULSE_STRUCT_BASE; EffectScaleExponent = 1 } }
			]

			/*MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Blue
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Blue
			]*/
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural = &PenetratingStructural
	}

	Sprite
	{
		Type = AnimatedSprite
		RenderBucket = BulletUpper3
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					SampleMode = Linear
					MipLevels = max
				}
				Size = [0.64, 0.64]
			}
			FrameCount = 8
			FrameSize = [128, 128]
			FramesPerRow = 2
			FramesPerSecond = 32
		}
		// Vanilla norm map passthrough:
		//NormalsTexture = &Animation/AtlasSprite/Texture
		//DiffuseShader  = "./Data/default.shader"
		//NormalsShader  = "./Data/no_normals.shader"
	}

	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0.5
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [3, 3]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
		}
	}

}
