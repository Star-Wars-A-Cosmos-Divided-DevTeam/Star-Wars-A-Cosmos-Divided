// LOCATION: shots/laser/turret/turbo/medium/overclock/oc_base_shot.rules
// PURPOSE: Shared overclock stats/behavior for all medium turbolaser shots
// NOTE: No color media here — color OC files pull visuals from their non-OC counterparts.

BASE = &<../base_shot.rules>

ID = "SW.turbolaser_turret_medium_laser_base_overclock"

// Overclock scalars
DAMAGE_SHIELD   			= 200% * (&BASE/DAMAGE_SHIELD_BASE) // &~/DAMAGE_SHIELD
DAMAGE    					= 125% * (&BASE/DAMAGE_BASE) // &~/DAMAGE
DAMAGE_STRUCT   			= 100% * (&BASE/DAMAGE_STRUCT_BASE) // &~/DAMAGE_STRUCT
//DAMAGE_EXPLOSIVE			= 0 // &~/DAMAGE_EXPLOSIVE
//AREA_DAMAGE					= 0 // &~/AREA_DAMAGE
PENETRATION  				= 200% * (&BASE/PENETRATION_BASE) // &~/PENETRATION
PENETRATION_DAMAGE   		= 85% * (&BASE/PENETRATION_DAMAGE_BASE) // &~/PENETRATION_DAMAGE
PENETRATION_SPEED  	 		= 175% * (&BASE/PENETRATION_SPEED_BASE) // &~/PENETRATION_SPEED
//ARMOR_PENETRATION_FACTOR	= 0 // &~/ARMOR_PENETRATION_FACTOR
IMPULSE      				= 100% * (&BASE/IMPULSE_BASE) // &~/IMPULSE
//IMPULSE_EXPLOSIVE			= 0 // &~/IMPULSE_EXPLOSIVE
//DRAIN_DURATION				= 0 // &~/DRAIN_DURATION
HEALTH       				= 200% * (&BASE/HEALTH_BASE) // &~/HEALTH
DAMAGE_RADIUS				= 100% * (&BASE/DAMAGE_RADIUS_BASE) //&~/DAMAGE_RADIUS
//DAMAGE_SLICES				= 0 // &~/DAMAGE_SLICES
DAMAGE_POOL 				= &~/DAMAGE // &~/DAMAGE_POOL
//TOTAL_DRAIN 				= 0 // &~/TOTAL_DRAIN
//TOTAL_SHIELD_DRAIN 			= 0 // &~/TOTAL_SHIELD_DRAIN
//DRAIN_PER_SECOND            = 0 // &~/DRAIN_PER_SECOND
//SHIELD_DRAIN_PER_SECOND     = 0 // &~/SHIELD_DRAIN_PER_SECOND

// Top-level properties tied to OC scalars
Range           = 125% * (&BASE/Range)
IdealRange      = [120, &~/Range]
IdealRadius     = &BASE/IdealRadius
Speed           = 175% * (&BASE/Speed)
ReceivableBuffs = &BASE/ReceivableBuffs

Components : &BASE/Components
{

	DamagePool
	{
		Type   = DamagePool
		Damage = { BaseValue = &~/DAMAGE_POOL; EffectScaleExponent = 1; }
	}
	Death : ^/0/Death
	{
        OnDeath
        {
            HitEffects
            [
                {
                    Type = ExplosiveDamage
                    TotalDamage = { BaseValue = &~/DAMAGE_POOL; EffectScaleExponent = 1 }
                    Radius = &~/DAMAGE_RADIUS
                    ExpandDuration = 0.9
                    ExpandStartRadius = 2
                    ExpandLoss = 100%
                    ImpulsePerNDamage = 10
                    NDamage = 5000
					Filter
					{
						OperationalHealth = true
						StructuralHealth = true
						Friendlies = true
					}
                }
            ]
            //MediaEffects = &<./Data/shots/missile_nuke/missile_nuke_stage1.rules>/Components/Hit/HitOperational/MediaEffects //TODO: Implement Custom Graphics
        }
	}

	Targetable : ^/0/Targetable
	{
		Health = &~/HEALTH
	}

	Hit : ^/0/Hit
	{
		Penetration      = &~/PENETRATION
		PenetrationSpeed = &~/PENETRATION_SPEED

		HitShield : ^/0/HitShield
		{
			HitEffects
			[
				: ../^/0/HitEffects/0 { Damage  : ^/0/Damage  { BaseValue = &~/DAMAGE_SHIELD } }
				: ../^/0/HitEffects/1 { Impulse : ^/0/Impulse { BaseValue = &~/IMPULSE } }
			]
		}

		HitOperational : ^/0/HitOperational
		{
			HitEffects
			[
				// Inherit full base entries to avoid self-references
				: ../^/0/HitEffects/0 { Damage  : ^/0/Damage  { BaseValue = &~/DAMAGE } }
				: ../^/0/HitEffects/1 { Impulse : ^/0/Impulse { BaseValue = &~/IMPULSE } }
			]
		}

		HitStructural : ^/0/HitStructural
		{
			HitEffects
			[
				: ../^/0/HitEffects/0 { Damage  : ^/0/Damage  { BaseValue = &~/DAMAGE_STRUCT } }
				: ../^/0/HitEffects/1 { Impulse : ^/0/Impulse { BaseValue = (&~/IMPULSE) / 2 } }
			]
		}

		PenetratingOperational : ^/0/PenetratingOperational
		{
			HitEffects
			[
				: ../^/0/HitEffects/0 { Damage  : ^/0/Damage  { BaseValue = &~/PENETRATION_DAMAGE } }
				: ../^/0/HitEffects/1 { Impulse : ^/0/Impulse { BaseValue = &~/IMPULSE } }
			]
		}

		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural  = &PenetratingStructural
	}

	//Needed because base Sprite has ReduceScaleWith=Hit
	Sprite : ^/0/Sprite {}


}
