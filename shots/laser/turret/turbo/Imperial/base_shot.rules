// LOCATION: shots/laser/turret/turbo/Imperial/base_shot.rules
// BASE FOR: Imperial turbolaser turret shots (shared stats & damage profile)
// STRINGKEY: NONE

//Base Stats
DAMAGE_SHIELD_BASE 				= 2400						// &~/DAMAGE_SHIELD_BASE
DAMAGE_BASE 					= 5500 						// &~/DAMAGE_BASE
DAMAGE_STRUCT_BASE 				= (&~/DAMAGE_BASE)/2 		// &~/DAMAGE_STRUCT_BASE
DAMAGE_EXPLOSIVE_BASE 			= 1000						// &~/DAMAGE_EXPLOSIVE_BASE
AREA_DAMAGE_BASE 				= 0 						// &~/AREA_DAMAGE_BASE 
DAMAGE_POOL_BASE 				= 0 						// &~/DAMAGE_POOL_BASE 
IMPULSE_BASE 					= 10 						// &~/IMPULSE_BASE 
IMPULSE_SHIELD_BASE 			= (&~/IMPULSE_BASE)*10% 	// &~/IMPULSE_SHIELD_BASE
IMPULSE_STRUCT_BASE 			= (&~/IMPULSE_BASE)/2		// &~/IMPULSE_STRUCT_BASE
IMPULSE_EXPLOSIVE_BASE 			= 0							// &~/IMPULSE_EXPLOSIVE_BASE
PENETRATION_DAMAGE_BASE 		= (&~/DAMAGE_STRUCT_BASE)	// &~/PENETRATION_DAMAGE_BASE
PENETRATION_BASE 				= 0							// &~/PENETRATION_BASE
PENETRATION_SPEED_BASE 			= 0							// &~/PENETRATION_SPEED_BASE					
ARMOR_PENETRATION_FACTOR_BASE 	= 0							// &~/ARMOR_PENETRATION_FACTOR_BASE
DRAIN_BATTERY_BASE      		= 0							// &~/DRAIN_BATTERY_BASE      
DRAIN_DURATION_BASE 			= 0							// &~/DRAIN_DURATION_BASEDRAIN_DURATION_BASE
DRAIN_PER_SECOND_BASE 			= 0							// &~/DRAIN_DURATION_BASEDRAIN_DURATION_BASE
SHIELD_DRAIN_PER_SECOND_BASE 	= 0							// &~/SHIELD_DRAIN_PER_SECOND_BASE
DAMAGE_RADIUS_BASE				= 3							// &~/DAMAGE_RADIUS_BASE
DAMAGE_SLICES_BASE 				= 0							// &~/DAMAGE_SLICES_BASE
HEALTH_BASE 					= 4000						// &~/HEALTH_BASE
RANGE_BASE						= 500						// &~/RANGE_BASE
SPEED_BASE						= 80 //*2						// &~/SPEED_BASE
IDEAL_RADIUS_BASE				= [5, 50]					// &~/IDEAL_RADIUS_BASE 

ID = "SW.turbolaser_turret_Imperial_laser_base"
OtherIDs = ["green_imperial_laser_shot", "SW.green_imperial_laser_shot_common"]
Range = &~/RANGE_BASE
IdealRange = [200, &~/RANGE_BASE]
IdealRadius = &~/IDEAL_RADIUS_BASE
Speed = &~/SPEED_BASE
ReceivableBuffs = [ElectronBuff]

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.2
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}

	Targetable
	{
		Type = Targetable
		Health = &~/HEALTH_BASE
		TargetCategory = "laser"
	}

	Hit
	{
		Type = PenetratingHit
		FactorEffectsWith = Targetable

		CrewCollisions = { Enemies = true; Junk = true }
		FriendlyShipLowCollisions = false
		SourceShipLowCollisions = false
		PenetratesCrew = true

		HitCrew = &HitOperational

		HitShield
		{
			HitEffects
			[
				{ Type = Damage;  Damage  = { BaseValue = &~/DAMAGE_SHIELD_BASE; BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent=1; } }
				{ Type = Impulse; Impulse = { BaseValue = &~/IMPULSE_SHIELD_BASE; } }
			]

			//MediaEffects[]
		}
		HitOperational
		{
			HitEffects
			[
				{ Type = Damage;        	Damage  = { BaseValue = &~/DAMAGE_BASE; BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent=1; } }
				{ Type = ExplosiveDamage; 	TotalDamage = { BaseValue = &~/DAMAGE_EXPLOSIVE_BASE; BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent=1; }; Radius = &~/DAMAGE_RADIUS_BASE; Filter = { Friendlies = false } }
				{ Type = Impulse;       	Impulse = { BaseValue = &~/IMPULSE_BASE; } }
			]

			//MediaEffects[]
		}
		HitStructural
		{
			HitEffects
			[
				{ Type = Damage; 			Damage  = { BaseValue = &~/DAMAGE_STRUCT_BASE; BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent=1; } }
				{ Type = ExplosiveDamage; 	TotalDamage = { BaseValue = (&~/DAMAGE_EXPLOSIVE_BASE)/2; BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent=1; }; Radius = &~/DAMAGE_RADIUS_BASE; Filter = { Friendlies = false } }
				{ Type = Impulse; 			Impulse = { BaseValue = &~/IMPULSE_STRUCT_BASE; } }
			]

			//MediaEffects[]
		}
		PenetratingOperational
		{
			//ReduceEffectsByPenetration = true
			//HitEffects[]
			//MediaEffects[]
		}
		PenetratingStructural
		{
			//HitEffects[]
			//MediaEffects[]
		}
		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural = &PenetratingStructural
	}

	Sprite
	{
		Type = AnimatedSprite
		RenderBucket = BulletUpper3
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					SampleMode = Linear
					MipLevels = max
				}
				Size = [1.75, 1.75]
			}
			FrameCount = 8
			FrameSize = [128, 128]
			FramesPerRow = 2
			FramesPerSecond = 64
		}
		DiffuseShader = "./Data/default.shader"
		NormalsShader = "./Data/no_normals.shader"
	}

	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0.5
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [6, 6]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
		}
	}

}

