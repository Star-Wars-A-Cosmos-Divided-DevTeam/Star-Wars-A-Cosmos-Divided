// LOCATION: shots/laser/turret/turbo/heavy/green_shot.rules
// USED IN: ships/terran/weapons/turbolasers/Turbolasers_Octuple_Barbette/octuple_barbette_turbolaser.rules, ships/terran/weapons/turbolasers/Turbolasers_Octuple_Barbette/quad_barbette_turbolaser.rules,
// BASE IS: &<base_shot.rules>
// STRINGKEY: NONE
BASESHOT = &<base_shot.rules>

DAMAGE_SHIELD_BASE = (&BASESHOT/DAMAGE_SHIELD_BASE)
DAMAGE_BASE = (&BASESHOT/DAMAGE_BASE)
DAMAGE_STRUCT_BASE = (&BASESHOT/DAMAGE_STRUCT_BASE)
IMPULSE_BASE = (&BASESHOT/IMPULSE_BASE)
EXPLOSIVE_DAMAGE_BASE = (&BASESHOT/EXPLOSIVE_DAMAGE_BASE)
AREA_DAMAGE_BASE = (&BASESHOT/AREA_DAMAGE_BASE)
DAMAGE_POOL_BASE = (&BASESHOT/DAMAGE_POOL_BASE)
PENETRATION_DAMAGE_BASE = (&BASESHOT/PENETRATION_DAMAGE_BASE)
PENETRATION_BASE = (&BASESHOT/PENETRATION_BASE)
PENETRATION_SPEED_BASE = (&BASESHOT/PENETRATION_SPEED_BASE)
ARMOR_PENETRATION_FACTOR_BASE = (&BASESHOT/ARMOR_PENETRATION_FACTOR_BASE)
DRAIN_DURATION_BASE = (&BASESHOT/DRAIN_DURATION_BASE)
DRAIN_PER_SECOND_BASE = (&BASESHOT/DRAIN_PER_SECOND_BASE)
SHIELD_DRAIN_PER_SECOND_BASE = (&BASESHOT/SHIELD_DRAIN_PER_SECOND_BASE)
RADIUS_BASE = (&BASESHOT/RADIUS_BASE)


ID = SW.turbolaser_turret_heavy_laser_green_shot //TURRET WEAPONSHOT
// OtherIDs = ["green_heavy_laser_shot""]
Range = &BASESHOT/Range
IdealRange =  &BASESHOT/IdealRange
IdealRadius = &BASESHOT/IdealRadius
Speed = &BASESHOT/Speed
ReceivableBuffs = &BASESHOT/ReceivableBuffs

Components : &BASESHOT/Components
{
	Hit : ^/0/Hit
	{
		HitCrew = &HitOperational
		HitShield = &HitOperational
		HitOperational : ^/0/HitOperational
		{
			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Hit/Med/Green
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Green
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Green

				&/SW_SOUNDS/SmallLaserHit

				: /BASE_SHAKE
				{
					ShakeAmount = .1
					Duration = .4
				}
			]
		}

		HitStructural : ^/0/HitStructural
		{
			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/HitStruct/Med/Green

				&/SW_SOUNDS/SmallLaserHit
			]
		}
		PenetratingOperational : ^/0/PenetratingOperational
		{
			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Green
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Green
			]
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural = &PenetratingStructural
	}

	Sprite : ^/0/Sprite
	{
		Animation : ^/0/Animation
		{
			AtlasSprite : ^/0/AtlasSprite
			{
				Texture : ^/0/Texture
				{
					File = "particles/heavy_laser_green_shot.png"
				}
			}
		}
	}
	GlowSprite : ^/0/GlowSprite
	{
		Sprite : ^/0/Sprite
		{
			VertexColor = [0, 255, 0]
			_litReflectiveStrength = 6
			_litAdditiveStrength = 0.02
			_unlitAdditiveStrength = 0.1
		}
	}
}