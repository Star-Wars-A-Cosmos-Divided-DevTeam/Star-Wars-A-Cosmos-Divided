// LOCATION: shots/laser/turret/turbo/xx9/overclock/oc_base_shot.rules
// PURPOSE: Shared overclock stats/behavior for all xx9 turbolaser shots
// NOTE: No color media here -- color OC files pull visuals from their non-OC counterparts.

BASE = &<../base_shot.rules>

ID = "SW.turbolaser_turret_xx9_laser_base_overclock"

// OC scalars (match base values but keep hooks for tuning)
DAMAGE_SHIELD   			= 200% * (&BASE/DAMAGE_SHIELD_BASE)
DAMAGE    					= 85% * (&BASE/DAMAGE_BASE)
DAMAGE_STRUCT   			= 100% * (&BASE/DAMAGE_STRUCT_BASE)
DAMAGE_EXPLOSIVE			= (&BASE/DAMAGE_EXPLOSIVE_BASE)
AREA_DAMAGE					= (&BASE/AREA_DAMAGE_BASE)
PENETRATION  				= 200% * (&BASE/PENETRATION_BASE)
PENETRATION_DAMAGE   		= 85% * (&BASE/PENETRATION_DAMAGE_BASE)
PENETRATION_SPEED  	 		= 175% * (&BASE/PENETRATION_SPEED_BASE)
ARMOR_PENETRATION_FACTOR	= (&BASE/ARMOR_PENETRATION_FACTOR_BASE)
IMPULSE      				= 100% * (&BASE/IMPULSE_BASE)
IMPULSE_EXPLOSIVE			= (&BASE/IMPULSE_EXPLOSIVE_BASE)
DRAIN_DURATION				= (&BASE/DRAIN_DURATION_BASE)
DRAIN_PER_SECOND			= (&BASE/DRAIN_PER_SECOND_BASE)
SHIELD_DRAIN_PER_SECOND		= (&BASE/SHIELD_DRAIN_PER_SECOND_BASE)
HEALTH       				= 200% * (&BASE/HEALTH_BASE)
DAMAGE_RADIUS				= 100% * (&BASE/DAMAGE_RADIUS_BASE)
DAMAGE_SLICES				= (&BASE/DAMAGE_SLICES_BASE)
DAMAGE_POOL 				= 3000 // (&BASE/DAMAGE_POOL_BASE)


// Top-level properties tied to OC scalars
Range           = 125% * (&BASE/Range)
IdealRange      = [120, &~/Range]
IdealRadius     = &BASE/IdealRadius
Speed           = 175% * (&BASE/SPEED_BASE)
ReceivableBuffs = &BASE/ReceivableBuffs

// Inherit base, but override key BaseValue fields to use OC scalars
Components : &BASE/Components
{

	DamagePool
	{
		Type   = DamagePool
		Damage = { BaseValue = &~/DAMAGE_POOL; EffectScaleExponent = 1; }
	}
	Death : ^/0/Death
	{
        OnDeath
        {
            HitEffects
            [
                {
                    Type = ExplosiveDamage
                    TotalDamage = { BaseValue = &~/DAMAGE_POOL; EffectScaleExponent = 1 }
                    Radius = 3
                    ExpandDuration = 0.9
                    ExpandStartRadius = 2
                    ExpandLoss = 100%
                    ImpulsePerNDamage = 10
                    NDamage = 10000
					Filter
					{
						OperationalHealth = true
						StructuralHealth = true
						Friendlies = true
					}
                }
            ]
            //MediaEffects = &<./Data/shots/missile_nuke/missile_nuke_stage1.rules>/Components/Hit/HitOperational/MediaEffects //TODO: Implement Custom Graphics
        }
	}

	Targetable : ^/0/Targetable
	{
		Health = &~/HEALTH
	}

	Hit : ^/0/Hit
	{
		Penetration      = &~/PENETRATION
		PenetrationSpeed = &~/PENETRATION_SPEED
		// Keep same structure & media; only scale values via variables above
		HitShield : ^/0/HitShield
		{
			HitEffects
			[
				: ../^/0/HitEffects/0 { Damage  : ^/0/Damage  { BaseValue = &~/DAMAGE_SHIELD } }
				: ../^/0/HitEffects/1 { Impulse : ^/0/Impulse { BaseValue = &~/IMPULSE } }
				//{
				//	Type = StatusApplication
				//	StatusType = cosmoteer.heat
				//	StatusValue = { BaseValue = &~/Components/Hit/HeatCarryStorage/ProvidedValuePerResource; EffectScaleExponent = 1 }
				//	ApplyToAllHitPartTiles = true
				//	DivideValueByPartArea = true
				//}
			]
		}

		HitOperational : ^/0/HitOperational
		{
			HitEffects
			[
				// Inherit full base entries to avoid self-references
				: ../^/0/HitEffects/0 { Damage  : ^/0/Damage  { BaseValue = &~/DAMAGE } }
				: ../^/0/HitEffects/1 { Impulse : ^/0/Impulse { BaseValue = &~/IMPULSE } }
			]
		}

		HitStructural : ^/0/HitStructural
		{
			HitEffects
			[
				: ../^/0/HitEffects/0 { Damage  : ^/0/Damage  { BaseValue = &~/DAMAGE_STRUCT } }
				: ../^/0/HitEffects/1 { Impulse : ^/0/Impulse { BaseValue = (&~/IMPULSE) / 2 } }
			]
		}

		PenetratingOperational : ^/0/PenetratingOperational
		{
			HitEffects
			[
				: ../^/0/HitEffects/0 { Damage  : ^/0/Damage  { BaseValue = &~/PENETRATION_DAMAGE } }
				: ../^/0/HitEffects/1 { Impulse : ^/0/Impulse { BaseValue = &~/IMPULSE } }
				: ../^/0/HitEffects/2 {}
			]
		}

		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural  = &PenetratingStructural
	}

	// Keep Sprite present (base uses ReduceScaleWith=Hit)
	Sprite : ^/0/Sprite {}
}
