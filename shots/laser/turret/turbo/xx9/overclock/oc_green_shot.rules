// LOCATION: shots/laser/turret/turbo/xx9/overclock/oc_green_shot.rules
// PURPOSE: Overclocked Green variant (OC stats/behavior from oc_base_shot; visuals from non-OC green)

BASE_OC = &<oc_base_shot.rules>
GREEN    = &<../green_shot.rules>

ID           = SW.turbolaser_turret_xx9_laser_green_shot_overclock
Range        = &BASE_OC/Range
IdealRange   = &BASE_OC/IdealRange
IdealRadius  = &BASE_OC/IdealRadius
Speed        = &BASE_OC/Speed
ReceivableBuffs = &BASE_OC/ReceivableBuffs

Components : &BASE_OC/Components
{

	Death : ^/0/Death
	{
        OnDeath : ^/0/OnDeath
        {
			MediaEffects = &~/Components/Hit/HitOperational/MediaEffects
        }
	}

	// Re-apply GREEN hit/flash/sparks media (keep OC damage model)
	Hit : ^/0/Hit
	{
		HitOperational : ^/0/HitOperational
		{


			HitEffects
			[
				: ../^/0/HitEffects/0 {}
				: ../^/0/HitEffects/1
				{
					MediaEffects
					[
						&<particles/StaticCharge_overclock_lightning_hit_green.rules>
						&<particles/StaticCharge_overclock_flash.rules>
						&<particles/StaticCharge_hit_sparks_green.rules>
					]
					ChainMediaEffects
					[
						&<particles/StaticCharge_overclock_lightning_chain_green.rules>
						&<particles/StaticCharge_overclock_flash.rules>
						&<particles/StaticCharge_hit_sparks_green.rules>
					]
				}
				: ../^/0/HitEffects/2 {}
			]
			MediaEffects
			[
				&<particles/laser_bolt_large_overclock_hit_green.rules>
				&<particles/laser_bolt_large_overclock_sparks.rules>
				&<particles/laser_bolt_large_overclock_flash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "sounds/sw_ion_impact.wav"
					Volume = .4
					SpeedVariation = .4
				}

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["sounds/ion_lightning_strike_01.wav",
									"sounds/ion_lightning_strike_02.wav",
									"sounds/ion_lightning_strike_03.wav",
									"sounds/ion_lightning_strike_04.wav",
									"sounds/ion_lightning_strike_05.wav",
									"sounds/ion_lightning_strike_06.wav",
									"sounds/ion_lightning_strike_07.wav"]
					Volume = 0.75
					Speed = .5
					SpeedVariation = .15
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .06
					Duration = .3
				}

				: <particles/StaticCharge_overclock_spikes_green.rules>
				{
					Filter
					{
					}
				}

				: <particles/StaticCharge_overclock_sparks_radial_green.rules>
				{
					Filter
					{
					}
				}

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "sounds/sw_ion_impact.wav"
					Db = 2
					MaxConcurrent = 1
					MaxConcurrentVolume = 1
					RampUpTime = 0.75
					RampDownTime = 0.75
					Filter
					{
					}
				}
				{
					Type = Quad
					Bucket = IonHitSpikes
					IntensityScaleFactor = 1
					IntensityScaleExponent = 0.5
					FadeInTime = 0.2
					FadeOutTime = 0.2
					Sprite
					{
						Color = [255, 255, 255, 255]
						Size = [24, 24]
						Shader = particles/ion_storm.shader
						Texture
						{
							File = ./Data/common_effects/particles/noise_voronoi.png
							SampleMode = Linear
							MipLevels = max
							UMode = Wrap
							VMode = Wrap
						}
						_noiseTex1
						{
							File = ./Data/common_effects/particles/noise_cracks.png
							SampleMode = Linear
							MipLevels = max
							UMode = Wrap
							VMode = Wrap
						}
						_color1 = [0, 255, 0, 255]
						_color2 = [255 * 0.8, 255, 255 * 0.8, 255]
						_noise1ScrollSpeed = [-0.03, -0.3]
						_noise2ScrollSpeed = [0.04, -0.34]
						TargetBlendMode = Add
					}
					Filter
					{
					}
				}
			]
		}
	}

	// Reuse the GREEN textures & glow tuning
	Sprite : ^/0/Sprite
	{
		Animation : ^/0/Animation
		{
			AtlasSprite : ^/0/AtlasSprite
			{
				Texture : ^/0/Texture
				{
					File = &~/GREEN/Components/Sprite/Animation/AtlasSprite/Texture/File
				}
			}
		}
	}

	MediaEffects
	{
		Type = MediaEffects
		//Offset = [-0.5, 0]
		FactorEffectsWith = Hit
		FactorEffectsExponent = 0.5
		MediaEffects
		[
			&<particles/laser_bolt_large_overclock_lightning_green.rules>
		]
	}

	GlowSprite : ^/0/GlowSprite
	{
		Sprite : ^/0/Sprite
		{
			VertexColor            = &~/GREEN/Components/GlowSprite/Sprite/VertexColor
			_litReflectiveStrength = &~/GREEN/Components/GlowSprite/Sprite/_litReflectiveStrength
			_litAdditiveStrength   = &~/GREEN/Components/GlowSprite/Sprite/_litAdditiveStrength
			_unlitAdditiveStrength = &~/GREEN/Components/GlowSprite/Sprite/_unlitAdditiveStrength
		}
	}

}
