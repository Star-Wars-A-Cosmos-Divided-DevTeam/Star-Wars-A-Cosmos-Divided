// LOCATION: shots\laser\turret\concussion\heavy\overclock\oc_blue_shot.rules
// PURPOSE: Overclocked Blue variant (stats from OC base, visuals from non-OC blue)

BASE_OC = &<oc_base_shot.rules>
BLUE = &<../blue_shot.rules>

ID = "SW.concussion_turret_heavy_laser_blue_shot_overclock"
Range       = &BASE_OC/Range
IdealRange  = &BASE_OC/IdealRange
IdealRadius = &BASE_OC/IdealRadius
Speed       = &BASE_OC/Speed
ReceivableBuffs = &BASE_OC/ReceivableBuffs

// Bring in OC stats (which already override base behavior to DamagePool model)
Components : &BASE_OC/Components
{
	// On-death media: use non-OC blue's operational media for consistency.
	Targetable : ^/0/Targetable
	{
		OnDeath : ^/0/OnDeath
		{
			MediaEffects = &~/BLUE/Components/Hit/HitOperational/MediaEffects
		}
	}

	// Re-attach all BLUE media from the non-OC file.
	Hit : ^/0/Hit
	{
		HitShield : ^/0/HitShield
		{
			MediaEffects = &~/BLUE/Components/Hit/HitShield/MediaEffects
		}
		HitOperational : ^/0/HitOperational
		{
			MediaEffects = &~/BLUE/Components/Hit/HitOperational/MediaEffects
		}
		PenetratingOperational : ^/0/PenetratingOperational
		{
			MediaEffects = &~/BLUE/Components/Hit/PenetratingOperational/MediaEffects
		}
		FinishedPenetratingStructural : ^/0/FinishedPenetratingStructural
		{
			MediaEffects = &~/BLUE/Components/Hit/FinishedPenetratingStructural/MediaEffects
		}
	}

	// Re-apply the Blue texture & glow settings.
	Sprite : ^/0/Sprite
	{
		ReduceScaleWith = DamagePool
		Animation : ^/0/Animation
		{
			AtlasSprite : ^/0/AtlasSprite
			{
				Texture : ^/0/Texture
				{
					File = &~/BLUE/Components/Sprite/Animation/AtlasSprite/Texture/File
				}
			}
		}
	}

	GlowSprite : ^/0/GlowSprite
	{
		Sprite : ^/0/Sprite
		{
			VertexColor            = &~/BLUE/Components/GlowSprite/Sprite/VertexColor
			_litReflectiveStrength = &~/BLUE/Components/GlowSprite/Sprite/_litReflectiveStrength
			_litAdditiveStrength   = &~/BLUE/Components/GlowSprite/Sprite/_litAdditiveStrength
			_unlitAdditiveStrength = &~/BLUE/Components/GlowSprite/Sprite/_unlitAdditiveStrength
		}
	}

	MediaEffects : ^/0/MediaEffects
	{
		MediaEffects = &~/BLUE/Components/MediaEffects/MediaEffects
	}
}
