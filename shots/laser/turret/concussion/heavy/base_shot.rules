// LOCATION: shots\laser\turret\concussion\heavy\base_shot.rules
// USED IN: shots/laser/turret/concussion/heavy/red_shot.rules, shots/laser/turret/concussion/heavy/green_shot.rules, shots/laser/turret/concussion/heavy/blue_shot.rules
// BASE FOR: Heavy Concussive Blast Laser Shots
// STRINGKEY: NONE

//Base Stats
DAMAGE_SHIELD_BASE = 20000 
DAMAGE_BASE = 30000
DAMAGE_STRUCT_BASE = (&~/DAMAGE_BASE)/2
DAMAGE_EXPLOSIVE_BASE = 0
AREA_DAMAGE_BASE = 0
DAMAGE_POOL_BASE = 0
IMPULSE_BASE = 400
IMPULSE_SHIELD_BASE = (&~/IMPULSE_BASE)*75%
IMPULSE_STRUCT_BASE = (&~/IMPULSE_BASE)/2
IMPULSE_EXPLOSIVE_BASE = 0
PENETRATION_DAMAGE_BASE = (&~/DAMAGE_STRUCT_BASE)
PENETRATION_BASE = 200
PENETRATION_SPEED_BASE = 26 //*2
ARMOR_PENETRATION_FACTOR_BASE = 0
DRAIN_DURATION_BASE = 0
DRAIN_PER_SECOND_BASE = 0
SHIELD_DRAIN_PER_SECOND_BASE = 0
DAMAGE_RADIUS_BASE = 0
DAMAGE_SLICES_BASE = 0
HEALTH_BASE = 20000

ID = "SW.concussion_turret_heavy_laser_base" 
Range = 550
IdealRange = [200, &~/Range]
IdealRadius = [5, 50]
Speed = 80 //*2
ReceivableBuffs = [ElectronBuff]

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.45
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime  // Lifetime auto-calculated from Range & Speed
	}

	Targetable
	{
		Type = Targetable
		Health = (&~/HEALTH_BASE)
		TargetCategory = "laser"

		OnDeath
		{

		}
	}

	Hit
	{
		Type = PenetratingHit
		Penetration = &~/PENETRATION_BASE
		PenetrationSpeed = &~/PENETRATION_SPEED_BASE

		CrewCollisions = { Enemies=true; Junk=true }
		FriendlyShipLowCollisions = false
		PenetratesCrew = true
		HitCrew = &HitOperational

		HitShield
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]

			HitEffects
			[
				{ Type = Damage;  Damage  = { BaseValue = (&~/DAMAGE_SHIELD_BASE); BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent = 1; } }  // was 20000
				{ Type = Impulse; Impulse = { BaseValue =   (&~/IMPULSE_SHIELD_BASE); EffectScaleExponent = 1; } }
			]

		}

		HitOperational
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]

			HitEffects
			[

				{ Type = Damage;  Damage  = { BaseValue =  (&~/DAMAGE_BASE); BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent = 1; } }
				{ Type = Impulse; Impulse = { BaseValue = (&~/IMPULSE_BASE); EffectScaleExponent = 1; } }
			]

		}

		HitStructural
		{
			ReduceEffectsByPenetration = true
			Offset = [0.5, 0]

			HitEffects
			[
				{ Type = Damage;	Damage = { BaseValue = (&~/DAMAGE_STRUCT_BASE); BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent = 1; } }
				{ Type = Impulse;	Impulse = { BaseValue = (&~/IMPULSE_STRUCT_BASE); EffectScaleExponent = 1; } }
			]
		}

		PenetratingOperational
		{
			ReduceEffectsByPenetration = true

			HitEffects
			[
				{
					Type = Damage;	Damage = { BaseValue = (&~/PENETRATION_DAMAGE_BASE); BuffType=ElectronBuff; BuffMode=Multiply; EffectScaleExponent = 1; }
				}
				{
					Type = StatusApplication
					StatusType = cosmoteer.fire
					StatusChance = { BaseValue = .4; EffectScaleExponent = 1 }
					ValueType = Interpolated
				}
				{ Type = Impulse; Impulse = { BaseValue = (&~/IMPULSE_STRUCT_BASE); EffectScaleExponent = 1; } }
			]

		}

		PenetratingStructural
		{
			//Nothing
		}
		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural = &PenetratingStructural

	}

	Sprite
	{
		Type = AnimatedSprite
		RenderBucket = BulletUpper3
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					SampleMode = Linear
					MipLevels = max
				}
				Size = [3, 1.5]
			}
			FrameCount = 2
			FrameSize = [64, 32]
			FramesPerRow = 1
			FramesPerSecond = 24
		}
		// Vanilla norm map passthrough:
		NormalsTexture = &Animation/AtlasSprite/Texture
		DiffuseShader  = "./Data/default.shader"
		NormalsShader  = "./Data/no_normals.shader"
	}

	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0.5
		IsLight = true
		Offset = [-1.5, 0]
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [16, 9]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_z = 1
            _nrmlStrengthLimit = 1
		}
	}

	MediaEffects // Trail
	{
		Type = MediaEffects
		Offset = [2, 0]
	}
}
