// LOCATION: shots\laser\turret\concussion\heavy\red_shot.rules
// USED IN: ships\terran\weapons\turbolasers\Turbolasers_Siege_12x12\siege12x12red.rules "Dual 70TT Superheavy Siege Turbolaser"
// STRINGKEY: HeavyRedConcussiveBlastLasershot = "Heavy <red>Red</red> Concussive Blast Laser Shot"
ID = "SW.concussion_turret_heavy_laser_red_shot" 
Range = 550
IdealRange = [200, &~/Range]
IdealRadius = [5, 50]
Speed = 80

Components : &<base_shot.rules>/Components
{
	Targetable : ^/0/Targetable
	{
		OnDeath : ^/0/OnDeath
		{
			MediaEffects = &~/Components/Hit/HitOperational/MediaEffects
		}
	}


	Hit : ^/0/Hit
	{
		HitShield : ^/0/HitShield
		{
			MediaEffects
			[
				&/SW_PARTICLES/SWConcussionLaserHitRed
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Red
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Red

				&/SW_SOUNDS/SmallLaserHit

				: /BASE_SHAKE { ShakeAmount = 0.03; Duration = 0.3 }
			]
		}
		HitOperational : ^/0/HitOperational
		{
			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Red
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Red
				&/SW_PARTICLES/SWConcussionLaserHitRed
				&/SW_PARTICLES/SWFlakLargeFlash

				&/SW_SOUNDS/SWConcussionLaserHit
				: /BASE_SHAKE { ShakeAmount = 0.2; Duration = 0.75 }
			]
		}

		PenetratingOperational : ^/0/PenetratingOperational
		{

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Red
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Red
				&/SW_PARTICLES/SWConcussionLaserHitRed
				&/SW_PARTICLES/SWFlakLargeFlash
			]
		}

		FinishedPenetratingStructural : ^/0/FinishedPenetratingStructural
		{

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Red
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Red
				&/SW_PARTICLES/SWConcussionLaserHitRed
				&/SW_PARTICLES/SWFlakLargeFlash
			]	
		}
	}
	Sprite : ^/0/Sprite
	{
		Animation : ^/0/Animation
		{
			AtlasSprite : ^/0/AtlasSprite
			{
				Texture : ^/0/Texture
				{
					File = "particles/lasershotred.png"
				}
			}
		}
	}

	GlowSprite : ^/0/GlowSprite
	{
		Sprite : ^/0/Sprite
		{
			VertexColor = [255, 0, 0]
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.125
		}
	}
	MediaEffects : ^/0/MediaEffects
	{
		MediaEffects
		[
			&/SW_PARTICLES/SWConcussionLaserTrailRed
		]
	}
}

