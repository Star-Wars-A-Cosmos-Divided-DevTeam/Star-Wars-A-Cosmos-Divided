// shots/missiles/discord/missile_discord.rules
ID = SW.discord_missle
OtherIDs = ["discord_missle"]

Range      = 150
IdealRange = 125
Speed      = 65

Components
{
    Physics
    {
        Type          = CirclePhysics
        Density       = 0.1
        Radius        = 0.4
        LinearDamping = 1.1
    }

    Homing
    {
        Type                 = TargetHoming
        TurnVelocity         = 360d
        Delay                = 1
        AvoidanceRaycastDistance = 250
        VelocityCompensation = 60%
    }

    Retarget
    {
        Type = SameShipRetarget
    }

    Acceleration
    {
        Type         = Acceleration
        Acceleration = 65
    }

    NegativeAcceleration
    {
        Type                = Acceleration
        Acceleration        = [-90, 0]
        AccelerationOverTime= [0, .75]
        Direction           = FrameOfReferenceVelocity
    }

    // Stage 1 deploy: proximity spawn
    DeathByEnemyProximity
    {
        Type           = DeathByEnemyProximity
        Interval       = .05
        Range          = 25
        DetectsShips   = true
        DetectsBullets = false
        StartDelay     = .1

        OnDeath
        {
            HitEffects
            [
                {
                    Type            = SpawnBullets
                    Bullet          = &<../buzz-droids/buzzdroid.rules>
                    Count           = [5,7]
                    Distance        = [0, 3]
                    Arc             = [-0d, 0d]
                    Spread          = [-50d, 50d]
                    InheritVelocity = true
                }
            ]
        }
    }

    // Stage 1 fallback: lifetime spawn
    DeathByLifetime
    {
        Type     = DeathByLifetime
        Lifetime = 2
        TargetHomingComponent = Homing

        OnDeath
        {
            HitEffects
            [
                {
                    Type            = SpawnBullets
                    Bullet          = &<../buzz-droids/buzzdroid.rules>
                    Count           = [5,7]
                    Distance        = [0, 3]
                    Arc             = [-0d, 0d]
                    Spread          = [-50d, 50d]
                    InheritVelocity = true
                }
            ]
        }
    }

    Sprite
    {
        Type         = Sprite
        RenderBucket = BulletUpper3
        Sprite
        {
            Texture
            {
                File       = "missile_discord.png"
                SampleMode = Linear
                MipLevels  = max
            }
            Size = [2, 1.5]
        }
        NormalsTexture
        {
            File      = "missile_discord_normals.png"
            MipLevels = max
        }
    }

    MediaEffects1
    {
        Type     = MediaEffects
        Offset   = [-1.5, 0]
        Rotation = 180d
        MediaEffects
        [
            &<particles/missile_discord_thruster_plume_light.rules>
            &<particles/missile_discord_thruster_smoke.rules>
        ]
    }

    MediaEffects2
    {
        Type       = MediaEffects
        Offset     = [-1, 0]
        MediaEffects
        [
            &/SW_PARTICLES/Shot/Ion/Trail/Med/Cyan
        ]
    }

    Targetable
    {
        Type           = Targetable
        Health         = 7000
        TargetCategory = "missile"

        OnDeath
        {
            MediaEffects
            [
                &<./Data/shots/bullet_med/particles/bullet_hit_med.rules>
                &<./Data/shots/bullet_med/particles/bullet_smoke_med.rules>
                &<./Data/shots/bullet_med/particles/bullet_flash_med.rules>

                : /BASE_SOUNDS/AudioExterior
                {
                    Sound          = "./Data/shots/bullet_med/bullet_med_hit.wav"
                    Volume         = .4
                    SpeedVariation = .4
                }

                : /BASE_SHAKE
                {
                    ShakeAmount = .05
                    Duration    = .5
                }
            ]
        }
    }

    // simplified Hit: no circular refs
    Hit
    {
        Type                    = SimpleHit
        SourceShipCollisionDelay= .01
		HitShield = &~/Components/DeathByEnemyProximity/OnDeath
		HitOperational = &~/Components/DeathByEnemyProximity/OnDeath
		HitStructural = &~/Components/DeathByEnemyProximity/OnDeath
    }
}
