// shots/missiles/discord/buzz-droids/buzzdroid.rules
ID = SW.buzz_bullet
OtherIDs = ["buzz_bullet"]

Range          = 30
IdealRange     = 25
Speed          = 15
RandomRotation = true

Components
{
    Physics
    {
        Type                    = CirclePhysics
        Radius                  = .3
        Density                 = 2
        LinearDamping           = .5
        AngularDamping          = 1
        CollidesWithBullets     = true
        FrameOfReferenceDuration= 1
    }

    Homing
    {
        Type                   = TargetHoming
        TurnVelocity           = 360d
        Delay                  = 0
        RaycastForward         = [1, 0]
        RaycastLeft            = [1, -1]
        RaycastRight           = [1, 1]
        ModifiesLinearVelocity = true
        VelocityCompensation   = 5%
    }

    Repulsion
    {
        Type                        = ProximityAcceleration
        Range                       = 30
        Acceleration                = 5
        AccelerateTowardsShips      = true
        AccelerateTowardsBullets    = false
        AccelerateTowardsBulletCategories = []
        AccelerateTowardsFriendlies = false
        AccelerateTowardsEnemies    = true
    }

    Retarget
    {
        Type = SameShipRetarget
    }

    Acceleration
    {
        Type         = Acceleration
        Acceleration = 10
    }

    DeathByLifetime
    {
        Type     = DeathByLifetime
        Lifetime = 150
    }

    Targetable
    {
        Type           = Targetable
        Health         = 500
        TargetCategory = "missile"

        OnDeath
        {
            MediaEffects = &~/Components/Hit/HitOperational/MediaEffects
        }
    }

    Hit
    {
        Type              = PenetratingHit
        Penetration       = 400
        PenetratesShields = true
        PenetrationSpeed  = 0.05

        HitShield
        {
            HitEffects
            [
                {
                    Type            = SpawnBullets
                    Bullet          = &<buzzdroid_deployed.rules>
                    Count           = [5,7]
                    Distance        = [0, 1]
                    Arc             = [0d, 0d]
                    Spread          = [-360d, 360d]
                    InheritVelocity = false
                }
                {
                    Type   = Damage
                    Damage = 35
                }
            ]

            MediaEffects = &../HitOperational/MediaEffects
        }

        HitOperational
        {
            StartDelay = 3
            HitEffects
            [
                {
                    Type   = Damage
                    Damage = 125
                }
            ]

            MediaEffects
            [
                &<particles/BuzzDroid_debris.rules>


            : /BASE_SOUNDS/AudioExterior
            {
                Sound         = "./Data/crew/salvage.wav"
                Volume        = 0.4
                MaxConcurrent = 2
            }


			: /BASE_SOUNDS/AudioExterior
			{
				RandomSounds = ["sounds/Buzz_droids_1.wav",
								"sounds/Buzz_droids_2.wav",
								"sounds/Buzz_droids_3.wav",
								"sounds/Buzz_droids_4.wav",
								"sounds/Buzz_droids_5.wav"]
				Volume = 0.75
				Speed = 1
				SpeedVariation = .05
            }
            ]

        }

        HitStructural                    = &HitOperational
        PenetratingOperational           = &HitOperational
        PenetratingStructural            = &HitOperational
        FinishedPenetratingOperational   = &HitOperational
        FinishedPenetratingStructural    = &HitOperational
    }

    HitSprite
    {
        Type         = AnimatedSprite
        RenderBucket = BulletUpper4
        StartTime    = &~/Components/Hit/HitOperational/StartDelay

        Animation
        {
            AtlasSprite
            {
                Texture = "buzz bullet.png"
                Size    = [1.5, 1.5]
            }
            FrameCount      = 5
            FrameSize       = [64, 64]
            FramesPerRow    = 1
            FramesPerSecond = 3
            WrapMode        = Clamp
        }

        NormalsTexture
        {
            File      = "buzz bullet_normals.png"
            MipLevels = max
        }
    }

    RollingSprite
    {
        Type         = AnimatedSprite
        RenderBucket = BulletUpper3
        EndTime      = &~/Components/Hit/HitOperational/StartDelay

        Animation
        {
            AtlasSprite
            {
                Texture = "buzz bullet rollin.png"
                Size    = [1.5, 1.5]
            }
            FrameCount      = 4
            FrameSize       = [64, 64]
            FramesPerRow    = 1
            FramesPerSecond = 20
        }

        NormalsTexture
        {
            File      = "buzz bullet rollin_normals.png"
            MipLevels = max
        }
    }

    Thruster_MediaEffectsR
    {
        Type                = MediaEffects
        InheritVelocityFrom = Physics
        Offset              = [-24/64, -.35]
        MediaEffects
        [
            &<./Data/crew/particles/thruster_fire_crew.rules>
            &<./Data/crew/particles/thruster_plume_crew.rules>
            &<./Data/crew/particles/thruster_plume_light_crew.rules>
            &<./Data/crew/particles/thruster_smoke_crew.rules>
        ]
    }

    Thruster_MediaEffectsL
    {
        Type                = MediaEffects
        InheritVelocityFrom = Physics
        Offset              = [-24/64, .35]
        MediaEffects
        [
            &<./Data/crew/particles/thruster_fire_crew.rules>
            &<./Data/crew/particles/thruster_plume_crew.rules>
            &<./Data/crew/particles/thruster_plume_light_crew.rules>
            &<./Data/crew/particles/thruster_smoke_crew.rules>
        ]
    }
}
