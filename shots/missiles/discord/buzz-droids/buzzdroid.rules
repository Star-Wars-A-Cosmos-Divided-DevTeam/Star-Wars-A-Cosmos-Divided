ID = SW.buzz_bullet
OtherIDs = ["buzz_bullet"]

Range = 30
IdealRange = 25
Speed = 10.5

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = .5
		Density = 0.1
		LinearDamping = 1
	}

	Homing
	{
		Type = TargetHoming
		TurnVelocity = 360d
		Delay = .1
		RaycastForward = [1, 0]
		RaycastLeft = [1, -1]
		RaycastRight = [1, 1]
	}

	Retarget
	{
		Type = SameShipRetarget
	}

	Acceleration
	{
		Type = Acceleration
		Acceleration = 15
	}

	DeathByLifetime
	{
		Type = DeathByLifetime
		Lifetime = 100
	}

	Targetable
	{
		Type = Targetable
		Health = 500
		TargetCategory = "missile"

		OnDeath
		{
			MediaEffects = &~/Components/Hit/HitOperational/MediaEffects
		}
	}

	Hit
	{
		Type = PenetratingHit
		Penetration = 400
		PenetratesShields = true
		PenetrationSpeed = 0.05

		HitShield
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 50
				}
			]

			MediaEffects = &../HitOperational/MediaEffects
		}
		HitOperational
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 300
				}

			]

			MediaEffects
			[
				&<particles/BuzzDroid_debris.rules>
			]
		}
		HitStructural = &HitOperational

		PenetratingOperational = &HitOperational
		PenetratingStructural = &HitOperational

		FinishedPenetratingOperational = &HitOperational
		FinishedPenetratingStructural = &HitOperational
	}

	Sprite
	{
		Type = AnimatedSprite
		RenderBucket = BulletUpper4
		Animation
		{
			AtlasSprite
			{
				Texture = "buzz bullet.png"
				Size = [1.5, 1.5]
			}
			FrameCount = 5
			FrameSize = [64, 64]
			FramesPerRow = 1
			FramesPerSecond = 5//7.5
			WrapMode = Clamp
		}
		NormalsTexture
		{
			File = "buzz bullet_normals.png"
			MipLevels = max
		}
	}

	Thruster_MediaEffects
	{
		Type = MediaEffects
		InheritVelocityFrom = Physics
		MediaEffects
		[
			&<./Data/shots/missile_he/particles/missile_he_thruster_fire.rules>
		]
	}

}
