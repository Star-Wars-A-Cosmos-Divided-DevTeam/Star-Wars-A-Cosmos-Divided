		ScaleIn = scale
		RotationIn = rot
		ColorIn = color
		UvRectIn
		BaseSize
		{
			X = 1
			Y = 1
		}
		MaxScale = 1
		Name = ""
	}
	Material
	{
		Shader = "./Data/common_effects/particles/particle_light.shader"
		_z = 0.5
		_litReflectiveStrength = 16
		_litAdditiveStrength = 0.05
		_unlitAdditiveStrength = 0.05
		Texture
		{
			File = "./Data/common_effects/particles/dry_light_cookie.png"
			FixTransparentColors = false
			PreMultiplyByAlpha = false
			SampleMode = Linear
			MipLevels = max
		}
		TargetBlendMode
		{
			SourceRgbFactor = InverseDestColor
			DestRgbFactor = One
			RgbOperator = Add
			SourceAlphaFactor = Zero
			DestAlphaFactor = One
			AlphaOperator = Add
		}
		Color
		{
			Rf = 1
			Gf = 1
			Bf = 1
			Af = 1
		}
	}
	DeleteMode = Fast
	EnableMultithreading = false
	InitCapacity = 256
}
EmitterDef
{
	EmitPerSecond = 0
	EmitPerOneShot = 1
	PreInitializers
	[
		{
			Type = SetValue
			DataOut = base_color
			ValueType = Color
			Value
			[
				255
				200
				150
				200
			]
			Name = "Base color"
			Enabled = true
			UpdateAfterInit = false
		}
		{
			Type = SetRandom
			DataOut = location
			ValueType = Vector2
			Value
			{
				Rf = 1
				Gf = 0.78431374
				Bf = 0.5882353
				Af = 0.6862745
			}
			Name = "Random position"
			Enabled = true
			UpdateAfterInit = false
			FromValue
			{
				X = -0.1
				Y = -0.1
			}
			ToValue
			{
				X = 0.1
				Y = 0.1
			}
		}
		{
			Type = SetRandom
			DataOut = scale
			ValueType = Float
			FromValue = 6
			ToValue = 8
			Name = "Random scale"
			Enabled = true
			UpdateAfterInit = false
		}
		{
			Type = SetRandom
			DataOut = rot
			ValueType = Angle
			FromValue = 0d
			ToValue = 360d
			Name = "Random rotation"
			Enabled = true
			UpdateAfterInit = false
		}
	]
	PostInitializers[]
}
