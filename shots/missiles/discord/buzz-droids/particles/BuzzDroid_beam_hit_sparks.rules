			ColorOut = color
			Invert = false
			Colors
			[
				{
					Rf = 1
					Gf = 0.9411765
					Bf = 0.83137256
					Af = 0.9
				}
				{
					Rf = 1
					Gf = 0.9411765
					Bf = 0.83137256
					Af = 0.2
				}
				{
					Rf = 1
					Gf = 0.9411765
					Bf = 0.83137256
					Af = 0
				}
			]
		}
		{
			Type = Lerp
			LerpIn = life
			DataOut = scale
			Invert = false
			ValueType = Float
			FromValue = 0.5
			ToValue = 1
			Name = "Scale lerp"
			Enabled = true
			UpdateAfterInit = true
		}
	]
