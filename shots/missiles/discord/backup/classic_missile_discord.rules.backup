ID = SW.discord_missle
OtherIDs = ["discord_missle"]

Range = 150
IdealRange = 125
Speed = 65

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.4
		Density = 0.1
		LinearDamping = 1.1
	}

	Homing
	{
		Type = TargetHoming
		TurnVelocity = 360d
		Delay = 1
		AvoidanceRaycastDistance = 250
		VelocityCompensation = 60%
	}

	Retarget
	{
		Type = SameShipRetarget
	}

	Acceleration
	{
		Type = Acceleration
		Acceleration = 65//100
	}

	NegativeAcceleration
	{
		Type = Acceleration
		Acceleration = [-90, 0]
		AccelerationOverTime = [0, .75]
		Direction = FrameOfReferenceVelocity
	}

	DeployDeath
	{
		Type = DeathByEnemyProximity
		Interval = .05
		Range = 30
		DetectsShips = true
		DetectsBullets = false
		StartDelay = .1

		OnDeath
		{
			HitEffects
			[
				{
					Type = SpawnBullets
					Bullet = &<buzzdroid.rules>
					Count = [3,5]
					Distance = [0, 2]
					Arc = [-0d,0d]
					Spread = [-50d, 50d]
					InheritVelocity = false
				}
			]
		}
	}

	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		Sprite
		{
			Texture
			{
				File = "missile_discord.png"
				SampleMode = Linear
				MipLevels = max
			}
			Size = [2, 1.5]
		}
		NormalsTexture
		{
			File = "missile_discord_normals.png"
			MipLevels = max
		}
	}

	MediaEffects
	{
		Type = MediaEffects
		MediaEffects
		[
			&<particles/missile_discord_thruster_glow.rules>
		]
	}
	
	MediaEffects1
	{
		Type = MediaEffects
		Offset = [-0.9, 0]
		Rotation = 180d
		MediaEffects
		[
			&<particles/missile_intruder_thruster_plume_light.rules>
			&<particles/missile_intruder_thruster_smoke.rules>
		]
	}

	MediaEffects3
	{
		Type = MediaEffects
		Offset = [45/64, 0]
		MediaEffects
		[
			&/SW_PARTICLES/Shot/Ion/Trail/Med/Cyan
		]
	}

	Targetable
	{
		Type = Targetable
		Health = 3000
		TargetCategory = "missile"

		OnDeath
		{
			MediaEffects
			[
				&<./Data/shots/bullet_med/particles/bullet_hit_med.rules>
				&<./Data/shots/bullet_med/particles/bullet_smoke_med.rules>
				&<./Data/shots/bullet_med/particles/bullet_flash_med.rules>

				&/SW_SOUNDS/BulletMedHit

				: /BASE_SHAKE
				{
					ShakeAmount = .05
					Duration = .5
				}
			]
		}
	}

	Hit
	{
		Type = SimpleHit
		SourceShipCollisionDelay = .01

		HitShield = &~/Components/Death/OnDeath
		HitOperational = &~/Components/Death/OnDeath
		HitStructural = &~/Components/Death/OnDeath
	}

}