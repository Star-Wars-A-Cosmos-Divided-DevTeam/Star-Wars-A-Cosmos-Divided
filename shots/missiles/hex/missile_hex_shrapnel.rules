ID = "sw.missile_hex_shrapnel"
Range = 40 // Note: Actual lifetime is set below. Need to change that when modifying range.
Speed = 35

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.25
		Density = 1
		//RandomExtraSpeed = [-5, 5]
	}

	Death
	{
		Type = DeathByLifetime
		Lifetime = [1, 1.3]
	}

	Hit
	{
		Type = PenetratingHit
		Penetration = 20
		PenetrationSpeed = 20
		PenetratesFriendlies = true

		CrewCollisions = { Enemies=true; Junk=true }
		PenetratesCrew = true
		HitCrew = &HitOperational

		ShieldCollisions
		{
			HitsOwnShields = true
			HitsFriendlyShields = true
		}

		HitShield = &HitOperational
		HitOperational
		{
			//ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]

			HitEffects
			[
				{
					Type = Repeating
					Count = 8
					Interval = 1
					InitialDelay = 0.5
					RequireHitPart = false
					HitEffectsScaleOverIterations
					{
						Min = 1
						Max = 5
					}
					HitEffects
					[
						{
							Type = ExplosiveDamage
							TotalDamage = 7500
							Radius = 10
							Filter
							{
								Friendlies = true
								Ships = true
								Crew = true
							}
						}
						{
							Type = Impulse
							Impulse = 10
						}
					]
					MediaEffects
					[
						&<particles/sw_flak_large_green_shrapnel.rules>
						//&<particles/missile_hex_shrapnel_smoke_large.rules>
						&<particles/missile_hex_shrapnel_flash_large.rules>
						&/SW_SOUNDS/SW_Missile_Hex_Hit
						: /BASE_SHAKE
						{
							ShakeAmount = .1
							Duration = .75
						}
					]
				}
				{
					Type = ExplosiveDamage
					TotalDamage = 15000
					CrewKillChance = 100%
					Radius = 8 //1 
					Filter
					{
						Friendlies = true
					}
				}
				{
					Type = Impulse
					Impulse = { BaseValue = 40; EffectScaleExponent = 1 }
				}
			]

			MediaEffects
			[
				&<particles/sw_flak_large_green_shrapnel.rules>
				//&<particles/missile_hex_shrapnel_smoke_large.rules>
				&<particles/missile_hex_shrapnel_flash_large.rules>
				&<particles/sw_flak_large_green_smoke.rules>
				//&<particles/chemical_hit_cloud.rules>

				&/SW_SOUNDS/SW_Missile_Hex_Hit
				: /BASE_SHAKE
				{
					ShakeAmount = .1
					Duration = .75
				}
			]
		}
		HitStructural
		{
			//ReduceEffectsByPenetration = true

			HitEffects
			[
				{
					Type = Repeating
					Count = 3
					Interval = 1
					InitialDelay = 0.5
					RequireHitPart = false
					HitEffectsScaleOverIterations
					{
						Min = 1
						Max = 2.5
					}
					HitEffects
					[
						{
							Type = ExplosiveDamage
							TotalDamage = 2500
							CrewKillChance = 45%
							Radius = 20
							Filter
							{
								Friendlies = true
								Crew = true
								Ships = true
							}
						}
						{
							Type = Impulse
							Impulse = { BaseValue = 10; EffectScaleExponent = 1 }
						}
					]
					MediaEffects
					[
						&<particles/sw_flak_large_green_shrapnel.rules>
						//&<particles/missile_hex_shrapnel_smoke_large.rules>
						&<particles/missile_hex_shrapnel_flash_large.rules>

						&/SW_SOUNDS/SW_Missile_Hex_Hit
					]
				}
			]

			MediaEffects
			[
				&<particles/sw_flak_large_green_shrapnel.rules>
				&<particles/sw_flak_large_green_smoke.rules>
				//&<particles/chemical_hit_cloud.rules>
				&/SW_SOUNDS/SW_Missile_Hex_Hit
			]
		}
		PenetratingOperational
		{
			ReduceEffectsByPenetration = true

			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = 5500
					CrewKillChance = 85%
					Radius = 5
					Filter
					{
						Friendlies = true
					}
				}

				{
					Type = Impulse
					Impulse = 60
				}
			]

			MediaEffects
			[
				&<particles/sw_flak_large_green_shrapnel.rules>
				&<particles/sw_flak_large_green_smoke.rules>
				//&<particles/chemical_hit_cloud.rules>
			]
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural = &PenetratingStructural

		BulletCollisions
		{
			Enemies = true
			Junk = true
			Friendlies = true
			Neutrals = true
			OnlyBulletCategories = [mine]
		}
		PenetratesBullets = true
		HitBullet
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = { BaseValue = 100000; EffectScaleExponent = 1 }
					Filter
					{
						Friendlies = true
					}
				}
			]

			MediaEffects = &../HitOperational/MediaEffects
		}
	}

	Sprite
	{
		Type = Sprite
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Sprite
		{
			Texture
			{
				File = "mine_shrapnel.png"
				SampleMode = Linear
				MipLevels = max
			}
			Size = [1.5, 1.5]
		}
	}

	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Z = 0
		IsLight = true
		Offset = [-1, 0]
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [12, 6]
			VertexColor = [255, 100, 0]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_z = 1
			_nrmlStrengthLimit = 1
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.125
		}
	}

	MediaEffects
	{
		Type = MediaEffects
		MediaEffects
		[
			&<particles/missile_hex_shrapnel_trail.rules>
		]
	}
}