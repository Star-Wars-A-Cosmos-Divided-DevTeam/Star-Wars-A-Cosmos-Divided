Range = 450
IdealRange = 450
Duration = 1 / (&/Simulation/PhysicsUpdatesPerSecond)
HitInterval = 1 / (&/Simulation/PhysicsUpdatesPerSecond)
FriendlyShipLowCollisions = false
FriendlyShipHighCollisions = false
NonFriendlyShipLowCollisions = false
NonFriendlyShipHighCollisions = false
ClipRangeToTarget = true
MediaEffectsScaleOverRange = [0.6, -10]
BeamMediaEffectsOffset = [39/64, 0]
BeamMediaEffectsLengthOffset = -39/64

BeamMediaEffects
[
	&/SW_PARTICLES/BeamCollectorGlints
	{
		Type = Beam
		IsFancy = true
		Sprite
		{
			Shader = "tractor_beam.shader"
			Size = [100%, 0.75]
			VertexColor = [255, 255, 255, 255]

			_extraBeginLength = 0
			_extraEndLength = 0
			_extraEndArc = 0d
			_minAlpha = .25

			Texture
			{
				File = ./Data/common_effects/particles/noise_voronoi2.png
				SampleMode = Linear
				MipLevels = max
				UMode = Wrap
				VMode = Wrap
			}
			_displacementStrength = 0.25
			_displacementSpeed = .2
			_additiveStrength = 0.4

			_noiseScaleX = 0.02
			_noiseScaleY = 2
			_noiseScrollSpeed = -2
			_noisePanSpeed = 0
			_endFadeLength = 1

			_color1 = [160,  33, 240, 255]
			_color2 = [255, 191, 204, 255]

			TargetBlendMode
			{
				SourceRgbFactor = SourceAlpha
				DestRgbFactor = InverseSourceAlpha
				RgbOperator = Add
				SourceAlphaFactor = One
				DestAlphaFactor = One
				AlphaOperator = Add
			}

			_noiseTex
			{
				File = ./Data/common_effects/particles/noise_gradient.png
				SampleMode = Linear
				MipLevels = max
				UVMode = Wrap
			}
		}
		FadeInTime = .25
		FadeOutTime = .25
		SpeedOverIntensity = [0, 0.5]
		Bucket = TractorBeam
		CaptureBackBuffer = true
		LengthSmoothSpeed = 80
		RotationSmoothSpeed = 80
		MinIntensity = -Infinity
	}

	: 1
	{
		IsFancy = false
		IsSimple = true
		Sprite : ^/0/Sprite
		{
			Shader = "tractor_beam_simple.shader"
			TargetBlendMode
			{
				SourceRgbFactor = One
				DestRgbFactor = One
				RgbOperator = Add
				SourceAlphaFactor = One
				DestAlphaFactor = One
				AlphaOperator = Add
			}
			_color1 = [160,  33, 240, 255]
			_color2 = [255, 191, 204, 255]
		}
		CaptureBackBuffer = false
	}
	
	&/SW_SOUNDS/CollectorBeam
]

HitNothing
{
	HitEffects
	[
		{
			Type = CollectNugget
			DeliveryDistance = 0.25
			AccelerationOverDistance = [32,64]
			DampingOverDistance = [8, .01]
			OverDistance = [1, 8]
			DoorOpenDistance = 4
		}
/*
		{
			Type = MoveCrew
			DeliveryDistance = 0.25
			AccelerationOverDistance = [32,64]
			DampingOverDistance = [15, 0.1]
			OverDistance = [0.1, 8]
			DoorOpenDistance = 7
		}
*/
	]
}