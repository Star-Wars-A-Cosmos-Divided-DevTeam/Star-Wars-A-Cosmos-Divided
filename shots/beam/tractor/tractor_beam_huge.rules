EMITTER = &<../../../ships/terran/utilities/tractor_beam_emitter_huge/tractor_beam_emitter_huge.rules>

Range = 300
StretchRange = 600
IdealRange = 300
Duration = 0.25
HitInterval = 1 / (&/Simulation/PhysicsUpdatesPerSecond)
TractorImpulse = 64000 * (&HitInterval) / (&EMITTER/BeamCount) // Actual impulse per-ship is half; this is net total of both ships.
RampUpTime = 1
RequireHitForRampUp = true
PenetratesStructure = false
ShieldCollisions = { Shields=false; }
InitHitLengthResetDelay = 1
BeamMediaEffectsIntensity = { BaseValue=1; EffectScaleExponent=1; }

BeamMediaEffects
[
	&/SW_PARTICLES/BeamTractorGlints
	{
		Type = Beam
		IsFancy = true
		Sprite
		{
			Shader = "tractor_beam.shader"
			Size = [100%, 6.5]
			VertexColor = [255, 255, 255, 255]

			_extraBeginLength = .5
			_extraEndLength = 1
			_extraEndArc = 3d
			_minAlpha = .25

			Texture
			{
				File = ./Data/common_effects/particles/noise_voronoi2.png
				SampleMode = Linear
				MipLevels = max
				UMode = Wrap
				VMode = Wrap
			}
			_displacementStrength = 4
			_displacementSpeed = .08

			_additiveStrength = 4
			_noiseScaleX = 0.01
			_noiseScaleY = 2
			_noiseScrollSpeed = 0.3
			_noisePanSpeed = 0.1
			_endFadeLength = 6

			_color1 = [0, 0, 3, 255]
			_color2 = [0, 2, 4, 255]
			TargetBlendMode
			{
				SourceRgbFactor = SourceAlpha
				DestRgbFactor = InverseSourceAlpha
				RgbOperator = Add
				SourceAlphaFactor = One
				DestAlphaFactor = One
				AlphaOperator = Add
			}

			_noiseTex
			{
				File = ./Data/common_effects/particles/noise_gradient.png
				SampleMode = Linear
				MipLevels = max
				UVMode = Wrap
			}
		}
		FadeInTime = .25
		FadeOutTime = .25
		SpeedOverIntensity = [0, 5]
		Bucket = TractorBeam
		CaptureBackBuffer = true
		LengthSmoothSpeed = 6
		MinIntensity = -Infinity
	}

	: 1
	{
		IsFancy = false
		IsSimple = true
		Sprite : ^/0/Sprite
		{
			Shader = "tractor_beam_simple.shader"
			TargetBlendMode
			{
				SourceRgbFactor = One
				DestRgbFactor = One
				RgbOperator = Add
				SourceAlphaFactor = One
				DestAlphaFactor = One
				AlphaOperator = Add
			}
			_color1 = [0, 0, 3, 255]
			_color2 = [0, 191, 179, 255]
		}
		CaptureBackBuffer = false
	}
	
	&/SW_SOUNDS/TractorBeamEmit
	
	&/SW_SOUNDS/TractorBeam
]

HitOperational
{
	HitEffectsScale = { BaseValue=1; EffectScaleExponent=1; }
	MediaEffectsScale = { BaseValue=1; EffectScaleExponent=1; }
	HitEffects
	[
		{
			Type = Impulse
			Impulse = { BaseValue = -(&~/TractorImpulse) / 2; EffectScaleExponent = 1 }
		}
		{
			Type = Feedback
			HitEffects
			[
				{
					Type = Impulse
					Impulse = { BaseValue = (&~/TractorImpulse) / 2; EffectScaleExponent = 1 }
				}
			]
		}
	]
}

HitStructural = &HitOperational