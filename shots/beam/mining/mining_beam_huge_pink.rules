Range = 300
IdealRange = ((&Range)*4/5)
Width = 0.2
HitInterval = 3 / (&/Simulation/PhysicsUpdatesPerSecond)
PenetratesStructure = false
FriendlyShipLowCollisions = false
CrewCollisions = {Enemies=true; Junk=true}
HitCrew = &HitOperational

BeamMediaEffects
[
	// The beam itself.
	{
		Type = Beam
		Sprite
		{
			Texture
			{
				File = "salvage_beam_pink.png"
				SampleMode = Linear
				MipLevels = 1
				UVMode = Clamp
			}
			_noiseTexture
			{
				File = "./Data/common_effects/particles/noise_marble.png"
				SampleMode = Linear
				MipLevels = max
				UVMode = Wrap
			}
			Shader = "salvage_beam_pink.shader"
			_gradientPow = 0.35
			_sineFreq = 2.5
			_sineAmp = 0.03
			_noiseAmp = 0.12
			_gradientIntensity = 3
			_endCapSize = .125
			Size = [100%, .8]
			VertexColor = [255, 255, 255, 255] //[255, 0, 98, 255]
			TargetBlendMode
			{
				SourceRgbFactor = SourceAlpha
				DestRgbFactor = One
				RgbOperator = Add
				SourceAlphaFactor = InverseDestAlpha
				DestAlphaFactor = One
				AlphaOperator = Add
			}
		}
		FadeInTime = .1
		FadeOutTime = .1
		RandomTimeOffset = [0, 1]
		Bucket = Upper1
	}

	// Beam lighting.
	{
		Type = Beam
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Shader = "./Data/common_effects/fancy_beam_light.shader"
			Size = [100%, 1.6]
			_extraBeginLength = (&Size/1) / 2
			_extraEndLength = (&Size/1) / 2
			VertexColor = [255, 127, 0, 255] //[255, 0, 98, 255]
			_z = 0.1
			_litReflectiveStrength = 8
			_litAdditiveStrength = 0
			_unlitAdditiveStrength = 0.25
			_nrmlStrengthLimit = 0.2
			TargetBlendMode
			{
				SourceRgbFactor = InverseDestColor
				DestRgbFactor = One
				RgbOperator = Add
				SourceAlphaFactor = Zero
				DestAlphaFactor = One
				AlphaOperator = Add
			}
		}
		Bucket = Upper4
		IsLight = true
		FadeInTime = .5
		FadeOutTime = .1
	}

	&/SW_SOUNDS/MiningBeam

	&/SW_SOUNDS/IonBeam
]

HitShield = &HitOperational
HitStructural = &HitOperational
HitOperational
{
	HitEffects
	[
		{ //Damage to enemy ships
			Type = Damage
			Damage = { BaseValue=1000/2 * (&~/HitInterval) ; BuffType=ElectronBuff; BuffMode=Multiply; }
			DamageType = salvage
			SpawnUnderlying = false
			Filter
			{
				ExcludePartCategories = [asteroid]
				junk = false
			}
		}
		{ //Damage to junk
			Type = Damage
			Damage = { BaseValue=19200/2 * (&~/HitInterval); BuffType=ElectronBuff; BuffMode=Multiply; }
			DamageType = salvage
			SpawnUnderlying = false
			Filter
			{
				ExcludePartCategories = [asteroid, armor]
				junk = true
				Enemies = false
				Friendlies = false
				Neutrals = false
			}
		}
		{ //Damage to junk armor
			Type = Damage
			Damage = { BaseValue=38400/2 * (&~/HitInterval); BuffType=ElectronBuff; BuffMode=Multiply; }
			DamageType = salvage
			SpawnUnderlying = false
			Filter
			{
				ExcludePartCategories = [asteroid]
				OnlyPartCategories = [armor]
				junk = true
				Enemies = false
				Friendlies = false
				Neutrals = false
			}
		}
		{ //Damage to asteroids
			Type = Damage
			Damage = { BaseValue=128000/2 * (&~/HitInterval); BuffType=ElectronBuff; BuffMode=Multiply; }
			DamageType = salvage
			SpawnUnderlying = false
			Filter
			{
				OnlyPartCategories = [asteroid]
				Shields = false
			}
		}
		/*{
			Type = Damage
			Damage = { BaseValue=128000/2 * (&~/HitInterval); BuffType=ElectronBuff; BuffMode=Multiply; }
			DamageType = salvage
			SpawnUnderlying = false
			Filter
			{
				OnlyPartCategories = [SW.asteroid]
				Shields = false
			}
		}*/
	]

	MediaEffects
	[
		//&/SW_PARTICLES/Beam/Mining/Hit/Sparks/Pink
		//&<../../../common_effects/particles/beam/mining/sparks/mining_beam_hit_sparks_pink.rules>
		&<./Data/shots/mining_beam_small/particles/mining_beam_hit_sparks.rules>
	]
}