BASE = &<mining_beam_huge_magenta.rules>

RANGE = (&~/BASE/Range) + 100
RADIUS = 2
DAMAGE_FACTOR = 75%
SHIELD_DAMAGE_FACTOR = 200% / ((&RADIUS) * 2)
RADIUS_FALLOFF = 0 
BEAM_VISUAL_WIDTH_FACTOR = 250%

Beam : BASE
{
	Range = &~/Range
	IdealRange = ((&Range)*4/5)

	BeamMediaEffects
	[
		: ~/BASE/BeamMediaEffects/0
		{
			Sprite : ^/0/Sprite
			{
				_noiseTexture : ^/0/_noiseTexture
				{
					File = "./Data/common_effects/particles/noise_distorted_voronoi.png"
				}
				_startCapSize = &_endCapSize
				Size = [100%, (&~/BASE/BeamMediaEffects/0/Sprite/Size/1) * (&~/BEAM_VISUAL_WIDTH_FACTOR)]
			}
		}
		: ~/BASE/BeamMediaEffects/1
		{
			Sprite : ^/0/Sprite
			{
				Size = [100%, (&~/BASE/BeamMediaEffects/1/Sprite/Size/1) * (&~/BEAM_VISUAL_WIDTH_FACTOR)]
			}
		}
		&~/BASE/BeamMediaEffects/2
		&~/BASE/BeamMediaEffects/3
	]

	AttenuationLimit : HitOperational/HitEffects/0/Damage
	{
		BaseValue = (&^/0/BaseValue) * (&~/RADIUS)
	}
	HitAttenuator
	{
		MediaEffects = &~/Beam/HitOperational/MediaEffects
	}
	
	HitStructural = &HitOperational
	HitOperational : ^/0/HitOperational
	{
		HitEffects
		[
			//Damage to enemy ships
			: ~/BASE/HitOperational/HitEffects/0
			{
				Type = AreaDamage
				Damage : ^/0/Damage { BaseValue = ceil((&^/0/BaseValue) * (&~/DAMAGE_FACTOR)) }
				Radius = &~/RADIUS
				RectType = Normal
				Falloff = &~/RADIUS_FALLOFF
				Filter : ^/0/Filter
				{
					Shields = false
				}
			}
			//Damage to enemy shields
			: ~/BASE/HitOperational/HitEffects/0
			{
				Type = AreaDamage
				Damage : ^/0/Damage { BaseValue = ceil((&^/0/BaseValue) * (&~/SHIELD_DAMAGE_FACTOR)) }
				Radius = &~/RADIUS
				Falloff = &~/RADIUS_FALLOFF
				Filter : ^/0/Filter
				{
					OperationalHealth = false
					StructuralHealth = false
				} 
			}
			//Damage to junk
			: ~/BASE/HitOperational/HitEffects/1
			{
				Type = AreaDamage
				Damage : ^/0/Damage { BaseValue = ceil((&^/0/BaseValue) * (&~/DAMAGE_FACTOR)) }
				Radius = &~/RADIUS
				RectType = Normal
				Falloff = &~/RADIUS_FALLOFF
			}
			//Damage to junk armor
			: ~/BASE/HitOperational/HitEffects/2
			{
				Type = AreaDamage
				Damage : ^/0/Damage { BaseValue = ceil((&^/0/BaseValue) * (&~/DAMAGE_FACTOR)) }
				Radius = &~/RADIUS
				RectType = Normal
				Falloff = &~/RADIUS_FALLOFF
			}
			//Damage to asteroids
			: ~/BASE/HitOperational/HitEffects/3
			{
				Type = AreaDamage
				Damage : ^/0/Damage { BaseValue = ceil((&^/0/BaseValue) * (&~/DAMAGE_FACTOR)) }
				Radius = &~/RADIUS
				RectType = Normal
				Falloff = &~/RADIUS_FALLOFF
			}
		]
		MediaEffects
		[
			&/SW_PARTICLES/BeamMiningRadialHitSparksMagenta

			//&/SW_PARTICLES/Beam/Mining/RadialHit/Sparks/Magenta
			//&/SW_PARTICLES/Beam/Mining/RadialHit/Sparks/Vanilla

			//&<../../../common_effects/particles/beam/mining/sparks/mining_beam_radial_hit_sparks_magenta.rules>
			//&<../../../common_effects/particles/beam/mining/sparks/mining_beam_radial_hit_sparks.rules>

			//&<./Data/shots/mining_beam_small/particles/mining_beam_hit_sparks.rules>
		]
	}
	HitShield : HitOperational
	{
		HitEffects
		[
			// Only damage shields, not the parts behind them.
			&../^/0/HitEffects/1
		]
	}
}