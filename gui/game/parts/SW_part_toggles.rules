				{
					Texture
					{
						File = "armor/framed_roof.png"
						MipLevels = 2
						SampleMode = Linear
					}
				}
			}
			//New Durasteel Sprite
			{
				ChoiceID = "DurasteelArmorRoof"
				ButtonToolTipKey = "PartToggles/DurasteelArmorRoof"
