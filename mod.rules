ID = 00.00.SW		//enforcing first load
Name = "Star Wars: A Cosmos Divided Mod Prerequisite"
Version = 200.300
CompatibleGameVersions = ["0.30.0","0.29.0","0.28.2","0.28.0","0.27.2","0.27.1e","0.27.1","0.27.0","0.26.2"]
ModifiesMultiplayer = true
Author = "skipperwraith"
Logo = "ModLogo.png"
Description = "Provides necessary core game changes before other Mods load"
StringsFolder = "Strings"

Actions
[
	{
		Action = Replace
		Replace = <gui/game/parts/part_stats.rules>/PartStats
		With = &<part_stats.rules>/PartStats
	}
]