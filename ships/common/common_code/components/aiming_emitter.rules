Part : <../bases/base_emitter.rules>/Part
{
	Components : ^/0/Components
	{
		AimingBulletEmitter : ^/0/BulletEmitter
		{
			FireTrigger // Not optional, but don't want to actually shoot this emitter.
			//ChainedTo = TurretLocationProxy //need to be set locally.
			//GetTargetFrom = Turret //need to be set locally.
			Location = [0, 0] //can be set locally.
		}
	}
}