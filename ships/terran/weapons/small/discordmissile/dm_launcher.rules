Part : &<./Data/ships/terran/base_part_terran.rules>/Part
{
	//IDs
	ID = SW.discordmissile_launcher
	OtherIDs = ["discordmissile_launcher"]

	//StringKeys
	NameKey = "Parts/DiscordMissileLauncher"
	IconNameKey = "Parts/DiscordMissileLauncherIcon"
	DescriptionKey = "Parts/DiscordMissileLauncherDesc"

	//Groups&Categories
	EditorGroups = ["WeaponsProjectile", "SWTechI"]
	TypeCategories = [weapon, uses_power]

	//Resources&Size&Health
	Resources
	[
		[steel, 80]
		[coil, 12]
		[enriched_uranium, 1]
	]
	Size = [1, 2]
	MaxHealth = 2000

	//Rects
	PhysicalRect = [0, 1, 1, 1]
	SaveRect = &PhysicalRect

	//Selections
	SelectionPriority = 1
	SelectionTypeByRotation = true

	//PartSpecific
	AIValueFactor = 1
	InitialPenetrationResistance = 1

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs []
	ProhibitAbove = 1

	//Doors&Etc
	MaxDoors = 2
	AllowedDoorLocations
	[
		[-1, 1]
		[1, 1]
		[0, 2]
	]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [21.33, 42.66]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = PowerToggle
			CommandPoints = 2
		}

		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}

		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}

		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}

		CommonReloadTimerExtraLong
		{
			Type = Timer
			Duration = 8.0
			AutoStart = true
			//StartsOn = 0
			StartTrigger = Turret
		}


/*		CommonReloadResetTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = Turret
		}*/
		LoadedDroid
		{
			Type = ResourceStorage
			ResourceType = mine_part
			MaxResources = 1
			DelayBeforeReadyToUse = .5
			AnticipateMoreResourcesFrom = ["DroidStorage"]
			ToggleOnResources = 1
			ToggleOffResources = 0
			DropResourcesWhenDestroyed = true
		}

		DroidStorage
		{
			Type = ResourceStorage
			ResourceType = mine_part
			MaxResources = 15
			DropResourcesWhenDestroyed = true
		}

		CombinedDroidParts
		{
			Type = MultiResourceStorage
			ResourceType = mine_part
			ResourceStorages = [LoadedDroid, DroidStorage]
			//UITileRect = [0.5, 0.5, 0.5, 0.5]
			UITileRect = [7/64, 7/64, 1 - 14/64, 1 - 14/64]
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/HeavyDeliver
			AddMode = InReverseOrder
		}

		DroidConsumer
		{
			Type = ResourceConsumer
			ResourceType = mine_part
			Storage = CombinedDroidParts
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			AdditionalStorageForJobPriority = [LoadedDroid]
			OperationalToggle = PowerToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}

		DroidLoader
		{
			Type = ResourceConverter
			FromStorage = DroidStorage
			ToStorage = LoadedDroid
			FromQuantity = 1
			ToQuantity = 1
			Interval = .5
			DelayTrigger = CommonReloadTimerExtraLong
			DelayAfterTrigger = .5
		}

		LoadEffects
		{
			Type = TriggeredEffects
			Trigger = DroidLoader
			MediaEffects = &/COMMON_EFFECTS/AmmoLoad
		}

		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = CommonReloadTimerExtraLong
		}

		Graphics
		{
			Type = Graphics
			OperationalToggle = IsOperational
			Location = [.5, 1.5]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "../common_graphics_1/floor.png"
						Size = [1, 1]
					}
					{
						File = "../common_graphics_1/floor_33.png"
						Size = [1, 1]
					}
					{
						File = "../common_graphics_1/floor_66.png"
						Size = [1, 1]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_high"
				Offset = [0, -0.5]
				DamageLevels
				[
					{
						File = "doodads_on.png"
						Size = [1, 2]
					}
					{
						File = "doodads_on_33.png"
						Size = [1, 2]
					}
					{
						File = "doodads_on_66.png"
						Size = [1, 2]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_high"
				Offset = [0, -0.5]
				DamageLevels
				[
					{
						File = "doodads_off.png"
						Size = [1, 2]
					}
					{
						File = "doodads_off_33.png"
						Size = [1, 2]
					}
					{
						File = "doodads_off_66.png"
						Size = [1, 2]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [1, 1]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "../common_graphics_1/walls.png"
						Size = [1, 1]
					}
					{
						File = "../common_graphics_1/walls_33.png"
						Size = [1, 1]
					}
					{
						File = "../common_graphics_1/walls_66.png"
						Size = [1, 1]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "../common_graphics_1/roof.png"
						NormalsFile = "../common_graphics_1/roof_normals.png"
						Size = [1, 1]
					}
					{
						File = "../common_graphics_1/roof_33.png"
						NormalsFile = "../common_graphics_1/roof_normals_33.png"
						Size = [1, 1]
					}
					{
						File = "../common_graphics_1/roof_66.png"
						NormalsFile = "../common_graphics_1/roof_normals_66.png"
						Size = [1, 1]
					}
				]
			}
		}

		FirePermissionToggle
		{
			Type = MultiToggle
			Toggles = [LoadedDroid, FireModeToggle, CommonReloadTimerExtraLong]
			Mode = All
		}

		Turret : &~/TurretBase
		{
			Type = TurretWeapon
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			Location = [.5, 0.89]
			Rotation = -90d
			FireInterval = 0
			FiringArc = 90d
			RotateSpeed = 15d
			FireThresholdAngle = 1d
			AIFirepowerRating = 2000
			AllowFireWithBlockedLOS = true
			FirePermissionToggle = FirePermissionToggle
			Emitter = BulletEmitter

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
					EnableInDirectControlMode = true
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}


		BulletEmitter : &~/BulletEmitterBase
		{
			Type = BulletEmitter
			ChainedTo = Turret
			FireTrigger = Turret
			GetTargetFrom = Turret
			Location = [1, 0]
			OperationalToggle = IsOperational
			Bullet = &/SW_SHOTS/Missiles/Discord
			ResourceStorage = LoadedDroid
			ResourcesUsed = 1
		}

		FireEffect
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = BulletEmitter

			Location = [0.6875, 0]
			AnchorMediaEffects = true

			MediaEffects
			[
				&/SW_SOUNDS/ProtonLauncherShoot
			]
		}

		GraphicsExtraLight
		{
			Type = Graphics
			OperationalToggle = CommonReloadTimerExtraLong
			InvertOperationalToggle = true
			ChainedTo = BulletEmitter

			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = &~/OperationalRoofLightingBase/Size
						Z = &~/OperationalRoofLightingBase/Z
						VertexColor = [240, 160, 240]
					}
				]
			}
		}

		TurretGraphics
		{
			Type = Graphics
			OperationalToggle = IsOperational
			ChainedTo = Turret
			Location = [0.409375, 0]
			Rotation = 90d
			OperationalDoodad
			{
				Layer = "turrets"
				DamageLevels
				[
					{
						File = "turret_on.png"
						Size = [1, 1]
					}
					{
						File = "turret_on_33.png"
						Size = [1, 1]
					}
					{
						File = "turret_on_66.png"
						Size = [1, 1]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "turrets"
				DamageLevels
				[
					{
						File = "turret_off.png"
						Size = [1, 1]
					}
					{
						File = "turret_off_33.png"
						Size = [1, 1]
					}
					{
						File = "turret_off_66.png"
						Size = [1, 1]
					}
				]
			}
		}
		DroidResourcesSprite //1
		{
			Type = ResourceSprites
			Location = [0.5, 1.5]
			ResourceStorage = LoadedDroid
			Layer = "doodads_low"
			HasZeroResourceSprite = false
			ResourceLevels
			[
				{
					File = "battery0.png"
					Size = [1, 1]
				}
				{
					File = "buzz-droid-ready.png"
					Size = [1, 1]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Toggle = IsOperational
			Location = [.5, 1.5]
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyed
			Location = [.5, 1.5]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [.5, 1.5]
			//Layer = "indicators" //Removal for 0.27.0_rc2_steam 
			Indicators
			[
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [1]
				}

				// Out of power.
				{
					Toggle = DroidStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoMines
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 2]
		}
	}

	//Stats
	Stats
	{
		//PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000

		//RecPower = &../StatsByCategory/0/Stats/PowerPerSecond

		MineCapacity = (&~/Part/Components/DroidStorage/MaxResources) + (&~/Part/Components/LoadedDroid/MaxResources)

		RecAmmo = 1//&../StatsByCategory/0/Stats/AmmoPerSecond

		RecCrew = (&RecAmmo) * 1

		Arc = deg(&~/Part/Components/Turret/FiringArc)
		TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
	}

	StatsByCategory
	[
		&~/TurretStats
		&~/BulletStats
		/*{
			NameKey = "StatCategories/Missile"
			Stats
			{
				ROF = 1 / (&~/Part/Components/Turret/FireInterval)
				Range = &~/Part/Components/BulletEmitter/Bullet/Range
				ShotSpeed = &~/Part/Components/BulletEmitter/Bullet/Speed
				ShotHP = &~/Part/Components/BulletEmitter/Bullet/Components/Targetable/Health
				PowerPerShot = (&~/Part/Components/BulletEmitter/ResourcesUsed) / 1000
				PowerPerSecond = (&PowerPerShot) * (&ROF)
				ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
			}
		}
		{
			NameKey = "StatCategories/BuzzDroid"
			Stats
			{
				// SimpleDamage = &~/Part/Components/BulletEmitter/Bullet/Components/Death/OnDeath/HitEffects/0/Bullet/Components/Hit/HitOperational/HitEffects/0/Damage
				Local_Burst = (&~/Part/Components/BulletEmitter/Bullet/Components/Death/OnDeath/HitEffects/0/Count/0) + (((&~/Part/Components/BulletEmitter/Bullet/Components/Death/OnDeath/HitEffects/0/Count/1) - (&~/Part/Components/BulletEmitter/Bullet/Components/Death/OnDeath/HitEffects/0/Count/0)) / 2)
				ROF = (&Local_Burst) / (&~/Part/Components/Turret/FireInterval)
				Salvo = [&../Local_Burst, (&~/Part/Components/Turret/FireInterval)]
				ShotSpeed = &~/Part/Components/BulletEmitter/Bullet/Components/Death/OnDeath/HitEffects/0/Bullet/Speed
				ShotHP = &~/Part/Components/BulletEmitter/Bullet/Components/Death/OnDeath/HitEffects/0/Bullet/Components/Targetable/Health
			}
		}*/
	]
}

TurretStats
{
	NameKey = "StatCategories/Turret"
	Stats
	{
		Barrels = 1
		ReloadTime = &~/Part/Components/CommonReloadTimerExtraLong/Duration
		Salvo = [&../Barrels, &../ReloadTime]
		ROF = (&Barrels) / (&~/Part/Components/CommonReloadTimerExtraLong/Duration)
		Range = &~/BulletEmitterBase/Bullet/Range
		Arc = deg(&~/TurretBase/FiringArc)
		TurretSpeed = deg(&~/TurretBase/RotateSpeed)
		AmmoPerShot = &~/BulletEmitterBase/ResourcesUsed
		AmmoPerSecond = (&AmmoPerShot) * (&ROF)
		ShotAmmoUsage = [&../AmmoPerShot, &../AmmoPerSecond]
		//ShotSpeed = &~/Components/BulletEmitterBase/Bullet/Speed
	}
}

BulletStats
{
	NameKey = "StatCategories/BuzzDroid"
	Stats
	{
		// ShieldDamagePerShot = &~/BulletEmitterBase/Bullet/Components/Hit/HitShield/HitEffects/0/Damage
		// ShieldDamagePerSecond = (&ShieldDamagePerShot) * (&~/TurretStats/Stats/ROF)
		// ShieldDamage = [&../ShieldDamagePerShot, &../ShieldDamagePerSecond]
		//DamagePerShot = 50 //&~/BulletEmitterBase/Bullet/Components/Hit/HitOperational/HitEffects/Bullet/Components/Hit/HitOperational/HitEffects/0/HitEffects/Damage
		//DamagePerSecond = (&DamagePerShot) * (&~/TurretStats/Stats/ROF)
		//MaxDamage = [&../DamagePerShot, &../DamagePerSecond]
		//DamageArea = &~/BulletEmitterBase/Bullet/Components/Hit/HitOperational/HitEffects/0/Radius
		// Penetration = &~/BulletEmitterBase/Bullet/Components/Hit/Penetration
		Acceleration = &~/BulletEmitterBase/Bullet/Components/Acceleration/Acceleration
		ShotGuidance = deg(&~/BulletEmitterBase/Bullet/Components/Homing/TurnVelocity)

		ShotSpeed = &~/BulletEmitterBase/Bullet/Speed
		ShotHP = &~/BulletEmitterBase/Bullet/Components/Targetable/Health
	}
}

OperationalRoofLightingBase
{
	Size = [1.2, 1.2] //X(Desired Radius)+barrelspacing(Distance between Barrels)+X(Desired Radius)=Y 
	Z = 1.32 // Controls the "height" of the light for the purposes of normal mapping.
}

BulletEmitterBase
{

	Type = BulletEmitter
	ChainedTo = Turret
	FireTrigger = Turret
	GetTargetFrom = Turret
	Location = [1, 0]
	OperationalToggle = IsOperational
	FireDelay = 1
	Bullet = &/SW_SHOTS/Missiles/Discord
	ResourceStorage = LoadedDroid
	ResourcesUsed = 1
	TargetLeadPrediction = true
	Recoil = 10
}

TurretBase
{
	Type = TurretWeapon
	Location = [0.5, 0.39]
	Rotation = -90d
	OperationalToggle = IsOperational
	AutoFireToggle = AutoFireToggle
	FireInterval = 0
	FiringArc = 90d
	ValidArc = 90d //Must be facing the direction
	RotateSpeed = 0d
	FireThresholdAngle = 90d
	AIFirepowerRating = 2000
	CanBeGivenExplicitTarget = true
	TargetSearchesPerSecond = 1
	Emitter = BulletEmitter
	FirePermissionToggle = FirePermissionToggle
	HoldTargetAfterCancel = 0.15
	AutoTargetCrewSafetyDist = 8
	IgnoreSourceShipLOSChecks = false
	AllowFireWithBlockedLOS = false

	AutoTargets
	[
		{
			TargetType = ShipParts
			Toggle = AutoTargetToggle
			EnableInDirectControlMode = true
		}
	]

	CoverageSectorArc
	{
		Texture = &/INDICATORS/VerticalGradient
		VertexColor = [255, 255, 255, 51]
		QuadCount = 64
	}
}
