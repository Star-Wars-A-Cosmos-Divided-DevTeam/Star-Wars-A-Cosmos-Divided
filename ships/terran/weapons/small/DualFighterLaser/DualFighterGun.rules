		ReloadProgressBarTurretRight
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = TurretRight
		}

		TurretLeft
		{
			Type = TurretWeapon
			Location = [1.25,0.5]
			Rotation = -90d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = .7
			FiringArc = 15d
			RotateSpeed = 360d
