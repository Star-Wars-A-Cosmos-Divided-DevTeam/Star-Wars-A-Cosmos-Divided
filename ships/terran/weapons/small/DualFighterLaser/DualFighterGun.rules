//BulletEmitters - BulletEmitterBase
	BulletEmitterBase
	{
			Type = BulletEmitter
			ChainedTo = TurretBase
			FireTrigger // = TurretBase
			GetTargetFrom = TurretBase
			Location = [1.28, 0]
			OperationalToggle = IsOperational
			FireDelay = 0.03
			Bullet = &/SW_SHOTS/blueeta2lasershot
			ResourceStorage = BatteryStorage
			ResourcesUsed = 125 // Previously 400
			MinResourcesUsed = 1
			//TargetLeadPrediction = true
			//Recoil = 0
	}

//BulletEmitters - BulletEmitterLeft
		BulletEmitterLeft : BulletEmitterBase //&~/Components/BulletEmitterBase
		{
			Location = [1.28, 0.25]
