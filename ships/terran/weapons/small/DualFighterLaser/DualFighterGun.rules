//BulletEmitters - BulletEmitterBase
	BulletEmitterBase
	{
			Type = BulletEmitter
			ChainedTo = TurretBase
			FireTrigger // = TurretBase
			GetTargetFrom = TurretBase
			Location = [1.28, 0]
			OperationalToggle = IsOperational
			FireDelay = 0.2
			Bullet = &/SW_SHOTS/blueeta2lasershot
			ResourceStorage = BatteryStorage
			ResourcesUsed = 125 // Previously 400
			MinResourcesUsed = 1
			//TargetLeadPrediction = true
			//Recoil = 0
	}

//BulletEmitters - BulletEmitterLeft
		BulletEmitterLeft : BulletEmitterBase //&~/Components/BulletEmitterBase
		{
			FireTrigger = ShootLeftTriggerProxy
			Location = [1.28, 0.25]
			//Type = BulletEmitter
			//ChainedTo = TurretLeft
			//FireTrigger = TurretLeft
			//GetTargetFrom = TurretLeft
			//OperationalToggle = IsOperational
			//Bullet = &<../../Shots/Small_RedLaser01/Small_RedLaser01.rules>
			//ResourceStorage = BatteryStorage
			//ResourcesUsed = 125
		}

//BulletEmitters - BulletEmitterRight
		BulletEmitterRight : BulletEmitterBase
		{
			FireTrigger = ShootRightTriggerProxy
			Location = [1.28, -0.25]
			//Type = BulletEmitter
			//ChainedTo = TurretRight
			//FireTrigger = TurretRight
			//GetTargetFrom = TurretRight
			//OperationalToggle = IsOperational
			//Bullet = &<../../Shots/Small_RedLaser01/Small_RedLaser01.rules>
			//ResourceStorage = BatteryStorage
			//ResourcesUsed = 125
		}

//Effects - FireEffectBase
		//None
//Effects - FireEffectLeft
		FireEffectLeft
		{
			Type = TriggeredEffects
			ChainedTo = BulletEmitterLeft
			Trigger = BulletEmitterLeft
			AnchorMediaEffects = true
			//Location = [1.7, 0]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Shoot/Small/Blue
				&/SW_SOUNDS/TinyLaserBlaster

				//: /BASE_SOUNDS/AudioExterior
				//{
				//	Sound = "../../Shots/Small_RedLaser01/fire.wav"
				//	Volume = .6
				//	//SpeedVariation = .25
				//}
			]
		}

//Effects - FireEffectRight
		FireEffectRight : FireEffectLeft
		{
			ChainedTo = BulletEmitterRight
			Trigger = BulletEmitterRight
		}

//Effects - ChargeEffects
		ChargeEffectLeft
		{
			Type = TriggeredEffects
			ChainedTo = BulletEmitterLeft
			Trigger = ShootLeftTriggerProxy
			AnchorMediaEffects = true

			MediaEffects
			[
				&/SW_SOUNDS/SmallLaserCharge
			]
		}
		ChargeEffectRight : ChargeEffectLeft
		{
			ChainedTo = BulletEmitterRight
			Trigger = ShootRightTriggerProxy
		}


		BatterySprites
		{
			Type = ResourceSprites
			Location = [.5, .5]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			HasZeroResourceSprite = false
			ResourceLevels
			[
				{
					File = "../common_graphics_1/batteries0.png"
					Size = [1, 1]
				}
				{
					File = "../common_graphics_1/batteries1.png"
					Size = [1, 1]
				}
				{
					File = "../common_graphics_1/batteries2.png"
					Size = [1, 1]
				}
				{
					File = "../common_graphics_1/batteries3.png"
					Size = [1, 1]
				}
				{
					File = "../common_graphics_1/batteries4.png"
					Size = [1, 1]
				}
				{
					File = "../common_graphics_1/batteries5.png"
					Size = [1, 1]
				}
				{
					File = "../common_graphics_1/batteries6.png"
					Size = [1, 1]
				}
				{
					File = "../common_graphics_1/batteries7.png"
					Size = [1, 1]
				}
				{
					File = "../common_graphics_1/batteries8.png"
					Size = [1, 1]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [.5, .5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyed
			//Location = [.5, 1.5]
			Location = [.5, .5]
		}

//Indicators
		Indicators
		{
			Type = IndicatorSprites
//			Location = [.5, 1.5]
			Location = [.5, .5]
			//Layer = "indicators" //Removal for 0.27.0_rc2_steam 
			Indicators
			[
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [1]
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 1]
//			Offset = [0, -0.5]
			//Offset = [0, -1]
		}
	}

	Stats
	{
		CrewRequired = 0 //&~/Part/Components/PartCrew/Crew
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		//TurretPenResist = &~/Part/Components/TurretCollider/InitialPenetrationResistance

		//RecPower = &../StatsByCategory/0/Stats/PowerPerSecond
		//RecCrew = (&RecPower) * 4
	}

   //Stats 
	StatsByCategory
	[
		&~/TurretStats
		&~/LaserStats
	]
}

		TurretStats
		{
			NameKey = "StatCategories/Turret"
			Stats
			{
				Barrels = 2
				ROF = 1 / (&~/Part/Components/TurretBase/FireInterval)
				Range = &~/Part/Components/BulletEmitterBase/Bullet/Range
				Arc = deg(&~/Part/Components/TurretBase/FiringArc)
				TurretSpeed = deg(&~/Part/Components/TurretBase/RotateSpeed)
				PowerPerShot = (&~/Part/Components/BulletEmitterBase/ResourcesUsed) / 1000
				PowerPerSecond = (&PowerPerShot) * (&ROF)
				ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
			}
		}
		LaserStats
		{
			NameKey = "StatCategories/SmallBlueIoncannonshot"
			Stats
			{
				ShieldDamagePerShot = &~/Part/Components/BulletEmitterBase/Bullet/Components/Hit/HitShield/HitEffects/0/Amount
				ShieldDamagePerSecond = (&ShieldDamagePerShot) * (&~/TurretStats/Stats/ROF)
				ShieldDamage = [&../ShieldDamagePerShot, &../ShieldDamagePerSecond]
				DamagePerShot = &~/Part/Components/BulletEmitterBase/Bullet/Components/Hit/HitOperational/HitEffects/1/Damage
				DamagePerSecond = (&DamagePerShot) * (&~/TurretStats/Stats/ROF)
				Damage = [&../DamagePerShot, &../DamagePerSecond]
				ShotSpeed = &~/Part/Components/BulletEmitterBase/Bullet/Speed
				ShotHP = &~/Part/Components/BulletEmitterBase/Bullet/Components/Targetable/Health
			}
		}


