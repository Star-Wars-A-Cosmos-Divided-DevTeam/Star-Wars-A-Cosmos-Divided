		TurretGraphicsRight
		{
			Type = Graphics
			ChainedTo = TurretRight
			Location = [0.86, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
			OperationalDoodad
			{
				Layer = "turrets"
				DamageLevels
				[
					{
						File = "../FighterGun01_1x1/turret_on.png"
						Size = [1, 2]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "turrets"
				DamageLevels
				[
					{
						File = "../FighterGun01_1x1/turret_off.png"
