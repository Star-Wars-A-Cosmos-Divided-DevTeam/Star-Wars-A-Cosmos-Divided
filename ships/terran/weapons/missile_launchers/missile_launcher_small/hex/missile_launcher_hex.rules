	}*/

	FirePermissionToggle
	{
		Type = MultiToggle
		Toggles = [CommonReloadTimerLong, FireModeToggle]
		Mode = All
	}

	CommonReloadResetTrigger
	{
		Type = MultiTrigger
		Triggers = [WeaponA/*, WeaponB, WeaponC*/]
	}

	LaunchEffectA : ~/LaunchEffectBase
	{
		ChainedTo = WeaponA
		Trigger = WeaponA
	}

	/*LaunchEffectB : ~/LaunchEffectBase
	{
		ChainedTo = WeaponB
		Trigger = WeaponB
	}

	LaunchEffectC : ~/LaunchEffectBase
	{
		ChainedTo = WeaponC
		Trigger = WeaponC
	}*/

	IsLaunchBayNotFullyOpen
	{
		Type = MultiToggle
		Toggles = [{Toggle = IsLaunchBayFullyOpen; Invert = true}]
		Mode = All
	}
	
    LaunchBayChangingValueTween
    {
        Type = ValueTween
        OnTweenDuration = .2
        OffTweenDuration = .2
        IsOnToggle = LauchBayShouldOpen
    }
    IsLaunchBayFullyOpen
    {
        Type = ThresholdToggle
        ValueFrom = LaunchBayChangingValueTween
        MinAmount = 100%
    }
    IsLauchBayFullyClosed
    {
        Type = ThresholdToggle
        ValueFrom = LaunchBayChangingValueTween
        MaxAmount = 0%
    }
    LauchBayShouldOpen
    {
        Type = MultiToggle
        Toggles = [IsOperational, MissilesPrereq, FireModeToggle]
        Mode = All
    }

	LaunchBaySprite
	{
		Type = OpenCloseSprite
		Location = [.5, 1.5]
		OperationalToggle = LauchBayShouldOpen
		Layer = "SW.roof_engines"
		OpenDamageLevels
		[
			{
				AnimationFiles
				[
					"roof_0.png"
					"roof_1.png"
					"roof_2.png"
					"roof_3.png"
				]
				
