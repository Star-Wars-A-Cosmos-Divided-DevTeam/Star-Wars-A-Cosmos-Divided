		IsLaunchBayNotFullyOpen
		{
			Type = MultiToggle
			Toggles = [{Toggle = IsLaunchBayFullyOpen; Invert = true}]
			Mode = All
		}

		LaunchBayChangingValueTween
		{
			Type = ValueTween
			OnTweenDuration = 0.6
			OffTweenDuration = 0.6
			IsOnToggle = LauchBayShouldOpen
		}

		IsLaunchBayFullyOpen
		{
			Type = ThresholdToggle
			ValueFrom = LaunchBayChangingValueTween
			MinAmount = 100%
		}

		IsLauchBayFullyClosed
		{
			Type = ThresholdToggle
			ValueFrom = LaunchBayChangingValueTween
			MaxAmount = 0%
		}

		LauchBayShouldOpen
		{
			Type = MultiToggle
			Toggles = [IsOperational, FireModeToggle, MissilesPrereqToggleProxy]
			Mode = All
		}

 /*
 		IsOuterLaunchBayNotFullyOpen
		{
			Type = MultiToggle
			Toggles = [{Toggle = IsOuterLaunchBayFullyOpen; Invert = true}]
			Mode = All
		}

		OuterLaunchBayChangingValueTween
		{
			Type = ValueTween
			OnTweenDuration = 0.6
			OffTweenDuration = 0.6
			IsOnToggle = OuterLauchBayShouldOpen
		}

		IsOuterLaunchBayFullyOpen
		{
			Type = ThresholdToggle
			ValueFrom = OuterLaunchBayChangingValueTween
			MinAmount = 100%
		}

		IsOuterLauchBayFullyClosed
		{
			Type = ThresholdToggle
			ValueFrom = OuterLaunchBayChangingValueTween
			MaxAmount = 0%
		}

		OuterLauchBayShouldOpen
		{
			Type = MultiToggle
			Toggles = [IsOperational, FireModeToggle, MissilesPrereqToggleProxy]
			Mode = All
