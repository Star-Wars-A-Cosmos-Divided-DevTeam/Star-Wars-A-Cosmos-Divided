					AnimationInterval = (&~/Part/Components/LaunchBayChangingValueTween/OffTweenDuration) / 12
					AnimationStartTime = MinValue
					ClampAnimation = true
				}
			]
		}

		InternalLaunchBaySprite
		{
			Type = OpenCloseSprite
			Location = [0.5, 1.5]
			OperationalToggle = LauchBayShouldOpen
			Layer = "roofs"
			OpenDamageLevels
			[
				{
					AnimationFiles
					[
						"sprites/roof_0.png"
