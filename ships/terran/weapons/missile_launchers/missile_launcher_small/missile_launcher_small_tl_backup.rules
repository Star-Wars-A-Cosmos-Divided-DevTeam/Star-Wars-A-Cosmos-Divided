						"sprites/missile_11.png"
						"sprites/missile_12.png"
					]
					Size = [1, 3]
					AnimationInterval = (&~/Part/Components/LaunchBayChangingValueTween/OnTweenDuration) / 12
					AnimationStartTime = MinValue
					ClampAnimation = true
				}
			]
			ClosedDamageLevels
			[
				{
					AnimationFiles
					[
						"sprites/missile_12.png"
						"sprites/missile_11.png"
