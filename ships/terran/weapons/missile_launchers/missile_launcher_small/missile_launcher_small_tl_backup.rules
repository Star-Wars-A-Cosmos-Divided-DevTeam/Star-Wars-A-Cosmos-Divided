				]
			}*/
			
		}

		DoodadGraphics
		{
			Type = Graphics
			Location = [0.5, 1.5]
			OperationalToggle = IsOperational
			OperationalDoodad
			{
				Layer = "doodads_low"
				//Offset = [0, 0.5]
				DamageLevels
				[
					{
						File = "sprites/doodads.png"
