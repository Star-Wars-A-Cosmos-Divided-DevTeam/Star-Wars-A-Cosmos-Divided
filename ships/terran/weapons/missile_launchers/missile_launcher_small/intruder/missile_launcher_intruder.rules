EditorIcon
{
	Texture
	{
		File = "icon_intruder.png"
		SampleMode = Linear
	}
	Size = [20, 60]
}

Components
{

	MissileStorageA_EMP : ~/MissileStorageBaseEMP
	{
		// Nothing different.
	}

	MissileStorageB_EMP : ~/MissileStorageBaseEMP
	{
		// Nothing different.
	}

	CombinedMissileStorage_EMP
	{
		Type = MultiResourceStorage
		ResourceType = missile_part_emp
		ResourceStorages = [MissileStorageA_EMP, MissileStorageB_EMP]
		AddMode = PrioritizeLeastEmptyCapacity
		RemoveMode = PrioritizeMostEmptyCapacity
		ReceiveResourceMediaEffects = &/COMMON_EFFECTS/MissileLoad
		UITileRect = [0.0625, 1.0625, 0.875, 0.875]  // Adjusted for padding within the tile
	}

	Consumer
	{
		Type = ResourceConsumer
		ResourceType = missile_part_emp
		Storage = CombinedMissileStorage_EMP
		DefaultPriority = &/PRIORITIES/Weapon_Supply
		OverridePriorityKey = EMPMissilesComponents
		OperationalToggle = PowerToggle
		ConsumptionToggleButtonOffset = [0, -.4]
	}

	MissileStorageA
	{
		Type = MultiToggle
		Toggles = [MissileStorageA_EMP]
		Mode = Any
	}

	MissileStorageB
	{
		Type = MultiToggle
		Toggles = [MissileStorageB_EMP]
		Mode = Any
	}

	MissilesPrereq
	{
		Type = MultiToggle
		Toggles = [MissileStorageA_EMP, MissileStorageB_EMP]
		Mode = All
	}

	ReloadProgressBar
	{
		Type = ProgressBar
		OperationalToggle = IsOperational
		ShowProgressFor = CommonReloadTimerMed
		Invert = true
	}

	WeaponArc : ~/WeaponBase
	{
		Location = [1, 1.5]
		Emitter = EmitterArc

		CoverageSectorArc
		{
			Texture = &/INDICATORS/VerticalGradient
			VertexColor = [255, 255, 255, 51]
			QuadCount = 64
		}
	}

	EmitterArc : ~/EmitterBase
	{
		ChainedTo = WeaponArc
		FireTrigger
		GetTargetFrom = WeaponArc
	}

	WeaponA : ~/WeaponBase
	{
		Location = [0.5, 1.5]
		ShowExplicitTarget = false
		Emitter = EmitterA
	}

	EmitterA : ~/EmitterBase
	{
		ChainedTo = WeaponA
		FireTrigger = WeaponA
		GetTargetFrom = WeaponA
		ResourceUsage
		[
			{
				ResourceStorage = MissileStorageA_EMP
				ResourcesUsed = 3
			}
			{
				ResourceStorage = MissileStorageB_EMP
				ResourcesUsed = 3
			}
		]
	}

	FirePermissionToggle
	{
		Type = MultiToggle
		Toggles = [CommonReloadTimerMed, FireModeToggle, ReadyToFireAfterOpen]
		Mode = All
	}

	CommonReloadResetTrigger
	{
		Type = MultiTrigger
		Triggers = [WeaponA]
	}

	OpenDelayAfterFullyOpenTween
	{
		Type = ValueTween
		IsOnToggle = IsLaunchBayFullyOpen
		OnTweenDuration = 1.0
		OffTweenDuration = 0.0
	}

	TargetingAndCanShoot_Missile
	{
		Type = MultiToggle
		Toggles = [FireModeToggle, CommonReloadTimerMed, WeaponA, MissilesPrereq]
		Mode = All
	}

	ReadyToFireAfterOpen
	{
		Type = ThresholdToggle
		ValueFrom = OpenDelayAfterFullyOpenTween
		MinAmount = 100%
	}

	LaunchEffectA : ~/LaunchEffectBase
	{
		ChainedTo = WeaponA
		Trigger = WeaponA
	}

	IsLaunchBayNotFullyOpen
	{
		Type = MultiToggle
		Toggles = [{Toggle = IsLaunchBayFullyOpen; Invert = true}]
		Mode = All
	}
	
	LaunchBayChangingValueTween
	{
		Type = ValueTween
		OnTweenDuration = 1.5
		OffTweenDuration = 2
		IsOnToggle = LaunchBayShouldOpen
	}
	IsLaunchBayFullyOpen
	{
		Type = ThresholdToggle
		ValueFrom = LaunchBayChangingValueTween
		MinAmount = 100%
	}
	IsLaunchBayFullyClosed
	{
		Type = ThresholdToggle
		ValueFrom = LaunchBayChangingValueTween
		MaxAmount = 0%
	}
	LaunchBayShouldOpen
	{
		Type = MultiToggle
		Toggles = [IsOperational, TargetingAndCanShoot_Missile]
		Mode = All
	}

	LaunchBaySprite
	{
		Type = OpenCloseSprite
		Location = [0.5, 1.5]
		OperationalToggle = LaunchBayShouldOpen
