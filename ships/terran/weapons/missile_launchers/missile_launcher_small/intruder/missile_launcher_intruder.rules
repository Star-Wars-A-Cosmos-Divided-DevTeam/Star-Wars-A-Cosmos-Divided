	OperationalLightingEffects
	{
		//Offset = [0, -.2]	
		Type = Sprite
		Location = [0.5, 1.5]
		Layer = "lights_add"
		ResetAnimationTrigger = WeaponA
		AtlasSprite
		{
			AnimationFiles
			[
				"lights_alert.png"
				"lights2.png"
				"lights.png"
			]
			/*NormalsAnimationFiles
			[
				"lights_alert.png"
				"lights2.png"
				"lights.png"
			]*/
