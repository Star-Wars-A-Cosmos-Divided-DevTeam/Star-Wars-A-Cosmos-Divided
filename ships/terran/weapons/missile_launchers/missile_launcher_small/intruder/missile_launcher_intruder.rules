				AnimationFiles
				[
					"roof_3_33.png"
					"roof_2_33.png"
					"roof_1_33.png"
					"roof_0_33.png"
				]
				NormalsAnimationFiles
				[
					"roof_3_normals_33.png"
					"roof_2_normals_33.png"
					"roof_1_normals_33.png"
					"roof_0_normals_33.png"
				]
				Size = [1, 3]
				AnimationInterval = (&~/Components/LaunchBayChangingValueTween/OffTweenDuration) / 4
				AnimationStartTime = 3 //MinValue
				ClampAnimation = true
			}
			{
				AnimationFiles
				[
					"roof_3_66.png"
					"roof_2_66.png"
					"roof_1_66.png"
					"roof_0_66.png"
				]
				NormalsAnimationFiles
				[
					"roof_3_normals_66.png"
					"roof_2_normals_66.png"
					"roof_1_normals_66.png"
					"roof_0_normals_66.png"
				]
				Size = [1, 3]
