	Consumer
	{
		Type = ResourceConsumer
		ResourceType = missile_part_emp
		Storage = MissileStorageA_EMP//CombinedMissileStorage_EMP
		DefaultPriority = &/PRIORITIES/Weapon_Supply
		OverridePriorityKey = EMPMissilesComponents
		OperationalToggle = PowerToggle
		ConsumptionToggleButtonOffset = [0, -0.4]
	}

	MissileStorageA
	{
		Type = MultiToggle
		Toggles = [MissileStorageA_EMP]
		Mode = All
	}

	/*MissileStorageB
	{
		Type = MultiToggle
		Toggles = [MissileStorageB_HE, MissileStorageB_EMP]
		Mode = All
	}*/

	MissilesPrereq
	{
		Type = MultiToggle
		Toggles = [MissileStorageA_EMP]
		//Toggles = [MissileStorageA, MissileStorageB]
		Mode = All
	}

	ReloadProgressBar
	{
		Type = ProgressBar
		OperationalToggle = IsOperational
		ShowProgressFor = CommonReloadTimerMed
		Invert = true
	}

	WeaponArc : ~/WeaponBase
	{
		Location = [1, 1.5]
		Emitter = EmitterArc

		CoverageSectorArc
		{
			Texture = &/INDICATORS/VerticalGradient
			VertexColor = [255, 255, 255, 51]
			QuadCount = 64
		}
	}

	EmitterArc : ~/EmitterBase
	{
		ChainedTo = WeaponArc
		FireTrigger
		GetTargetFrom = WeaponArc
	}

	WeaponA : ~/WeaponBase
	{
		Location = [0.5, 1.5]
		ShowExplicitTarget = false
		Emitter = EmitterA
	}

	EmitterA : ~/EmitterBase
	{
		ChainedTo = WeaponA
		FireTrigger = WeaponA
		GetTargetFrom = WeaponA
		ResourceUsage
		[
			/*{
				ResourceStorage = MissileStorageA_HE
				ResourcesUsed = 2
			}*/
			{
				ResourceStorage = MissileStorageA_EMP
				ResourcesUsed = 6
			}
		]
	}

	/*WeaponB : ~/WeaponBase
	{
		Location = [2- (&~/Components/WeaponA/Location/0), (&~/Components/WeaponA/Location/1)]
		ShowExplicitTarget = false
		Emitter = EmitterB
	}*/

