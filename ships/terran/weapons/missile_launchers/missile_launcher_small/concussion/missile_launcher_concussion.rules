EditorIcon
{
	Texture
	{
		File = "icon_concussion.png"
		SampleMode = Linear
	}
	Size = [20, 60]
}

Components
{
	MissileStorageA : ~/MissileStorageBase
	{
		// Nothing different.
	}

	MissileStorageB : ~/MissileStorageBase
	{
		// Nothing different.
	}

	/*MissileStorageC : ~/MissileStorageBase
	{
		// Nothing different.
	}*/

	CombinedMissileStorage
	{
		Type = MultiResourceStorage
		ResourceType = missile_part_he
		ResourceStorages = [MissileStorageA, MissileStorageB /*, MissileStorageC*/]
		AddMode = PrioritizeLeastEmptyCapacity
		RemoveMode = PrioritizeMostEmptyCapacity
		ReceiveResourceMediaEffects = &/COMMON_EFFECTS/MissileLoad
		UITileRect = [0.0625, 1.0625, 0.875, 0.875]  // Adjusted for padding within the tile
		//UITileRect = [.5 + 7/64, 1 + 7/64, 1 - 14/64, 1 - 14/64]
	}

	Consumer
	{
		Type = ResourceConsumer
		ResourceType = missile_part_he
		Storage = CombinedMissileStorage
		DefaultPriority = &/PRIORITIES/Weapon_Supply
		OverridePriorityKey = MissileStorage
		OperationalToggle = PowerToggle
		ConsumptionToggleButtonOffset = [0, -.4]
	}

	MissilesPrereq
	{
		Type = MultiToggle
		Toggles = [MissileStorageA, MissileStorageB/*, MissileStorageC*/]
		Mode = All
	}

	ReloadProgressBar
	{
		Type = ProgressBar
		OperationalToggle = IsOperational
		ShowProgressFor = CommonReloadTimerShort
		Invert = true
	}

	WeaponArc : ~/WeaponBase
	{
		Location = [1, 1.5]
		Emitter = EmitterArc

		CoverageSectorArc
		{
			Texture = &/INDICATORS/VerticalGradient
			VertexColor = [255, 255, 255, 51]
			QuadCount = 64
		}
	}

	EmitterArc : ~/EmitterBase
	{
		ChainedTo = WeaponArc
		FireTrigger
		GetTargetFrom = WeaponArc
	}

	WeaponA : ~/WeaponBase
	{
		Location = [0.5, 1.5]
		ShowExplicitTarget = false
		Emitter = EmitterA
	}

	EmitterA : ~/EmitterBase
	{
		ChainedTo = WeaponA
		FireTrigger = WeaponA
		GetTargetFrom = WeaponA
		ResourceStorage = CombinedMissileStorage
	}

	/*WeaponB : ~/WeaponBase
	{
		Location = [2- (&~/Components/WeaponA/Location/0), (&~/Components/WeaponA/Location/1)]
		ShowExplicitTarget = false
		Emitter = EmitterB
	}

	EmitterB : ~/EmitterBase
	{
		ChainedTo = WeaponB
		FireTrigger = WeaponB
		GetTargetFrom = WeaponB
		ResourceUsage
		[
			{
				ResourceStorage = MissileStorageB_HE
				ResourcesUsed = 3
			}
			{
				ResourceStorage = MissileStorageB_EMP
				ResourcesUsed = 1
			}
		]
	}
*/
	FirePermissionToggle
	{
		Type = MultiToggle
		Toggles = [CommonReloadTimerShort, FireModeToggle]
		Mode = All
	}

	CommonReloadResetTrigger
	{
		Type = MultiTrigger
		Triggers = [WeaponA /*, WeaponB*/]
	}

	LaunchEffectA : ~/LaunchEffectBase
	{
		ChainedTo = WeaponA
		Trigger = WeaponA
	}

	/*LaunchEffectB : ~/LaunchEffectBase
	{
		ChainedTo = WeaponB
		Trigger = WeaponB
	}*/

	IsLaunchBayNotFullyOpen
	{
		Type = MultiToggle
		Toggles = [{Toggle = IsLaunchBayFullyOpen; Invert = true}]
		Mode = All
	}
	
	LaunchBayChangingValueTween
	{
		Type = ValueTween
		OnTweenDuration = .2
		OffTweenDuration = .2
		IsOnToggle = LauchBayShouldOpen
	}
	IsLaunchBayFullyOpen
	{
		Type = ThresholdToggle
		ValueFrom = LaunchBayChangingValueTween
		MinAmount = 100%
	}
	IsLauchBayFullyClosed
	{
		Type = ThresholdToggle
		ValueFrom = LaunchBayChangingValueTween
		MaxAmount = 0%
	}
	LauchBayShouldOpen
	{
		Type = MultiToggle
		Toggles = [IsOperational, MissilesPrereq, FireModeToggle, WeaponA]
		Mode = All
	}

	LaunchBaySprite
	{
		Type = OpenCloseSprite
		Location = [0.5, 1.5]
		OperationalToggle = LauchBayShouldOpen
		Layer = "SW.roof_engines"
