Part : &<../base_part_terran_weapons_ions.rules>/Part
{
	TypeCategories : ^/0/TypeCategories []

	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronBuff, SW_Fusion_Energy_Grid]

	Components : ^/0/Components 
	{
		FusionEnergyGridToggle
		{
			Type = BuffToggle
			BuffType = SW_Fusion_Energy_Grid
		}
		BatteryStorageBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = BatteryStorage
			LowColor = [64, 64, 0]
			HighColor = [250, 250, 0]
			FullColor = [255, 255, 0]
		}		
	}
}