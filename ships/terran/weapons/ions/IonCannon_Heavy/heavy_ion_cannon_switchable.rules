OVERCLOCK
{
	BULLET = &<../../../../../shots/ion/turret/turbo/heavy/overclock/oc_base_shot.rules>

	// Rate-of-fire scaler (2 = twice as fast)
	FIRE_RATE_FACTOR = 100%
	POWER_USE_FACTOR = 100%

	// OC spread/recoil modifiers
	//HALF_SPREAD   = (&~/EMITTER_BASE/Spread/1) * 2
	RECOIL_FACTOR = 150%

	// Heat hookup
	HEAT_PER_SHOT   = 650
	HEAT_PER_SECOND = 100


	// Drain metrics pulled from OC shot definition.
	TOTAL_DRAIN = &~/BULLET/TOTAL_POWER_DRAIN
	DRAIN_PER_SECOND = &~/BULLET/DRAIN_PER_SECOND
	TOTAL_SHIELD_DRAIN = &~/BULLET/TOTAL_SHIELD_DRAIN
	SHIELD_DRAIN_PER_SECOND = &~/BULLET/SHIELD_DRAIN_PER_SECOND
	DRAIN_DURATION = &~/BULLET/DRAIN_DURATION
}
// Heat Producers
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

// Resources Used
RESOURCES_USED = 1500

// Max Resources
BASE_MAX_RESOURCES = 25000 //(&~/BASE_MAX_RESOURCES)

// Shot Timer
BASE_SHOT_INTERVAL = 1 // (&~/BASE_SHOT_INTERVAL)

Part : &<../base_part_terran_ion_cannons.rules>/Part
{
	//IDs
	ID = SW.heavy_ion_cannon_switchable
	OtherIDs = ["SW.heavy_ion_cannon", "SW.heavy_ion_cannon_b"]

	//StringKeys
	NameKey = "Parts/HeavyIonCannon"
	IconNameKey = "Parts/HeavyIonCannonIcon"
	DescriptionKey = "Parts/HeavyIonCannonDesc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups ["WeaponsEnergy", SWTechIII]
	TypeCategories : ^/0/TypeCategories [weapon, uses_power,is_crewed]
	SignificanceToggle = ScorchedToggle
	RequiresCategories = [SW_Bridge]

	//Resources&Size&Health
	Resources
	[
		[steel, 72]
		[coil, 30]
		[coil2, 15]
	]
	Size = [4, 4]
	MaxHealth = 42000

	//Rects
	//GenerateRectCollider = true

	//Selections
	SelectionPriority = 1
	SelectionTypeByRotation = true
	SelectionTypeID = "ion-cannons"

	//PartSpecifics
	AIValueFactor = 3
	InitialPenetrationResistance = 5

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronBuff]

	//DoorsEtc
	AutoDoorMaxPathLength = 8
	MaxDoors = 8
	AllowedDoorLocations
	[
		[-1, 0]
		//[-1, 1]
		//[-1, 2]
		[-1, 3]
		[0, 4]
		[1, 4]
		[2, 4]
		[3, 4]
		[4, 3]
		//[4, 2]
		//[4, 1]
		[4, 0]
		[3, -1]
		//[2, -1]
		//[1, -1]
		[0, -1]
	]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 80]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		IsOperational : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [PowerToggle, BatteryStorage, PartCrew, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 12 // 6
		}

		//OverclockSettings
		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One  { Type = StaticValue; Value = 1; }

		OverheatEffects : ^/0/OverheatEffects
		{
			Location = [2, 2]
		}

		Port_Thermal_TopLeft : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 0]
			Direction = Left
		}

		Port_Thermal_LeftUp : Port_Thermal_TopLeft
		{
			Direction = Up
		}

		Port_Thermal_TopRight : Port_Thermal_LeftUp
		{
			Location = [3, 0]
			Direction = Right
		}

		Port_Thermal_RightUp : Port_Thermal_TopRight
		{
			Direction = Up
		}

		Port_Thermal_MidUp1 : Port_Thermal_RightUp
		{
			Location = [1, 0]
		}

		Port_Thermal_MidUp2 : Port_Thermal_MidUp1
		{
			Location = [2, 0]
		}

		Port_Thermal_MidRight1 : Port_Thermal_MidUp2
		{
			Location = [3, 1]
			Direction = Right
		}

		Port_Thermal_MidLeft1 : Port_Thermal_MidRight1
		{
			Location = [0, 1]
			Direction = Left
		}

		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}

		FireAlternatingToggle
		{
			Type = UIToggle
			ToggleID = "fire_alternating"
			Default = 0
		}
/*
		CommonReloadTimer
		{
			Type = Timer
			Duration = 2
			AutoStart = true
			StartTrigger = CommonReloadResetTriggerProxy
		}
		CommonOnShootEffectTimer
		{
			Type = Timer
			Duration = 0.42
			AutoStart = true
			StartTrigger = CommonReloadResetTriggerProxy
		}
		CommonReloadResetTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = CommonReloadResetTrigger
		}
*/
/*
		MunitionType
		{
			Type = UIToggle
			ToggleID = "SW.munition_type"
			Default = 1
			AvailableChoices = [1]
			AlwaysAllowInBuildMode = true
		}
*/
		ExteriorType
		{
			Type = UIToggle
			ToggleID = "SW.exterior_type"
			Default = 0
			ToggledOnChoices = [0,1]
			//AlwaysAllowInBuildMode = true
			//RequiresCommand = false
		}

		WhiteExteriorToggle
		{
			Type = ModeToggle
			Mode = ExteriorType
			OnMode = 0
		}
		WhiteExteriorComponents
		{
			Type = ToggledComponents
			Toggle = WhiteExteriorToggle
			//IncludeInBlueprints = true
			Components = &<heavy_ion_cannon_white.rules>/Components
		}

		GreyExteriorToggle
		{
			Type = ModeToggle
			Mode = ExteriorType
			OnMode = 1
		}
		GreyExteriorComponents
		{
			Type = ToggledComponents
			Toggle = GreyExteriorToggle
			//IncludeInBlueprints = true
			Components = &<heavy_ion_cannon_grey.rules>/Components
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = (&~/BASE_MAX_RESOURCES)
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			ResupplyThreshold = 2500
			OperationalToggle = CommandConsumptionToggle
		}

		Graphics
		{
			Type = Graphics
			OperationalToggle = IsOperational
			Location = [2, 2]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [4, 4]
					}
					{
						File = "floor_33.png"
						Size = [4, 4]
					}
					{
						File = "floor_66.png"
						Size = [4, 4]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights5_2.png"
						Size = [4, 4]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [4, 4]
					}
					{
						File = "walls_33.png"
						Size = [4, 4]
					}
					{
						File = "walls_66.png"
						Size = [4, 4]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [4, 4]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [4, 4]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [4, 4]
					}
				]
			}
			/*
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [2, 2]
						Z = 1.30 // Controls the "height" of the light for the purposes of normal mapping.
						VertexColor = [192, 192, 192] // [6, 57, 113]
					}
				]
			}
			*/
		}

		TurretInsideGraphics
		{
			Type = Graphics
			OperationalToggle = IsOperational
			//Location = [0, 0]
			ChainedTo = Turret
			Rotation = 90d
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights4_2.png"
						Size = [1.625,1.125]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"console on1.png"
							"console on2.png"
							"console on3.png"
						]
						Size = [4, 4]
						AnimationInterval = 0.50
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "console off.png"
						Size = [4, 4]
					}
				]
			}
		}

		Turret
		{
			Type = TurretWeapon
			Location = [2, 2]
			Rotation = -90d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = 0 // Uses separate common fire timer.
			FiringArc = 180d
			RotateSpeed = 24d
			FireThresholdAngle = 2d
			HoldTargetAfterCancel = 0.15
			AIFirepowerRating = &~/Part/StatsByCategory/0/Stats/DamagePerSecond //6400
			FirePermissionToggle = FirePermissionToggle
			IgnoreSourceShipLOSChecks = true
			IgnoreSourceShipLowLOSChecks = true
			AllowFireWithBlockedLOS = false
			//AutoTargetCrewSafetyDist = 8
			Emitter = WeaponEmitterLeft

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}

		IsFireSynchronised_NonOverclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, IsOverclocked ]
			// ON when Alternating is OFF and Overclock is OFF
			Mode = None
		}
		IsFireSynchronised_Overclock
		{
			Type = MultiToggle
			Toggles = [ {Toggle=FireAlternatingToggle; Invert=true}, IsOverclocked ]
			// ON when Alternating is OFF and Overclock is ON
			Mode = All
		}
		IsFireAlternating_NonOverclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, {Toggle=IsOverclocked; Invert=true} ]
			// ON when Alternating is ON and Overclock is OFF
			Mode = All
		}
		IsFireAlternating_Overclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, IsOverclocked ]
			// ON when Alternating is ON and Overclock is ON
			Mode = All
		}

		// Synchronized (both barrels) — Overclocked
		ShootSynchronizedComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = IsFireSynchronised_Overclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					DURATION_BASE = (&~/Part/Components/ShootSynchronizedComponents/Components/FireTimer/Duration)
					Duration = (&DURATION_BASE) / (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					AutoStart = true
					StartTrigger = Turret
				}
				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				// Add these so the emitters actually fire in OC
				ShootLeftTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
				ShootRightTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
			}
		}


		// Alternating (per barrel) — Overclocked
		ShootAlternatingComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = IsFireAlternating_Overclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					DURATION_BASE = (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration)
					Duration = (&DURATION_BASE) / (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					AutoStart = true
					StartTrigger = Turret
				}
				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				// Add these so alternating works in OC
				ShootCycle
				{
					Type = ModeCycle
					ModeRange = [0, 1]
					IncrementTrigger = Turret
					StartingMode = 1
				}
				ShootLeftTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [0]
				}
				ShootRightTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [1]
				}
			}
		}

		//Non-OC
		ShootSynchronizedComponents
		{
			Type = ToggledComponents
			Toggle = IsFireSynchronised_NonOverclock
			//Invert = true
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					Duration = (&~/BASE_SHOT_INTERVAL)*2  //1*2
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				ShootLeftTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}

				ShootRightTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
			}
		}

		ShootAlternatingComponents
		{
			Type = ToggledComponents
			Toggle = IsFireAlternating_NonOverclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					Duration = (&~/BASE_SHOT_INTERVAL) //1
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				ShootCycle
				{
					Type = ModeCycle
					ModeRange = [0, 1]
					IncrementTrigger = Turret
					StartingMode = 1 // First shot will switch to mode 0.
				}

				ShootLeftTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [0]
				}

				ShootRightTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [1]
					OperationalToggle = FireAlternatingToggle
				}
			}
		}

		FireTimerProxy
		{
			Type = ToggleProxy
			ComponentID = FireTimer
		}
		FirePermissionToggle
		{
			Type = MultiToggle
			Toggles = [FireTimerProxy, FireModeToggle]
			Mode = All
		}

		ShootLeftTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = ShootLeftTrigger
		}
		ShootLeftTriggerProxy_Overclocked : ShootLeftTriggerProxy
		{
			ProxyToggle = IsOverclocked
		}
		ShootLeftTriggerProxy_NonOverclocked : ShootLeftTriggerProxy_Overclocked
		{
			InvertProxyToggle = true
		}

		ShootRightTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = ShootRightTrigger
		}
		ShootRightTriggerProxy_Overclocked : ShootRightTriggerProxy
		{
			ProxyToggle = IsOverclocked
		}
		ShootRightTriggerProxy_NonOverclocked : ShootRightTriggerProxy_Overclocked
		{
			InvertProxyToggle = true
		}

		ShootTrigger1
		{
			Type = TriggerProxy
			ComponentID = ShootLeftTriggerProxy
		}
		ShootTrigger2
		{
			Type = TriggerProxy
			ComponentID = ShootRightTriggerProxy
		}

/*
		CommonReloadResetTrigger
		{
			Type = MultiTrigger
			Triggers = [Turret]
		}
*/

		IsOperationalNonOverclocked
		{
			Type = MultiToggle
			Toggles = [IsOperational, {Toggle = IsOverclocked; Invert = true}]
			Mode = All
		}

		WeaponEmitterLeft
		{
			Type = BulletEmitter
			ChainedTo = Turret
			FireTrigger = ShootTrigger1
			GetTargetFrom = Turret
			Location = [2.375, -0.164]
			OperationalToggle = IsOperationalNonOverclocked
			FireDelay = 0.15
			Bullet = &/SW_SHOTS/Ion/Turret/Turbo/Heavy/Cyan
			SourceShipCollisions = false
			TargetLeadPrediction = false
			ResourceStorage = BatteryStorage
			ResourcesUsed = &~/RESOURCES_USED
			MinResourcesUsed = 1
			Recoil = 75
			AntiPhasingRaycastDistance = 2
		}

		WeaponEmitterRight : WeaponEmitterLeft
		{
			FireTrigger = ShootTrigger2
			Location = [2.375, 0.164]
		}

		WeaponEmitterLeftOverclock : WeaponEmitterLeft
		{
			OperationalToggle = IsOperationalOverclocked
			FireTrigger = ShootTrigger1
			Bullet = &~/OVERCLOCK/BULLET
        	ResourcesUsed 	= floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
		}

		WeaponEmitterRightOverclock : WeaponEmitterLeftOverclock
		{
			FireTrigger = ShootTrigger2
			Location = [2.375, 0.164]
		}

		Overclock_EmissionTriggered
		{
			Type = MultiTrigger
			OperationalToggle = IsOperationalOverclocked
			Triggers = [WeaponEmitterLeftOverclock, WeaponEmitterRightOverclock]
		}
		Overclock_ShotHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_EmissionTriggered
			Amount = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
		}

		BatterySprites
		{
			ChainedTo = Turret
			Rotation = 90d
			Type = ResourceSprites
			Location = [0,0]//2,2
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			HasZeroResourceSprite = false
			ResourceLevels
			[
				{
					File = "batteries01.png"
					Size = [4, 4]
				}
				{
					File = "batteries02.png"
					Size = [4, 4]
				}
				{
					File = "batteries03.png"
					Size = [4, 4]
				}
				{
					File = "batteries04.png"
					Size = [4, 4]
				}
				{
					File = "batteries05.png"
					Size = [4, 4]
				}
				{
					File = "batteries06.png"
					Size = [4, 4]
				}
				{
					File = "batteries07.png"
					Size = [4, 4]
				}
				{
					File = "batteries08.png"
					Size = [4, 4]
				}
				{
					File = "batteries09.png"
					Size = [4, 4]
				}
				{
					File = "batteries10.png"
					Size = [4, 4]
				}
			]
		}

		TurretCollider
		{
			Type = CircleCollider
			Location = &../Turret/Location
			Radius = 1.64
			Density = 1.5
			InitialPenetrationResistance = 5
		}

		FireEffectSound
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = Turret
			AnchorMediaEffects = true

			MediaEffects
			[
				&/SW_SOUNDS/IonCannonShot
			]
		}

		FireEffectLeft
		{
			Type = TriggeredEffects
			ChainedTo = WeaponEmitterLeft
			Trigger = WeaponEmitterLeft
			AnchorMediaEffects = true
	
			MediaEffects
			[
				&/SW_PARTICLES/Shot/Ion/Shoot/Med/Cyan
			]
		}

		FireEffectRight : FireEffectLeft
		{
			ChainedTo = WeaponEmitterRight
			Trigger = WeaponEmitterRight
		}

		FireEffectLeftOverclock : FireEffectLeft
		{
			ChainedTo = WeaponEmitterLeftOverclock
			Trigger = WeaponEmitterLeftOverclock
		}

		FireEffectRightOverclock : FireEffectRight
		{
			ChainedTo = WeaponEmitterRightOverclock
			Trigger = WeaponEmitterRightOverclock
		}

		TurretLocationProxy
		{
			Type = ChainableProxy
			ComponentID = Turret
		}

		GraphicsExtraLight
		{
			Type = Graphics
			OperationalToggle = IsOperationalOverclocked
			//InvertOperationalToggle = true
			ChainedTo = TurretLocationProxy
			Location = [2.375, 0]

			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = &~/OperationalRoofLightingBase/Size
						Z = &~/OperationalRoofLightingBase/Z
						VertexColor = [164, 255, 255]
					}
				]
			}
		}

		CrewLocation1
		{
			Type = CrewLocation
			Location = [0.4, 0.45]
			ChainedTo = TurretLocationProxy
			Rotation = 90d
		}
		CrewLocation2
		{
			Type = CrewLocation
			Location = [0.4, -0.45]
			ChainedTo = TurretLocationProxy
			Rotation = 90d
		}
		PartCrew
		{
			Type = PartCrew
			Crew = 2
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle, ScorchedToggle]
			HighPriorityPrerequisites = [BatteryStorage]
			CrewDestinations
			[
				[1.55, 1.6]
				[2.45, 1.6]
			]
			CrewLocations
			[
				CrewLocation1
				CrewLocation2
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Toggle = IsOperational
			Location = [2, 2]
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/BigPartScorched
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
			Location = [2, 2]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [2, 2]
			Indicators
			[
				// 0 Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3,4]
				}
				// 1 Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2,3,4]
				}
				// 2 Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
				// 3 Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
					HidesIndicators = [4]
				}
				// 4 No crew.
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [1, 1]
					}
				}
			]
		}
		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [4, 4]
		}

		PeakHeatGenerationValue
		{
			Type = StaticValue
			SHOT_HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_SHOT) * (2 / (&~/Part/Components/ShootSynchronizedComponents/Components/FireTimer/Duration))
			Value = (&SHOT_HEAT_PER_SECOND)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationValue
		}
	}
	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		TurretPenResist = &~/Part/InitialPenetrationResistance

		RecPower = &../StatsByCategory/0/Stats/PowerPerSecond
		RecCrew = (&CrewRequired) + (&RecPower) * 4
		
	}
	StatsByCategory
	[
		{
			NameKey = "StatCategories/HeavyIonCannonShot"
			Stats
			{
				ROF = 2 / (&~/Part/Components/ShootSynchronizedComponents/Components/FireTimer/Duration)
				// Primary operational damage (use BaseValue leaf)
				DamagePerShot = (&~/EMITTER_BASE/Bullet/Components/Hit/HitOperational/HitEffects/1/Damage/BaseValue)
				DamagePerSecond = (&DamagePerShot) * (&ROF)
				Damage = [&../DamagePerShot, &../DamagePerSecond]
				// Shield damage uses the Amount/BaseValue leaf from the HitShield effect
				ShieldDamagePerShot = (&~/EMITTER_BASE/Bullet/Components/Hit/HitShield/HitEffects/0/Amount/BaseValue)
				ShieldDamagePerSecond = (&ShieldDamagePerShot) * (&ROF)
				ShieldDamage = [&../ShieldDamagePerShot, &../ShieldDamagePerSecond]
				PowerDrainPerShot = (&~/EMITTER_BASE/Bullet/Components/Hit/HitShield/HitEffects/0/Amount/BaseValue) / 1000
				PowerDrainPerSecond = (&PowerDrainPerShot) * (&ROF)
				PowerDrain = [&../PowerDrainPerShot, &../PowerDrainPerSecond]
				Penetration = &~/EMITTER_BASE/Bullet/Components/Hit/Penetration
				Range = &~/EMITTER_BASE/Bullet/Range
				Arc = deg(&~/Part/Components/Turret/FiringArc)
				TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
				ShotSpeed = &~/EMITTER_BASE/Bullet/Speed
				ShotHP = &~/EMITTER_BASE/Bullet/Components/Targetable/Health
				PowerPerShot = (&~/EMITTER_BASE/ResourcesUsed) / 1000
				PowerPerSecond = (&PowerPerShot) * (&ROF)
				ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
			}
		}
		{
			NameKey = "StatCategories/Turret"
			Stats
			{
				Barrels = 2
				ReloadTime = &~/Part/Components/ShootSynchronizedComponents/Components/FireTimer/Duration
				Salvo = [&../Barrels, &../ReloadTime]
				ROF = (&Barrels) / (&ReloadTime)
				Range = &~/EMITTER_BASE/Bullet/Range
				Arc = deg(&~/Part/Components/Turret/FiringArc)
				TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
				PowerPerShot = (&~/EMITTER_BASE/ResourcesUsed) / 1000
				PowerPerSecond = (&PowerPerShot) * (&ROF)
				ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
			}
		}
	]
	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/HeavyIonCannonOverclockDesc"
		StatsByCategory
		[
			{
				NameKey = "StatCategories/HeavyIoncannonshotOverclocked"
				Stats
				{
					PowerDrain = [0, 0]
					HeatPerShot = (&~/OVERCLOCK/HEAT_PER_SHOT)
					Range = &~/OVERCLOCK/BULLET/RANGE
					Penetration = &~/OVERCLOCK/BULLET/PENETRATION
					ArmorPenetrationResistance = (&~/OVERCLOCK/BULLET/ARMOR_PENETRATION_FACTOR) * 100
				}
				Features
				[
					PenetratesOperational
				]
			}
			{
				NameKey = "StatCategories/HeavyIonCannonOverclock"
				Stats
				{
					PowerDrainOverTime = [(&~/OVERCLOCK/BULLET/TOTAL_POWER_DRAIN) / 1000, (&~/OVERCLOCK/BULLET/DRAIN_PER_SECOND) / 1000]
					SHIELD_DRAIN_PER_DAMAGE = &<./Data/ships/terran/shield_gen_small/shield_gen_small.rules>/Part/Components/ArcShield/ResourceDrainPerDamage/BaseValue
					ShieldDamageOverTime = [(&~/OVERCLOCK/BULLET/TOTAL_SHIELD_DRAIN) / (&../SHIELD_DRAIN_PER_DAMAGE), (&~/OVERCLOCK/BULLET/SHIELD_DRAIN_PER_SECOND) / (&../SHIELD_DRAIN_PER_DAMAGE)]
					EffectDuration = &~/OVERCLOCK/BULLET/DRAIN_DURATION
				}
			}
		]
	}
	StatsNotesKey = "Stats/CommandBridge_Notes"
}
OperationalRoofLightingBase
{
	Size = [1.6, 1.8] //X(Desired Radius)+barrelspacing(Distance between Barrels)+X(Desired Radius)=Y 
	Z = 1.45 // Controls the "height" of the light for the purposes of normal mapping.
}
EMITTER_BASE = &~/Part/Components/WeaponEmitterLeft
EMITTER_BASE_OVERCLOCK = &~/Part/Components/WeaponEmitterLeftOverclock
