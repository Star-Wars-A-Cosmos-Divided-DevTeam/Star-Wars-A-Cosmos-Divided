Part : &<./Data/ships/terran/base_part_terran.rules>/Part
{
	//IDs
	ID = SW.deathstar_beam_emitter
	OtherIDs = [SW.deathstar_beam_emitter_4x4, deathstar_beam_emitter_4x4]

	//StringKeys
	NameKey = "Parts/DeathStarBeamEmitter"
	IconNameKey = "Parts/DeathstarBeamEmitterIcon"
	DescriptionKey = "Parts/DeathstarBeamEmitterDesc"
	//Groups&Categories
	EditorGroups = ["WeaponsEnergy", "SWTechIII"]
	TypeCategories = [weapon, uses_power, SW_DeathStar, SW_DeathStar_Beam_Emitter]
	RequiresCategories = [SW_Bridge]

	//Resources&Size&Health
	Resources
	[
		[steel, 128]
		[coil2, 15]
		[diamond, 1]
	]
	Size = [4, 4]
	MaxHealth = 16000

	//Rects

	//Selections
	SelectionPriority = 1
	SelectionTypeID = "SW_deathstar_beam_emitter"
	SelectionTypeByRotation = true

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronBuff, SW_DeathStar, SW_DeathStarBeam ,SW_DeathstarReverseOperation]

	//PartSpecific
	Density = 4.0
	GenerateRectCollider = false
	ForceManhattanPathInPart = true

	//Doors&Etc
	AllowedDoorLocations
	[
		[-1, 0]
		[-1, 1]
		[-1, 2]
		[-1, 3]
		[4, 0]
		[4, 1]
		[4, 2]
		[4, 3]
		[0, 4]
		//[1, 4]
		//[2, 4]
		[3, 4]
	]
	BlockedTravelCells
	[
		[1, 0]
		[2, 0]
		[1, 1]
		[2, 1]
		[1, 2]
		[2, 2]
		//[1, 3]
		//[2, 3]
	]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [36, 36]
	}

	Components : ^/0/Components
	{
		ColliderLeft
		{
			Type = PolygonCollider
			Vertices
			[
				[0, 0]
				[1, 0]
				[2, 1]
				[2, 4]
				[0, 4]
			]
			Density = 4.2
		}
		ColliderRight
		{
			Type = PolygonCollider
			Vertices
			[
				[2, 1]
				[3, 0]
				[4, 0]
				[4, 4]
				[2, 4]
			]
			Density = 4.2
		}

		BuffOperational
		{
			Type = MultiToggle
			Toggles = [CommandToggle]
			Mode = All
		}
		True
		{
			Type = StaticToggle
			ToggleOn = "true"
		}

		IsOperational
		{
			Type = MultiToggle
			Toggles = [BuffOperational, DeathstarReverseOperationBuffToggle]
			Mode = All
		}

		DeathstarReverseOperationBuffToggle
		{
			Type = BuffToggle
			BuffType = SW_DeathstarReverseOperation
		}

		DeathStarBuffToggle
		{
			Type = BuffToggle
			BuffType = SW_DeathStar
		}

		OperationBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = SW_DeathstarOperation
			BuffArea = [0, -1, 4, 1]
			OperationalToggle = BuffOperational
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 4
				Bottom = 0
			}
		}

		DeathStarBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = SW_DeathStar
			BuffAmount = { BaseValue=1; BuffType=SW_DeathStar; BuffMode=Add; }
			BuffArea = [0, 4, 4, 1]
			OperationalToggle = DeathStarBuffToggle
			ChainsFromBuffType = SW_DeathStar
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 4
				Top = 4
			}
		}

		BeamBuffProvider
		{
			Type = SelfBuffProvider
			BuffType = SW_DeathStarBeam
			ChainsFromBuffType = SW_DeathStar
			BuffAmount = { BaseValue=0; BuffType=SW_DeathStar; BuffMode=Add; }
		}

		CommandToggle
		{
			Type = CommandToggle
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = PowerToggle
			CommandPoints = 4
		}

		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 40000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			ResupplyThreshold = 500
			OperationalToggle = PowerToggle
		}
/*
		WeaponTrigger
		{
			Type = TriggerProxy
			PartLocation = [0, -1]
			PartCriteria
			{
				Category = deathstar_power
				Rot = 0
				Left = 0
				Right = 4
				Bottom = 0
			}
			ComponentID = Weapon
		}

		EmitTrigger
		{
			Type = TriggerProxy
			PartLocation = [0, -1]
			PartCriteria
			{
				Category = deathstar_power
				Rot = 0
				Left = 0
				Right = 4
				Bottom = 0
			}
			ComponentID = BeamEmitter
		}
*/
		Weapon
		{
			Type = FixedWeapon
			Location = [2, 0.5]// Relative to upper-left corner of unrotated part.
			Rotation = -90d// Relative to unrotated part.
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = .2
			AIFirepowerRating = &~/Part/StatsByCategory/0/Stats/DamageContinuousNear
			Emitter = BeamEmitter
			ChainFireToggleComponent = DeathStarBeamChainToggle
			ProhibitTargetPartsFilter = &FriendlyPrismFilter // Don't force fire on friendly ion prisms!
			SuppressShipWideExplicitTargetsWhenTargetingPartsFilter = &FriendlyPrismFilter
			SuppressDirectControlWhenTargetingPartsFilter = &FriendlyPrismFilter
			SuppressFirepowerEstimationWhenTargetingPartsFilter = &FriendlyPrismFilter
			AutoExplicitTargetPartsFilter = &FriendlyPrismFilter
			SaveSelfTargetPartCategories = [SW_DeathStar_Beam_Prism]
			FirePermissionToggle = FireModeToggle

			FriendlyPrismFilter
			{
				Enemies = false
				Junk = false
				OnlyPartCategories = [SW_DeathStar_Beam_Prism]
			}

			AutoTarget
			{
				TargetType = ShipParts
				Toggle = AutoTargetToggle
			}

			CoverageLine
			{
				LineSprite
				{
					Texture = &/INDICATORS/RadialGradient
					VertexColor = [255, 255, 255, 191]
					UVRect = [.5, 0, 0, 1]
				}
				LineThickness = 2

				BeginCapSprite : LineSprite
				{
					UVRect = [0, 0, .5, 1]
				}
				BeginCapSize = [1, 2]

				EndCapSprite : LineSprite
				{
					UVRect = [.5, 0, .5, 1]
				}
				EndCapSize = [1, 2]
			}
		}

		BeamEmitter : &/SW_SHOTS/Beam/DeathStar
		{
			Type = BeamEmitter
			ChainedTo = Weapon
			FireTrigger = Weapon
			GetTargetFrom = Weapon
			OperationalToggle = IsOperational
			Duration = .5
			ResourceStorage = BatteryStorage
			ResourcesUsed = 250
			MinResourcesUsed = 1

			BeamMediaEffects : ^/0/BeamMediaEffects
			[
				/*
				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./Data/shots/ion_beam/ion_beam_emit.wav"
					Volume = 1
					MaxConcurrent = 1
					MaxConcurrentVolume = 1
					RampUpTime = .25
					RampDownTime = .25
				}
				*/
			]
		}

		Graphics
		{
			Type = Graphics
			Location = [2, 2]
			OperationalToggle = IsOperational
			DoodadToggle = BatteryStorage

			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [4, 4]
					}
					{
						File = "floor_33.png"
						Size = [4, 4]
					}
					{
						File = "floor_66.png"
						Size = [4, 4]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [4, 4]
					}
					{
						File = "walls_33.png"
						Size = [4, 4]
					}
					{
						File = "walls_66.png"
						Size = [4, 4]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "doodads.png"
						Size = [4, 4]
					}
					{
						File = "doodads_33.png"
						Size = [4, 4]
					}
					{
						File = "doodads_66.png"
						Size = [4, 4]
					}
				]
			}
			NonOperationalDoodad = &OperationalDoodad

			ToggleOnDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "lights_on.png"
						Size = [4, 4]
					}
				]
			}
			ToggleOffDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "lights_off.png"
						Size = [4, 4]
					}
				]
			}
			/*
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [4, 4]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [4, 4]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [4, 4]
					}
				]
			}*/
		}

		OperatingHum
		{
			Type = ContinuousEffects
			Location = [2, 1.5]
			OperationalToggle = IsOperational
			MaxMediaEffectsZoom = 4
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					Sound = "operating.wav"
					Volume = .2
					Speed = 2
					MaxConcurrent = 1
					MaxConcurrentVolume = .2
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [2, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [2, 2]
		}

		RecursiveDeath
		{
			Type = DeathEffects
			Location = [2, -.5]

			HitEffects
			[
				{
					Type = AreaDamage
					Damage = 3000
					Radius = .6
					Falloff = 0
					Delay = .15
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
			]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [2, 2]
			Indicators
			[
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [2.0, 2.0]
					}
					HidesIndicators = [2]
				}

				// Missing component
				{
					Toggle = DeathStarReverseOperationBuffToggle
					ShowInBuildMode = true
					AtlasSprite
					{
						File = &/INDICATORS/MissingComponent
						Size = [1.5, 1.5]
					}
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					Delay = &~/Part/Components/Weapon/FireInterval
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1.5, 1.5]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [4, 4]
		}
	}

	Stats
	{
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000

		RecPower = &../StatsByCategory/0/Stats/PowerUsageContinuous
		RecCrew = (&RecPower) * 4
	}

	StatsByCategory
	[
		{
			NameKey = "StatCategories/DeathStarBeam"
			Stats
			{
				BaseDamage = &~/Part/Components/BeamEmitter/HitOperational/HitEffects/0/Damage/BaseValue
				DamagePerShotNear = (&BaseDamage) * (&~/Part/Components/BeamEmitter/HitEffectsScaleOverRange/0)
				DamagePerShotFar = (&BaseDamage) * (&~/Part/Components/BeamEmitter/HitEffectsScaleOverRange/1)
				HitInterval = &~/Part/Components/BeamEmitter/HitInterval
				DamageContinuousNear = (&DamagePerShotNear) / (&HitInterval)
				DamageContinuousFar = (&DamagePerShotFar) / (&HitInterval)
				Range = &~/Part/Components/BeamEmitter/Range
				Arc = 0
				ShotSpeed = Infinity
				PowerPerShot = (&~/Part/Components/BeamEmitter/ResourcesUsed) / 1000
				PowerUsageContinuous = (&PowerPerShot) / (&~/Part/Components/Weapon/FireInterval)
			}
		}
	]

	StatsNotesKey = "Stats/DeathstarBeamNotes"
}
Size = Huge