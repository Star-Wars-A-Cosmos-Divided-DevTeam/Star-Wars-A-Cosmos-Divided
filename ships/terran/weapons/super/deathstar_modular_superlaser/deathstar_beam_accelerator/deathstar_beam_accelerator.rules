Part : &<./Data/ships/terran/base_part_terran.rules>/Part
{
	//IDs
	ID = SW.deathstar_beam_accelerator
	//OtherIDs = [deathstar_beam_accelerator]

	//StringKeys
	NameKey = "Parts/DeathstarBeamAccelerator"
	IconNameKey = "Parts/DeathstarBeamAcceleratorIcon"
	DescriptionKey = "Parts/DeathstarBeamAcceleratorDesc"
	//Groups&Categories
	EditorGroups = ["WeaponsEnergy", "SWTechIII"]
	TypeCategories = [weapon, uses_power, SW_DeathStar, SW_DeathStar_Beam_Accelerator]
	RequiresCategories = [SW_Bridge]

	//Resources&Size&Health
	Resources
	[
		[steel, 128]
		[coil2, 15]
		[diamond, 1]
	]
	Size = [4, 4]
	MaxHealth = 16000

	//Rects

	//Selections
	SelectionPriority = 1
	SelectionTypeID = "SW_deathstar_beam_acccelerator"
	SelectionTypeByRotation = true

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronBuff, SW_DeathStar, SW_DeathStarOperation, SW_DeathStarReverseOperation]

	//PartSpecific
	Density = 2.4
	GenerateRectCollider = false
	ForceManhattanPathInPart = true
	HasNonContiguousPathing = true

	//Doors&Etc
	AllowedDoorLocations
	[
		[-1, 0]
		[-1, 1]
		[-1, 2]
		[-1, 3]
		[4, 0]
		[4, 1]
		[4, 2]
		[4, 3]
	]
	BlockedTravelCells
	[
		[1, 0]
		[2, 0]
		[1, 1]
		[2, 1]
		[1, 2]
		[2, 2]
		[1, 3]
		[2, 3]
	]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [36, 36]
	}

	Components : ^/0/Components
	{
		ColliderLeft
		{
			Type = PolygonCollider
			Vertices
			[
				[0, 0]
				[1, 0]
				[1, 4]
				[0, 4]
			]
			Density = 4.8
		}
		ColliderRight
		{
			Type = PolygonCollider
			Vertices
			[
				[3, 0]
				[4, 0]
				[4, 4]
				[3, 4]
			]
			Density = 4.8
		}

		BuffUPOperational
		{
			Type = MultiToggle
			Toggles = [DeathstarOperationBuffToggle]
			Mode = All
		}
		BuffDOWNOperational
		{
			Type = MultiToggle
			Toggles = [DeathstarReverseOperationBuffToggle]
			Mode = All
		}
		IsOperational
		{
			Type = MultiToggle
			Toggles = [DeathstarOperationBuffToggle, DeathstarReverseOperationBuffToggle]
			Mode = All
		}

		DeathStarBuffToggle
		{
			Type = BuffToggle
			BuffType = SW_DeathStar
		}

		DeathStarOperationBuffToggle
		{
			Type = BuffToggle
			BuffType = SW_DeathStarOperation
		}

		DeathstarReverseOperationBuffToggle
		{
			Type = BuffToggle
			BuffType = SW_DeathstarReverseOperation
		}

		DeathStarOperationBuffProvider //Buffing UP -> PRISM
		{
			Type = AreaBuffProvider
			BuffType = SW_DeathStarOperation
			BuffArea = [0, -1, 4, 1]
			OperationalToggle = DeathStarOperationBuffToggle
			ChainsFromBuffType = SW_DeathStarOperation
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 4
				Bottom = 0
			}
		}

		ReverseOperationBuffProvider // Buffing DOWN <- PRISM
		{
			Type = AreaBuffProvider
			BuffType = SW_DeathStarReverseOperation
			BuffArea = [0, 4, 4, 1]
			OperationalToggle = DeathstarReverseOperationBuffToggle
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 4
				Top = 4
			}
			ShowBuffRange = true //DEBUG
		}

		DeathStarBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = SW_DeathStar
			BuffAmount = { BaseValue=1; BuffType=SW_DeathStar; BuffMode=Add; }
			BuffArea = [0, 4, 4, 1]
			OperationalToggle = DeathStarBuffToggle
			ChainsFromBuffType = SW_DeathStar
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 4
				Top = 4
			}
		}

		/* PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		} */
		PowerToggle
		{
			Type = ToggleProxy
			PartLocation = [0, 4]
			ComponentID = PowerToggle
			PartCriteria
			{
				Category = SW_DeathStar
				Rot = 0
				Left = 0
				Right = 4
				Top = 4
			}
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = PowerToggle
			CommandPoints = 4
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 40000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			ResupplyThreshold = 500
			OperationalToggle = PowerToggle
		}

		Graphics
		{
			Type = Graphics
			Location = [2, 2]
			OperationalToggle = IsOperational
			//DoodadToggle = BeamEmitter
			//ShowToggledDoodadsWhenNotOperational = false

			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [4, 4]
					}
					{
						File = "floor_33.png"
						Size = [4, 4]
					}
					{
						File = "floor_66.png"
						Size = [4, 4]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [4, 4]
					}
					{
						File = "walls_33.png"
						Size = [4, 4]
					}
					{
						File = "walls_66.png"
						Size = [4, 4]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [4, 4]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [4, 4]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [4, 4]
					}
				]
			}
		}

		OperatingHum
		{
			Type = ContinuousEffects
			Location = [2, 2]
			OperationalToggle = IsOperational
			MaxMediaEffectsZoom = 4
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					Sound = "../deathstar_beam_emitter/operating.wav"
					Volume = .2
					Speed = 2
					MaxConcurrent = 1
					MaxConcurrentVolume = .2
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [2, 2]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [2, 2]
		}

		RecursiveDeath1
		{
			Type = DeathEffects
			Location = [2, -.5]

			HitEffects
			[
				{
					Type = AreaDamage
					Damage = 3000
					Radius = .6
					Falloff = 0
					Delay = .15
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
			]
		}

		RecursiveDeath2 : RecursiveDeath1
		{
			Location = [1, 4.5]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [2, 2]
			Indicators
			[
				// Missing component
				{
					Toggle = DeathStarOperationBuffToggle
					ShowInBuildMode = true
					AtlasSprite
					{
						File = &/INDICATORS/MissingComponent
						Size = [1.5, 1.5]
					}
					HidesIndicators = [2,3]
				}
				// Missing component
				{
					Toggle = DeathStarReverseOperationBuffToggle
					ShowInBuildMode = true
					AtlasSprite
					{
						File = &/INDICATORS/MissingComponent
						Size = [1.5, 1.5]
					}
					HidesIndicators = [2,3]
				}
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [2.0, 2.0]
					}
					HidesIndicators = [3]
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					Delay = 0.2
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1.5, 1.5]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [4, 4]
		}
	}

	Stats
	{
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000

		RecPower = (&<../deathstar_beam_emitter/deathstar_beam_emitter.rules>/Part/Stats/RecPower)
		RecCrew = (&RecPower) * 2
	}

	StatsByCategory
	[
		{
			NameKey = "StatCategories/DeathStarBeamBuff"
			Stats
			{
				/*Multiplier = (&<./Data/buffs/buffs.rules>/DeathStarBeam/Multiplier) * 100
				Exponent = (&<./Data/buffs/buffs.rules>/DeathStarBeam/Exponent)
				BaseValue = ((&<./Data/buffs/buffs.rules>/DeathStarBeam/BaseValue) - 1) * 100
				DeathStarBeamBuff
				[
					(&../BaseValue) + (&../Multiplier) * (1 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (2 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (3 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (4 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (5 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (6 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (7 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (8 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (9 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (10 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (11 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (12 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (13 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (14 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (15 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (16 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (17 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (18 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (19 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (20 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (21 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (22 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (23 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (24 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (25 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (26 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (27 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (28 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (29 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (30 ^ (&../Exponent))
				]*/
			}
		}
	]
}
Size = Huge