OVERCLOCK
{
	BULLET  = &<../../../../../shots/laser/turret/turbo/CIS/overclock/oc_base_shot.rules>

	//BLUEBULLET  = &<../../../../../shots/laser/turret/turbo/CIS/overclock/oc_blue_shot.rules>
	//GREENBULLET = &<../../../../../shots/laser/turret/turbo/CIS/overclock/oc_green_shot.rules>
	REDBULLET   = &<../../../../../shots/laser/turret/turbo/CIS/overclock/oc_red_shot.rules>

	// Rate-of-fire scaler
	FIRE_RATE_FACTOR = 125%
	POWER_USE_FACTOR = 175%

	// OC spread/recoil modifiers
	HALF_SPREAD   = (&~/Part/Components/NonOverclockedComponents/Components/EmitterBase/Spread/1) * 3
	RECOIL_FACTOR = 150%

	// Heat hookup
	HEAT_PER_SHOT   = 650
	HEAT_PER_SECOND = 100

	// Stun scaling
	//CREW_STUN_DURATION = ((&~/Part/Components/StunEffect/HitEffects/0/Duration/BaseValue) * 3)
	//CREW_STUN_RADIUS   = ((&~/Part/Components/StunEffect/HitEffects/0/Radius/BaseValue) * 3)
}

// Heat Producers
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS   = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

// Resources Used
RESOURCES_USED = 500

// Max Resources
BASE_MAX_RESOURCES = 20000 //(&~/BASE_MAX_RESOURCES)

// Shot Timer
BASE_SHOT_INTERVAL = 1.15 // (&~/BASE_SHOT_INTERVAL)

Part : &<../base_part_terran_turbolasers_overclock.rules>/Part
{	
	//IDs
	ID = SW.cis_turbolaser_switchable
	OtherIDs = ["cis_turbolaser", "cis_turbolaser2"]

	//StringKeys
	NameKey = "Parts/CISturbolaserswitchable"
	IconNameKey = "Parts/CISturbolaserswitchableIcon"
	DescriptionKey = "Parts/CISturbolaserswitchableDesc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups ["WeaponsEnergy", SWTechIII]
	TypeCategories : ^/0/TypeCategories [weapon, uses_power, is_crewed]
	SignificanceToggle = ScorchedToggle
	RequiresCategories = [SW_Bridge]

	//Resources&Size&Health
	Resources
	[
		[steel, 128] //4*4*8*2
		[coil, 72] //[2, 5] takes 36
		[coil2, 8] //some extra
	]
	Size = [4, 4]
	MaxHealth = 42000  

	//Rects

	//Selections
	SelectionPriority = 1
	SelectionTypeByRotation = true
	SelectionTypeID = "turbolasers"

	//PartSpecific
	AIValueFactor = 2
	InitialPenetrationResistance = 5

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronBuff]

	//Doors&Etc
	AutoDoorMaxPathLength = 8
	MaxDoors = 4
	AllowedDoorLocations
	[
		[-1, 2]
		[-1, 3]
		[0, 4]
		[1, 4]
		[2, 4]
		[3, 4]
		[4, 3]
		[4, 2]
	]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "CIS/icon_separatist_a.png"
			SampleMode = Linear
		}
		Size = [100, 80]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		IsOperational : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [PowerToggle, PartCrew, BatteryStorage, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 12 //cannon_deck takes 8???
		}

		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}

		FireAlternatingToggle
		{
			Type = UIToggle
			ToggleID = "fire_alternating"
			Default = 0
			AvailableChoices = [0/*, 1*/]
		}

		IsFireSynchronised_NonOverclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, IsOverclocked ]
			// ON when Alternating is OFF and Overclock is OFF
			Mode = None
		}
		IsFireSynchronised_Overclock
		{
			Type = MultiToggle
			Toggles = [ {Toggle=FireAlternatingToggle; Invert=true}, IsOverclocked ]
			// ON when Alternating is OFF and Overclock is ON
			Mode = All
		}
		IsFireAlternating_NonOverclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, {Toggle=IsOverclocked; Invert=true} ]
			// ON when Alternating is ON and Overclock is OFF
			Mode = All
		}
		IsFireAlternating_Overclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, IsOverclocked ]
			// ON when Alternating is ON and Overclock is ON
			Mode = All
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = (&~/BASE_MAX_RESOURCES)
			ReceiveResourceMediaEffects = &/SW_SOUNDS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			ResupplyThreshold = 2000
			OperationalToggle = CommandConsumptionToggle
		}
		//OverclockSettings
		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero	{ Type = StaticValue; Value = 0; }
		One 	{ Type = StaticValue; Value = 1; }

		OverheatEffects : ^/0/OverheatEffects
		{
			Location = [2, 2]
		}

		Overclock_ShotHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_EmissionTriggered
			Amount = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
		}

		Port_Thermal_TopLeft : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 0]
			Direction = Left
		}

		Port_Thermal_LeftUp : Port_Thermal_TopLeft
		{
			Direction = Up
		}

		Port_Thermal_TopRight : Port_Thermal_LeftUp
		{
			Location = [3, 0]
			Direction = Right
		}

		Port_Thermal_RightUp : Port_Thermal_TopRight
		{
			Direction = Up
		}

		Port_Thermal_MidUp1 : Port_Thermal_RightUp
		{
			Location = [1, 0]
		}

		Port_Thermal_MidUp2 : Port_Thermal_MidUp1
		{
			Location = [2, 0]
		}

		Port_Thermal_MidRight1 : Port_Thermal_MidUp2
		{
			Location = [3, 1]
			Direction = Right
		}

		Port_Thermal_MidLeft1 : Port_Thermal_MidRight1
		{
			Location = [0, 1]
			Direction = Left
		}
/* forgot this one ???
		Overclock_ConstantHeatProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperationalOverclocked
			HEAT_PER_INTERVAL = ceil((&~/OVERCLOCK/HEAT_PER_SECOND) * (&Interval))
			ToQuantity = (&HEAT_PER_INTERVAL) * (&~/HEAT_TO_RESOURCE)
			ToStorage  = &~/Part/^/0/HEAT_TARGET_STORAGE
			Interval = 0.5
		}
*/
		MunitionType
		{
			Type = UIToggle
			ToggleID = "SW.munition_type"
			Default = 0
			AvailableChoices = [0/*, 1, 2*/]
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}
		RedMunitionToggle
		{
			Type = ModeToggle
			Mode = MunitionType
			OnMode = 0
		}

		ExteriorType
		{
			Type = UIToggle
			ToggleID = "SW.exterior_type"
			Default = 0
			ToggledOnChoices = [0,1]
		}

		WhiteExteriorToggle
		{
			Type = ModeToggle
			Mode = ExteriorType
			OnMode = 0
		}
		WhiteExteriorComponents
		{
			Type = ToggledComponents
			Toggle = WhiteExteriorToggle
			IncludeInBlueprints = true
			Components
			{
				WeaponSprite
				{
					Type = Sprite
					ChainedTo = Turret
					Location = [1, 0]
					Rotation = 90d
					Layer = "roof_turrets"
					ResetAnimationTrigger = Turret
					AtlasSprite
					{
						AnimationFiles
						[
							"CIS/barrel_Separatist_A2.png"
							"CIS/barrel_Separatist_A3.png"
							"CIS/barrel_Separatist_A1.png"
						]
						NormalsAnimationFiles
						[
							"CIS/barrel_Separatist_A2_normals.png"
							"CIS/barrel_Separatist_A3_normals.png"
							"CIS/barrel_Separatist_A1_normals.png"
						]
						Size = [4, 5]
						AnimationInterval = 0.18
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
				}
			}
		}

		GreyExteriorToggle
		{
			Type = ModeToggle
			Mode = ExteriorType
			OnMode = 1
		}
		GreyExteriorComponents
		{
			Type = ToggledComponents
			Toggle = GreyExteriorToggle
			IncludeInBlueprints = true
			Components
			{
				WeaponSprite
				{
					Type = Sprite
					ChainedTo = Turret
					Location = [1, 0]
					Rotation = 90d
					Layer = "roof_turrets"
					ResetAnimationTrigger = Turret
					AtlasSprite
					{
						AnimationFiles
						[
							"CIS/barrel_Separatist_B2.png"
							"CIS/barrel_Separatist_B3.png"
							"CIS/barrel_Separatist_B1.png"
						]
						NormalsAnimationFiles
						[
							"CIS/barrel_Separatist_A2_normals.png"
							"CIS/barrel_Separatist_A3_normals.png"
							"CIS/barrel_Separatist_A1_normals.png"
						]
						Size = [4, 5]
						AnimationInterval = 0.18
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
				}
			}
		}

		Graphics
		{
			Type = Graphics
			Location = [2,2]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [4,4]
					}
					{
						File = "floor_33.png"
						Size = [4,4]
					}
					{
						File = "floor_66.png"
						Size = [4,4]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights5.png"
						Size = [4,4]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [4,4]
					}
					{
						File = "walls_33.png"
						Size = [4,4]
					}
					{
						File = "walls_66.png"
						Size = [4,4]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [4, 4]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [4, 4]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [4, 4]
					}
				]
			}
		}

		TurretInsideGraphics
		{
			Type = Graphics
			OperationalToggle = IsOperational
			Location = [0,0]
			ChainedTo = Turret
			Rotation = 90d
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights4.png"
						Size = [1.625, 1.125]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"console on1.png"
							"console on2.png"
							"console on3.png"
						]
						Size = [4, 4]
						AnimationInterval = 0.50
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "console off.png"
						Size = [4,4]
					}
				]
			}
		}

		TurretGhostGraphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [1, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "CIS/barrel_shadow.png"
						Size = [6, 5]
					}
				]
			}
		}

		Turret
		{
			Type = TurretWeapon
			Location = [2, 2]
			Rotation = -90d															// Relative to unrotated part.													// Relative to unrotated part.
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = 0														// Uses separate common fire timer.
			FirePermissionToggle = FirePermissionToggle
			FiringArc = 210d														//v: 190d
			RotateSpeed = 24d														//v: 45d
			FireThresholdAngle = 1d
			AIFirepowerRating = &~/Part/StatsByCategory/1/Stats/DamagePerSecond
			Emitter = EmitterBaseProxy												// Doesn't actually fire; only used for targeting.
			HoldTargetAfterCancel = &../NonOverclockedComponents/Components/EmitterBase/FireDelay
			AutoTargetCrewSafetyDist = 8
			IgnoreSourceShipLowLOSChecks = true
			IgnoreFriendlyShipLowLOSChecks = true

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}

		ShootSynchronizedComponents
		{
			Type = ToggledComponents
			Toggle = FireAlternatingToggle
			Invert = true
			Components
			{
				ShootLeftTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}

				ShootLeft2Trigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}

				ShootRightTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}

				ShootRight2Trigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
			}
		}

		ShootSynchronizedComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = IsFireSynchronised_NonOverclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					Duration = (&~/BASE_SHOT_INTERVAL)*2  //1.35*2
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}
			}
		}
		ShootSynchronizedComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = IsFireSynchronised_Overclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					DURATION_BASE = (&~/Part/Components/ShootSynchronizedComponents_NonOverclocked/Components/FireTimer/Duration)
					Duration = (&DURATION_BASE) / (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}
			}
		}

		ShootAlternatingComponents
		{
			Type = ToggledComponents
			Toggle = FireAlternatingToggle
			Components
			{
				ShootCycle
				{
					Type = ModeCycle
					ModeRange = [0, 3]
					IncrementTrigger = Turret
					StartingMode = 3 // First shot will switch to mode 0.
				}

				ShootLeftTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [0]
				}

				ShootLeft2Trigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [1]
				}

				ShootRightTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [2]
				}

				ShootRight2Trigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [3]
					OperationalToggle = FireAlternatingToggle
				}
			}
		}
		ShootAlternatingComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = IsFireAlternating_NonOverclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					Duration = (&~/BASE_SHOT_INTERVAL) //1.35
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}
			}
		}
		ShootAlternatingComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = IsFireAlternating_Overclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					DURATION_BASE = (&~/Part/Components/ShootAlternatingComponents_NonOverclocked/Components/FireTimer/Duration)
					Duration = (&DURATION_BASE) / (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}
			}
		}

		FireTimerProxy
		{
			Type = ToggleProxy
			ComponentID = FireTimer
		}
		FirePermissionToggle
		{
			Type = MultiToggle
			Toggles = [FireTimerProxy, FireModeToggle]
			Mode = All
		}

		ShootLeftTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = ShootLeftTrigger
		}
		ShootLeftTriggerProxy_Overclocked : ShootLeftTriggerProxy
		{
			ProxyToggle = IsOverclocked
		}
		ShootLeftTriggerProxy_NonOverclocked : ShootLeftTriggerProxy_Overclocked
		{
			InvertProxyToggle = true
		}

		ShootLeft2TriggerProxy
		{
			Type = TriggerProxy
			ComponentID = ShootLeft2Trigger
		}
		ShootLeft2TriggerProxy_Overclocked : ShootLeft2TriggerProxy
		{
			ProxyToggle = IsOverclocked
		}
		ShootLeft2TriggerProxy_NonOverclocked : ShootLeft2TriggerProxy_Overclocked
		{
			InvertProxyToggle = true
		}

		ShootRightTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = ShootRightTrigger
		}
		ShootRightTriggerProxy_Overclocked : ShootRightTriggerProxy
		{
			ProxyToggle = IsOverclocked
		}
		ShootRightTriggerProxy_NonOverclocked : ShootRightTriggerProxy_Overclocked
		{
			InvertProxyToggle = true
		}

		ShootRight2TriggerProxy
		{
			Type = TriggerProxy
			ComponentID = ShootRight2Trigger
		}
		ShootRight2TriggerProxy_Overclocked : ShootRight2TriggerProxy
		{
			ProxyToggle = IsOverclocked
		}
		ShootRight2TriggerProxy_NonOverclocked : ShootRight2TriggerProxy_Overclocked
		{
			InvertProxyToggle = true
		}

		// Bullet emitters
		NonOverclockedComponents
		{
			Type = ToggledComponents
			Toggle = IsOverclocked
			Invert = true
			IncludeInBlueprints = true
			Components
			{
				EmitterBase // Doesn't actually fire; only used for targeting and as a base for the left and right emitters.
				{
					Type = BulletEmitter
					ChainedTo = Turret
					FireTrigger // none, but field is required
					GetTargetFrom = Turret
					Location = [2.567, 0]
					OperationalToggle = IsOperational
					FireDelay = .15
					Bullet = &/SW_SHOTS/Laser/Turret/Turbo/CIS/Red
					ResourceStorage = BatteryStorage
					ResourcesUsed = &~/RESOURCES_USED
					MinResourcesUsed = 1
					Recoil = 200
					AntiPhasingRaycastDistance = 2
					TargetLeadPrediction = true
					Spread = [-3.0d, 3.0d]
				}

        		EmitterLeft : EmitterBase
        		{
        			FireTrigger = ShootLeftTriggerProxy
        			Location = [2.567, -1.151]
        		}

        		EmitterLeft2 : EmitterBase
        		{
        			FireTrigger = ShootLeft2TriggerProxy
        			Location = [2.55, -1.150]
        		}

        		EmitterRight : EmitterBase
        		{
        			FireTrigger = ShootRightTriggerProxy
        			Location = [2.55, 1.150]
        		}

        		EmitterRight2 : EmitterBase
        		{
        			FireTrigger = ShootRight2TriggerProxy
        			Location = [2.567, 1.151]
        		}
			}
		}

		OverclockedComponents
		{
			Type = ToggledComponents
			Toggle = IsOverclocked
			Components
			{
				// Doesn't actually fire; only used for targeting and as a base for the left and right emitters.
				EmitterBase : ~/Part/Components/NonOverclockedComponents/Components/EmitterBase
        		{
        			Type = BulletEmitter
        			Bullet = &~/OVERCLOCK/BLUEBULLET
        			ResourceStorage = BatteryStorage
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
        			ResourcesUsed = floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
        		}

        		EmitterLeft : EmitterBase
        		{
        			FireTrigger = ShootLeftTriggerProxy
        			Location = [2.567, -1.151]
        		}

        		EmitterLeft2 : EmitterBase
        		{
        			FireTrigger = ShootLeft2TriggerProxy
        			Location = [4.75, -1.151]
        		}

        		EmitterRight : EmitterBase
        		{
        			FireTrigger = ShootRightTriggerProxy
        			Location = [2.567, 1.151]
        		}

				EmitterRight2 : EmitterBase
				{
					FireTrigger = ShootRight2TriggerProxy
					Location = [4.75, 1.151]
				}
			}
		}

		EmitterBaseProxy
		{
			Type = EmitterProxy
			ComponentID = EmitterBase
			ChainedTo = Turret
			Location = &../NonOverclockedComponents/Components/EmitterBase/Location
		}
		EmitterLeftProxy_NonOverclocked : EmitterBaseProxy
		{
			ComponentID = EmitterLeft
			ProxyToggle = IsOverclocked
			InvertProxyToggle = true
			Location = &../NonOverclockedComponents/Components/EmitterLeft/Location
		}
		EmitterLeft2Proxy_NonOverclocked : EmitterBaseProxy
		{
			ComponentID = EmitterLeft2
			ProxyToggle = IsOverclocked
			InvertProxyToggle = true
			Location = &../NonOverclockedComponents/Components/EmitterLeft2/Location
		}
		EmitterRightProxy_NonOverclocked : EmitterBaseProxy
		{
			Type = EmitterProxy
			ProxyToggle = IsOverclocked
			InvertProxyToggle = true
			ComponentID = EmitterRight
			Location = &../NonOverclockedComponents/Components/EmitterRight/Location
		}
		EmitterRight2Proxy_NonOverclocked : EmitterBaseProxy
		{
			Type = EmitterProxy
			ProxyToggle = IsOverclocked
			InvertProxyToggle = true
			ComponentID = EmitterRight2
			Location = &../NonOverclockedComponents/Components/EmitterRight2/Location
		}
		EmitterLeftProxy_Overclocked : EmitterLeftProxy_NonOverclocked
		{
			InvertProxyToggle = false
		}
		EmitterLeft2Proxy_Overclocked : EmitterLeft2Proxy_NonOverclocked
		{
			InvertProxyToggle = false
		}
		EmitterRightProxy_Overclocked : EmitterRightProxy_NonOverclocked
		{
			InvertProxyToggle = false
		}
		EmitterRight2Proxy_Overclocked : EmitterRight2Proxy_NonOverclocked
		{
			InvertProxyToggle = false
		}
		Overclock_EmissionTriggered
		{
			Type = MultiTrigger
			OperationalToggle = IsOverclocked
			Triggers = [ EmitterLeftProxy_Overclocked, EmitterRightProxy_Overclocked, EmitterLeft2Proxy_Overclocked, EmitterRight2Proxy_Overclocked ]
		}

		ChargeEffectLeft_NonOverclocked
		{
			Type = TriggeredEffects
			ChainedTo = EmitterLeftProxy_NonOverclocked
			Trigger = ShootLeftTriggerProxy_NonOverclocked
			AnchorMediaEffects = true

			MediaEffects
			[
				&/SW_SOUNDS/LaserReCharge
			]
		}
		ChargeEffectLeft_Overclocked : ChargeEffectLeft_NonOverclocked
		{
			Trigger = ShootLeftTriggerProxy_Overclocked
			MediaEffects
			[
				&/SW_SOUNDS/LaserReCharge
			]
		}

		ChargeEffectLeft2_NonOverclocked
		{
			Type = TriggeredEffects
			ChainedTo = EmitterLeft2Proxy_NonOverclocked
			Trigger = ShootLeft2TriggerProxy_NonOverclocked
			AnchorMediaEffects = true

			MediaEffects
			[
				&/SW_SOUNDS/LaserReCharge
			]
		}
		ChargeEffectLeft2_Overclocked : ChargeEffectLeft2_NonOverclocked
		{
			Trigger = ShootLeft2TriggerProxy_Overclocked
			MediaEffects
			[
				&/SW_SOUNDS/LaserReCharge
			]
		}

		ChargeEffectRight_NonOverclocked : ChargeEffectLeft_NonOverclocked
		{
			ChainedTo = EmitterRightProxy_NonOverclocked
			Trigger = ShootRightTriggerProxy_NonOverclocked
		}
		ChargeEffectRight_Overclocked : ChargeEffectRight_NonOverclocked
		{
			Trigger = ShootRightTriggerProxy_Overclocked
			MediaEffects = &~/Part/Components/ChargeEffectLeft_Overclocked/MediaEffects
