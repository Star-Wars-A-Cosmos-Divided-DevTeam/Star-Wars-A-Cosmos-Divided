		OperationEffects
		{
			Type = ToggleEffects
			Location = [2, 2]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOnLarge
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOffLarge
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/BigPartScorched
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [2, 2]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [2, 2]
			Indicators
			[
				// 0 Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3,4]
				}
				// 1 Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2,3,4]
				}
				// 2 Out of power.
				{
					Toggle = BatteryStorage
					Delay = &~/Part/Components/ShootSynchronizedComponents_NonOverclocked/Components/FireTimer/Duration
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
				// 3 Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
					HidesIndicators = [4]
				}
				// 4 No crew.
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [4, 4]
		}

		PeakHeatGenerationValue
		{
			Type = StaticValue
			SHOT_HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/Part/SecondaryToolTip/StatsByCategory/0/Stats/ROF)
			Value = (&~/OVERCLOCK/HEAT_PER_SECOND) + (&SHOT_HEAT_PER_SECOND)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationValue
		}
	}

   //Stats 
	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		TurretPenResist = &~/Part/Components/TurretCollider/InitialPenetrationResistance

		RecPower = &../StatsByCategory/1/Stats/PowerPerSecond
		RecCrew = (&CrewRequired) + (&RecPower) * 4
	}

	StatsByCategory
	[
		&~/TurretStats
		{
			NameKey = "StatCategories/CISLasershot"
			Stats
			{
				DamagePerShot = &~/EMITTER_BASE/Bullet/Components/Hit/HitOperational/HitEffects/0/Damage/BaseValue
				DamagePerSecond = (&DamagePerShot) * (&ROF)
				Damage = [&../DamagePerShot, &../DamagePerSecond]
				ShieldDamagePerShot = &~/EMITTER_BASE/Bullet/Components/Hit/HitShield/HitEffects/0/Damage/BaseValue
				ShieldDamagePerSecond = (&ShieldDamagePerShot) * (&ROF)
				ShieldDamage = [&../ShieldDamagePerShot, &../ShieldDamagePerSecond]
				ROF = 1 / (&~/Part/Components/ShootAlternatingComponents_NonOverclocked/Components/FireTimer/Duration)
				Range = &~/EMITTER_BASE/Bullet/Range
				Arc = deg(&~/Part/Components/Turret/FiringArc)
				TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
				ShotSpeed = &~/EMITTER_BASE/Bullet/Speed
				ShotHP = &~/EMITTER_BASE/Bullet/Components/Targetable/Health
				PowerPerShot = (&~/EMITTER_BASE/ResourcesUsed) / 1000
				PowerPerSecond = (&PowerPerShot) * (&ROF)
				ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
			}
		}
	]
	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/CISturbolaserswitchableOverclockDesc"
		StatsByCategory
		[
			{
				NameKey = "StatCategories/CISLasershotOverclocked"
				Stats
				{
					DamagePerShot = &~/OVERCLOCK/BULLET/DAMAGE
					DamagePerSecond = (&DamagePerShot) * (&ROF)
					Damage = [&../DamagePerShot, &../DamagePerSecond]
					ShieldDamagePerShot = &~/OVERCLOCK/BULLET/DAMAGE_SHIELD
					ShieldDamagePerSecond = (&ShieldDamagePerShot) * (&ROF)
					ShieldDamage = [&../ShieldDamagePerShot, &../ShieldDamagePerSecond]
					DamageArea = &~/OVERCLOCK/BULLET/DAMAGE_RADIUS
					ROF = (&~/Part/StatsByCategory/1/Stats/ROF) * (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					HeatPerShot = (&~/OVERCLOCK/HEAT_PER_SHOT)
					PowerPerShot = (&~/EMITTER_BASE_OVERCLOCK/ResourcesUsed) / 1000
					PowerPerSecond = (&PowerPerShot) * (&ROF)
					ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
					ShotHP = &~/OVERCLOCK/BULLET/HEALTH
				}
			}
		]
	}
}
TurretStats
{
	NameKey = "StatCategories/Turret"
	Stats
	{
		Barrels = 4
		ROF = 1 / (&~/Part/Components/ShootAlternatingComponents_NonOverclocked/Components/FireTimer/Duration)
		Range = &~/EMITTER_BASE/Bullet/Range
		Arc = deg(&~/Part/Components/Turret/FiringArc)
		TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
	}
}
TurretStatsOC
{
	NameKey = "StatCategories/TurretOC"
	Stats
	{
		Barrels = 2
		ROF = 1 / (&~/Part/Components/ShootAlternatingComponents_Overclocked/Components/FireTimer/Duration)
		Range = &~/EMITTER_BASE/Bullet/Range
		Arc = deg(&~/Part/Components/Turret/FiringArc)
		TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
	}
}

EMITTER_BASE = &~/Part/Components/NonOverclockedComponents/Components/EmitterBase
EMITTER_BASE_OVERCLOCK = &~/Part/Components/OverclockedComponents/Components/EmitterBase