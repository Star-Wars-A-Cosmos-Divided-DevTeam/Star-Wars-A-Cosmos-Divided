OVERCLOCK
{
	BULLET  = &<../../../../../shots/laser/turret/turbo/Republic/overclock/oc_base_shot.rules>

	BLUEBULLET  = &<../../../../../shots/laser/turret/turbo/Republic/overclock/oc_blue_shot.rules>
	//GREENBULLET = &<../../../../../shots/laser/turret/turbo/Republic/overclock/oc_green_shot.rules>
	//REDBULLET   = &<../../../../../shots/laser/turret/turbo/Republic/overclock/oc_red_shot.rules>

	// Rate-of-fire scaler (2 = twice as fast)
	FIRE_RATE_FACTOR = 50%
	POWER_USE_FACTOR = 200%

	// OC spread/recoil modifiers
	HALF_SPREAD   = (&~/Part/Components/WeaponEmitterBase/Spread/1) / 2
	RECOIL_FACTOR = 150%

	// Heat hookup
	HEAT_PER_SHOT   = 1000
	HEAT_PER_SECOND = 100

	// Stun scaling
	//CREW_STUN_DURATION = ((&~/Part/Components/StunEffect/HitEffects/0/Duration/BaseValue) * 3)
	//CREW_STUN_RADIUS   = ((&~/Part/Components/StunEffect/HitEffects/0/Radius/BaseValue) * 3)
}

// Heat Producers
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS   = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

// Resources Used
RESOURCES_USED 	= 1000

Part : &<../base_part_terran_turbolasers_overclock.rules>/Part
{	
	//IDs
	ID = SW.republic_turbolaser_switchable
	OtherIDs = ["republic_turbolaser","republic_turbolaser2"]

	//StringKeys
	NameKey = "Parts/Republicturbolaserswitchable"
	IconNameKey = "Parts/RepublicturbolaserswitchableIcon"
	DescriptionKey = "Parts/RepublicturbolaserswitchableDesc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups ["WeaponsEnergy", SWTechIII]
	TypeCategories : ^/0/TypeCategories [weapon, uses_power, is_crewed]
	SignificanceToggle = ScorchedToggle
	RequiresCategories = [SW_Bridge]

	//Resources&Size&Health
	Resources
	[
		[steel, 135]
		[coil, 75]
		[coil2, 10]
	]
	Size = [4, 4]
	MaxHealth = 42000  

	//Rects

	//Selections
	SelectionPriority = 1
	SelectionTypeByRotation = true
	SelectionTypeID = "turbolasers"

	//PartSpecific
	AIValueFactor = 2
	InitialPenetrationResistance = 5

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronBuff]

	//Doors&Etc
	AutoDoorMaxPathLength = 8
	MaxDoors = 4
	AllowedDoorLocations
	[
		[-1, 2]
		[-1, 3]
		[0, 4]
		[1, 4]
		[2, 4]
		[3, 4]
		[4, 3]
		[4, 2]
	]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "Republic/icon_republic_A.png"
			SampleMode = Linear
		}
		Size = [64, 80]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		IsOperational : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [PowerToggle, PartCrew, BatteryStorage, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 12 //cannon_deck takes 8???
		}

		WeaponEmitterProxy
		{
			Type = EmitterProxy
			ComponentID = WeaponEmitter
			ChainedTo = Turret
		}
		WeaponEmitter2Proxy : WeaponEmitterProxy
		{
			ComponentID = WeaponEmitter2
		}

		Overclock_EmissionTriggered
		{
			Type = MultiTrigger
			OperationalToggle = IsOverclocked
			Triggers = [ WeaponEmitterProxy, WeaponEmitter2Proxy ]
		}
		Overclock_ConstantHeatProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperationalOverclocked
			HEAT_PER_INTERVAL = ceil((&~/OVERCLOCK/HEAT_PER_SECOND) * (&Interval))
			ToQuantity = (&HEAT_PER_INTERVAL) * (&~/HEAT_TO_RESOURCE)
			ToStorage  = &~/Part/^/0/HEAT_TARGET_STORAGE
			Interval = 0.5
		}

		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}

		FireAlternatingToggle
		{
			Type = UIToggle
			ToggleID = "fire_alternating"
			Default = 0
		}

		MunitionType
		{
			Type = UIToggle
			ToggleID = "SW.munition_type"
			Default = 1
			AvailableChoices = [/*0,*/ 1/*, 2*/]
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}
		/*RedMunitionToggle
		{
			Type = ModeToggle
			Mode = MunitionType
			OnMode = 0
		}*/
		BlueMunitionToggle
		{
			Type = ModeToggle
			Mode = MunitionType
			OnMode = 1
		}
		/*GreenMunitionToggle
		{
			Type = ModeToggle
			Mode = MunitionType
			OnMode = 2
		}

		// ---- RED: Non-OC ----
		/*RedMunitionNonOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ RedMunitionToggle, {Toggle=IsOverclocked; Invert=true} ]
			Mode = All
		}
		RedMunitionComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = RedMunitionNonOC_Toggle
			IncludeInBlueprints = false
			Components = &<Republic/republic_turbolaser_switchable_red.rules>/Components
		}

		// ---- RED: OC ----
		RedMunitionOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ RedMunitionToggle, IsOverclocked ]
			Mode = All
		}
		RedMunitionComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = RedMunitionOC_Toggle
			IncludeInBlueprints = false
			Components : &<Republic/republic_turbolaser_switchable_red.rules>/Components
			{
				WeaponEmitter  : ^/0/WeaponEmitter
				{
					Bullet  = &~/OVERCLOCK/REDBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
        			ResourcesUsed = floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
				}
				WeaponEmitter2 : ^/0/WeaponEmitter2
				{
					Bullet  = &~/OVERCLOCK/REDBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
        			ResourcesUsed = floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
				}
			}
		}*/


		// ---- BLUE: Non-OC ----
		BlueMunitionNonOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ BlueMunitionToggle, {Toggle=IsOverclocked; Invert=true} ]
			Mode = All
		}
		BlueMunitionComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = BlueMunitionNonOC_Toggle
			IncludeInBlueprints = false
			Components = &<Republic/republic_turbolaser_switchable_blue.rules>/Components // TODO ensure blue components defined
		}

		// ---- BLUE: OC ----
		BlueMunitionOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ BlueMunitionToggle, IsOverclocked ]
			Mode = All
		}
		BlueMunitionComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = BlueMunitionOC_Toggle
			IncludeInBlueprints = false
			Components : &<Republic/republic_turbolaser_switchable_blue.rules>/Components
			{
				WeaponEmitter  : ^/0/WeaponEmitter
				{
					Bullet  = &~/OVERCLOCK/BLUEBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
        			ResourcesUsed = floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
				}
				WeaponEmitter2 : ^/0/WeaponEmitter2
				{
					Bullet  = &~/OVERCLOCK/BLUEBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
        			ResourcesUsed = floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
				}
			}
		}

		// ---- GREEN: Non-OC ----
		/*GreenMunitionNonOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ GreenMunitionToggle, {Toggle=IsOverclocked; Invert=true} ]
			Mode = All
		}
		GreenMunitionComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = GreenMunitionNonOC_Toggle
			IncludeInBlueprints = false
			Components = &<Republic/republic_turbolaser_switchable_green.rules>/Components // TODO ensure green components defined
		}

		// ---- GREEN: OC ----
		GreenMunitionOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ GreenMunitionToggle, IsOverclocked ]
			Mode = All
		}
		GreenMunitionComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = GreenMunitionOC_Toggle
			IncludeInBlueprints = false
			Components : &<Republic/republic_turbolaser_switchable_green.rules>/Components
			{
				WeaponEmitter  : ^/0/WeaponEmitter
				{
					Bullet  = &~/OVERCLOCK/GREENBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
        			ResourcesUsed = floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
				}
				WeaponEmitter2 : ^/0/WeaponEmitter2
				{
					Bullet  = &~/OVERCLOCK/GREENBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
        			ResourcesUsed = floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
				}
			}
		}*/
		
		ExteriorType
		{
			Type = UIToggle
			ToggleID = "SW.exterior_type"
			Default = 0
			ToggledOnChoices = [0,1]
		}

		WhiteExteriorToggle
		{
			Type = ModeToggle
			Mode = ExteriorType
			OnMode = 0
		}
		WhiteExteriorComponents
		{
			Type = ToggledComponents
			Toggle = WhiteExteriorToggle
			//IncludeInBlueprints = true
			Components = &<Republic/republic_turbolaser_white.rules>/Components
		}

		GreyExteriorToggle
		{
			Type = ModeToggle
			Mode = ExteriorType
			OnMode = 1
		}
		GreyExteriorComponents
		{
			Type = ToggledComponents
			Toggle = GreyExteriorToggle
			//IncludeInBlueprints = true
			Components = &<Republic/republic_turbolaser_grey.rules>/Components
		}
/*
		CommonReloadTimer
		{
			Type = Timer
			Duration = 3.3
			AutoStart = true
			StartTrigger = CommonReloadResetTrigger
		}
		CommonOnShootEffectTimer
		{
			Type = Timer
			Duration = 0.54
			AutoStart = true
			StartTrigger = CommonReloadResetTrigger
		}

		CommonOnShootEffectGraphics
		{
			Type = Graphics
			OperationalToggle = CommonOnShootEffectTimer
			InvertOperationalToggle = true
			ChainedTo = TurretLocationProxy
			Location = [2.75, 1.04]

			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [3.6, 3.6]
						Z = 1.45
						VertexColor = [16, 16, 255]
					}
				]
			}
		}

		CommonOnShootEffectGraphics2
		{
			Type = Graphics
			OperationalToggle = CommonOnShootEffectTimer
			InvertOperationalToggle = true
			ChainedTo = TurretLocationProxy
			Location = [2.75, -1.04]

			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [3.6, 3.6]
						Z = 1.45
						VertexColor = [16, 16, 255]
					}
				]
			}
		}
*/
		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 10000
			ReceiveResourceMediaEffects = &/SW_SOUNDS/PowerDeliver
		}

		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			ResupplyThreshold = 1000
			OperationalToggle = CommandConsumptionToggle
		}

		//OverclockSettings
		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One  { Type = StaticValue; Value = 1; }

		OverheatEffects : ^/0/OverheatEffects
		{
			Location = [2, 2]
		}

		Overclock_ShotHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_EmissionTriggered
			Amount = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
		}

		Port_Thermal_TopLeft : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 0]
			Direction = Left
		}

		Port_Thermal_LeftUp : Port_Thermal_TopLeft
		{
			Direction = Up
		}

		Port_Thermal_TopRight : Port_Thermal_LeftUp
		{
			Location = [3, 0]
			Direction = Right
		}

		Port_Thermal_RightUp : Port_Thermal_TopRight
		{
			Direction = Up
		}

		Port_Thermal_MidUp1 : Port_Thermal_RightUp
		{
			Location = [1, 0]
		}

		Port_Thermal_MidUp2 : Port_Thermal_MidUp1
		{
			Location = [2, 0]
		}

		Port_Thermal_MidRight1 : Port_Thermal_MidUp2
		{
			Location = [3, 1]
			Direction = Right
		}

		Port_Thermal_MidLeft1 : Port_Thermal_MidRight1
		{
			Location = [0, 1]
			Direction = Left
		}

		Graphics
		{
			Type = Graphics
			Location = [2,2]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [4,4]
					}
					{
						File = "floor_33.png"
						Size = [4,4]
					}
					{
						File = "floor_66.png"
						Size = [4,4]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights5.png"
						Size = [4,4]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [4,4]
					}
					{
						File = "walls_33.png"
						Size = [4,4]
					}
					{
						File = "walls_66.png"
						Size = [4,4]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [4, 4]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [4, 4]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [4, 4]
					}
				]
			}
		}

		TurretInsideGraphics
		{
			Type = Graphics
			OperationalToggle = IsOperational
			Location = [0,0]
			ChainedTo = Turret
			Rotation = 90d
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights4.png"
						Size = [1.625, 1.125]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"console on1.png"
							"console on2.png"
							"console on3.png"
						]
						Size = [4, 4]
						AnimationInterval = 0.50
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "console off.png"
						Size = [4, 4]
					}
				]
			}
		}

		TurretGhostGraphics
		{
			Type = Graphics
			ChainedTo = TurretLocationProxy
			Location = [1, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "Republic/barrel_shadow.png"
						Size = [4, 5]
					}
				]
			}
		}

		Turret
		{
			Type = TurretWeapon
			Location = [2, 2]
			Rotation = -90d// Relative to unrotated part.
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = 0 //5.4
			FirePermissionToggle = FirePermissionToggle
			FiringArc = 210d
			RotateSpeed = 15d
			FireThresholdAngle = 2d
			AIFirepowerRating = &~/Part/StatsByCategory/1/Stats/DamagePerSecond
			Emitter = WeaponEmitterBase
			IgnoreSourceShipLowLOSChecks = true

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}

		IsFireSynchronised_NonOverclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, IsOverclocked ]
			// ON when Alternating is OFF and Overclock is OFF
			Mode = None
		}
		IsFireSynchronised_Overclock
		{
			Type = MultiToggle
			Toggles = [ {Toggle=FireAlternatingToggle; Invert=true}, IsOverclocked ]
			// ON when Alternating is OFF and Overclock is ON
			Mode = All
		}
		IsFireAlternating_NonOverclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, {Toggle=IsOverclocked; Invert=true} ]
			// ON when Alternating is ON and Overclock is OFF
			Mode = All
		}
		IsFireAlternating_Overclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, IsOverclocked ]
			// ON when Alternating is ON and Overclock is ON
			Mode = All
		}

		// Synchronized (both barrels) — Overclocked
		ShootSynchronizedComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = IsFireSynchronised_Overclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					DURATION_BASE = (&~/Part/Components/ShootSynchronizedComponents/Components/FireTimer/Duration)
					Duration = (&DURATION_BASE) / (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					AutoStart = true
					StartTrigger = Turret
				}
				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				// Add these so the emitters actually fire in OC
				ShootLeftTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
				ShootRightTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
			}
		}


		// Alternating (per barrel) — Overclocked
		ShootAlternatingComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = IsFireAlternating_Overclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					DURATION_BASE = (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration)
					Duration = (&DURATION_BASE) / (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					AutoStart = true
					StartTrigger = Turret
				}
				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				// Add these so alternating works in OC
				ShootCycle
				{
					Type = ModeCycle
					ModeRange = [0, 1]
					IncrementTrigger = Turret
					StartingMode = 1
				}
				ShootLeftTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [0]
				}
				ShootRightTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [1]
				}
			}
		}

		//Non-OC
		ShootSynchronizedComponents
		{
			Type = ToggledComponents
			Toggle = IsFireSynchronised_NonOverclock
			//Invert = true
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					Duration = 1.35*2  //2.25*2
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				ShootLeftTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}

				ShootRightTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
			}
		}

		ShootAlternatingComponents
		{
			Type = ToggledComponents
			Toggle = IsFireAlternating_NonOverclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					Duration = 1.35 //2.25
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				ShootCycle
				{
					Type = ModeCycle
					ModeRange = [0, 1]
					IncrementTrigger = Turret
					StartingMode = 1 // First shot will switch to mode 0.
				}

				ShootLeftTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [0]
				}

				ShootRightTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [1]
					OperationalToggle = FireAlternatingToggle
				}
			}
		}

		FireTimerProxy
		{
			Type = ToggleProxy
			ComponentID = FireTimer
		}
		FirePermissionToggle
		{
			Type = MultiToggle
			Toggles = [FireTimerProxy, FireModeToggle]
			Mode = All
		}

		ShootLeftTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = ShootLeftTrigger
		}
		ShootLeftTriggerProxy_Overclocked : ShootLeftTriggerProxy
		{
			ProxyToggle = IsOverclocked
		}
		ShootLeftTriggerProxy_NonOverclocked : ShootLeftTriggerProxy_Overclocked
		{
			InvertProxyToggle = true
		}

		ShootRightTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = ShootRightTrigger
		}
		ShootRightTriggerProxy_Overclocked : ShootRightTriggerProxy
		{
			ProxyToggle = IsOverclocked
		}
		ShootRightTriggerProxy_NonOverclocked : ShootRightTriggerProxy_Overclocked
		{
			InvertProxyToggle = true
		}

		ShootTrigger1
		{
			Type = TriggerProxy
			ComponentID = ShootLeftTriggerProxy
		}
		ShootTrigger2
		{
			Type = TriggerProxy
			ComponentID = ShootRightTriggerProxy
		}

		WeaponEmitterBase
		{
			Type = BulletEmitter
			ChainedTo = Turret
			FireTrigger
			GetTargetFrom = Turret
			Location = [0, 0]
			OperationalToggle = IsOperational
			FireDelay = 0 // 0.15
			Bullet = &/SW_SHOTS/Laser/Turret/Turbo/Republic/Blue
			ResourceStorage = BatteryStorage
			ResourcesUsed = &~/RESOURCES_USED
			MinResourcesUsed = 1
			Recoil = 200
			AntiPhasingRaycastDistance = 2
			TargetLeadPrediction = false
			Spread = [-0.5d, 0.5d]
		}

		ChargeEffectSound
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = Turret
			AnchorMediaEffects = true
		
			MediaEffects
			[
				&/SW_SOUNDS/LaserReCharge
			]
		}

		FireEffectSound
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = Turret
			AnchorMediaEffects = true
	
			MediaEffects
			[
				&/SW_SOUNDS/TurbolaserSFX
			]
		}

		TurretLocationProxy
		{
			Type = ChainableProxy
			ComponentID = Turret
		}

		CrewLocation1
		{
			Type = CrewLocation
			Location = [0.4, 0.45]
			ChainedTo = Turret
			Rotation = 90d
		}
		CrewLocation2
		{
			Type = CrewLocation
			Location = [0.4, -0.45]
			ChainedTo = Turret
			Rotation = 90d
		}
		PartCrew
		{
			Type = PartCrew
			Crew = 2
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle]
			HighPriorityPrerequisites = [BatteryStorage]
			CrewDestinations
			[
				[1.55, 1.6]
				[2.45, 1.6]
			]
			CrewLocations
			[
				CrewLocation1
				CrewLocation2
			]
		}

		TurretCollider
		{
			Type = CircleCollider
			Location = &../Turret/Location
			Radius = 1.5
			Density = .75
			InitialPenetrationResistance = 5
			//IsHigh = true
		}

		BatterySprites
		{
			ChainedTo = Turret
			Rotation = 90d
			Type = ResourceSprites
			Location = [0, 0]//2,2
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			HasZeroResourceSprite = false
			ResourceLevels
			[
				{
					File = "batteries01.png"
					Size = [4,4]
				}
				{
					File = "batteries02.png"
					Size = [4,4]
				}
				{
					File = "batteries03.png"
					Size = [4,4]
				}
				{
					File = "batteries04.png"
					Size = [4,4]
				}
				{
					File = "batteries05.png"
					Size = [4,4]
				}
				{
					File = "batteries06.png"
					Size = [4,4]
				}
				{
					File = "batteries07.png"
					Size = [4,4]
				}
				{
					File = "batteries08.png"
					Size = [4,4]
				}
				{
					File = "batteries09.png"
					Size = [4,4]
				}
				{
					File = "batteries10.png"
					Size = [4,4]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [2, 2]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/BigPartScorched
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
			Location = [2, 2]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [2, 2]
			Indicators
			[
				// 0 Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3,4]
				}
				// 1 Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2,3,4]
				}
				// 2 Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
				// 3 Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
					HidesIndicators = [4]
				}
				// 4 No crew.
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [4, 4]
		}

		PeakHeatGenerationValue
		{
			Type = StaticValue
			SHOT_HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/Part/SecondaryToolTip/StatsByCategory/0/Stats/ROF)
			Value = (&~/OVERCLOCK/HEAT_PER_SECOND) + (&SHOT_HEAT_PER_SECOND)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationValue
		}

	}

   //Stats 
	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		TurretPenResist = &~/Part/Components/TurretCollider/InitialPenetrationResistance

		RecPower =  &../StatsByCategory/1/Stats/PowerPerSecond
		RecCrew = (&CrewRequired) + (&RecPower) * 4
	}

	StatsByCategory
	[
		&~/TurretStats
		{
			NameKey = "StatCategories/RepublicLasershot"
			Stats
			{
					DamagePerShot = &~/EMITTER_BASE/Bullet/Components/Hit/HitOperational/HitEffects/0/Damage/BaseValue
					DamagePerSecond = (&DamagePerShot) * (&ROF)
					Damage = [&../DamagePerShot, &../DamagePerSecond]
					ShieldDamagePerShot = &~/EMITTER_BASE/Bullet/Components/Hit/HitShield/HitEffects/0/Damage/BaseValue
					ShieldDamagePerSecond = (&ShieldDamagePerShot) * (&ROF)
					ShieldDamage = [&../ShieldDamagePerShot, &../ShieldDamagePerSecond]
					ROF = 1 / (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration)
					PowerPerSecond = (&PowerPerShot) * (&ROF)
					ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
					ShotSpeed = &~/EMITTER_BASE/Bullet/Speed
					ShotHP = &~/EMITTER_BASE/Bullet/Components/Targetable/Health
					PowerPerShot = (&~/EMITTER_BASE/ResourcesUsed) / 1000
			}
		}
	]
	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/RepublicturbolaserswitchableOverclockDesc"
		StatsByCategory
		[
			{
				NameKey = "StatCategories/RepublicLasershotOverclocked"
				Stats
				{
					DamagePerShot = &~/OVERCLOCK/BULLET/DAMAGE
					DamagePerSecond = (&DamagePerShot) * (&ROF)
					Damage = [&../DamagePerShot, &../DamagePerSecond]
					ShieldDamagePerShot = &~/OVERCLOCK/BULLET/DAMAGE_SHIELD
					ShieldDamagePerSecond = (&ShieldDamagePerShot) * (&ROF)
					ShieldDamage = [&../ShieldDamagePerShot, &../ShieldDamagePerSecond]
					DamageArea = &~/OVERCLOCK/BULLET/DAMAGE_RADIUS
					ROF = (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration) * (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					HeatPerShot = (&~/OVERCLOCK/HEAT_PER_SHOT)
					PowerPerShot = (&~/EMITTER_BASE_OVERCLOCK/ResourcesUsed) / 1000
					PowerPerSecond = (&PowerPerShot) * (&ROF)
					ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
				}
			}
		]
	}
}
TurretStats
{
	NameKey = "StatCategories/Turret"
	Stats
	{
		Barrels = 2
		ROF = 1 / (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration)
		Range = &~/EMITTER_BASE/Bullet/Range
		Arc = deg(&~/Part/Components/Turret/FiringArc)
		TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
	}
}

EMITTER_BASE =  &~/Part/Components/WeaponEmitterBase
EMITTER_BASE_OVERCLOCK = &~/Part/Components/WeaponEmitterBase

