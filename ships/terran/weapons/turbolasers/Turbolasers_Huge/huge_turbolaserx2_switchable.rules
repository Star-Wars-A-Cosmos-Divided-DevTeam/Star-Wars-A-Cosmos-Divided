		{
			Type = PartCrew
			Crew = 8
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle]
			HighPriorityPrerequisites = [BatteryStorage]
			CrewDestinations
			[
				[4.5, 4.5] //&../../CrewLocation1/Location // scaled proportionally
				[4.5, 4.5] //&../../CrewLocation2/Location // scaled proportionally
				[4.5, 4.5] //&../../CrewLocation3/Location // scaled proportionally
