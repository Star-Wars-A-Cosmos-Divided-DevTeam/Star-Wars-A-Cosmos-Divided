                [
                    { File = "floors/Option_A.png"     Size = [&~/SIZE/0, &~/SIZE/1] }
                    { File = "floors/Option_A_33.png"  Size = [&~/SIZE/0, &~/SIZE/1] }
                    { File = "floors/Option_A_66.png"  Size = [&~/SIZE/0, &~/SIZE/1] }
                ]
            }
        }
    }
}

