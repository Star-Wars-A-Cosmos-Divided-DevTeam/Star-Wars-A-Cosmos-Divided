		{
			Type = ResourceSprites
			ChainedTo = Turret
			Location = [0, -2.4]
			Rotation = 90d
			ResourceStorage = BatteryStorage
			Layer = "lights_add"
			//RangeLow = 0
			//RangeHigh = 24000
			ResourceLevels
			[
