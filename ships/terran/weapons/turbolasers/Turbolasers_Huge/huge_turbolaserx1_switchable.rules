		{
			Type = ChainableProxy
			ComponentID = Turret
		}
		TurretGhostGraphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [0, 0]
			Rotation = 90d
			//OperationalToggle = IsOperational
		
