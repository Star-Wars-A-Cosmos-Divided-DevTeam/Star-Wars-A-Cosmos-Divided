OVERCLOCK
{
	BULLET  = &<../../../../../shots/laser/turret/turbo/light/overclock/oc_base_shot.rules>

	BLUEBULLET  = &<../../../../../shots/laser/turret/turbo/light/overclock/oc_blue_shot.rules>
	GREENBULLET = &<../../../../../shots/laser/turret/turbo/light/overclock/oc_green_shot.rules>
	REDBULLET   = &<../../../../../shots/laser/turret/turbo/light/overclock/oc_red_shot.rules>

	// Rate-of-fire scaler (2 = twice as fast)
	FIRE_RATE_FACTOR = 50%

	// OC spread/recoil modifiers
	HALF_SPREAD   = (&~/Part/Components/WeaponEmitterBase/Spread/1) / 2
	RECOIL_FACTOR = 150%

	// Heat hookup
	HEAT_PER_SHOT   = 650
	HEAT_PER_SECOND = 100
	POWER_USE_FACTOR = 150%

	HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
	HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

	// Stun scaling
	//CREW_STUN_DURATION = ((&~/Part/Components/StunEffect/HitEffects/0/Duration/BaseValue) * 3)
	//CREW_STUN_RADIUS   = ((&~/Part/Components/StunEffect/HitEffects/0/Radius/BaseValue) * 3)
}

// Heat Producers
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS   = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO


Part : &<../base_part_terran_turbolasers_overclock.rules>/Part
{
 	//IDs
	ID = SW.quad_barbette_turbolaser

	//StringKeys
	NameKey = "Parts/QuadBarbetteTurbolaser"
	IconNameKey = "Parts/QuadBarbetteTurbolaserIcon"
	DescriptionKey = "Parts/QuadBarbetteTurbolaserDesc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups ["WeaponsEnergy", SWTechIII]
	TypeCategories : ^/0/TypeCategories [weapon, uses_power, is_crewed]
	SignificanceToggle = ScorchedToggle
	RequiresCategories = [SW_Bridge]

	//Resources&Size&Health
	Resources
	[
		[steel, 128]
		[SW.durasteel, 240]
		[coil, 108]	//
		[coil2, 12] //some extra
	]  //Cost = 30000 
	Size = [8, 8]
	MaxHealth = 128000

	//Rects

	//Selections
	SelectionPriority = 1
	//SelectionTypeByRotation = true
	SelectionTypeID = "cannons" 

	//PartSpecific
	AIValueFactor = 2
	InitialPenetrationResistance = 10
	//Density = 1 + (&~/Part/TurretDensity)
	TurretDensity = 3.0

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronBuff]

	//Doors&Etc
	ForceManhattenPathInPart = true
	AllowedDoorLocations
	[
		[2, -1]
		[2, 8]
		[3, -1]
		[3, 8]
		[4, -1]
		[4, 8]
		[5, -1]
		[5, 8]
		[-1, 2]
		[8, 2]
		[-1, 3]
		[8, 3]
		[-1, 4]
		[8, 4]
		[-1, 5]
		[8, 5]
	]
	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon2.png"
			SampleMode = Linear
		}
		Size = [56, 56]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		IsOperational : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [PowerToggle, PartCrew, BatteryStorage]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 16
		}
		//OverclockSettings

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		OverheatEffects : ^/0/OverheatEffects
		{
			Location = [6, 6]
		}

		WeaponEmitterProxy
		{
			Type = EmitterProxy
			ComponentID = WeaponEmitter
			ChainedTo = Turret
		}
		WeaponEmitter2Proxy : WeaponEmitterProxy
		{
			ComponentID = WeaponEmitter2
		}

		Overclock_EmissionTriggered
		{
			Type = MultiTrigger
			OperationalToggle = IsOverclocked
			Triggers = [ WeaponEmitterProxy, WeaponEmitter2Proxy ]
		}
		Overclock_ConstantHeatProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperationalOverclocked
			HEAT_PER_INTERVAL = ceil((&~/OVERCLOCK/HEAT_PER_SECOND) * (&Interval))
			ToQuantity = (&HEAT_PER_INTERVAL) * (&~/HEAT_TO_RESOURCE)
			ToStorage  = &~/Part/^/0/HEAT_TARGET_STORAGE
			Interval = 0.5
		}
		Overclock_ShotHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_EmissionTriggered
			Amount = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
		}

		Port_Thermal_TopLeft : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 0]
			Direction = Left
		}
		Port_Thermal_LeftUp : Port_Thermal_TopLeft
		{
			Direction = Up
		}
		Port_Thermal_TopRight : Port_Thermal_LeftUp
		{
			Location = [7, 0]
			Direction = Right
		}
		Port_Thermal_RightUp : Port_Thermal_TopRight
		{
			Direction = Up
		}
		Port_Thermal_BottomRight : Port_Thermal_RightUp
		{
			Location = [7, 7]
			Direction = Right
		}
		Port_Thermal_RightDown : Port_Thermal_BottomRight
		{
			Direction = Down
		}
		Port_Thermal_BottomLeft : Port_Thermal_RightDown
		{
			Location = [0, 7]
			Direction = Left
		}
		Port_Thermal_LeftDown : Port_Thermal_BottomLeft
		{
			Direction = Down
		}
		Port_Thermal_MidUp1 : Port_Thermal_LeftDown
		{
			Location = [1, 0]
			Direction = Up
		}
		Port_Thermal_MidUp6 : Port_Thermal_MidUp1
		{
			Location = [6, 0]
		}
		Port_Thermal_MidRight1 : Port_Thermal_MidUp6
		{
			Location = [7, 1]
			Direction = Right
		}
		Port_Thermal_MidRight6 : Port_Thermal_MidRight1
		{
			Location = [7, 6]
		}
		Port_Thermal_MidDown6 : Port_Thermal_MidRight6
		{
			Location = [6, 7]
			Direction = Down
		}
		Port_Thermal_MidDown1 : Port_Thermal_MidDown6
		{
			Location = [1, 7]
		}
		Port_Thermal_MidLeft6 : Port_Thermal_MidDown1
		{
			Location = [0, 6]
			Direction = Left
		}
		Port_Thermal_MidLeft1 : Port_Thermal_MidLeft6
		{
			Location = [0, 1]
		}


		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}

		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}

		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}

		FireAlternatingToggle
		{
			Type = UIToggle
			ToggleID = "fire_alternating"
			Default = 0
		}

		MunitionType
		{
			Type = UIToggle
			ToggleID = "SW.munition_type"
			Default = 0
			AvailableChoices = [0, 1, 2]
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}
		RedMunitionToggle
		{
			Type = ModeToggle
			Mode = MunitionType
			OnMode = 0
		}
		BlueMunitionToggle
		{
			Type = ModeToggle
			Mode = MunitionType
			OnMode = 1
		}
		GreenMunitionToggle
		{
			Type = ModeToggle
			Mode = MunitionType
			OnMode = 2
		}
		// ---- RED: Non-OC ----
		RedMunitionNonOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ RedMunitionToggle, {Toggle=IsOverclocked; Invert=true} ]
			Mode = All
		}
		RedMunitionComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = RedMunitionNonOC_Toggle
			IncludeInBlueprints = false
			Components = &<weapon_quad_turbolaser_red.rules>/Components
		}

		RedMunitionOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ RedMunitionToggle, IsOverclocked ]
			Mode = All
		}
		RedMunitionComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = RedMunitionOC_Toggle
			IncludeInBlueprints = false
			Components : &<weapon_quad_turbolaser_red.rules>/Components
			{
				WeaponEmitter  : ^/0/WeaponEmitter
				{
					Bullet  = &~/OVERCLOCK/REDBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
				}
				WeaponEmitter2 : ^/0/WeaponEmitter2
				{
					Bullet  = &~/OVERCLOCK/REDBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
				}
			}
		}


		// ---- BLUE: Non-OC ----
		BlueMunitionNonOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ BlueMunitionToggle, {Toggle=IsOverclocked; Invert=true} ]
			Mode = All
		}
		BlueMunitionComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = BlueMunitionNonOC_Toggle
			IncludeInBlueprints = false
			Components = &<weapon_quad_turbolaser_blue.rules>/Components
		}

		// ---- BLUE: OC ----
		BlueMunitionOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ BlueMunitionToggle, IsOverclocked ]
			Mode = All
		}
		BlueMunitionComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = BlueMunitionOC_Toggle
			IncludeInBlueprints = false
			Components : &<weapon_quad_turbolaser_blue.rules>/Components
			{
				WeaponEmitter  : ^/0/WeaponEmitter
				{
					Bullet  = &~/OVERCLOCK/BLUEBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
				}
				WeaponEmitter2 : ^/0/WeaponEmitter2
				{
					Bullet  = &~/OVERCLOCK/BLUEBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
				}
			}
		}

		// ---- GREEN: Non-OC ----
		GreenMunitionNonOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ GreenMunitionToggle, {Toggle=IsOverclocked; Invert=true} ]
			Mode = All
		}
		GreenMunitionComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = GreenMunitionNonOC_Toggle
			IncludeInBlueprints = false
			Components = &<weapon_quad_turbolaser_green.rules>/Components
		}

		GreenMunitionOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ GreenMunitionToggle, IsOverclocked ]
			Mode = All
		}
		GreenMunitionComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = GreenMunitionOC_Toggle
			IncludeInBlueprints = false
			Components : &<weapon_quad_turbolaser_green.rules>/Components
			{
				WeaponEmitter  : ^/0/WeaponEmitter
				{
					Bullet  = &~/OVERCLOCK/GREENBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
				}
				WeaponEmitter2 : ^/0/WeaponEmitter2
				{
					Bullet  = &~/OVERCLOCK/GREENBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
				}
			}
		}

		ExteriorType
		{
			Type = UIToggle
			ToggleID = "SW.exterior_type"
			Default = 0
			ToggledOnChoices = [0,1]
		}

		WhiteExteriorToggle
		{
			Type = ModeToggle
			Mode = ExteriorType
			OnMode = 0
		}
		WhiteExteriorComponents
		{
			Type = ToggledComponents
			Toggle = WhiteExteriorToggle
			//IncludeInBlueprints = true
			Components = &<turbolaser_quad_white.rules>/Components
		}
		GreyExteriorToggle
		{
			Type = ModeToggle
			Mode = ExteriorType
			OnMode = 1
		}
		GreyExteriorComponents
		{
			Type = ToggledComponents
			Toggle = GreyExteriorToggle
			//IncludeInBlueprints = true
			Components = &<turbolaser_quad_grey.rules>/Components
		}

		//AmmoPrereq
		//{
		//	Type = MultiResourceStorage
		//	ResourceType = battery
		//	ResourceStorages = [BatteryStorage]
		//	//ToggleOnResources = 19001
		//	//ToggleOffResources = 3750
		//}
		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 15000
			//ToggleOnResources = 10001
			ReceiveResourceMediaEffects = &/SW_SOUNDS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			ResupplyThreshold = 1500
			OperationalToggle = PowerToggle
		}

		Turret
		{
			Type = TurretWeapon
			Location = [4, 4] // Relative to upper-left corner of unrotated part.
			Rotation = -90d // Relative to unrotated part.
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = 0 // Uses separate fire timer.
			FiringArc = 180d
			RotateSpeed = 15d
			FireThresholdAngle = 1d
			HoldTargetAfterCancel = 0.5
			AIFirepowerRating = 5400
			FirePermissionToggle = FirePermissionToggle
			IgnoreSourceShipLOSChecks = true
			IgnoreSourceShipLowLOSChecks = true
			AllowFireWithBlockedLOS = false
			Emitter = WeaponEmitterBase

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}

		IsFireSynchronised_NonOverclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, IsOverclocked ]
			// ON when Alternating is OFF and Overclock is OFF
			Mode = None
		}
		IsFireSynchronised_Overclock
		{
			Type = MultiToggle
			Toggles = [ {Toggle=FireAlternatingToggle; Invert=true}, IsOverclocked ]
			// ON when Alternating is OFF and Overclock is ON
			Mode = All
		}
		IsFireAlternating_NonOverclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, {Toggle=IsOverclocked; Invert=true} ]
			// ON when Alternating is ON and Overclock is OFF
			Mode = All
		}
		IsFireAlternating_Overclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, IsOverclocked ]
			// ON when Alternating is ON and Overclock is ON
			Mode = All
		}

		// Synchronized (both barrels) — Overclocked
		ShootSynchronizedComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = IsFireSynchronised_Overclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					DURATION_BASE = (&~/Part/Components/ShootSynchronizedComponents/Components/FireTimer/Duration)
					Duration = (&DURATION_BASE) / (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					AutoStart = true
					StartTrigger = Turret
				}
				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				// Add these so the emitters actually fire in OC
				ShootLeftTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
				ShootRightTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
			}
		}


		// Alternating (per barrel) — Overclocked
		ShootAlternatingComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = IsFireAlternating_Overclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					DURATION_BASE = (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration)
					Duration = (&DURATION_BASE) / (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					AutoStart = true
					StartTrigger = Turret
				}
				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				// Add these so alternating works in OC
				ShootCycle
				{
					Type = ModeCycle
					ModeRange = [0, 1]
					IncrementTrigger = Turret
					StartingMode = 1
				}
				ShootLeftTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [0]
				}
				ShootRightTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [1]
				}
			}
		}



		//Non-OC
		ShootSynchronizedComponents
		{
			Type = ToggledComponents
			Toggle = IsFireSynchronised_NonOverclock
			//Invert = true
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					Duration = 1.25*2  //2.25*2
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				ShootLeftTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}

				ShootRightTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
			}
		}

		ShootAlternatingComponents
		{
			Type = ToggledComponents
			Toggle = IsFireAlternating_NonOverclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					Duration = 1.25 //2.25
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				ShootCycle
				{
					Type = ModeCycle
					ModeRange = [0, 1]
					IncrementTrigger = Turret
					StartingMode = 1 // First shot will switch to mode 0.
				}

				ShootLeftTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [0]
				}

				ShootRightTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [1]
					OperationalToggle = FireAlternatingToggle
				}
			}
		}

		FireTimerProxy
		{
			Type = ToggleProxy
			ComponentID = FireTimer
		}
		FirePermissionToggle
		{
			Type = MultiToggle
			Toggles = [FireTimerProxy, FireModeToggle]
			Mode = All
		}

		ShootLeftTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = ShootLeftTrigger
		}
		ShootLeftTriggerProxy_Overclocked : ShootLeftTriggerProxy
		{
			ProxyToggle = IsOverclocked
		}
		ShootLeftTriggerProxy_NonOverclocked : ShootLeftTriggerProxy_Overclocked
		{
			InvertProxyToggle = true
		}

		ShootRightTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = ShootRightTrigger
		}
		ShootRightTriggerProxy_Overclocked : ShootRightTriggerProxy
		{
			ProxyToggle = IsOverclocked
		}
		ShootRightTriggerProxy_NonOverclocked : ShootRightTriggerProxy_Overclocked
		{
			InvertProxyToggle = true
		}

		ShootTrigger1
		{
			Type = TriggerProxy
			ComponentID = ShootLeftTriggerProxy
		}
		ShootTrigger2
		{
			Type = TriggerProxy
			ComponentID = ShootRightTriggerProxy
		}

		WeaponEmitterBase
		{
			Type = BulletEmitter
			ChainedTo = Turret
			FireTrigger
			GetTargetFrom = Turret
			Location = [0, 0]
			OperationalToggle = IsOperational
			FireDelay = .6
			Bullet = &/SW_SHOTS/Laser/Turret/Turbo/Light/Green
			SourceShipCollisions = false
			TargetLeadPrediction = false
			ResourceStorage = BatteryStorage
			ResourcesUsed = 500 //250-350?
			MinResourcesUsed = 1
			Recoil = 350
			AntiPhasingRaycastDistance = 4
			Spread = [-0.2d, 0.2d]
		}

		Graphics
		{
			Type = Graphics
			Location = [4, 4]
			Floor
			{
				Layer = "floors"
				//Offset = [-1, 0]
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [8, 8]
					}
					{
						File = "floor_33.png"
						Size = [8, 8]
					}
					{
						File = "floor_66.png"
						Size = [8, 8]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [8, 8]
					}
					{
						File = "walls_33.png"
						Size = [8, 8]
					}
					{
						File = "walls_66.png"
						Size = [8, 8]
					}
				]
