			FireDelay = 0.18
			Bullet =  &/SW_SHOTS/Laser/Turret/Turbo/Heavy/Red
			SourceShipCollisions = false
			TargetLeadPrediction = false
			ResourceStorage = BatteryStorage
			ResourcesUsed = &~/RESOURCES_USED
			//Burst = 2
			//BurstDelay = 0.06666
			//UseAmmoPerShotInBurst = true
			MinResourcesUsed = 1
			Recoil = 150
			AntiPhasingRaycastDistance = 2
			Spread = [-0.1d, 0.1d]
		}

