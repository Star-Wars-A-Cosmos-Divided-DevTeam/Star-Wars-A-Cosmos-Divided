			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "../Turbolasers_Big/roof.png"
						NormalsFile = "../Turbolasers_Big/roof_normals.png"
						Size = [4,4]
					}
					{
						File = "../Turbolasers_Big/roof_33.png"
						NormalsFile = "../Turbolasers_Big/roof_normals_33.png"
