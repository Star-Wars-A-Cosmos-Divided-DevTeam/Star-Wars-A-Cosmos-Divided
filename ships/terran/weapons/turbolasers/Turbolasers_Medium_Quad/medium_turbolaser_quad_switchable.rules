   //Stats
	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		TurretPenResist = &~/Part/InitialPenetrationResistance

		RecPower = &../StatsByCategory/1/Stats/PowerPerSecond
		RecCrew = (&CrewRequired) + (&RecPower) * 4
/*
		ROF = 2 / (&~/Part/Components/Turret/FireInterval)
		Range = &~/Part/Components/BulletEmitterBase/Bullet/Range
		Arc = deg(&~/Part/Components/Turret/FiringArc)
		TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
*/		
	}
	StatsByCategory
	[
		&~/TurretStats
		{
			NameKey = "StatCategories/HeavyTurbolasershot"
			Stats
			{
					DamagePerShot = &~/EMITTER_BASE/Bullet/Components/Hit/HitOperational/HitEffects/0/Damage/BaseValue
					DamagePerSecond = (&DamagePerShot) * (&ROF)
					Damage = [&../DamagePerShot, &../DamagePerSecond]
					ShieldDamagePerShot = &~/EMITTER_BASE/Bullet/Components/Hit/HitShield/HitEffects/0/Damage/BaseValue
					ShieldDamagePerSecond = (&ShieldDamagePerShot) * (&ROF)
					ShieldDamage = [&../ShieldDamagePerShot, &../ShieldDamagePerSecond]
					ROF = 1 / (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration)
					PowerPerSecond = (&PowerPerShot) * (&ROF)
					ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
					ShotSpeed = &~/EMITTER_BASE/Bullet/Speed
					ShotHP = &~/EMITTER_BASE/Bullet/Components/Targetable/Health
					PowerPerShot = (&~/EMITTER_BASE/ResourcesUsed) / 1000
			}
		}
	]
	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/MediumTurbolaserQuadswitchableOverclockDesc"
		StatsByCategory
		[
			{
				NameKey = "StatCategories/HeavyTurbolasershotOverclocked"
				Stats
				{
					DamagePerShot = &~/OVERCLOCK/BULLET/DAMAGE
					DamagePerSecond = (&DamagePerShot) * (&ROF)
					Damage = [&../DamagePerShot, &../DamagePerSecond]
					ShieldDamagePerShot = &~/OVERCLOCK/BULLET/DAMAGE_SHIELD
					ShieldDamagePerSecond = (&ShieldDamagePerShot) * (&ROF)
					ShieldDamage = [&../ShieldDamagePerShot, &../ShieldDamagePerSecond]
					DamageArea = &~/OVERCLOCK/BULLET/DAMAGE_RADIUS
					ROF = (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration) * (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					HeatPerShot = (&~/OVERCLOCK/HEAT_PER_SHOT)
					PowerPerShot = (&~/EMITTER_BASE_OVERCLOCK/ResourcesUsed) / 1000
					PowerPerSecond = (&PowerPerShot) * (&ROF)
					ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
				}
			}
		]
	}
}

TurretStats
{
	NameKey = "StatCategories/Turret"
	Stats
	{
		Barrels = 4
		ROF = 1 / (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration)
		Range = &~/EMITTER_BASE/Bullet/Range
		Arc = deg(&~/Part/Components/Turret/FiringArc)
		TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
	}
}
EMITTER_BASE =  &~/Part/Components/WeaponEmitterBase
EMITTER_BASE_OVERCLOCK = &~/Part/Components/WeaponEmitterBase
