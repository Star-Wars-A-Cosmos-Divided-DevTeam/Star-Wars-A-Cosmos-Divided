OVERCLOCK
{
	BULLET  = &<../../../../../shots/laser/turret/turbo/medium/overclock/oc_base_shot.rules>

	BLUEBULLET  = &<../../../../../shots/laser/turret/turbo/medium/overclock/oc_blue_shot.rules>
	GREENBULLET = &<../../../../../shots/laser/turret/turbo/medium/overclock/oc_green_shot.rules>
	REDBULLET   = &<../../../../../shots/laser/turret/turbo/medium/overclock/oc_red_shot.rules>

	// Rate-of-fire scaler (2 = twice as fast)
	FIRE_RATE_FACTOR = 85%
	POWER_USE_FACTOR = 200%

	// OC spread/recoil modifiers
	HALF_SPREAD   = (&~/Part/Components/WeaponEmitterBase/Spread/1) / 2
	RECOIL_FACTOR = 150%

	// Heat hookup
	HEAT_PER_SHOT   = 550
	HEAT_PER_SECOND = 75

	// Stun scaling
	//CREW_STUN_DURATION = ((&~/Part/Components/StunEffect/HitEffects/0/Duration/BaseValue) * 3)
	//CREW_STUN_RADIUS   = ((&~/Part/Components/StunEffect/HitEffects/0/Radius/BaseValue) * 3)
}

// Heat Producers
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS   = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

// Resources Used
RESOURCES_USED = 350

Part : &<../base_part_terran_turbolasers_overclock.rules>/Part
{	
	//IDs
	ID = SW.turbolaser_med_switchable
	OtherIDs = [med_turbolaser,med_turbolaser2,med_turbolaserb1,med_turbolaserb2,med_turbolaserg1,med_turbolaserg2,SW.turbolaser_med_switchable_2]

	//StringKeys
	NameKey = "Parts/Medturbolaserswitchable"
	IconNameKey = "Parts/MedturbolaserswitchableIcon"
	DescriptionKey = "Parts/MedturbolaserswitchableDesc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups ["WeaponsEnergy", SWTechII]
	TypeCategories : ^/0/TypeCategories [weapon, uses_power, is_crewed]
	SignificanceToggle = ScorchedToggle
	//RequiresCategories = []

	//Resources&Size&Health
	Resources
	[
		[steel, 64]
		[coil, 32]
		[coil2, 4]
	]
	Size = [2, 2]
	MaxHealth = 18000

	//Rects
	GenerateRectCollider = true
	/*
	ProhibitRects
	[
		[tall, [0, -1, 2, 1]]
	]
	*/

	//Selections
	SelectionPriority = 1
	SelectionTypeByRotation = true
	SelectionTypeID = "turbolasers"

	//PartSpecific
	AIValueFactor = 2
	InitialPenetrationResistance = 5

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronBuff]
	//ProhibitedBy : ^/0/ProhibitedBy [tall]

	//Doors&Etc
	//AutoDoorMaxPathLength = 8
	MaxDoors = 3
	AllowedDoorLocations
	[
		[-1, 1]
		[2, 1]
		[1, 2]
		[0, 2]
	]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [48, 60]
	}


	//Components&Inheritance
	Components : ^/0/Components
	{
		IsOperational : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [PowerToggle, PartCrew, BatteryStorage, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 6
		}

		//OverclockSettings
		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		OverheatEffects : ^/0/OverheatEffects
		{
			Location = [2, 2]
		}

		WeaponEmitterProxy
		{
			Type = EmitterProxy
			ComponentID = WeaponEmitter
			ChainedTo = Turret
		}
		WeaponEmitter2Proxy : WeaponEmitterProxy
		{
			ComponentID = WeaponEmitter2
		}

		Overclock_EmissionTriggered
		{
			Type = MultiTrigger
			OperationalToggle = IsOverclocked
			Triggers = [ WeaponEmitterProxy, WeaponEmitter2Proxy ]
		}
		Overclock_ConstantHeatProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperationalOverclocked
			HEAT_PER_INTERVAL = ceil((&~/OVERCLOCK/HEAT_PER_SECOND) * (&Interval))
			ToQuantity = (&HEAT_PER_INTERVAL) * (&~/HEAT_TO_RESOURCE)
			ToStorage  = &~/Part/^/0/HEAT_TARGET_STORAGE
			Interval = 0.5
		}

		Overclock_ShotHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_EmissionTriggered
			Amount = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
		}


		Port_Thermal_TopLeft : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 0]
			Direction = Left
		}

		Port_Thermal_LeftUp : Port_Thermal_TopLeft
		{
			Direction = Up
		}

		Port_Thermal_RightUp : Port_Thermal_LeftUp
		{
			Location = [1, 0]
		}

		Port_Thermal_TopRight : Port_Thermal_RightUp
		{
			Direction = Right
		}

		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}

		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}

		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}

		FireAlternatingToggle
		{
			Type = UIToggle
			ToggleID = "fire_alternating"
			Default = 0
		}
/*
		CommonReloadTimer
		{
			Type = Timer
			Duration = 2.1
			AutoStart = true
			StartTrigger = CommonReloadResetTriggerProxy
		}
		CommonOnShootEffectTimer
		{
			Type = Timer
			Duration = 0.42
			AutoStart = true
			StartTrigger = CommonReloadResetTriggerProxy
		}
		CommonReloadResetTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = CommonReloadResetTrigger
		}
*/
//		SwitchWeaponCooldownProgressBar
//		{
//			Type = ProgressBar
//			OperationalToggle = SwitchWeaponCooldownTimer
//			InvertOperationalToggle = true
//			ShowProgressFor = SwitchWeaponCooldownTimer
//			Invert = true
//			LowColor = [16, 16, 16]
//			HighColor = [255, 255, 255]
//		}
//		SwitchWeaponCooldownTimer
//		{
//			Type = Timer
//			Duration = 6.3
//			AutoStart = true
//			Repeats = false
//			StartsOn = 0
//			StartTrigger = SwitchWeaponCooldownTrigger
//		}
//		SwitchWeaponCooldownTrigger
//		{
//			Type = ModeTrigger
//			Mode = MunitionType
//			TriggerInModes = [0, 1, 2]
//		}

		MunitionType
		{
			Type = UIToggle
			ToggleID = "SW.munition_type"
			Default = 0
			AvailableChoices = [0, 1, 2]
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}
		RedMunitionToggle
		{
			Type = ModeToggle
			Mode = MunitionType
			OnMode = 0
		}
		BlueMunitionToggle
		{
			Type = ModeToggle
			Mode = MunitionType
			OnMode = 1
		}
		GreenMunitionToggle
		{
			Type = ModeToggle
			Mode = MunitionType
			OnMode = 2
		}

		// ---- RED: Non-OC ----
		RedMunitionNonOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ RedMunitionToggle, {Toggle=IsOverclocked; Invert=true} ]
			Mode = All
		}
		RedMunitionComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = RedMunitionNonOC_Toggle
			IncludeInBlueprints = false
			Components = &<med_turbolaser_red.rules>/Components
		}

		// ---- RED: OC ----
		RedMunitionOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ RedMunitionToggle, IsOverclocked ]
			Mode = All
		}
		RedMunitionComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = RedMunitionOC_Toggle
			IncludeInBlueprints = false
			Components : &<med_turbolaser_red.rules>/Components
			{
				WeaponEmitter  : ^/0/WeaponEmitter
				{
					Bullet  = &~/OVERCLOCK/REDBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
        			ResourcesUsed = floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
				}
				WeaponEmitter2 : ^/0/WeaponEmitter2
				{
					Bullet  = &~/OVERCLOCK/REDBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
        			ResourcesUsed = floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
				}
			}
		}


		// ---- BLUE: Non-OC ----
		BlueMunitionNonOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ BlueMunitionToggle, {Toggle=IsOverclocked; Invert=true} ]
			Mode = All
		}
		BlueMunitionComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = BlueMunitionNonOC_Toggle
			IncludeInBlueprints = false
			Components = &<med_turbolaser_blue.rules>/Components
		}

		// ---- BLUE: OC ----
		BlueMunitionOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ BlueMunitionToggle, IsOverclocked ]
			Mode = All
		}
		BlueMunitionComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = BlueMunitionOC_Toggle
			IncludeInBlueprints = false
			Components : &<med_turbolaser_blue.rules>/Components
			{
				WeaponEmitter  : ^/0/WeaponEmitter
				{
					Bullet  = &~/OVERCLOCK/BLUEBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
        			ResourcesUsed = floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
				}
				WeaponEmitter2 : ^/0/WeaponEmitter2
				{
					Bullet  = &~/OVERCLOCK/BLUEBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
        			ResourcesUsed = floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
				}
			}
		}

		// ---- GREEN: Non-OC ----
		GreenMunitionNonOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ GreenMunitionToggle, {Toggle=IsOverclocked; Invert=true} ]
			Mode = All
		}
		GreenMunitionComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = GreenMunitionNonOC_Toggle
			IncludeInBlueprints = false
			Components = &<med_turbolaser_green.rules>/Components
		}

		// ---- GREEN: OC ----
		GreenMunitionOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ GreenMunitionToggle, IsOverclocked ]
			Mode = All
		}
		GreenMunitionComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = GreenMunitionOC_Toggle
			IncludeInBlueprints = false
			Components : &<med_turbolaser_green.rules>/Components
			{
				WeaponEmitter  : ^/0/WeaponEmitter
				{
					Bullet  = &~/OVERCLOCK/GREENBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
        			ResourcesUsed = floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
				}
				WeaponEmitter2 : ^/0/WeaponEmitter2
				{
					Bullet  = &~/OVERCLOCK/GREENBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
        			ResourcesUsed = floor((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR))
				}
			}
		}

		ExteriorType
		{
			Type = UIToggle
			ToggleID = "SW.exterior_type"
			Default = 0
			ToggledOnChoices = [0,1]
		}

		WhiteExteriorToggle
		{
			Type = ModeToggle
			Mode = ExteriorType
			OnMode = 0
		}
		WhiteExteriorComponents
		{
			Type = ToggledComponents
			Toggle = WhiteExteriorToggle
			//IncludeInBlueprints = false
			Components = &<med_turbolaser_white.rules>/Components
		}
		GreyExteriorToggle
		{
			Type = ModeToggle
			Mode = ExteriorType
			OnMode = 1
		}
		GreyExteriorComponents
		{
			Type = ToggledComponents
			Toggle = GreyExteriorToggle
			//IncludeInBlueprints = false
			Components = &<med_turbolaser_grey.rules>/Components
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 10000 //7680 //for 12 times firing(24shots) //1x2 has 4000 //2x3 has 10000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			ResupplyThreshold = 1000
			OperationalToggle = CommandConsumptionToggle
		}

		Graphics
		{
			Type = Graphics
			OperationalToggle = IsOperational
			Location = [1, 1]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [2, 2]
					}
					{
						File = "floor_33.png"
						Size = [2, 2]
					}
					{
						File = "floor_66.png"
						Size = [2, 2]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [2, 2]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"console_on_1.png"
							"console_on_2.png"
							"console_on_3.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.50
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "console_off.png"
						Size = [2, 2]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [2, 2]
					}
					{
						File = "walls_33.png"
						Size = [2, 2]
					}
					{
						File = "walls_66.png"
						Size = [2, 2]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "../../../../common/common_sprites/roof_turret_base/roof.png"
						NormalsFile = "../../../../common/common_sprites/roof_turret_base/roof_normals.png"
						Size = [2, 2]
					}
					{
						File = "../../../../common/common_sprites/roof_turret_base/roof_33.png"
						NormalsFile = "../../../../common/common_sprites/roof_turret_base/roof_normals_33.png"
						Size = [2, 2]
					}
					{
						File = "../../../../common/common_sprites/roof_turret_base/roof_66.png"
						NormalsFile = "../../../../common/common_sprites/roof_turret_base/roof_normals_66.png"
						Size = [2, 2]
					}
				]
			}
			/*
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [2, 2]
						Z = 1.30 // Controls the "height" of the light for the purposes of normal mapping.
						VertexColor = [192, 192, 192] // [6, 57, 113]
					}
				]
			}
			*/
		}

		TurretGhostGraphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [0.5, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "WeaponSprite/barrel_shadow.png"
						Size = [2.4, 3]
					}
				]
			}
		}

		Turret
		{
			Type = TurretWeapon
			Location = [1, 1]
			Rotation = -90d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = 0 // Uses separate common fire timer.
			//CanBeGivenExplicitTarget = true
			//TargetSearchesPerSecond = 4
			FiringArc = 225d
			RotateSpeed = 21d
			FireThresholdAngle = 2d
			HoldTargetAfterCancel = 0.15
			AIFirepowerRating = &~/Part/StatsByCategory/1/Stats/DamagePerSecond
			FirePermissionToggle = FirePermissionToggle
			IgnoreSourceShipLOSChecks = true
			IgnoreSourceShipLowLOSChecks = true
			AllowFireWithBlockedLOS = false
			AutoTargetCrewSafetyDist = 8
			Emitter = WeaponEmitterBase


			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}

		IsFireSynchronised_NonOverclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, IsOverclocked ]
			// ON when Alternating is OFF and Overclock is OFF
			Mode = None
		}
		IsFireSynchronised_Overclock
		{
			Type = MultiToggle
			Toggles = [ {Toggle=FireAlternatingToggle; Invert=true}, IsOverclocked ]
			// ON when Alternating is OFF and Overclock is ON
			Mode = All
		}
		IsFireAlternating_NonOverclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, {Toggle=IsOverclocked; Invert=true} ]
			// ON when Alternating is ON and Overclock is OFF
			Mode = All
		}
		IsFireAlternating_Overclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, IsOverclocked ]
			// ON when Alternating is ON and Overclock is ON
			Mode = All
		}

		// Synchronized (both barrels) — Overclocked
		ShootSynchronizedComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = IsFireSynchronised_Overclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					DURATION_BASE = (&~/Part/Components/ShootSynchronizedComponents/Components/FireTimer/Duration)
					Duration = (&DURATION_BASE) / (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					AutoStart = true
					StartTrigger = Turret
				}
				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				// Add these so the emitters actually fire in OC
				ShootLeftTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
				ShootRightTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
			}
		}


		// Alternating (per barrel) — Overclocked
		ShootAlternatingComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = IsFireAlternating_Overclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					DURATION_BASE = (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration)
					Duration = (&DURATION_BASE) / (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					AutoStart = true
					StartTrigger = Turret
				}
				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				// Add these so alternating works in OC
				ShootCycle
				{
					Type = ModeCycle
					ModeRange = [0, 1]
					IncrementTrigger = Turret
					StartingMode = 1
				}
				ShootLeftTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [0]
				}
				ShootRightTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [1]
				}
			}
		}

		//Non-OC
		ShootSynchronizedComponents
		{
			Type = ToggledComponents
			Toggle = IsFireSynchronised_NonOverclock
			//Invert = true
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					Duration = 1.05*2  //2.25*2
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				ShootLeftTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}

				ShootRightTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
			}
		}

		ShootAlternatingComponents
		{
			Type = ToggledComponents
			Toggle = IsFireAlternating_NonOverclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					Duration = 1.05 //2.25
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				ShootCycle
				{
					Type = ModeCycle
					ModeRange = [0, 1]
					IncrementTrigger = Turret
					StartingMode = 1 // First shot will switch to mode 0.
				}

				ShootLeftTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [0]
				}

				ShootRightTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [1]
					OperationalToggle = FireAlternatingToggle
				}
			}
		}

		FireTimerProxy
		{
			Type = ToggleProxy
			ComponentID = FireTimer
		}
		FirePermissionToggle
		{
			Type = MultiToggle
			Toggles = [FireTimerProxy, FireModeToggle]
			Mode = All
		}

		ShootLeftTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = ShootLeftTrigger
		}
		ShootLeftTriggerProxy_Overclocked : ShootLeftTriggerProxy
		{
			ProxyToggle = IsOverclocked
		}
		ShootLeftTriggerProxy_NonOverclocked : ShootLeftTriggerProxy_Overclocked
		{
			InvertProxyToggle = true
		}

		ShootRightTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = ShootRightTrigger
		}
		ShootRightTriggerProxy_Overclocked : ShootRightTriggerProxy
		{
			ProxyToggle = IsOverclocked
		}
		ShootRightTriggerProxy_NonOverclocked : ShootRightTriggerProxy_Overclocked
		{
			InvertProxyToggle = true
		}

		ShootTrigger1
		{
			Type = TriggerProxy
			ComponentID = ShootLeftTriggerProxy
		}
		ShootTrigger2
		{
			Type = TriggerProxy
			ComponentID = ShootRightTriggerProxy
		}

		WeaponEmitterBase
		{
			Type = BulletEmitter
			ChainedTo = Turret
			FireTrigger
			GetTargetFrom = Turret
			Location = [0, 0]
			OperationalToggle = IsOperational
			FireDelay = 0.05
			Bullet = &/SW_SHOTS/Laser/Turret/Turbo/Medium/Red
			SourceShipCollisions = false
			TargetLeadPrediction = false
			ResourceStorage = BatteryStorage
			ResourcesUsed = &~/RESOURCES_USED
			MinResourcesUsed = 1
			Recoil = 25
			AntiPhasingRaycastDistance = 2
			Spread = [-5d, 5d]
		}

/*
		CommonReloadResetTrigger
		{
			Type = MultiTrigger
			Triggers = [Turret]
		}
*/
		ChargeEffectSound
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = Turret
			AnchorMediaEffects = true
		
			MediaEffects
			[
				&/SW_SOUNDS/LaserReCharge
			]
		}

		FireEffectSound
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Location = [1, 0]
			Trigger = Turret
			AnchorMediaEffects = true
	
			MediaEffects
			[
				&/SW_SOUNDS/TurbolaserSFX
			]
		}

		TurretLocationProxy
		{
			Type = ChainableProxy
			ComponentID = Turret
		}

		CrewLocation1
		{
			Type = CrewLocation
			Location = [0.55, 0.6]
		}
		CrewLocation2
		{
			Type = CrewLocation
			Location = [1.45, 0.6]
		}
		PartCrew
		{
			Type = PartCrew
			Crew = 2
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle]
			HighPriorityPrerequisites = [BatteryStorage]
			CrewDestinations
			[
				[0.55, 0.5]
				[1.45, 0.5]
			]
			CrewLocations
			[
				CrewLocation1
				CrewLocation2
			]
		}

		TurretCollider
		{
			Type = CircleCollider
			Location = &../Turret/Location
			Radius = 1.66
			Density = .75
			InitialPenetrationResistance = 5
			//IsHigh = true
		}

		BatterySprites
		{
			Type = ResourceSprites
			Location = [1, 1]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			HasZeroResourceSprite = false
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [2, 2]
				}
				{
					File = "batteries2.png"
					Size = [2, 2]
				}
				{
					File = "batteries3.png"
					Size = [2, 2]
				}
				{
					File = "batteries4.png"
					Size = [2, 2]
				}
				{
					File = "batteries5.png"
					Size = [2, 2]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [1, 1]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/BigPartScorched
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
			Location = [1, 1]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1, 1]
			Indicators
			[
				// 0 Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3,4]
				}
				// 1 Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2,3,4]
				}
				// 2 Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
				// 3 Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
					HidesIndicators = [4]
				}
				// 4 No crew.
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [2, 2]
		}
	}

   //Stats
	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		TurretPenResist = &~/Part/Components/TurretCollider/InitialPenetrationResistance

		RecPower = &../StatsByCategory/1/Stats/PowerPerSecond
		RecCrew = (&CrewRequired) + (&RecPower) * 2
	}

	StatsByCategory
	[
		&~/TurretStats
		{
			NameKey = "StatCategories/MedTurbolasershot"
			Stats
			{
					DamagePerShot = &~/EMITTER_BASE/Bullet/Components/Hit/HitOperational/HitEffects/0/Damage/BaseValue
					DamagePerSecond = (&DamagePerShot) * (&ROF)
					Damage = [&../DamagePerShot, &../DamagePerSecond]
					ShieldDamagePerShot = &~/EMITTER_BASE/Bullet/Components/Hit/HitShield/HitEffects/0/Damage/BaseValue
					ShieldDamagePerSecond = (&ShieldDamagePerShot) * (&ROF)
					ShieldDamage = [&../ShieldDamagePerShot, &../ShieldDamagePerSecond]
					ROF = 1 / (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration)
					PowerPerSecond = (&PowerPerShot) * (&ROF)
					ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
					ShotSpeed = &~/EMITTER_BASE/Bullet/Speed
					ShotHP = &~/EMITTER_BASE/Bullet/Components/Targetable/Health
					PowerPerShot = (&~/EMITTER_BASE/ResourcesUsed) / 1000
			}
		}
	]
	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/MedTurbolaserswitchableOverclockDesc"
		StatsByCategory
		[
			{
				NameKey = "StatCategories/MedTurbolasershotOverclocked"
				Stats
				{
					DamagePerShot = &~/OVERCLOCK/BULLET/DAMAGE
					DamagePerSecond = (&DamagePerShot) * (&ROF)
					Damage = [&../DamagePerShot, &../DamagePerSecond]
					ShieldDamagePerShot = &~/OVERCLOCK/BULLET/DAMAGE_SHIELD
					ShieldDamagePerSecond = (&ShieldDamagePerShot) * (&ROF)
					ShieldDamage = [&../ShieldDamagePerShot, &../ShieldDamagePerSecond]
					DamageArea = &~/OVERCLOCK/BULLET/DAMAGE_RADIUS
					ROF = (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration) * (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					HeatPerShot = (&~/OVERCLOCK/HEAT_PER_SHOT)
					PowerPerShot = ((&~/RESOURCES_USED) * (&~/OVERCLOCK/POWER_USE_FACTOR)) / 1000
					PowerPerSecond = (&PowerPerShot) * (&ROF)
					ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
					ShotHP = &~/OVERCLOCK/BULLET/HEALTH
				}
			}
		]
	}
}

TurretStats
{
	NameKey = "StatCategories/Turret"
	Stats
	{
		Barrels = 2
		ROF = 1 / (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration)
		Range = &~/EMITTER_BASE/Bullet/Range
		Arc = deg(&~/Part/Components/Turret/FiringArc)
		TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
	}
}
OperationalRoofLightingBase
{
	Size = [2.4, 3.0] //X+0,6(Distance between Barrels)=Y
	Z = 1.65 // Controls the "height" of the light for the purposes of normal mapping.
}
EMITTER_BASE =  &~/Part/Components/WeaponEmitterBase
EMITTER_BASE_OVERCLOCK = &~/Part/Components/WeaponEmitterBase
