		WeaponEmitter : &<med_turbolaser_switchable.rules>/Part/Components/WeaponEmitterBase
		{
			FireTrigger = ShootTrigger1
			Type = BulletEmitter
			Location = [1.9, 0.3]
			Bullet = &/SW_SHOTS/Laser/Turret/Turbo/Medium/Blue
		}

		WeaponEmitter2 : WeaponEmitter
		{
			FireTrigger = ShootTrigger2
			Type = BulletEmitter
			Location = [1.9, -0.3]
		}

		FireEffect1
		{
			Type = TriggeredEffects
			ChainedTo = WeaponEmitter
			Trigger = ShootTrigger1
			AnchorMediaEffects = true
	
			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Shoot/Med/Blue
			]
		}

		FireEffect2 : FireEffect1
		{
			ChainedTo = WeaponEmitter2
			Trigger = ShootTrigger2
		}

