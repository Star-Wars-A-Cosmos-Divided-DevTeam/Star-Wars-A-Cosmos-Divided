		//Overclock Weapon Settings
/*
		IsOperationalNonOverclocked
		{
			Type = MultiToggle
			Toggles = [ IsOperational, { Toggle=IsOverclocked; Invert=true } ]
			Mode = All
		}

		Emitters_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = IsOverclocked
			Invert = true
			IncludeInBlueprints = true
			Components
			{
				BaseEmitter
				{
					Type = BulletEmitter
					ChainedTo = Turret
					FireTrigger // Not optional, but don't want to actually shoot this emitter.
					GetTargetFrom = Turret
					Location = [2.5, 0]
					OperationalToggle = IsOperational
					Bullet = &<./Data/shots/bullet_deck/bullet_deck.rules>
					Spread = [-2.5d, 2.5d]
					ResourceStorage = CombinedLoadedAmmo // Needed to prevent turret from trying to fire when out of ammo.
					ResourcesUsed = 10
					Recoil = 240
					AntiPhasingRaycastDistance = 2
					AntiPhasingRaycastIgnoreLowCollisions = true
				}
				Emitter1 : BaseEmitter
				{
					Location = [240/64, -35/64]
					FireTrigger = ShootTrigger1
					ResourceStorage = LoadedAmmo1
				}
				Emitter2 : BaseEmitter
				{
					Location = [240/64, 35/64]
					FireTrigger = ShootTrigger2
					ResourceStorage = LoadedAmmo2
				}
			}
		}

		Emitters_Overclocked
		{
			Type = ToggledComponents
			Toggle = IsOverclocked
			Components
			{
				BaseEmitter : ~/Part/Components/Emitters_NonOverclocked/Components/BaseEmitter
				{
					Bullet = &~/OVERCLOCK/BULLET
					Spread = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
				}
				Emitter1 : BaseEmitter, ~/Part/Components/Emitters_NonOverclocked/Components/Emitter1
				{
					FireTrigger = &^/1/FireTrigger
					Location = &^/1/Location
					ResourceStorage = &^/1/ResourceStorage
				}
				Emitter2 : BaseEmitter, ~/Part/Components/Emitters_NonOverclocked/Components/Emitter2
				{
					FireTrigger = &^/1/FireTrigger
					Location = &^/1/Location
					ResourceStorage = &^/1/ResourceStorage
				}
			}
		}

		BaseEmitterProxy
		{
			Type = EmitterProxy
			ComponentID = BaseEmitter
			ChainedTo = Turret
		}
		Emitter1Proxy
		{
			Type = EmitterProxy
			ComponentID = Emitter1
			ChainedTo = Turret
			Location = [240/64, -35/64]
		}
		Emitter1Proxy_Overclocked : Emitter1Proxy
		{
			ProxyToggle = IsOverclocked
		}
		Emitter1Proxy_NonOverclocked : Emitter1Proxy_Overclocked
		{
			InvertProxyToggle = true
		}
		Emitter2Proxy
		{
			Type = EmitterProxy
			ComponentID = Emitter2
			ChainedTo = Turret
			Location = [240/64, 35/64]
		}
		Emitter2Proxy_Overclocked : Emitter2Proxy
		{
			ProxyToggle = IsOverclocked
		}
		Emitter2Proxy_NonOverclocked : Emitter2Proxy_Overclocked
		{
			InvertProxyToggle = true
		}

		FireEffect1
		{
			Type = TriggeredEffects
			ChainedTo = Emitter1Proxy_NonOverclocked
			Trigger = Emitter1Proxy_NonOverclocked
			Location = [90/64, 0]

			MediaEffects
			[
				&<particles/cannon_shoot_deck.rules>
				&<particles/cannon_shoot_deck_flash.rules>
				&<particles/cannon_shoot_deck_flare.rules>
				&<particles/cannon_smoke_deck.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "shoot.wav"
					SpeedVariation = .25
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .1
					Duration = 1
				}
			]
		}
		FireEffect2 : FireEffect1
		{
			ChainedTo = Emitter2Proxy_NonOverclocked
			Trigger = Emitter2Proxy_NonOverclocked
		}
		Overclock_FireEffect1 : FireEffect1
		{
			ChainedTo = Emitter1Proxy_Overclocked
			Trigger = &ChainedTo
			
			MediaEffects
			[
				&<particles/cannon_shoot_deck.rules>
				&<particles/cannon_shoot_deck_flash.rules>
				&<particles/cannon_shoot_deck_flare.rules>
				&<particles/cannon_smoke_deck.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "sounds/deck_cannon_overclocked_shot.wav"
					SpeedVariation = .25
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .1
					Duration = 1
				}
			]
		}
		Overclock_FireEffect2 : Overclock_FireEffect1
		{
			ChainedTo = Emitter2Proxy_Overclocked
			Trigger = &ChainedTo
		}
*/


