		PeakHeatGenerationValue
		{
			Type = StaticValue
			SHOT_HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/Part/SecondaryToolTip/StatsByCategory/0/Stats/ROF)
			Value = (&~/OVERCLOCK/HEAT_PER_SECOND) + (&SHOT_HEAT_PER_SECOND)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationValue
		}

	}

   //Stats
	Stats
	{
		CrewRequired   = &~/Part/Components/PartCrew/Crew
		PowerPerShot   = (&~/Part/Components/WeaponEmitterBase/ResourcesUsed) / 1000

		ROF            = &<siege_turbolaser12x12.rules>/TurretStats/Stats/ROF

		PowerPerSecond = (&PowerPerShot) * (&ROF)
		ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
	}

   //Stats 
	StatsByCategory
	[
		&~/TurretStats
		&<siege12x12red.rules>/LaserStats
		&<siege12x12blue.rules>/LaserStats
		&<siege12x12green.rules>/LaserStats
	]

	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/SiegeTurbolaser12x12OverclockDesc"
		Stats
		{
			CrewStunDuration = [0, &~/OVERCLOCK/CREW_STUN_DURATION]
			CrewStunRadius = &~/OVERCLOCK/CREW_STUN_RADIUS
		}
		StatsByCategory
		[
			{
				NameKey = "StatCategories/HeavyConcussiveBlastLasershotOverclocked"
				Stats
				{
					DamagePerShot = &~/OVERCLOCK/BULLET/DAMAGE_POOL
					DamagePerSecond = (&DamagePerShot) * (&ROF)
					Damage = [&../DamagePerShot, &../DamagePerSecond]
					PenetrationDamagePool = [infinity, &../DamagePerShot]
					HeatPerShot = (&~/OVERCLOCK/HEAT_PER_SHOT)
					HeatGeneration = (&~/OVERCLOCK/HEAT_PER_SECOND)
					FIRE_INTERVAL = ((&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration) / (&~/OVERCLOCK/FIRE_RATE_FACTOR))
					ROF = 1 / (&FIRE_INTERVAL)
					Spread = deg(&~/OVERCLOCK/HALF_SPREAD)
					Range = &~/OVERCLOCK/BULLET/Range
					ShotSpeed = &~/OVERCLOCK/BULLET/Speed
					ShotHP = &~/OVERCLOCK/BULLET/HEALTH
				}
			}
		]
	}

}

TurretStats
{
	NameKey = "StatCategories/Turret"
	Stats
	{
		Barrels = 2
		//ReloadTime = &~/Part/Components/WeaponTimerBuffProvider/BuffAmount
		Salvo = [&../Barrels, &../ROF]
		ROF = 1 / (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration)
		Range = &~/Part/Components/WeaponEmitterBase/Bullet/Range
		Arc = deg(&~/Part/Components/Turret/FiringArc)
		TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
		PowerPerShot = (&~/Part/Components/WeaponEmitterBase/ResourcesUsed) / 1000
		PowerPerSecond = (&PowerPerShot) * (&ROF)
		ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
		//Spread = deg(&~/BulletEmitterBase/Spread/1)
		//ShotSpeed = &~/Components/BulletEmitterBase/Bullet/Speed
	}
}