		StunEffect
		{
			Type = TriggeredEffects
			Location = [8, 1]
			Trigger = StunTrigger

			HitEffects
			[
				{
					Type = AreaCrewStun
					Duration = { BaseValue=1; BuffType=Overclock; BuffMode=Lerp; MinValue=&BaseValue; MaxValue=&~/OVERCLOCK/CREW_STUN_DURATION; }
					Falloff = 1
					Radius = { BaseValue=12; BuffType=Overclock; BuffMode=Lerp; MinValue=&BaseValue; MaxValue=&~/OVERCLOCK/CREW_STUN_RADIUS; }
					Filter { Friendlies=true; IgnoreInvulnerability=true; }
					Cumulative = true
					HitShipOnly = true
				}
			]
		}

