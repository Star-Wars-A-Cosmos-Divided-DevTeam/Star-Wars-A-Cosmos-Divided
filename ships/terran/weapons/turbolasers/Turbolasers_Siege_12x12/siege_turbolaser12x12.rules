OVERCLOCK
{
	BULLET  = &<../../../../../shots/laser/turret/concussion/heavy/overclock/oc_base_shot.rules>

	BLUEBULLET  = &<../../../../../shots/laser/turret/concussion/heavy/overclock/oc_blue_shot.rules>
	GREENBULLET = &<../../../../../shots/laser/turret/concussion/heavy/overclock/oc_green_shot.rules>
	REDBULLET   = &<../../../../../shots/laser/turret/concussion/heavy/overclock/oc_red_shot.rules>

	// Rate-of-fire scaler (2 = twice as fast)
	FIRE_RATE_FACTOR = 2

	// OC spread/recoil modifiers
	HALF_SPREAD   = (&~/Part/Components/WeaponEmitterBase/Spread/1) / 2
	RECOIL_FACTOR = 250%

	// Heat hookup
	HEAT_PER_SHOT   = 7000
	HEAT_PER_SECOND = 240

	// Stun scaling
	CREW_STUN_DURATION = ((&~/Part/Components/StunEffect/HitEffects/0/Duration/BaseValue) * 3)
	CREW_STUN_RADIUS   = ((&~/Part/Components/StunEffect/HitEffects/0/Radius/BaseValue) * 3)
}

// Heat Producers
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS   = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO


Part : &<../base_part_terran_turbolasers_overclock.rules>/Part
{
	//IDs
	ID = SW.siege_turbolaser12x12

	//StringKeys
	NameKey = "Parts/SiegeTurbolaser12x12"
	IconNameKey = "Parts/SiegeTurbolaser12x12Icon"
	DescriptionKey = "Parts/SiegeTurbolaser12x12Desc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups ["WeaponsEnergy", SWTechIII]
	TypeCategories : ^/0/TypeCategories [weapon, uses_power, is_crewed]
	RequiresCategories = [SW_WarRoom]

	//Resources&Size&Health
	Resources
	[
		[steel, 288]
		[SW.durasteel, 1200]
		[SW.doonium_ingot, 1000]
		[coil2, 175]
		[processor, 60]
	]
	Size = [12, 12]
	MaxHealth = 168000

	//Rects

	//Selections
	SelectionPriority = 1
	SelectionTypeID = "cannons" 
	//SelectionTypeByRotation = true

	//PartSpecific
	AIValueFactor = 4
	InitialPenetrationResistance = 15
	//	Density = 1 + (&~/Part/TurretDensity)
	TurretDensity = 5
	SignificanceToggle = ScorchedToggle

	//ReceivableBuffs&ProhibitedBy
	ReceivableBuffs : ^/0/ReceivableBuffs [/*SWWeaponTimerBuff*/]

	//Doors&Etc
	ForceManhattenPathInPart = true
	AllowedDoorLocations
	[
		[1, -1]
		[1, 12]
		[2, -1]
		[2, 12]
		[4, 12]
		[5, 12]
		[6, 12]
		[7, 12]
		[9, -1]
		[9, 12]
		[10, -1]
		[10, 12]
		[-1, 1]
		[12, 1]
		[-1, 2]
		[12, 2]
		[-1, 4]
		[12, 4]
		[-1, 5]
		[12, 5]
		[-1, 6]
		[12, 6]
		[-1, 7]
		[12, 7]
		[-1, 9]
		[12, 9]
		[-1, 10]
		[12, 10]
	]


	//BlockedTravelCells
	//[
	//	[5, 1]
	//	[6, 1]
	//	[5, 2]
	//	[6, 2]
	//	[5, 3]
	//	[6, 3]
	//	[5, 4]
	//	[6, 4]
	//	[5, 5]
	//	[6, 5]
	//	[5, 6]
	//	[6, 6]
	//	[5, 7]
	//	[6, 7]
	//	[5, 8]
	//	[6, 8]
	//]
	BlockedTravelCellDirections
	[
		{
			Key = [3, 1]
			Value = [Right]
		}
		{
			Key = [4, 0]
			Value = [Down]
		}
		{
			Key = [7, 0]
			Value = [Down]
		}
		{
			Key = [8, 1]
			Value = [Left]
		}
		{
			Key = [5, 10]
			Value = [Up]
		}
		{
			Key = [6, 10]
			Value = [Up]
		}
		{
			Key = [3, 2]
			Value = [Right]
		}
		{
			Key = [3, 3]
			Value = [Right]
		}
		{
			Key = [8, 2]
			Value = [Left]
		}
		{
			Key = [8, 3]
			Value = [Left]
		}
		{
			Key = [4, 8]
			Value = [Right]
		}
		{
			Key = [7, 8]
			Value = [Left]
		}
		{
			Key = [4, 9]
			Value = [Right]
		}
		{
			Key = [7, 9]
			Value = [Left]
		}
		{
			Key = [5, 0]
			Value = [Down]
		}
		{
			Key = [6, 0]
			Value = [Down]
		}
	]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [70, 92]
	}

	//Components
	Components : ^/0/Components
	{
		IsOperational : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [PowerToggle, PartCrew, BatteryStorage]
			Mode = All
		}
		
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = PowerToggle
			CommandPoints = 20
		}
		//OverclockSettings

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		OverheatEffects : ^/0/OverheatEffects
		{
			Location = [6, 6]
		}

		WeaponEmitterProxy
		{
			Type = EmitterProxy
			ComponentID = WeaponEmitter
			ChainedTo = Turret
		}
		WeaponEmitter2Proxy : WeaponEmitterProxy
		{
			ComponentID = WeaponEmitter2
		}

		Overclock_EmissionTriggered
		{
			Type = MultiTrigger
			OperationalToggle = IsOverclocked
			Triggers = [ WeaponEmitterProxy, WeaponEmitter2Proxy ]
		}
		Overclock_ConstantHeatProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperationalOverclocked
			HEAT_PER_INTERVAL = ceil((&~/OVERCLOCK/HEAT_PER_SECOND) * (&Interval))
			ToQuantity = (&HEAT_PER_INTERVAL) * (&~/HEAT_TO_RESOURCE)
			ToStorage  = &~/Part/^/0/HEAT_TARGET_STORAGE
			Interval = 0.5
		}
		Overclock_ShotHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_EmissionTriggered
			Amount = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
		}


		// Thermal Ports
		Port_Thermal_TopLeft : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 0]
			Direction = Left
		}
		Port_Thermal_LeftUp : Port_Thermal_TopLeft
		{
			Direction = Up
		}
		Port_Thermal_TopRight : Port_Thermal_LeftUp
		{
			Location = [11, 0]
			Direction = Right
		}
		Port_Thermal_RightUp : Port_Thermal_TopRight
		{
			Direction = Up
		}
		Port_Thermal_BottomRight : Port_Thermal_RightUp
		{
			Location = [11, 11]
			Direction = Right
		}
		Port_Thermal_RightDown : Port_Thermal_BottomRight
		{
			Direction = Down
		}
		Port_Thermal_BottomLeft : Port_Thermal_RightDown
		{
			Location = [0, 11]
			Direction = Left
		}
		Port_Thermal_LeftDown : Port_Thermal_BottomLeft
		{
			Direction = Down
		}
		Port_Thermal_MidUp3 : Port_Thermal_LeftDown
		{
			Location = [3, 0]
			Direction = Up
		}
		Port_Thermal_MidUp4 : Port_Thermal_MidUp3
		{
			Location = [4, 0]
		}
		Port_Thermal_MidUp5 : Port_Thermal_MidUp4
		{
			Location = [5, 0]
		}
		Port_Thermal_MidUp6 : Port_Thermal_MidUp5
		{
			Location = [6, 0]
		}
		Port_Thermal_MidUp7 : Port_Thermal_MidUp6
		{
			Location = [7, 0]
		}
		Port_Thermal_MidUp8 : Port_Thermal_MidUp7
		{
			Location = [8, 0]
		}
		Port_Thermal_MidRight3 : Port_Thermal_MidUp8
		{
			Location = [11, 3]
			Direction = Right
		}
		Port_Thermal_MidRight8 : Port_Thermal_MidRight3
		{
			Location = [11, 8]
		}
		Port_Thermal_MidDown8 : Port_Thermal_MidRight8
		{
			Location = [8, 11]
			Direction = Down
		}
		Port_Thermal_MidDown3 : Port_Thermal_MidDown8
		{
			Location = [3, 11]
		}
		Port_Thermal_MidLeft8 : Port_Thermal_MidDown3
		{
			Location = [0, 8]
			Direction = Left
		}
		Port_Thermal_MidLeft3 : Port_Thermal_MidLeft8
		{
			Location = [0, 3]
		}


		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}

		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}

		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}

		FireAlternatingToggle
		{
			Type = UIToggle
			ToggleID = "fire_alternating"
			Default = 0
		}

		MunitionType
		{
			Type = UIToggle
			ToggleID = "SW.munition_type"
			Default = 0
			AvailableChoices = [0, 1, 2]
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}
		RedMunitionToggle
		{
			Type = ModeToggle
			Mode = MunitionType
			OnMode = 0
		}
		BlueMunitionToggle
		{
			Type = ModeToggle
			Mode = MunitionType
			OnMode = 1
		}
		GreenMunitionToggle
		{
			Type = ModeToggle
			Mode = MunitionType
			OnMode = 2
		}
		// ---- RED: Non-OC ----
		RedMunitionNonOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ RedMunitionToggle, {Toggle=IsOverclocked; Invert=true} ]
			Mode = All
		}
		RedMunitionComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = RedMunitionNonOC_Toggle
			IncludeInBlueprints = false
			Components = &<siege12x12red.rules>/Components
		}

		RedMunitionOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ RedMunitionToggle, IsOverclocked ]
			Mode = All
		}
		RedMunitionComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = RedMunitionOC_Toggle
			IncludeInBlueprints = false
			Components : &<siege12x12red.rules>/Components
			{
				WeaponEmitter  : ^/0/WeaponEmitter
				{
					Bullet  = &~/OVERCLOCK/REDBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
				}
				WeaponEmitter2 : ^/0/WeaponEmitter2
				{
					Bullet  = &~/OVERCLOCK/REDBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
				}
			}
		}


		// ---- BLUE: Non-OC ----
		BlueMunitionNonOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ BlueMunitionToggle, {Toggle=IsOverclocked; Invert=true} ]
			Mode = All
		}
		BlueMunitionComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = BlueMunitionNonOC_Toggle
			IncludeInBlueprints = false
			Components = &<siege12x12blue.rules>/Components
		}

		// ---- BLUE: OC ----
		BlueMunitionOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ BlueMunitionToggle, IsOverclocked ]
			Mode = All
		}
		BlueMunitionComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = BlueMunitionOC_Toggle
			IncludeInBlueprints = false
			Components : &<siege12x12blue.rules>/Components
			{
				WeaponEmitter  : ^/0/WeaponEmitter
				{
					Bullet  = &~/OVERCLOCK/BLUEBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
				}
				WeaponEmitter2 : ^/0/WeaponEmitter2
				{
					Bullet  = &~/OVERCLOCK/BLUEBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
				}
			}
		}

		// ---- GREEN: Non-OC ----
		GreenMunitionNonOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ GreenMunitionToggle, {Toggle=IsOverclocked; Invert=true} ]
			Mode = All
		}
		GreenMunitionComponents_NonOverclocked
		{
			Type = ToggledComponents
			Toggle = GreenMunitionNonOC_Toggle
			IncludeInBlueprints = false
			Components = &<siege12x12green.rules>/Components
		}

		GreenMunitionOC_Toggle
		{
			Type = MultiToggle
			Toggles = [ GreenMunitionToggle, IsOverclocked ]
			Mode = All
		}
		GreenMunitionComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = GreenMunitionOC_Toggle
			IncludeInBlueprints = false
			Components : &<siege12x12green.rules>/Components
			{
				WeaponEmitter  : ^/0/WeaponEmitter
				{
					Bullet  = &~/OVERCLOCK/GREENBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
				}
				WeaponEmitter2 : ^/0/WeaponEmitter2
				{
					Bullet  = &~/OVERCLOCK/GREENBULLET
					Spread  = [-(&~/OVERCLOCK/HALF_SPREAD), (&~/OVERCLOCK/HALF_SPREAD)]
					Recoil  = (&^/0/Recoil) * (&~/OVERCLOCK/RECOIL_FACTOR)
				}
			}
		}

		ExteriorType
		{
			Type = UIToggle
			ToggleID = "SW.exterior_type"
			Default = 0
			ToggledOnChoices = [0,1]
		}

		WhiteExteriorToggle
		{
			Type = ModeToggle
			Mode = ExteriorType
			OnMode = 0
		}
		WhiteExteriorComponents
		{
			Type = ToggledComponents
			Toggle = WhiteExteriorToggle
			//IncludeInBlueprints = true
			Components = &<turbolaser_siege_white.rules>/Components
		}
		GreyExteriorToggle
		{
			Type = ModeToggle
			Mode = ExteriorType
			OnMode = 1
		}
		GreyExteriorComponents
		{
			Type = ToggledComponents
			Toggle = GreyExteriorToggle
			//IncludeInBlueprints = true
			Components = &<turbolaser_siege_grey.rules>/Components
		}

		AmmoPrereq
		{
			Type = MultiResourceStorage
			ResourceType = battery
			ResourceStorages = [BatteryStorage]
			//ToggleOnResources = 19001
			//ToggleOffResources = 3750
		}
		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 20000
			ToggleOnResources = 10001
			ReceiveResourceMediaEffects = &/SW_SOUNDS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			ResupplyThreshold = 1000
			OperationalToggle = PowerToggle

		}

		Turret
		{
			Type = TurretWeapon
			Location = [6, 6] // Relative to upper-left corner of unrotated part.
			Rotation = -90d // Relative to unrotated part.
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = 0 // Uses separate fire timer.
			FiringArc = 120d //180d
			RotateSpeed = 3d
			FireThresholdAngle = 1d
			HoldTargetAfterCancel = 0.5
			AIFirepowerRating = 10000
			FirePermissionToggle = FirePermissionToggle //FireModeToggle //FirePermissionToggle
			IgnoreSourceShipLOSChecks = true
			IgnoreSourceShipLowLOSChecks = true
			AllowFireWithBlockedLOS = false
			Emitter = WeaponEmitterBase

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}

		IsFireSynchronised_NonOverclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, IsOverclocked ]
			// ON when Alternating is OFF and Overclock is OFF
			Mode = None
		}
		IsFireSynchronised_Overclock
		{
			Type = MultiToggle
			Toggles = [ {Toggle=FireAlternatingToggle; Invert=true}, IsOverclocked ]
			// ON when Alternating is OFF and Overclock is ON
			Mode = All
		}
		IsFireAlternating_NonOverclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, {Toggle=IsOverclocked; Invert=true} ]
			// ON when Alternating is ON and Overclock is OFF
			Mode = All
		}
		IsFireAlternating_Overclock
		{
			Type = MultiToggle
			Toggles = [ FireAlternatingToggle, IsOverclocked ]
			// ON when Alternating is ON and Overclock is ON
			Mode = All
		}

		// Synchronized (both barrels) — Overclocked
		ShootSynchronizedComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = IsFireSynchronised_Overclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					DURATION_BASE = (&~/Part/Components/ShootSynchronizedComponents/Components/FireTimer/Duration)
					Duration = (&DURATION_BASE) / (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					AutoStart = true
					StartTrigger = Turret
				}
				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				// Add these so the emitters actually fire in OC
				ShootLeftTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
				ShootRightTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
			}
		}


		// Alternating (per barrel) — Overclocked
		ShootAlternatingComponents_Overclocked
		{
			Type = ToggledComponents
			Toggle = IsFireAlternating_Overclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					DURATION_BASE = (&~/Part/Components/ShootAlternatingComponents/Components/FireTimer/Duration)
					Duration = (&DURATION_BASE) / (&~/OVERCLOCK/FIRE_RATE_FACTOR)
					AutoStart = true
					StartTrigger = Turret
				}
				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				// Add these so alternating works in OC
				ShootCycle
				{
					Type = ModeCycle
					ModeRange = [0, 1]
					IncrementTrigger = Turret
					StartingMode = 1
				}
				ShootLeftTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [0]
				}
				ShootRightTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [1]
				}
			}
		}



		//Non-OC
		ShootSynchronizedComponents
		{
			Type = ToggledComponents
			Toggle = IsFireSynchronised_NonOverclock
			//Invert = true
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					Duration = 6.25*2  //2.25*2
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				ShootLeftTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}

				ShootRightTrigger
				{
					Type = TriggerProxy
					ComponentID = Turret
				}
			}
		}

		ShootAlternatingComponents
		{
			Type = ToggledComponents
			Toggle = IsFireAlternating_NonOverclock
			Components
			{
				FireTimer
				{
					Type = Timer
					OperationalToggle = IsOperational
					Duration = 6.25 //2.25
					AutoStart = true
					StartTrigger = Turret
				}

				ReloadProgressBar
				{
					Type = ProgressBar
					OperationalToggle = IsOperational
					ShowProgressFor = FireTimer
					Invert = true
				}

				ShootCycle
				{
					Type = ModeCycle
					ModeRange = [0, 1]
					IncrementTrigger = Turret
					StartingMode = 1 // First shot will switch to mode 0.
				}

				ShootLeftTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [0]
				}

				ShootRightTrigger
				{
					Type = ModeTrigger
					Mode = ShootCycle
					TriggerInModes = [1]
					OperationalToggle = FireAlternatingToggle
				}
			}
		}

		FireTimerProxy
		{
			Type = ToggleProxy
			ComponentID = FireTimer
		}
		FirePermissionToggle
		{
			Type = MultiToggle
			Toggles = [FireTimerProxy, FireModeToggle]
			Mode = All
		}

		ShootTrigger1
		{
			Type = TriggerProxy
			ComponentID = ShootLeftTrigger
		}
		ShootTrigger2
		{
			Type = TriggerProxy
			ComponentID = ShootRightTrigger
		}

		WeaponEmitterBase // Doesn't actually fire; only used for targeting and as a base for the left and right emitters.
		{
			Type = BulletEmitter
			ChainedTo = Turret
			FireTrigger // none, but field is required
			GetTargetFrom = Turret
			Location = [0, 0]
			OperationalToggle = IsOperational
			//FireDelay = .1
			Bullet = &/SW_SHOTS/Laser/Turret/Concussion/Heavy/Green
			SourceShipCollisions = false
			TargetLeadPrediction = false
			ResourceStorage = BatteryStorage
			ResourcesUsed = 3000
			Recoil = 750
			AntiPhasingRaycastDistance = 5
			Spread = [-1.5d, 1.5d]
		}

	
