Components
{
		WeaponEmitter : &<siege_turbolaser12x12.rules>/Part/Components/WeaponEmitterBase
		{
			Type = BulletEmitter
			ChainedTo = Turret
			FireTrigger = ShootTrigger1
			GetTargetFrom = Turret
			Location = [9.328125, -1]  //-64,-629
			OperationalToggle = IsOperational
			Bullet = &/SW_SHOTS/Laser/Turret/Concussion/Heavy/Red
			SourceShipCollisions = false
			FireDelay = .5
			ResourceStorage = BatteryStorage
			AntiPhasingRaycastDistance = 5
		}
		WeaponEmitter2 : &WeaponEmitter
		{
			FireTrigger = ShootTrigger2
			Location = [9.328125, 1]
		}

		FireEffect
		{
			Type = TriggeredEffects

			ChainedTo = WeaponEmitter
			Trigger = WeaponEmitter
			AnchorMediaEffects = true

			MediaEffects

			[

				&/SW_SOUNDS/SiegeTurbolaserSFX
				&/SW_PARTICLES/Shot/Laser/Shoot/Large/Red
				&/SW_PARTICLES/Shot/Laser/Flash/Large/Red
				&/SW_PARTICLES/Shot/Laser/Flare/Large/Red
				&<./Data/ships/terran/cannon_deck/particles/cannon_smoke_deck.rules>//&<../Turbolasers_Flak_Cannon/particles/flak_cannon_shoot_flash_large.rules> // &/SW_PARTICLES/SWFlakLargeFlash &<./Data/ships/terran/point_defense/particles/flak_cannon_shoot_flash_large.rules>

				: /BASE_SHAKE
				{
					ShakeAmount = .3
					Duration = 1
				}

			] 
		}
		FireEffect2 : FireEffect
		{
			ChainedTo = WeaponEmitter2
			Trigger = WeaponEmitter2
		}
}
