//Toggle 0 (Default)
		NozzleArtOptionToggle0
		{
			Type = ModeToggle
			Mode = NozzleArtOptionToggle
			OnMode = 0
		}
		NozzleArtOptionComponents0
		{
			Type = ToggledComponents
			Toggle = NozzleArtOptionToggle0
			Components
			{
				NozzleGraphics
				{
					Type = Graphics
					Location = [1.5, 1.5]
					Floor
					{
						Layer = "weapons"
						Offset = [0, 1.5 + .75]
						DamageLevels
						[
							{
								File = "nozzle.png"
								NormalsFile = "nozzle_normals.png"
								Size = [3.0, 1.5]
							}
							{
								File = "nozzle_33.png"
								NormalsFile = "nozzle_normals_33.png"
								Size = [3.0, 1.5]
							}
							{
								File = "nozzle_66.png"
								NormalsFile = "nozzle_normals_66.png"
								Size = [3.0, 1.5]
							}
						]
					}
				}
				NozzleCollider
				{
					Type = PolygonCollider
					Vertices
					[
						[0.0643, 3]
						[0.1643, 3.66]
						[2.8357, 3.66]
						[2.9357, 3]
					]
					Density = 1 //1.35 why?
				}
				NozzleOutputPosition
				{
					Type = ContinuousEffects
					MediaEffects = []
					Rotation = 90d
					Location = [1.5, 4]
				}
				LightGraphics2
				{
					Type = Graphics
					Location = [1.5, 4.5]
					OperationalToggle = IsOperational
					GetColorFrom = ColorPickerThruster

					AnimationSpeedFactor = DoodadAnimationSpeedFactorValue
					AnimationSpeedFactorRenormalize = [0.64, 2.7]

					OperationalLighting
					{
						Layer = "lights_add"
						DamageLevels
						[
							{
								AnimationFiles
								[
									"lights_1_bleached_B.png"
									"lights_2_bleached_B.png"
								]
								Size = [3, 3]
								AnimationInterval = 0.1
							}
						]
					}
				}
			}
		}

