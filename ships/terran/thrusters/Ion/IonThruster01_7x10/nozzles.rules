//Toggle 0 (Default)
		NozzleArtOptionToggle0
		{
			Type = ModeToggle
			Mode = NozzleArtOptionToggle
			OnMode = 0
		}
		NozzleArtOptionComponents0
		{
			Type = ToggledComponents
			Toggle = NozzleArtOptionToggle0
			Components
			{
				NozzleGraphics
				{
					Type = Graphics
					Location = [3.5, 5]
					Floor
					{
						Layer = "weapons"
						Offset = [0, 6.75] //4.32
						DamageLevels
						[
							{
								File = "../Ion_Common/IonThruster_thruster_nozzle[2,1]01.png"
								NormalsFile = "../Ion_Common/IonThruster_thruster_nozzle[2,1]01_normals.png"
								Size = [7, 3.5]
							}
						]
					}
				}
				NozzleCollider
				{
					Type = PolygonCollider
					Vertices
					[
						[0.15, 10]
						[0.15, 12.5]
						[6.85, 12.5]
						[6.85, 10]
					]
					Density = 1
				}
				NozzleOutputPosition
				{
					Type = ContinuousEffects
					MediaEffects = []
					Rotation = 90d
					Location = [3.5, 12.5]
				}
			}
		}

//Toggle 1 (Standard)
		NozzleArtOptionToggle1
		{
			Type = ModeToggle
			Mode = NozzleArtOptionToggle
			OnMode = 1
		}
		NozzleArtOptionComponents1
		{
			Type = ToggledComponents
			Toggle = NozzleArtOptionToggle1
			Components
			{
				NozzleGraphics
				{
					Type = Graphics
					Location = [3.5, 5]
					Floor
					{
						Layer = "weapons"
						Offset = [0, 5+(((7*4)/10)/2)]//Original offset plus ( ( ( [width of part] * [lenght of sprite] ) / [width of sprite] ) / half (sprite is centered) )
						DamageLevels
						[
							{
								File = "../Ion_Common/IonThruster_thruster_nozzle[3,1]01.png"
								NormalsFile = "../Ion_Common/IonThruster_thruster_nozzle[3,1]01_normals.png"
								Size = [(7*10)/10, (7*4)/10]//(WIDTH * SPRITEWIDTH)/SPRITEWIDTH (redundant but yeah.),    (WIDTH * SPRITELENGHT)/SPRITEWIDTH
							}
						]
					}
				}
				NozzleCollider
				{
					Type = PolygonCollider
					Vertices
					[
						[0.15, 10]
						[1.15, 12.2]
						[5.85, 12.2]
						[6.85, 10]
					]
					Density = 1
				}
				NozzleOutputPosition
				{
					Type = ContinuousEffects
					MediaEffects = []
					Rotation = 90d
					Location = [3.5, 12.2]
				}
			}
		}

