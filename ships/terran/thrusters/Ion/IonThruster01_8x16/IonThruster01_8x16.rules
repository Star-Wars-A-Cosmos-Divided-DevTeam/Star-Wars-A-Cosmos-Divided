		DoodadGraphicsCombined01
		{
			Type = Graphics
			OperationalToggle = IsOperational

			Location = [4, 5]//[4, 9 + 57/64 + 1/256]

			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "IonThruster_doodad_1.png" //"../Ion_Common/IonThruster_doodads_combined.png"
						Size = [6, 8] // scaled down by 30%
						//Size = [8, 10]
					}
				]
			}
			NonOperationalDoodad = &OperationalDoodad
		}
		DoodadGraphicsCombined02 : &DoodadGraphicsCombined01
		{
			Location = [4, 13]

			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "IonThruster_doodad_1.png" //"../Ion_Common/IonThruster_doodads_combined.png"
