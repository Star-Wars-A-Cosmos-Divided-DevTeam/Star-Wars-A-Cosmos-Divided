			Toggle = NozzleArtOptionToggle16
			Components
			{
				NozzleGraphics
				{
					Type = Graphics
					Location = [4, 8] // Centered within the part
					Floor
					{
						Layer = "weapons"
						Offset = [0, 8 + 3.2 -.0125] // Correct offset calculation
						DamageLevels
						[
							{
								File = "../Ion_Common/IonThruster_thruster_nozzle[2,1]16.png"
								NormalsFile = "../Ion_Common/IonThruster_thruster_nozzle[2,1]16_normals.png"
								Size = [8, 6.4] // Scaled size
							}
						]
					}
				}
				NozzleCollider
				{
					Type = PolygonCollider
					Vertices
					[
						[0.2, 16]
						[0.2, 20]
						[7.8, 20]
						[7.8, 16]
					]
					Density = 1
				}
				NozzleOutputPosition
				{
					Type = ContinuousEffects
					MediaEffects = []
					Rotation = 90d
					Location = [4, 16 + 6.4 - 0.0125] // Positioned at the end of the nozzle sprite
				}
			}
		}

