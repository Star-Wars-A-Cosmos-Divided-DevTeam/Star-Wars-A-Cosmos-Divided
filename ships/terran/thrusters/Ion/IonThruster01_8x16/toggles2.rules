//Toggle 18 (Type E)
		NozzleArtOptionToggle18
		{
			Type = ModeToggle
			Mode = NozzleArtOptionToggle
			OnMode = 18
		}
		NozzleArtOptionComponents18
		{
			Type = ToggledComponents
			Toggle = NozzleArtOptionToggle18
				Components
			{
				NozzleGraphics
				{
					Type = Graphics
					Location = [4, 8]
					Floor
					{
						Layer = "weapons"
						Offset = [0, 8+(((8*3)/10)/2)]//Original offset plus ( ( ( [width of part] * [lenght of sprite] ) / [width of sprite] ) / half (sprite is centered) )
						DamageLevels
						[
							{
								File = "../Ion_Common/IonThruster_thruster_nozzle[3,1]18.png"
								NormalsFile = "../Ion_Common/IonThruster_thruster_nozzle[3,1]18_normals.png"
								Size = [(8*10)/10, (8*3)/10]//(WIDTH * SPRITEWIDTH)/SPRITEWIDTH (redundant but yeah.),	(WIDTH * SPRITELENGHT)/SPRITEWIDTH
							}
						]
					}
				}
				NozzleCollider
				{
					Type = PolygonCollider
					Vertices
					[
						[0.15, 16]
						[1.65, 17.75]
						[6.35, 17.75]
						[7.85, 16]
					]
					Density = 1
				}
				NozzleOutputPosition
				{
					Type = ContinuousEffects
					MediaEffects = []
					Rotation = 90d
					Location = [4, 16 + 2.4 - (2.4*.19)] // Positioned at the end of the nozzle sprite
				}
			}
		}



