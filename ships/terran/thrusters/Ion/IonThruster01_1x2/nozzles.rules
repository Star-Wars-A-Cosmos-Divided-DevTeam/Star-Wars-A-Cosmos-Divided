						[
							{
								File = "../Ion_Common/Nozzles_128x/IonThruster_thruster_nozzle[3,1]01.png"
								NormalsFile = "../Ion_Common/Nozzles_128x/IonThruster_thruster_nozzle[3,1]01_normals.png"
								Size = [1, 1]//(WIDTH * SPRITEWIDTH)/SPRITEWIDTH (redundant but yeah.),	(WIDTH * SPRITELENGHT)/SPRITEWIDTH
