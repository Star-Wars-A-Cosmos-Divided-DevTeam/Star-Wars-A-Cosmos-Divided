CLASSIFICATION = Large
SIZE = [2, 3]
LOCATION = [((&~/SIZE/0)/2), ((&~/SIZE/1)/2)]
//UPSCALER = 100%

OVERCLOCK : &<./Data/ships/terran/thruster_boost/thruster_boost.rules>/OVERCLOCK
{
	//THRUST_FACTOR = 250%
	//MAX_POWER_USAGE_FACTOR = 175%
	//POWER_USAGE_FACTOR = 1 / (&THRUST_FACTOR) * (&MAX_POWER_USAGE_FACTOR)
	//THRUST_HEAT_PER_SECOND = 675

	//BASE_BOOST_HEAT_FACTOR = 175%
	//BOOST_HEAT_FACTOR_PER_BATTERY = 20%
	//BOOST_HEAT_FACTOR_PER_SECOND = -6%
	//BOOST_HEAT_FACTOR_POWER_THRESHOLD = (&~/Part/Components/RealBatteryStorage/MaxResources)

	//BOOST_MAX_POWER_USAGE_FACTOR = 175%
	//BOOST_POWER_RAMP_TIME = 2
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

Part : &<../base_part_terran_thrusters_ion.rules>/Part
{
	//IDs
	ID = SW.IonThruster01_2x3_switchable
	//OtherIDs = [IonThruster01_2x3, SW.IonThruster01_2x3]

	//StringKeys
	NameKey = "Parts/IonThruster01_2x3"
	IconNameKey = "Parts/IonThruster01_2x3_Icon"
	DescriptionKey = "Parts/IonThruster01_2x3_Desc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups [Flight, SWTechII]
	TypeCategories : ^/0/TypeCategories [thruster, ion_thruster, self_buffing, uses_power, SW_Tech_II]
	//RequiresCategories = []

	//Resources&Size&Health
	Resources
	[
		[steel, 70]//125%*56 of vanilla
		//[coil, 0]//133%*0 of vanilla
		[coil2, 12]//120%*10 of vanilla
		[SW.durasteel, 10]//120%*8 of vanilla
	]
	Size = [2, 5]
	MaxHealth = 4900 //4860 //81% of vanilla 1000 per tile

	//Rects
	PhysicalRect = [0, 0, 2, 3]
	SaveRect = &PhysicalRect
	BoundingRectType = Physical

	//Selections
	SelectionPriority = 1
	SelectionTypeByRotation = true
	SelectionTypeID = "ion_thrusters"

	//PartSpecific
	ThrusterForce = 5120 		//v:3200		//160%*3200 of vanilla = 5120 managed thru ramping buff 
	ThrustIncreaseTime
	{ 
		BaseValue=2
		Modifiers
		[
			{
				Type = Buff
				BuffType=SW_Ion_Thruster_Boost_RampUpFinal
				ModificationMode = Divide
			}
			{
				Type = BuffRemap
				BuffType = Overclock
				ModificationMode = Divide
				RemapFrom = [0, 1]
				RemapTo = [1, (&~/OVERCLOCK/THRUST_FACTOR)]
			}
		]
	}
	ThrustDecreaseTime = 0 	//v:0			//softer deccel
	ThrustRecoveryTime = 2.0
	FuelUsage = 128 			//v:200			// 64%*200 of vanilla
	
	//Boosted
	BoostedThrusterForce = 15360		//ONLY HERE FOR STAT DISPLAY
	BoostedThrustIncreaseTime = 0		//ONLY HERE FOR STAT DISPLAY
	BoostedThrustDecreaseTime = 0		//ONLY HERE FOR STAT DISPLAY
	BoostedThrustRecoveryTime = 0		//ONLY HERE FOR STAT DISPLAY
	BoostedFuelUsage = 384				//ONLY HERE FOR STAT DISPLAY
	BoostedPowerDrain = { BaseValue=-10; BuffType=Engine; BuffMode=Multiply; }
	BoostedPowerDrainInterval = 0.1
	BOOSTED_BASE_POWER_DRAIN_PER_SEC = (&BoostedPowerDrain/BaseValue) / (&BoostedPowerDrainInterval)
	
	//ReceivableBuffs&Prohibits
	//
	ProhibitBelow = 18			//v:18
	ReceivableBuffs : ^/0/ReceivableBuffs [SW_Hypernode_Interface, SW_Ion_Thruster_Boost, SW_Ion_Thruster_Boost_Thrust, SW_Ion_Thruster_Boost_RampUp, SW_Ion_Thruster_Boost_RampUpFinal]

	//Doors&Etc
	ForceManhattenPathInPart = true
	BlockedTravelCells
	[
		//[0, 1]
		//[1, 1]
		//[2, 1]
		[0, 2]
		[1, 2]
		//[2, 2]
		//[0, 3]
		//[1, 3]
		//[2, 3]
		//[0, 4]
		//[1, 4]
		//[2, 4]
	]
	AllowedDoorLocations
	[
		[-1, 0]
		//[-1, 1]
		//[-1, 2]
		[0, -1]
		[1, -1]
		//[2, -1]
		//[1, 0]
		//[2, -1]
		[2, 0]
		//[3, -1]
		//[3, 0]
		//[3, 1]
		//[3, 2]
		//[4, 0]
		//[4, 1]
		//[4, 2]
	]
	//

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [42.66, 106.66]
	}

	//Components&Inheritance
	Components : ^/0/Components //, &<nozzles.rules>, &<nozzle_covers.rules> /*@Rojamahorse where?*/
	{
		IsOperational : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [PowerToggle, RealBatteryStorage]
			Mode = All
		}

		CommandConsumptionToggle : ^/0/CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [PowerToggle]
			Mode = All
		}

		CommandToggle
		{
			Type = CommandToggle
		}

		IsOperationalAndHypernodeConnectedToggle
		{
			Type = MultiToggle
			Toggles = [IsOperational, HypernodeConnectedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 6
		}

		HypernodeConnectedToggle
		{
			Type = BuffToggle
			BuffType = SW_Hypernode_Interface
		}

		EngineBuffToggle
		{
			Type = BuffToggle
			BuffType = Engine
		}

		PowerDistributionBuffToggle
		{
			Type = BuffToggle
			BuffType = EnginePowerDistribution
		}

		BoostToggle
		{
			Type = UIToggle
			ToggleID = "thruster_boost"
			Default = 0
			AutoOffTrigger = AutoBoostOffTrigger
			OperationalToggle = IsOperational
			RememberValue = false
		}

		RealBatteryStorage // Can't call this "BatteryStorage" because we don't want it fillable via the engine room when in boost mode. We define a proxy to it below.
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 8000 //v:6000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
			ToggleOnResources = (&MaxResources) - 999
			ToggleOffResources = 0
			ProvidedValueRange = 0
			ProvidedValuePerResource = 1
		}

		PowerDrainTimer
		{
			Type = Timer
			OperationalToggle = BoostToggle
			Duration = &~/Part/BoostedPowerDrainInterval
			AutoStart = true
			Repeats = true
		}

		PowerDrain
		{
			Type = ResourceChange
			Trigger = PowerDrainTimer
			ResourceStorage = RealBatteryStorage
			Amount = &~/Part/BoostedPowerDrain
			InitialDelay = 0
		}

		FullAmmoToggle
		{
			Type = MultiResourceStorage
			ResourceType = battery
			ResourceStorages = [RealBatteryStorage]
			ToggleOnResources = &../RealBatteryStorage/MaxResources
			ToggleOffResources = (&ToggleOnResources) - 1
		}

		BoostOffInstantDrainToggles
		{
			Type = MultiToggle
			Toggles = [BoostToggle, CommandConsumptionToggle]
			Mode = All
		}

		BoostOffInstantDrainTrigger
		{
			Type = ToggleTrigger
			Toggle = BoostOffInstantDrainToggles
			TriggerWhenOn = false
			TriggerWhenOff = true
			OperationalToggle = FullAmmoToggle
			InvertOperationalToggle = true
		}

		BoostOffInstantDrain
		{
			Type = ResourceChange
			Trigger = BoostOffInstantDrainTrigger
			ResourceStorage = RealBatteryStorage
			Amount = -999999
		}

		AutoBoostOffTrigger
		{
			Type = MultiTrigger
			Triggers = [ BatteryDepletedTrigger, OverclockDisabledTrigger ]
		}

		BatteryDepletedTrigger
		{
			Type = ToggleTrigger
			Toggle = RealBatteryStorage
			TriggerWhenOn = false
			TriggerWhenOff = true
		}

		CanReceivePower
		{
			Type = MultiToggle
			Toggles
			[
				{ Toggle = BoostToggle; Invert = true }
				IsOverclocked
			]
			Mode = Any
		}

		BatteryStorage
		{
			Type = ResourceStorageProxy
			ProxyToggle = CanReceivePower
			ResourceType = battery
			ComponentID = RealBatteryStorage
		}
		ToggledBatteryConsumer
		{
			Type = ToggledComponents
			Toggle = PowerDistributionBuffToggle
			Invert = true
			IncludeInBlueprints = true
			Components
			{
				BatteryConsumer
				{
					Type = ResourceConsumer
					ResourceType = battery
					Storage = BatteryStorage
					DefaultPriority = &/PRIORITIES/Thruster_Supply
					ResupplyThreshold = 500
					OperationalToggle = CommandConsumptionToggle
				}
			}
		}
		BatteryStorageBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperationalAndNotBoostToggle
			ShowProgressFor = RealBatteryStorage
			LowColor = [64, 64, 0]
			HighColor = [250, 250, 0]
			FullColor = [255, 255, 0]
		}

		ColorPickerThruster
		{
			Type = UIColor
			ColorID = "SW_Part_ThrusterColor"
			Default = [83, 122, 255, 255]//.85 saturation
			AlwaysAllowInBuildMode = false
			RequiresCommand = true
		}

		ThrusterEffectType
		{
			Type = UIToggle
			ToggleID = "SW.thruster_effect_type"
			Default = 5
			AvailableChoices = [0, 1, 3, 5]
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}

		ThrusterEffectGlowToggle
		{
			Type = ModeToggle
			Mode = ThrusterEffectType
			OnModes = [0, 1, 2]
		}

		ThrusterEffectSparksToggle
		{
			Type = ModeToggle
			Mode = ThrusterEffectType
			OnModes = [1, 3]
		}

		ThrusterEffectFullsetToggle
		{
			Type = ModeToggle
			Mode = ThrusterEffectType
			OnModes = [2, 4]
		}

		ThrusterEffectRocketToggle
		{
			Type = ModeToggle
			Mode = ThrusterEffectType
			OnModes = [5]
		}

		IsThrusterEffectGlowToggleAndNotBoostToggle
		{
			Type = MultiToggle
			Toggles = [ThrusterEffectGlowToggle,  {Toggle = BoostToggle; Invert = true},]
			Mode = All
		}

		IsThrusterEffectSparksToggleAndNotBoostToggle
		{
			Type = MultiToggle
			Toggles = [ThrusterEffectSparksToggle,  {Toggle = BoostToggle; Invert = true},]
			Mode = All
		}

		IsThrusterEffectFullsetToggleAndNotBoostToggle
		{
			Type = MultiToggle
			Toggles = [ThrusterEffectFullsetToggle,  {Toggle = BoostToggle; Invert = true},]
			Mode = All
		}

		IsThrusterEffectRocketToggleAndNotBoostToggle
		{
			Type = MultiToggle
			Toggles = [ThrusterEffectRocketToggle,  {Toggle = BoostToggle; Invert = true},]
			Mode = All
		}

		ThrusterEffectGlowComponents
		{
			Type = ToggledComponents
			Toggle = IsThrusterEffectGlowToggleAndNotBoostToggle
			Components = &<particles/thruster_colorable_glow.rules>/Components
		}

		ThrusterEffectSparksComponents
		{
			Type = ToggledComponents
			Toggle = IsThrusterEffectSparksToggleAndNotBoostToggle
			Components = &<particles/thruster_colorable_sparks.rules>/Components
		}

		ThrusterEffectFullsetComponents
		{
			Type = ToggledComponents
			Toggle = IsThrusterEffectFullsetToggleAndNotBoostToggle
			Components = &<particles/thruster_colorable_fullset.rules>/Components
		}

		ThrusterEffectRocketsetComponents
		{
			Type = ToggledComponents
			Toggle = IsThrusterEffectRocketToggleAndNotBoostToggle
			Components = &<particles/thruster_colorable_rocketset.rules>/Components
		}

		HypernodeEffectComponents
		{
			Type = ToggledComponents
			Toggle = IsOperationalAndHypernodeConnectedToggle
			Components = &<particles/thruster_cyan_hypernodeset.rules>/Components
		}

		ThrusterEffectBoostsetComponents
		{
			Type = ToggledComponents
			Toggle = BoostToggle
			Components = &<particles/thruster_colorable_boostset.rules>/Components
		}

		IsOperationalAndNotBoostToggle
		{
			Type = MultiToggle
			Toggles = [IsOperational,  {Toggle = BoostToggle; Invert = true},]
			Mode = All
		}

		MainThrusterLocationProxy
		{
			Type = ChainableProxy
			ComponentID = MainThruster
		}

		MainThrusterValueProxy
		{
			Type = ValueProxy
			ComponentID = MainThruster
			ValueWhenNotConnected = 0
		}

		ReverseThrusterValueProxy
		{
			Type = ValueProxy
			ComponentID = ReverseThruster
			ValueWhenNotConnected = 0
		}

		BurstTriggerProxy
		{
			Type = TriggerProxy
			ComponentID = BurstTrigger
		}

		HypernodeEffectValue
		{
			Type = BuffableValue
			Value = { BaseValue=0; BuffType=SW_Hypernode_Interface; BuffMode=Add; }
		}

		DoodadAnimationSpeedFactorValue
		{
			Type = MultiValue
			Values = [MainThrusterValueProxy, ReverseThrusterValueProxy]
			Mode = Add
		}

		RampProgressBar
		{
			Type = ProgressBar
			OperationalToggle = ThrusterIsFiringThresholdToggle
			ShowProgressFor = MainThrusterValueProxy
			LowColor = [0, 0, 0]
			HighColor = [250, 250, 250]
			FullColor = [255, 255, 255]
		}

		ThrusterIsFiringThresholdToggle
		{
			Type = ThresholdToggle
			ValueFrom = MainThrusterValueProxy
			MinAmount = 10%
		}

		EngineBuffProvider
		{
			Type = SelfBuffProvider
			BuffType = SW_Ion_Thruster_Boost
			ChainsFromBuffType = Engine
			BuffAmount = { BaseValue=-100%; BuffType=Engine; BuffMode=Add; }
			OperationalToggle = EngineBuffToggle
		}

		ThrustBuffProvider
		{
			Type = SelfBuffProvider
			BuffType =	SW_Ion_Thruster_Boost_Thrust
			ChainsFromBuffType = SW_Ion_Thruster_Boost
			BuffAmount = { BaseValue=100%; BuffType=SW_Ion_Thruster_Boost; BuffMode=Add; }
			BuffMultiplier = BoostTween
			OperationalToggle = IsOperational
		}
		BoostTween
		{
			Type = ValueTween
			OffValue = 1
			OnValue = 3
			OnTweenDuration = 0
			OffTweenDuration = 0
			IsOnToggle = BoostToggle
		}

		BoostProgressBar
		{
			Type = ProgressBar
			OperationalToggle = BoostToggle
			ShowProgressFor = RealBatteryStorage
			LowColor = [64, 0, 64]
			HighColor = [0, 0, 255]
			FullColor = [0, 0, 255]
		}

		RampUpBuffProvider
		{
			Type = SelfBuffProvider
			BuffType =	SW_Ion_Thruster_Boost_RampUp
			ChainsFromBuffType = SW_Ion_Thruster_Boost_Thrust
			BuffAmount = { BaseValue=0%; BuffType=SW_Ion_Thruster_Boost_Thrust; BuffMode=Add; }
			OperationalToggle = BoostToggle
		}

		RampUpFinalBuffProvider
		{
			Type = SelfBuffProvider
			BuffType =	SW_Ion_Thruster_Boost_RampUpFinal
			ChainsFromBuffType = SW_Ion_Thruster_Boost_RampUp
			BuffAmount = { BaseValue=100%; BuffType=SW_Ion_Thruster_Boost_RampUp;  BuffMode=Multiply; MaxValue=900%; }
		}

		//OC START

		IsOverclockedBoosting
		{
			Type = MultiToggle
			Toggles = [ IsOverclocked, BoostToggle ]
			Mode = All
		}

		Overclock_OnBoostPowerUsed
		{
			Type = ValueChangeTrigger
			OperationalToggle = IsOverclockedBoosting
			ValueSource = RealBatteryStorage
			TriggerOnIncrease = false
		}

		Overclock_TotalBoostPowerUsed
		{
			Type = ValueAccumulator
			OperationalToggle = IsOverclockedBoosting
			NonOperationalBehaviour = Reset
			AccumulatingToggle = Overclock_IsThrusterActive
			THRUST_DISSIPATION_PER_SECOND = -(&~/OVERCLOCK/BOOST_HEAT_FACTOR_PER_SECOND) / (&~/OVERCLOCK/BOOST_HEAT_FACTOR_PER_BATTERY)
			DISSIPATION_PER_SECOND = (&THRUST_DISSIPATION_PER_SECOND)
			DissipationRate
			{
				BaseValue = (&../DISSIPATION_PER_SECOND) * 1000
				Modifiers
				[
					{
						Type = ScaledBuff
						BuffType = Engine
						Scale = -(&~/Part/BOOSTED_BASE_POWER_DRAIN_PER_SEC)
						ModificationMode = Add
					}
				]
			}
			MinValue = 0
			AccumulationTriggers
			[
				{
					Trigger = Overclock_OnBoostPowerUsed
					// Negative to flip the sign of the negative resource change value
					Value = { BaseValue = -1; EffectScaleExponent = 1; }
					AllowWhenNonOperational = false
				}
			]
		}
		Overclock_RampingBoostPowerUseFactor
		{
			Type = ValueAccumulator
			OperationalToggle = IsOverclockedBoosting
			NonOperationalBehaviour = Reset
			AccumulatingToggle = Overclock_IsThrusterActive
			AccumulationRate = 1 / (&~/OVERCLOCK/BOOST_POWER_RAMP_TIME)
			DissipationRate = &AccumulationRate
			MinValue = 0
			MaxValue = 1
		}
		Overclock_BoostPowerUseBuff
		{
			Type = SelfBuffProvider
			BuffType = BoostOverclockPowerRamp
			BuffMultiplier = Overclock_RampingBoostPowerUseFactor
		}
		Overclock_BoostPowerUseBar
		{
			Type = ProgressBar
			OperationalToggle = IsOverclockedBoosting
			ShowProgressFor = Overclock_RampingBoostPowerUseFactor
			LowColor = [201, 239, 0]
			HighColor = [201, 239, 0]
			FullColor = [201, 239, 0]
		}

		Overclock_BoostHeatFactorPowerThreshold
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/BOOST_HEAT_FACTOR_POWER_THRESHOLD)
		}

		Overclock_BoostPowerUsedOverThreshold
		{
			Type = ValueOperation
			Operator = Subtract
			ValueOne = Overclock_TotalBoostPowerUsed
			ValueTwo = Overclock_BoostHeatFactorPowerThreshold
			MinValue = 0
		}

		Overclock_BoostHeatFactorPerPower
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/BOOST_HEAT_FACTOR_PER_BATTERY) / 1000
		}

		Overclock_BoostPowerUsedAdditionalHeatFactor
		{
			Type = MultiValue
			Values = [Overclock_BoostHeatFactorPerPower, Overclock_BoostPowerUsedOverThreshold]
			Mode = Multiply
		}
		Overclock_BoostBaseHeatFactor
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/BASE_BOOST_HEAT_FACTOR)
		}
		Overclock_BaseHeatFactor
		{
			Type = ToggleValueSelector
			Toggle = BoostToggle
			ToggleOffValue = One
			ToggleOnValue = Overclock_BoostBaseHeatFactor
		}
		Overclock_BoostPowerUsedHeatFactor
		{
			Type = MultiValue
			Values = [One, Overclock_BoostPowerUsedAdditionalHeatFactor]
			Mode = Add
		}

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		Overclock_CombinedHeatInput
		{
			Type = MultiResourceStorage
			ResourceType = heat
			ResourceStorages = [ NetworkHeatInput ]
			ViaBuffs
			{
				IncomingBuffTypes = [ EngineHeatCollection ]
				ComponentIDs = [ EngineHeatCollectionStorage ]
			}
		}

		// Overriding to use the combined heat input
		HeatDistributionStorage : ^/0/HeatDistributionStorage
		{
			ResourceStorages = [Overclock_CombinedHeatInput, OverflowHeatStorage]
		}

		Overclock_ThrusterHeatProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperationalOverclocked
			HEAT_PER_INTERVAL = ceil((&~/OVERCLOCK/THRUST_HEAT_PER_SECOND) * (&Interval))
			ToQuantity
			{
				BaseValue = (&../HEAT_PER_INTERVAL) * (&~/HEAT_TO_RESOURCE)
				BuffType = ThermalActivity
				BuffMode = Multiply
			}
			ToStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Interval = 0.5
		}

		Overclock_ActivationBuff
		{
			Type = SelfBuffProvider
			BuffType = ThermalActivity
			BuffMultiplier = Overclock_HeatProductionFactor
		}

		Overclock_HeatProductionFactor
		{
			Type = MultiValue
			Values = [Overclock_BoostPowerUsedHeatFactor, Overclock_SmoothedThrusterActivation]
			Mode = Multiply
		}

		Overclock_SmoothedThrusterActivation
		{
			Type = SmoothedValue
			ValueSource = Overclock_NormalizedThrusterActivation
			MaxDelta = 1 / (&../Overclock_ThrusterHeatProducer/Interval)
		}

		Overclock_NormalizedThrusterActivation
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = MainThrusterValueProxy
			ValueTwo = Overclock_MaxActivation
		}

		//Overclock_CombinedThrusterActivation
		//
			//
			//
			//
		//
		Overclock_IsThrusterActive
		{
			Type = ThresholdToggle
			ValueFrom = MainThrusterValueProxy
			MinAmount = 0
			MaxAmount = 0
			Invert = true
		}

		Overclock_MaxActivation
		{
			Type = BuffableValue
			Value = &~/Part/Components/MainThruster/MaxActivation
		}

		Port_Thermal_Left : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 0]
			Direction = Left
		}
		Port_Thermal_LeftUp : Port_Thermal_Left
		{
			Direction = Up
		}
		Port_Thermal_RightUp : Port_Thermal_LeftUp
		{
			Location = [1, 0]
		}
		Port_Thermal_Right : Port_Thermal_Left
		{
			Location = [1, 0]
			Direction = Right
		}

		//OC END

		FloorGrid : &/SW_GRAPHICS/FloorGrid/GridSize_1x1/Floor_01/RDL
		{
			
		}

		LightGraphics
		{
			Type = Graphics
			Location = [1, 2.5]
			OperationalToggle = IsOperational
			GetColorFrom = ColorPickerThruster

			AnimationSpeedFactor = DoodadAnimationSpeedFactorValue
			AnimationSpeedFactorRenormalize = [0.64, 2.7]

			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"lights_1_bleached.png"
							"lights_2_bleached.png"
						]
						Size = [2, 5]
						AnimationInterval = 0.1
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_high"
				Offset = [0, -1]
				DamageLevels
				[
					{
						AnimationFiles
