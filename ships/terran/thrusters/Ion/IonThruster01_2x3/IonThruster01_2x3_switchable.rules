		OperationEffects
		{
			Type = ToggleEffects
			Location = [1, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}

		ScorchedEffects : ^/0/ScorchedEffects
		{
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/MedPartScorched //Small Med Big Huge
		}

		DestroyedEffects
		{
			Type = DeathEffects
			Location = [1, 1.5]
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1, 1.5]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3]
				}

				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2,3]
				}

				// Out of power.
				{
					Toggle = RealBatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}

				// Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [2, 5]
		}

		// Since heat ramps during refuelled boost, this just provides the base boost peak heat
		PeakHeatGenerationValue
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/THRUST_HEAT_PER_SECOND) * (&~/OVERCLOCK/BASE_BOOST_HEAT_FACTOR)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationValue
		}
	}

	//Stats
	Stats
	{
		//
		//
		//
		//
		PowerCapacity = (&~/Part/Components/RealBatteryStorage/MaxResources) / 1000

		RecPower = ((&../StatsByCategory/1/Stats/ThrusterPowerUsage) + (&../StatsByCategory/1/Stats/BoostedPowerUsageContinuous)) / 2
		RecCrew = (&RecPower) * 4
	}

	StatsByCategory
	[
		{
			NameKey = "StatCategories/BoostOff"
			Stats
			{
				ThrusterForce = &~/Part/ThrusterForce
				ThrusterRampUp = ceil(&~/Part/ThrustIncreaseTime/BaseValue)
				ThrusterRampDown = ceil(&~/Part/ThrustDecreaseTime)
				ThrusterPowerUsage = (&~/Part/FuelUsage) / 1000
			}
		}
		{
			NameKey = "StatCategories/BoostOn"
			Stats
			{
				ThrusterForce = &~/Part/BoostedThrusterForce
				ThrusterRampUp = ceil(&~/Part/BoostedThrustIncreaseTime)
				ThrusterRampDown = ceil(&~/Part/BoostedThrustDecreaseTime)
				ThrusterPowerUsage = (&~/Part/BoostedFuelUsage) / 1000
				BoostedPowerUsageContinuous = -(&~/Part/BoostedPowerDrain/BaseValue) / (&~/Part/BoostedPowerDrainInterval) / 1000
			}
		}
		{
			NameKey = "StatCategories/EngineBuff"
			Stats
			{
				ThrusterBuff =  (&<./Data/ships/terran/engine_room/engine_room.rules>/Part/Components/BuffProvider/BuffAmount) * 100
			}
		}
	]

	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/ThrusterBoostOverclockDesc"
		Stats
		{
			ThrusterForce = (&~/Part/ThrusterForce) * (&~/OVERCLOCK/THRUST_FACTOR)
			ThrusterHeatGeneration = &~/OVERCLOCK/THRUST_HEAT_PER_SECOND
			ThrusterPowerUsage = (&~/Part/FuelUsage) * (&~/OVERCLOCK/MAX_POWER_USAGE_FACTOR) / 1000
		}
		StatsByCategory
		[
			{
				NameKey = "StatCategories/OverclockedBoost"
				Stats
				{
					ThrusterForce = (&~/Part/BoostedThrusterForce) * (&~/OVERCLOCK/THRUST_FACTOR)
					BASE_THRUSTER_POWER_USAGE = (&~/Part/BoostedFuelUsage) * (&~/OVERCLOCK/MAX_POWER_USAGE_FACTOR) / 1000
					ThrusterPowerUsageRamp = [&../BASE_THRUSTER_POWER_USAGE, (&../BASE_THRUSTER_POWER_USAGE) * (&~/OVERCLOCK/BOOST_MAX_POWER_USAGE_FACTOR)]
					ThrusterPowerUsageRampTime = (&~/OVERCLOCK/BOOST_POWER_RAMP_TIME)
					BaseHeatFactor = [(&~/OVERCLOCK/BASE_BOOST_HEAT_FACTOR) * 100, (&~/OVERCLOCK/THRUST_HEAT_PER_SECOND) * (&~/OVERCLOCK/BASE_BOOST_HEAT_FACTOR)]
					BoostHeatFactorPerBattery = (&~/OVERCLOCK/BOOST_HEAT_FACTOR_PER_BATTERY) * 100
					BoostHeatFactorPerSecond = (&~/OVERCLOCK/BOOST_HEAT_FACTOR_PER_SECOND) * 100
					BoostHeatFactorBatteryThreshold = (&~/OVERCLOCK/BOOST_HEAT_FACTOR_POWER_THRESHOLD) / 1000
				}
				Features
				[
					CanReceivePower
				]
			}
		]
	}
}