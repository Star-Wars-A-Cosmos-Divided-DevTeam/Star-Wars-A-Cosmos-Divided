//Toggle 0 (Default)
		NozzleArtOptionToggle0
		{
			Type = ModeToggle
			Mode = NozzleArtOptionToggle
			OnMode = 0
		}
		NozzleArtOptionComponents0
		{
			Type = ToggledComponents
			Toggle = NozzleArtOptionToggle0
			Components
			{
				NozzleGraphics
				{
					Type = Graphics
					Location = [5, 7]
					Floor
					{
						Layer = "weapons"
						Offset = [0, 9.5]
						DamageLevels
						[
							{
								File = "../Ion_Common/IonThruster_thruster_nozzle[2,1]01.png"
								NormalsFile = "../Ion_Common/IonThruster_thruster_nozzle[2,1]01_normals.png"
								Size = [10, 5]
							}
						]
					}
				}
				NozzleCollider
				{
					Type = PolygonCollider
					Vertices
					[
						[0.15, 14]
						[0.15, 17.57]
						[9.85, 17.57]
						[9.85, 14]
					]
					Density = 1
				}
				NozzleOutputPosition
				{
					Type = ContinuousEffects
					MediaEffects = []
					Rotation = 90d
					Location = [5, 17.57]
				}
			}
		}

