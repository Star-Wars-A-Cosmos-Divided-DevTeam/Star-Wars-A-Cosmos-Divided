				NozzleCollider
				{
					Type = PolygonCollider
					Vertices
					[
						[0.25, 26]
						[0.25, 33.2]
						[19.75, 33.2]
						[19.75, 26]
					]
					Density = 1
				}
				NozzleOutputPosition
				{
					Type = ContinuousEffects
					MediaEffects = []
					Rotation = 90d
					Location = [10, 33.2]
				}
			}
		}
		
