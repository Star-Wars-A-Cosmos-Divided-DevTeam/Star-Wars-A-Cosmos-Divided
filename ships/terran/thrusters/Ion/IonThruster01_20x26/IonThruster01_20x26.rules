	DoodadGraphics1
	{
		Type = Graphics
		Location = [10-3.4, 16] // Scaled location
		OperationalToggle = IsOperational

		Floor
		{
			Layer = "doodads_low"
			DamageLevels
			[
				{
					File = "DoodadXLR.png"
					Size = [6.9, 19.9]
					MirrorU = true
				}
				/*
				{
