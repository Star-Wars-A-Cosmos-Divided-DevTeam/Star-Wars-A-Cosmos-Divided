		MainThruster
		{
			Type = Thruster
			Location = [10, 26.5]// Relative to upper-left corner of unrotated part.
			Rotation = 90d// Relative to unrotated part.
			SoftOperationalToggle = IsOperational
			Force = &../../ThrusterForce
			MinActivation = 0
			MaxActivation
			{
				BaseValue=1;
				Modifiers
				[
					{
						Type = Buff
						BuffType = SW_Ion_Thruster_Accelerator_Thrust
						ModificationMode = Multiply
					}
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/THRUST_FACTOR)]
					}
				]
				MinValue=(&BaseValue)/10
				MaxValue=(&BaseValue)*10
			}
			MinUncommandedActivation = &MinActivation
			MaxUncommandedActivation = &MaxActivation
			ActivationIncreaseTime = &../../ThrustIncreaseTime
			ActivationDecreaseTime = &../../ThrustDecreaseTime
			ActivationRecoveryTime = &../../ThrustRecoveryTime
			FuelStorage = BatteryStorage
			FuelUsagePerSecond
			{
				BaseValue = &~/Part/FuelUsage
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/POWER_USAGE_FACTOR)]
					}
				]
			}
		}
		LateralThruster : MainThruster
		{
			Rotation = 0d
			MinActivation = -0.05
			MaxActivation = 0.05
			ActivationIncreaseTime = &../../ThrustIncreaseTime/BaseValue
			ActivationRecoveryTime = &../../ThrustRecoveryTime/BaseValue
			MinUncommandedActivation = &MinActivation
			MaxUncommandedActivation = &MaxActivation
			AllowAutoFire = false
		}
		ReverseThruster : MainThruster
		{
			Rotation = -90d
			MinActivation = 0
			MaxActivation = 0.20
			ActivationIncreaseTime = &../../ThrustIncreaseTime/BaseValue
			ActivationRecoveryTime = &../../ThrustRecoveryTime/BaseValue
			MinUncommandedActivation = &MinActivation
			MaxUncommandedActivation = &MaxActivation
			FuelUsagePerSecond
			{
				BaseValue = ceil((&~/Part/FuelUsage)*2.5)
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/POWER_USAGE_FACTOR)]
					}
				]
			}
			AllowAutoFire = false
		}

		ThrustEffectsSounds
		{
			Type = ContinuousEffects
			ChainedTo = MainThrusterLocationProxy
			FactorMediaEffectsIntensityWith = DoodadAnimationSpeedFactorValue
			IntensityTweenDuration = 0.1
			MinMediaEffectsIntensity = 1%
			MediaEffects
			[
				: /SW_SOUNDS/ThrusterRumble
				{
					Volume = 1.125
					Speed = 1.5
					MaxConcurrentVolume = 1.25
				}
			]
		}

		BurstTrigger
		{
			Type = ThresholdTrigger
			AmountFrom = MainThrusterValueProxy
			MinAmount = 0.5
		}

		BurstEffectsSounds
		{
			Type = TriggeredEffects
			ChainedTo = MainThrusterLocationProxy
			Trigger = BurstTrigger
			FactorMediaEffectsIntensityWith = MainThrusterValueProxy
			MinMediaEffectsIntensity = 1%
			AnchorMediaEffects = true
			MediaEffects
			[
				: /SW_SOUNDS/ThrusterBurst
				{
					Volume = 1.25
					Speed = 1.5
					MaxConcurrentVolume = 1.5
				}
			]
		}

