	DoodadGraphics2
	{
		Type = Graphics
		Location = [13.4, 26-10] // Scaled location
		OperationalToggle = IsOperational
	
		Floor
		{
			Layer = "doodads_low"
			DamageLevels
			[
				{
					File = "DoodadXLR.png"
					Size = [6.9, 19.9]
				}
				/*
