CLASSIFICATION = Giga
SCALE = (1)
SIZE = [20, 26]
SIZE_2 = (&~/SIZE/0) * (&~/SIZE/1)
MULTIPLIKATOR = (&~/SCALE) * (&~/SIZE/0) * (&~/SIZE/1)
NOZZLE_OFFSET = 7
LOCATION = [((&~/SIZE/0)/2), ((&~/SIZE/1)/2)]
MAXHEALTH = 810

UPSCALER = 175%

OVERCLOCK : &<./Data/ships/terran/thruster_huge/thruster_huge.rules>/OVERCLOCK
{
	THRUST_FACTOR = (ceil((&^/0/THRUST_FACTOR)/1.6*100)/100)									//v:2				//2/1.6 = 1.875 ~= 1.87
	MAX_POWER_USAGE_FACTOR = &^/0/MAX_POWER_USAGE_FACTOR										//v:1.5				//
	POWER_USAGE_FACTOR = (ceil((1 / (&THRUST_FACTOR) * (&MAX_POWER_USAGE_FACTOR))*100)/100)		//v:1/2*1.5=0.75	//1/1.87*1.5 = 0.80 ~= 0.80
	//POWER_GENERATION_FACTOR																	//					//
	THRUST_HEAT_PER_SECOND = (floor(((&^/0/THRUST_HEAT_PER_SECOND)*(&~/UPSCALER))/1.6/10)*10)	//v:1100			//1100/1.6*1.75 = 1203.125 ~= 1200
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

Part : &<../base_part_terran_thrusters_ion.rules>/Part
{
	//IDs
	ID = SW.IonThruster01_20x26_switchable
	OtherIDs = ["IonThruster01_20x26","SW.IonThruster01_20x26"]

	//StringKeys
	NameKey = "Parts/IonThruster01_20x26"
	IconNameKey = "Parts/IonThruster01_20x26_Icon"
	DescriptionKey = "Parts/IonThruster01_20x26_Desc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups [ SWTechIII]
	TypeCategories : ^/0/TypeCategories [ftl, thruster, ion_thruster, uses_power, SW_Hypernodes, SW_Tech_III]
	RequiresCategories = [SW_Bridge]

	//Resources&Size&Health
	Resources
	[
		[steel, 3600] //80/9*20*26=4622*81%
		//[coil, 0]//133%*0 of vanilla
		[coil2, 920] //20/9*20*26=1155*81%
		//[SW.durasteel, 692]//120%*577 of vanilla		//10/9*20*26=577*81%
	]
	Size = [&~/SIZE/0, ((&~/SIZE/1) + (&~/NOZZLE_OFFSET))]
	MaxHealth = (ceil((&~/MAXHEALTH)*(&~/MULTIPLIKATOR)/1000)*1000)	//420000 //421.200 //81% of vanilla 1000 per tile

	//Rects
	PhysicalRect = [0, 0, &~/SIZE/0, &~/SIZE/1]
	SaveRect = &PhysicalRect
	BoundingRectType = Physical

	//Selections
	SelectionPriority = 1
	SelectionTypeByRotation = true
	SelectionTypeID = "ion_thrusters"

	//PartSpecific
	ThrusterForce = 560000 //554.320 //75%sizedegrade*[normalized] 160% of vanilla 1000*8/9 per tilee 
	ThrustIncreaseTime
	{
		BaseValue = 21		//v:4		//160%*175% of vanilla
		Modifiers
		[
			{
				Type = Buff
				BuffType = SW_Ion_Thruster_Accelerator_RampUpFinal
				ModificationMode = Divide
			}
			{
				Type = BuffRemap
				BuffType = Overclock
				ModificationMode = Divide
				RemapFrom = [0, 1]
				RemapTo = [1, (&~/OVERCLOCK/THRUST_FACTOR)]
			}
		]
		MinValue=(&BaseValue)/10
		MaxValue=(&BaseValue)*10
	}
	ThrustDecreaseTime : ThrustIncreaseTime
	{	
		BaseValue = (&^/0/BaseValue) / 3
		MinValue=(&BaseValue)/10
		MaxValue=(&BaseValue)*10
	}				// = 4.8	//v:2		//softer deccel
	ThrustRecoveryTime : ThrustIncreaseTime
	{	
		BaseValue = (&^/0/BaseValue) * 2 / 3
		MinValue=(&BaseValue)/10
		MaxValue=(&BaseValue)*10
	}				// = 2.5	//v:0
	FuelUsage = 14800 //14.790 //160%*40% of vanilla 50*8/9 per tile

	//ReceivableBuffs&Prohibits
	//ProhibitRects
	ProhibitBelow = 20 // 32
	ReceivableBuffs : ^/0/ReceivableBuffs [Engine, EnginePowerDistribution, SW_Hypernode_Interface, SW_Ion_Thruster_Accelerator, SW_Ion_Thruster_Accelerator_Thrust, SW_Ion_Thruster_To_Accelerator, SW_Ion_Thruster_Accelerator_RampUp, SW_Ion_Thruster_Accelerator_RampUpFinal, SW_Display] 

	//Doors&Etc
	ForceManhattenPathInPart = true
	AllowedDoorLocations
	[
		[5, -1]
		[6, -1]
		[7, -1]
		[8, -1]
		[9, -1]
		[10, -1]
