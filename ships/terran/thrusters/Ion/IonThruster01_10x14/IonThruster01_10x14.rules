				{
					File = "../Ion_Common/batteries_3.png"
					Size = [6, 3]
				}
			]
		}
*/
		BatterySpritesHolder
		{
			Type = Graphics
			OperationalToggle = IsOperational
		
			Location = [5, 2.5]
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "../Ion_Common/IonThruster_battery_holder05.png"
						Size = [4, 1.6]  // Reduced by 20%
					}
				]
			}
			NonOperationalDoodad = &OperationalDoodad
		}
		
		BatterySprites
		{
			Type = ResourceSprites
			Location = &../BatterySpritesHolder/Location
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			HasZeroResourceSprite = false
			ResourceLevels
			[
				{
					File = "../Ion_Common/batteries_1.png"
					Offset = [-1, 0]
					Size = [2, 2]  // Reduced by 20%
				}
				{
					File = "../Ion_Common/batteries_2.png"
					//
					Size = [4, 2]  // Reduced by 20%
				}
				{
					File = "../Ion_Common/batteries_3.png"
					Size = [4, 2]  // Reduced by 20%
				}
				{
					File = "../Ion_Common/batteries_4.png"
					Size = [4, 2]  // Reduced by 20%
				}
				{
					File = "../Ion_Common/batteries_5.png"
					Size = [4, 2]  // Reduced by 20%
				}
				{
					File = "../Ion_Common/batteries_6.png"
					Size = [4, 2]  // Reduced by 20%
				}
				{
					File = "../Ion_Common/batteries_7.png"
					Size = [4, 2]  // Reduced by 20%
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Toggle = IsOperational
			Location = [5, 7]
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			Location = [5, 7]
			MediaEffects = &/COMMON_EFFECTS/HugePartDestroyed
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [5, 7]
			Indicators
			[
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [4, 4]
					}
					HidesIndicators = [1]
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [4, 4]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [10, 19.0625]
			Offset = [0, 0.53125]
		}
	}

	//Stats&StatsByCategory&StatsNotes
	Stats
	{
		ThrusterForce = &~/Part/ThrusterForce
		ThrusterRampUp = ceil(&~/Part/ThrustIncreaseTime/BaseValue)
		ThrusterRampDown = ceil(&~/Part/ThrustDecreaseTime)
		ThrusterPowerUsage = (&~/Part/FuelUsage) / 1000
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000

		RecPower = (&ThrusterPowerUsage) / 2
		RecCrew = (&RecPower) * 4
	}
	StatsByCategory
	[
		{
			NameKey = "StatCategories/EngineBuff"
			Stats
			{
				ThrusterBuff =  (&<./Data/ships/terran/engine_room/engine_room.rules>/Part/Components/BuffProvider/BuffAmount) * 100
			}
		}
	]
	StatsNotesKey = "Stats/SWIonAccelerator_Notes"
}
Size = Giga