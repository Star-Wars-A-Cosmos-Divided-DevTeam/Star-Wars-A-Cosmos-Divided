		OperationEffects
		{
			Type = ToggleEffects
			Toggle = IsOperational
			Location = [5, 7]
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}

		ScorchedEffects : ^/0/ScorchedEffects
		{
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/HugePartScorched //Small Med Big Huge
		}

		DestroyedEffects
		{
			Type = DeathEffects
			Location = [5, 7]
			MediaEffects = &/COMMON_EFFECTS/HugePartDestroyed
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [5, 7]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite : &/INDICATORS/Scorched
					{
						Size = [5, 5]
					}
					HidesIndicators = [1,2,3]
				}

				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [5, 5]
					}
					HidesIndicators = [2,3]
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [5, 5]
					}
				}

				// Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : &/INDICATORS/OverclockReset
					{
						Size = [3, 3]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [10, 19.0625]
			Offset = [0, 0.53125]
		}

		PeakHeatGenerationStatValue
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/THRUST_HEAT_PER_SECOND)
		}

		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationStatValue
		}
	}

	//Stats
	Stats
	{
		ThrusterForce = &~/Part/ThrusterForce
		ThrusterRampUp = &~/Part/ThrustIncreaseTime/BaseValue
		ThrusterRampDown = &~/Part/ThrustDecreaseTime/BaseValue
		ThrusterPowerUsage = (&~/Part/FuelUsage) / 1000
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000

		RecPower = (&ThrusterPowerUsage) / 2
		RecCrew = (&RecPower) * 4
	}

	StatsByCategory
	[
		{
			NameKey = "StatCategories/EngineBuff"
			Stats
			{
				ThrusterBuff =  (&<./Data/ships/terran/engine_room/engine_room.rules>/Part/Components/BuffProvider/BuffAmount) * 100
			}
		}
	]

	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/ThrusterLargeOverclockDesc"
		Stats
		{
			ThrusterForce = (&~/Part/ThrusterForce) * (&~/OVERCLOCK/THRUST_FACTOR)
			//PowerGeneration
			ThrusterHeatGeneration = &~/OVERCLOCK/THRUST_HEAT_PER_SECOND
			ThrusterPowerUsage = (&~/Part/FuelUsage) * (&~/OVERCLOCK/MAX_POWER_USAGE_FACTOR) / 1000
		}
	}
	StatsNotesKey = "Stats/SWIonAccelerator_Notes"
}