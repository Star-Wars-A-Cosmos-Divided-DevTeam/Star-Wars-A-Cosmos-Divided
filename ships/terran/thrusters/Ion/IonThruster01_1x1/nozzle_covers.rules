//Not Updated Yet Would like to add Y-Wing style roof covers to extend the tail of the thrusters.
        NozzleRoofCoverOptionToggle0
        {
            Type = ModeToggle
            Mode = NozzleRoofCoverOptionToggle
            OnMode = 0
        }
        
        NozzleRoofCoverOptionToggle1
        {
            Type = ModeToggle
            Mode = NozzleRoofCoverOptionToggle
            OnMode = 1
        }
        NozzleRoofCoverComponents1
        {
            Type = ToggledComponents
            Toggle = NozzleRoofCoverOptionToggle1
            //Invert = true
            Components
            {
                NozzleRoofCoverGraphics1
                {
                    Type = Graphics
                    Location = [.5, .5]
                    Roof
                    {
                        Layer = "SW.roof_engines"
                        Offset = [0, 2.5] // Offset X = 0 (no change) Offset Y = remainder of loc to end of part + half of roof cover Size height (Y) (e.g., Location of mid part = .5, .5, Roof Size = [1, 7] then offset for Y is .5 + 3.5 = 4)
                        DamageLevels
                        [
                            {
                                File = "../Ion_Common/Nozzle_Covers/SM/nozzle_cover_1.png"
                                NormalsFile =  "../Ion_Common/Nozzle_Covers/SM/nozzle_cover_1_normals.png"
                                Size = [2, 12]
                                //UVRotation = 2
                            }
                        ]
                    }
                }
            }
        }
