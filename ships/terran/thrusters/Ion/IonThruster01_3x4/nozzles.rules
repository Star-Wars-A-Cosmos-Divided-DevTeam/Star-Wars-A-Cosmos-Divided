/*Simplified Equation for math dumb-dumbs like me for calculating Width Height based on Original Sprite vs Target Size in game

Simplified Equation
For any given original size (in units 64 = 1 unit) ["𝑊orig","𝐻orig"] and target width "𝑊target":

𝐻target = "𝐻orig" * ("𝑊target" / "𝑊orig")
​
Explanation
Original Width (𝑊orig): The width of the sprite in its original form.
Original Height (𝐻orig): The height of the sprite in its original form.
Target Width (𝑊target: The width you WANT the sprite to be.
Target Height (𝐻target): The height the sprite SHOULD be, calculated to maintain the aspect ratio.

Example: I have a sprite that is originally [5, 7] I want it to be width of 2 units wide.
Original Width (𝑊orig): 5
Original Height (𝐻orig): 7
Target Width (𝑊target: 2
Target Height (𝐻target): "T" (Target)

T = 7 * (2 / 5) = 2.8 New Size = [2, 2.8]

*/

//Toggle 0 (Default)
		NozzleArtOptionToggle0
		{
			Type = ModeToggle
			Mode = NozzleArtOptionToggle
			OnMode = 0
		}
		NozzleArtOptionComponents0
		{
			Type = ToggledComponents
			Toggle = NozzleArtOptionToggle0
			Components
			{
				NozzleGraphics
				{
					Type = Graphics
					Location = [1.5, 5]
					Floor
					{
						Layer = "weapons"
						DamageLevels
						[
							{
								File = "nozzle.png"
								NormalsFile = "nozzle_normals.png"
								Size = [3.0, 2.0]
							}
							{
								File = "nozzle_33.png"
								NormalsFile = "nozzle_normals_33.png"
								Size = [3.0, 2.0]
							}
							{
								File = "nozzle_66.png"
								NormalsFile = "nozzle_normals_66.png"
								Size = [3.0, 2.0]
							}
						]
					}
				}
				NozzleCollider
				{
					Type = PolygonCollider
					Vertices
					[
						[0 + 13/64	, 4			]
						[3 - 13/64	, 4			]
						[3 - 4/64	, 5			]
						[3 - 4/64	, 5 + 26/64	]
						[0 + 4/64	, 5 + 26/64	]
						[0 + 4/64	, 5			]
					]
					Density = 1 //1.35 why, bcs its a nozzlee aka heavy idkkkk?
				}
				NozzleOutputPosition
				{
					Type = ContinuousEffects
					MediaEffects = []
					Rotation = 90d
					Location = [1.5, 5 + 26/64]
				}
				LightGraphics2
				{
					Type = Graphics
					Location = [1.5, 5.5]
					OperationalToggle = IsOperational
					GetColorFrom = ColorPickerThruster

					AnimationSpeedFactor = DoodadAnimationSpeedFactorValue
					AnimationSpeedFactorRenormalize = [0.64, 2.7]

					OperationalLighting
					{
						Layer = "lights_add"
						DamageLevels
						[
							{
								AnimationFiles
								[
									"lights_1_bleached_B.png"
									"lights_2_bleached_B.png"
								]
								Size = [3, 3]
								AnimationInterval = 0.1
							}
						]
					}
				}			
			}
		}

