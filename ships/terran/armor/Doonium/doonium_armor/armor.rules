SCALE = (1)
SIZE = [1, 1]
MULTIPLIKATOR = (&~/SCALE) * (&~/Size/0) * (&~/Size/1)
LOCATION = [((&~/Size/0)/2), ((&~/Size/1)/2)]

Part : &<../base_part_terran_doonium.rules>/Part
{
	//IDs
	ID = SW.doonium_armor
	OtherIDs = [doonium_armor]

	//StringKeys
	NameKey = "Parts/DooniumArmor"
	IconNameKey = "Parts/DooniumArmorIcon"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups [Defenses]
	TypeCategories : ^/0/TypeCategories []
	DontStackInEditorGroups = [SWDoonium]
	EditorParentParts = []

	//Resources&Size&Health
	Resources
	[
		[SW.doonium_ingot, ceil((&<../base_part_terran_doonium.rules>/Cost)*(&~/MULTIPLIKATOR))]
	]
	Size = [&~/SIZE/0, &~/SIZE/1]
	MaxHealth = floor((&<../base_part_terran_doonium.rules>/MaxHealth) * (&~/MULTIPLIKATOR))
	FractionalCostToRepair = (ceil((&Resources/0/1)/5)/(&Resources/0/1))

	//PartSpecific
	EditorReplacementPartID = corridor //""

	UnderlyingPartPerTile = "" //SW.structure_doonium
	UnderlyingPart = SW.structure_doonium

	IsRotateable = false //base true
	IsFlippable = false	//base true

	InitialPenetrationResistance = floor((&<../base_part_terran_doonium.rules>/InitialPenetrationResistance) * (&~/MULTIPLIKATOR))

	//ReceivableBuffs&Prohibits
	//ReceivableBuffs : ^/0/ReceivableBuffs []

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Point
			MipLevels = max
		}
		Size = [32, 32]
	}

	//Components&Inheritance
	Components : ^/0/Components //, &<roof_toggles.rules>
	{
/*
		ArmorRoofType
		{
			Type = UIToggle
			ToggleID = "SW.armor_roof_type"
			Default = 0
			AvailableChoices = [0, 1, 2, 3]
			RequiresCommand = false
		}

		VanillaArmorRoofToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofType
			OnMode = 0
		}

		OldArmorRoofToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofType
			OnMode = 1
		}

		BlankArmorRoofToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofType
			OnMode = 2
		}

		BoxedArmorRoofToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofType
			OnMode = 3
		}

		ArmorRoofNormalType
		{
			Type = UIToggle
			ToggleID = "SW.armor_roof_normal_type"
			Default = 0
			AvailableChoices = [0, 1, 2, 3]
			RequiresCommand = false
		}

		VanillaArmorRoofNormalToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofNormalType
			OnMode = 0
		}

		OldArmorRoofNormalToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofNormalType
			OnMode = 1
		}

		BlankArmorRoofNormalToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofNormalType
			OnMode = 2
		}

		BoxedArmorRoofNormalToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofNormalType
			OnMode = 3
		}
*/
		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = ceil((&~/Part/MaxHealth)/4)
			RecoveryRate = ceil(&AbsorbsResourceDrain) * 0.1
		}

		Graphics
		{
			Type = Graphics
			Location = [&~/LOCATION/0, &~/LOCATION/1]
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "armor.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "armor_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "armor_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "armor.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "armor_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "armor_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof_0.png"
						NormalsFile = "roof_0_normals.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "roof_0_33.png"
						NormalsFile = "roof_0_normals_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "roof_0_66.png"
						NormalsFile = "roof_0_normals_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [&~/LOCATION/0, &~/LOCATION/1]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [&~/SIZE/0, &~/SIZE/1]
		}
	}
	//Stats
	Stats
	{
		EMPResist = (&~/Part/Components/EmpAbsorber/AbsorbsResourceDrain) / 1000
		AOEResist = (&~/Part/DamageResistances/explosive) * 100
	}
}