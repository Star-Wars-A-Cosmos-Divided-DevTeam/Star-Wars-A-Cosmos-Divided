/**
 * Doonium armor base part definition.
 *  
 * @EditorGroup Doonium - Editor group name
 * @DescriptionKey Parts/DooniumArmor1x1Desc - Common Shared Localization key for description text
 * @Resources [[SW.doonium_ingot, 16]] - Resources required to construct this part
 * @FractionalCostToRepair 20% - Fraction of full cost to repair when damaged
 * @Density 4.5 - Part density
 * @ExplosiveDamageAbsorption 100% - Percentage of explosive damage absorbed
 * @ExplosiveDamageResistance 60% - Resistance to remaining explosive damage
 * @IsRotateable true - Part can be rotated
 * @IsFlippable true - Part can be flipped
 * @IsWalled true - Part is walled
 * @TypeCategories [dooniumarmor, armor] - Part type category tags 
 * @InitialPenetrationResistance 8 - Initial penetration resistance 
 * @ContinuingPenetrationResistance 4 - Continuing penetration resistance
 * @Components - Shared Components definitions 
*/

MaxHealth = 9000
Density = 4.5
InitialPenetrationResistance = 21
Cost = 10

Part : &<../base_part_terran_armor.rules>/Part
{
	//IDs

	//StringKeys
	DescriptionKey = "Parts/DooniumArmorDesc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups [SWDoonium]
	EditorParentParts = [ "SW.doonium_armor" ]
	TypeCategories : ^/0/TypeCategories [doonium_armor] //own type

	//Resources&Size&Health
	Resources
	[
		[SW.doonium_ingot, 10]
	]
	MaxHealth = 9000 //v:4000
	FractionalCostToRepair = (ceil((&Resources/0/1)/5)/(&Resources/0/1))

	//Selections
	SelectionTypeID = "doonium_armor" //armor stuff
	IgnoreRotationForMirroredSelection = true

	//PartSpecific

	//UnderlyingPartPerTile = SW.structure_doonium
	UnderlyingPart = "" //SW.structure_doonium

	InitialPenetrationResistance = 21 //common value// most files use own def
	ContinuingPenetrationResistance = (floor((&InitialPenetrationResistance)/2)) //shared scaler //shared across all

	FlipHRotate = [0, 3, 2, 1] //using vanila def mostly
	FlipVRotate = [2, 1, 0, 3] //using vanila def mostly

	ConstructionDuration = 0.5 //Buff
	RepairDuration = 0.5 //Buff

	Density = 4.5 //v:3? //1.5*v

	DamageResistances
	{
		explosive = 60%
		thermal = -30%
	}

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs []

	//Components&Inheritance
	Components : ^/0/Components
	{
		ConstructionStructureSprites : ^/0/ConstructionStructureSprites
		{
			AtlasSprite = &<../../structures/doonium/structure_1x1/structure_doonium.rules>/Part/Components/Graphics/Floor/DamageLevels/0
		}
	}
}