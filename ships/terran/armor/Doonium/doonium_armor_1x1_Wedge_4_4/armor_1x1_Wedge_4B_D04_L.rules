SCALE = (7/8)
SIZE = [1, 1]
MULTIPLIKATOR = (&~/SCALE) * (&~/Size/0) * (&~/Size/1)
LOCATION = [((&~/Size/0)/2), ((&~/Size/1)/2)]
COST = &<../base_part_terran_doonium.rules>/COST
MAXHEALTH = &<../base_part_terran_doonium.rules>/MAXHEALTH

Part : &<../base_part_terran_doonium.rules>/Part
{
	//IDs
	ID = SW.doonium_armor_1x1_Wedge_4B_D04_L
	OtherIDs = [SW.doonium_armor_1x1_Wedge_4B_D04_R]
	FlipWhenLoadingIDs = [SW.doonium_armor_1x1_Wedge_4B_D04_R]

	//StringKeys
	NameKey = "Parts/DooniumArmor_1x1_Wedge_4B_A01_L"
	IconNameKey = "Parts/DooniumArmor_1x1_Wedge_4B_A01_LIcon"

	//Resources&Size&Health
	Resources
	[
		[SW.doonium_ingot, ceil((&~/COST)*(&~/MULTIPLIKATOR))]
	]
	Size = [&~/SIZE/0, &~/SIZE/1]
	MaxHealth = ceil((&~/MAXHEALTH) * (&~/MULTIPLIKATOR))
	FractionalCostToRepair = (ceil((&Resources/0/1)/5)/(&Resources/0/1))

	//PartSpecific

	UnderlyingPartPerTile = SW.structure_doonium
	UnderlyingPart = "" //SW.structure_doonium

	//IsRotateable = true //base true
	IsFlippable = true

	FlipHRotate = [0, 3, 2, 1]
	FlipVRotate = [2, 1, 0, 3]

	AllowedContiguity = [Top, Right, Bottom]

	ExternalWalls = [/*Top,*/ TopRight, Right, BottomRight, Bottom, BottomLeft]
	//
		//
			//
				//
		//
		//
			//
				//
		//
		//
			//
				//
		//
		//
			//
				//
		//
	//
	InternalWalls = [Left/*, TopLeft, Top*/]
	//
		//
			//
				//
		//
		//
			//
				//
		//
		//
			//
				//
		//
		//
			//
				//
		//
	//
	VirtualInternalCells
	[
		{ExternalCell=[-1, 0]; InternalCell=[0, 1]}
			//
	]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}

	//Components&Inheritance
	Components : ^/0/Components //, &<roof_toggles.rules>
	{
		Collider
		{
			Type = PolygonCollider
			Vertices
			[
				[0.25, 0]
				[1, 0]
				[1, 1]
				[0, 1]
			]
		}
/*
		ArmorRoofType
		{
			Type = UIToggle
			ToggleID = "SW.armor_roof_type"
			Default = 0
			AvailableChoices = [0, 1, 2, 3]
			RequiresCommand = false
		}

		VanillaArmorRoofToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofType
			OnMode = 0
		}

		OldArmorRoofToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofType
			OnMode = 1
		}

		BlankArmorRoofToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofType
			OnMode = 2
		}

		BoxedArmorRoofToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofType
			OnMode = 3
		}

		ArmorRoofNormalType
		{
			Type = UIToggle
			ToggleID = "SW.armor_roof_normal_type"
			Default = 0
			AvailableChoices = [0, 1, 2, 3]
			RequiresCommand = false
		}

		VanillaArmorRoofNormalToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofNormalType
			OnMode = 0
		}

		OldArmorRoofNormalToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofNormalType
			OnMode = 1
		}

		BlankArmorRoofNormalToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofNormalType
			OnMode = 2
		}

		BoxedArmorRoofNormalToggle
		{
			Type = ModeToggle
			Mode = ArmorRoofNormalType
			OnMode = 3
		}
*/
		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = ceil((&~/Part/MaxHealth)/4)
			RecoveryRate = ceil(&AbsorbsResourceDrain)* 0.1
		}

		Graphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "armor.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_33.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_66.png"
						Size = [1, 1]
						UVRotation = 0
					}
				]
			}
			Walls
			{
				Layer = "external_walls"
				DamageLevels
				[
					{
						File = "armor.png"
						NormalsFile = "external_wall_normals.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_33.png"
						NormalsFile = "external_wall_normals_33.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_66.png"
						NormalsFile = "external_wall_normals_66.png"
						Size = [1, 1]
						UVRotation = 0
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof_0.png"
						NormalsFile = "roof_0_normals.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "roof_0_33.png"
						NormalsFile = "roof_0_normals_33.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "roof_0_66.png"
						NormalsFile = "roof_0_normals_66.png"
						Size = [1, 1]
						UVRotation = 0
					}
				]
			}
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [0.5, 0.5]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 1]
		}
	}

	Stats
	{
		EMPResist = (&~/Part/Components/EmpAbsorber/AbsorbsResourceDrain) / 1000
		AOEResist = (&~/Part/DamageResistances/explosive) * 100
	}
}