Part : &<../base_part_terran_doonium.rules>/Part
{
	NameKey = "Parts/DooniumArmor4x4"
	IconNameKey = "Parts/DooniumArmor4x4Icon"
	ID = SW.doonium_armor_4x4
	//EditorGroup = "Defenses"
	//DescriptionKey = "Parts/DooniumArmorDesc"
	EditorReplacementPartID = SW.doonium_armor
	MaxHealth = floor((&<../base_part_terran_doonium.rules>/MaxHealth) * (&~/Scale))	
	InitialPenetrationResistance = floor((&<../base_part_terran_doonium.rules>/InitialPenetrationResistance) * (&~/Scale))
	//Density = (^/0/Density)

	Resources
	[
		[SW.doonium_ingot, ceil((&<../base_part_terran_doonium.rules>/Cost)*(&~/Scale))]
	]

	//AIValueFactor = 0
	Size = [4, 4]
	//SelectionTypeID = "armor"
	//MaxHealth = 32000 //8000*4
	//ExplosiveDamageAbsorption = 100%
	//ExplosiveDamageResistance = 50%
	//TypeCategories : ^/0/TypeCategories [armor]
	//ReceivableBuffs : ^/0/ReceivableBuffs []
	
	UnderlyingPartPerTile = SW.structure_doonium
	//UnderlyingPart = ""
	//CreatePartPerTileWhenGrabbed = ""
	//InitialPenetrationResistance = 32
	ContinuingPenetrationResistance = &InitialPenetrationResistance
	//CrewSpeedFactor = 0
	//Density = 4 //v:3?
	IsRotateable = false //
	IsFlippable = false	//
	//IsWalled = true
	//IsSelfDestructible = false
	//AllowedDoorLocations = []
	//GeneratorRequiresDoor = false
	IgnoreRotationForMirroredSelection = true
	GenerateRectCollider = true

	EditorIcon
	{
		Texture
		{
			File = "armor.png"
			SampleMode = Point
			MipLevels = max
		}
		Size = [64, 64]
	}
	Components : ^/0/Components
	{
		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = ceil((&~/Part/MaxHealth)/4) // 8000
			RecoveryRate = ceil(&AbsorbsResourceDrain) * 0.1
		}

		Graphics
		{
			Type = Graphics
			Location = [1, 1]
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "armor.png"
						Size = [4, 4]
					}
					{
						File = "armor.png"
						Size = [4, 4]
					}
					{
						File = "armor.png"
						Size = [4, 4]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "armor.png"
						Size = [4, 4]
					}
					{
						File = "armor.png"
						Size = [4, 4]
					}
					{
						File = "armor.png"
						Size = [4, 4]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof_0.png"
						NormalsFile = "roof_0_normals.png"
						Size = [4, 4]
					}
					{
						File = "roof_0_33.png"
						NormalsFile = "roof_0_normals_33.png"
						Size = [4, 4]
					}
					{
						File = "roof_0_66.png"
						NormalsFile = "roof_0_normals_66.png"
						Size = [4, 4]
					}
				]
			}
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [1.0, 1.0]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [4, 4]
		}
	}

	Stats
	{
		EMPResist = (&~/Part/Components/EmpAbsorber/AbsorbsResourceDrain) / 1000
		AOEResist = (&~/Part/DamageResistances/explosive) * 100
	}
}
Scale = (4)
