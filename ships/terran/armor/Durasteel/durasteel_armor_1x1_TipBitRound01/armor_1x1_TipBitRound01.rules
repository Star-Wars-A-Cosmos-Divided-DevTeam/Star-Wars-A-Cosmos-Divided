Part : &<../base_part_terran_durasteel.rules>/Part
{
	NameKey = "Parts/DurasteelArmor_1x1_TipBitRound01"
	IconNameKey = "Parts/DurasteelArmor_1x1_TipBit01Icon"
	ID = SW.durasteel_armor_1x1_TipBitRound01
	OtherIDs = [Armor_1x1_TipBitRound01, Kroom.Armor_1x1_TipBitRound01]
	//EditorGroup = "DefensesSWACD"
	//DescriptionKey = "Parts/DurasteelArmorDesc"
	//EditorReplacementPartID = ""
	MaxHealth = floor((&<../base_part_terran_durasteel.rules>/MaxHealth) * (&~/Scale))	
	InitialPenetrationResistance = floor((&<../base_part_terran_durasteel.rules>/InitialPenetrationResistance) * (&~/Scale))
	Density = (&<../base_part_terran_durasteel.rules>/Density)

	Resources
	[
		[SW.durasteel, ceil((&<../base_part_terran_durasteel.rules>/Cost)*(&~/Scale))]
	]
	//AIValueFactor = 0
	Size = [1, 1]
	AllowedContiguity = [Bottom]
	UnderlyingPart = SW.durasteel_structure_1x1_TipBitRound01
	//SelectionTypeID = "armor"
	//MaxHealth = 3000 //4000/2*1,5
	//ExplosiveDamageAbsorption = 100%
	//ExplosiveDamageResistance = 50%
	//TypeCategories : ^/0/TypeCategories [armor]
	//ReceivableBuffs : ^/0/ReceivableBuffs []
	//CreatePartPerTileWhenDestroyed = ""
	//CreatePartWhenDestroyed = ""
	//CreatePartPerTileWhenGrabbed = ""
	//InitialPenetrationResistance = 6
	ContinuingPenetrationResistance = &InitialPenetrationResistance
	//CrewSpeedFactor = 0
	//Density = 3
	//IsRotateable = true
	//IsWalled = true
	//IsSelfDestructible = false
	ExternalWalls = [None]
	InternalWalls = [BottomLeft, Left, TopLeft, Top, TopRight, Right, BottomRight]
	//AllowedDoorLocations = []
	//GeneratorRequiresDoor = false
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}
	Components : ^/0/Components, &<roofs.rules>
	{
		RoofArtOptionToggle
		{
			Type = UIToggle
			ToggleID = "SW.armor_roof_type"
			Default = 4
			AvailableChoices = [0,1,2,3,4]
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}

		Collider
		{
			Type = PolygonCollider
			Vertices
			[
				[0.53, 0]
				[0.60, 0.08]
				[0.72, 0.37]
				[0.76, 1]
				[0.24, 1]
				[0.28, 0.37]
				[0.40, 0.08]
				[0.47, 0]
			]
		}

		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = ceil((&~/Part/MaxHealth)/4) // 750
			RecoveryRate = ceil(&AbsorbsResourceDrain) * 0.1
		}

		Graphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "armor.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_33.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_66.png"
						Size = [1, 1]
						UVRotation = 0
					}
				]
			}
			Walls
			{
				Layer = "external_walls"
				DamageLevels
				[
					{
						File = "armor.png"
						NormalsFile = "external_wall_normals.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_33.png"
						NormalsFile = "external_wall_normals_33.png"
						Size = [1, 1]
						UVRotation = 0
					}
					{
						File = "armor_66.png"
						NormalsFile = "external_wall_normals_66.png"
						Size = [1, 1]
						UVRotation = 0
					}
				]
			}

		}

		ConstructionStructureSprite
		{
			Type = Sprite
			IncludeWhenUnderConstruction = true
			IncludeWhenNotUnderConstruction = false
			Layer = "structure"
			Location = [.5, .5]
			AtlasSprite = &<../../../structures/durasteel/Structure_1x1_TipBitRound01/Structure_1x1_TipBitRound01.rules>/Part/Components/Graphics/Floor/DamageLevels/0
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [0.5, 0.5]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 1]
		}
	}

	Stats
	{
		EMPResist = (&~/Part/Components/EmpAbsorber/AbsorbsResourceDrain) / 1000
		AOEResist = (&~/Part/DamageResistances/explosive) * 100
	}
}
Scale = (1*5/8)
