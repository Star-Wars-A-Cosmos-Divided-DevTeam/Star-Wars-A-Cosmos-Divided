Part : &<../base_part_terran_durasteel.rules>/Part
{
	NameKey = "Parts/DurasteelArmor2x2"
	IconNameKey = "Parts/DurasteelArmor2x2Icon"
	ID = SW.durasteel_armor_2x2
	//EditorGroup = "Defenses"
	//DescriptionKey = "Parts/DurasteelArmorDesc"
	EditorReplacementPartID = SW.durasteel_armor //""
	MaxHealth = floor((&<../base_part_terran_durasteel.rules>/MaxHealth) * (&~/Scale))	
	InitialPenetrationResistance = floor((&<../base_part_terran_durasteel.rules>/InitialPenetrationResistance) * (&~/Scale))
	Density = (&<../base_part_terran_durasteel.rules>/Density)

	Resources
	[
		[SW.durasteel, ceil((&<../base_part_terran_durasteel.rules>/Cost)*(&~/Scale))]
	]
	//AIValueFactor = 0
	Size = [2, 2]
	IsRotateable = false //
	IsFlippable = false	//
	//SelectionTypeID = "armor"
	//MaxHealth = 24000 //4000*4*1.5
	//ExplosiveDamageAbsorption = 100%
	//ExplosiveDamageResistance = 50%
	//TypeCategories : ^/0/TypeCategories [armor]
	//ReceivableBuffs : ^/0/ReceivableBuffs []
	
	//InitialPenetrationResistance = 72
	ContinuingPenetrationResistance = &InitialPenetrationResistance
	//UnderlyingPartPerTile = ""
	//UnderlyingPart = ""
	//CreatePartPerTileWhenGrabbed = SW.durasteel_armor
	//CrewSpeedFactor = 0
	//Density = 4 //v:3?
	//IsWalled = true
	//IsSelfDestructible = false
	//AllowedDoorLocations = []
	//GeneratorRequiresDoor = false
	IgnoreRotationForMirroredSelection = true
	GenerateRectCollider = true //
	EditorIcon
	{
		Texture
		{
			File = "../../icon2x2.png"
			SampleMode = Point
			MipLevels = max
		}
		Size = [64, 64]
	}
	Components : ^/0/Components, &<roofs2x2.rules>
	{
		RoofArtOptionToggle
		{
			Type = UIToggle
			ToggleID = "SW.armor_roof_type"
			Default = 4
			AvailableChoices = [0,1,2,3,4]
			AlwaysAllowInBuildMode = true
			RequiresCommand = false
		}

		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = ceil((&~/Part/MaxHealth)/4) // 6000
		}
		
		Graphics
		{
			Type = Graphics
			Location = [1, 1]
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "armor.png"
						Size = [2, 2]
					}
					/*{
						File = "armor_33.png"
						Size = [2, 2]
					}
					{
						File = "armor_66.png"
						Size = [2, 2]
					}*/
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "armor.png"
						Size = [2, 2]
					}
					/*{
						File = "armor_33.png"
						Size = [2, 2]
					}
					{
						File = "armor_66.png"
						Size = [2, 2]
					}*/
				]
			}
//			Roof
//			{
//				Layer = "roofs"
//				DamageLevels
//				[
//					{
//						File = "roof_4.png"
//						NormalsFile = "roof_4_normals.png"
//						Size = [2, 2]
//					}
//					/*{
//						File = "roof_4_33.png"
//						NormalsFile = "roof_4_33_normals.png"
//						Size = [2, 2]
//					}
//					{
//						File = "roof_4_66.png"
//						NormalsFile = "roof_4_66_normals.png"
//						Size = [2, 2]
//					}*/
//				]
//			}
		}
/*
		ConstructionStructureSprites
		{
			Type = SpriteGrid
			IncludeWhenUnderConstruction = true
			IncludeWhenNotUnderConstruction = false
			Layer = "structure"
			RandomUVRotation = true
			AtlasSprite = &<./Data/ships/terran/structure/structure.rules>/Part/Components/Graphics/Floor/DamageLevels/0
		}
*/
		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [0.5, 0.5]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "../../blueprints2x2.png"
			Size = [2, 2]
		}
	}

	Stats
	{
		EMPResist = (&~/Part/Components/EmpAbsorber/AbsorbsResourceDrain) / 1000
		AOEResist = (&~/Part/DamageResistances/explosive) * 100
	}
}
Scale = (4)


