Part : &<../base_part_terran_sw_fireproof.rules>/Part
{

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups []

	TypeCategories : ^/0/TypeCategories [armor]

	//Selections
	IgnoreRotationForMirroredSelection = true

	//PartSpecific
	AIValueFactor = 0 //removes AI targetting //shared across all

	GenerateRectCollider = false //armor stuff

	EditorReplacementPartID = "" //bpt: corridor

	CreatePartPerTileWhenGrabbed = "" //bpt: corridor

	UnderlyingPart = "" //bpt: structure

	IsRotateable = true   //v value true
	IsFlippable = true //v value false
	IsSelfDestructible = false //lol

	CrewSpeedFactor = 0 //no crew movement wanted

	//Doors&Etc
	GeneratorRequiresDoor = false //armor stuff
	AllowedDoorLocations = []

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs []

	//Components&Inheritance
	Components : ^/0/Components {}
}