		BatterySpritesLeft
		{
			Type = ResourceSprites
			Location = [84/64, 92/64]
			ResourceStorage = BatteryStorageLeft
			Layer = "doodads_high"
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [1, 1]
				}
				{
					File = "batteries2.png"
					Size = [1, 1]
				}
				{
					File = "batteries3.png"
					Size = [1, 1]
				}
				{
					File = "batteries4.png"
					Size = [1, 1]
				}
			]
		}
		
		BatterySpritesRight : BatterySpritesLeft
		{
			Location = [6- (&~/Part/Components/BatterySpritesLeft/Location/0), &~/Part/Components/BatterySpritesLeft/Location/1]
			ResourceStorage = BatteryStorageRight
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [1, 1]
					MirrorU = true
				}
				{
					File = "batteries2.png"
					Size = [1, 1]
					MirrorU = true
				}
				{
					File = "batteries3.png"
					Size = [1, 1]
					MirrorU = true
				}
				{
					File = "batteries4.png"
					Size = [1, 1]
					MirrorU = true
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [2, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/HugePartDestroyed
			Location = [2, 1.5]
		}

		ScorchedEffects : ^/0/ScorchedEffects
		{
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/BigPartScorched //Small Med Big Huge
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [3, 2]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3,4]
				}
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2,3,4]
				}

				// No Resource.
				{
					Toggle = NoResourceToggle
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}

				// Out of power.
				{
					Toggle = CombinedBatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
				
				// Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			OnlyWithFlip = false
			File = "blueprints.png"
			Size = [6, 4]
		}

		BlueprintsFlipped
		{
			Type = BlueprintSprite
			OnlyWithFlip = true
			File = "blueprints_flipped.png"
			Size = [6, 4]
		}
		
		Overclock_HeatProductionInterval
		{
			Type = BuffableValue
			Value = &~/Part/Components/ResourceConverter/Interval
			IncludeInBlueprints = true
		}
		Overclock_HeatPerConversion { Type = StaticValue; Value = &~/OVERCLOCK/HEAT_PER_CONVERSION; }
		HeatGenerationValue
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = Overclock_HeatPerConversion
			ValueTwo = Overclock_HeatProductionInterval
			NaNFallbackValue = 0
			IncludeInBlueprints = Normal
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = HeatGenerationValue
		}
	}

	//Stats
	Stats
	{
		DuraSteelProduction = (&~/Part/Components/ResourceConverter/ToQuantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)

		DuraSteelCapacity = (&~/Part/Components/DuraSteelStorage/GridRect/2) * (&~/Part/Components/DuraSteelStorage/GridRect/3) * (&<../../../../Resources/durasteel/durasteel.rules>/MaxStackSize)
		SteelCapacity = (&~/Part/Components/SteelStorage/GridRect/2) * (&~/Part/Components/SteelStorage/GridRect/3) * (&<./Data/resources/steel/steel.rules>/MaxStackSize)
		CarbonCapacity = (&~/Part/Components/CarbonStorage/GridRect/2) * (&~/Part/Components/CarbonStorage/GridRect/3) * (&<./Data/resources/carbon/carbon.rules>/MaxStackSize)
		ZersiumCapacity = (&~/Part/Components/ZersiumStorage/GridRect/2) * (&~/Part/Components/ZersiumStorage/GridRect/3) * (&<../../../../Resources/zersium/zersium.rules>/MaxStackSize)

		SteelPerDuraSteel = (&~/Part/Components/SteelSplitter/FromQuantity) / (&~/Part/Components/SteelSplitter/ToQuantity) * (&~/Part/Components/ResourceConverter/From/0/Quantity) / (&~/Part/Components/ResourceConverter/ToQuantity)
		CarbonPerDuraSteel = (&~/Part/Components/CarbonSplitter/FromQuantity) / (&~/Part/Components/CarbonSplitter/ToQuantity) * (&~/Part/Components/ResourceConverter/From/1/Quantity) / (&~/Part/Components/ResourceConverter/ToQuantity)
		ZersiumPerDuraSteel = (&~/Part/Components/ZersiumSplitter/FromQuantity) / (&~/Part/Components/ZersiumSplitter/ToQuantity) * (&~/Part/Components/ResourceConverter/From/1/Quantity) / (&~/Part/Components/ResourceConverter/ToQuantity)

		SteelPerSecond = (&SteelPerDuraSteel) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		CarbonPerSecond = (&CarbonPerDuraSteel) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		ZersiumPerSecond = (&ZersiumPerDuraSteel) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)

		DuraSteelSteelUsage = [&../SteelPerDuraSteel, &../SteelPerSecond]
		DuraSteelCarbonUsage = [&../CarbonPerDuraSteel, &../CarbonPerSecond]
		DuraSteelZersiumUsage = [&../ZersiumPerDuraSteel, &../ZersiumPerSecond]

		PowerPerDuraSteel = (&~/Part/Components/ResourceConverter/From/2/Quantity) / (&~/Part/Components/ResourceConverter/ToQuantity) / 1000
		PowerPerSecond = (&~/Part/Components/ResourceConverter/From/2/Quantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) / 1000
		DuraSteelPowerUsage = [&../PowerPerDuraSteel, &../PowerPerSecond]
		PowerCapacity = (&~/Part/Components/CombinedBatteryStorage/MaxResources) / 1000

		FactoryBuff = (&~/Part/Components/BuffProvider/BuffAmount) * 100

		RecPower = &PowerPerSecond
		RecCrew = (&RecPower) * 4
	}
	
	StatsByCategory
	[
		{
			NameKey = "StatCategories/Overclocked"
			Stats
			{
				DuraSteelProduction = (&~/Part/Stats/DuraSteelProduction) * (&~/OVERCLOCK/SPEED_FACTOR)
				DuraSteelSteelUsage = [(&~/Part/Stats/DuraSteelSteelUsage/0), (&~/Part/Stats/DuraSteelSteelUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)]
				DuraSteelCarbonUsage = [(&~/Part/Stats/DuraSteelCarbonUsage/0), (&~/Part/Stats/DuraSteelCarbonUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)]
				DuraSteelZersiumUsage = [(&~/Part/Stats/DuraSteelZersiumUsage/0), (&~/Part/Stats/DuraSteelZersiumUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)]
				POWER_PER_ITEM = (&~/Part/Stats/DuraSteelPowerUsage/0) * (&~/OVERCLOCK/POWER_USE_FACTOR)
				POWER_PER_SECOND = (&~/Part/Stats/DuraSteelPowerUsage/1) * (&~/OVERCLOCK/POWER_USE_FACTOR) * (&~/OVERCLOCK/SPEED_FACTOR)
				DuraSteelPowerUsage = [&../POWER_PER_ITEM, &../POWER_PER_SECOND]
				CONVERSION_OUTPUT = (&~/Part/Components/ResourceConverter/ToQuantity)
				HEAT_PER_ITEM = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&CONVERSION_OUTPUT)
				HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_CONVERSION) * (&~/Part/Components/ResourceConverter/Interval/BaseValue) * (&~/OVERCLOCK/SPEED_FACTOR);
				DuraSteelHeatGeneration = [&../HEAT_PER_ITEM, &../HEAT_PER_SECOND]
			}
		}
	]
}