OVERCLOCK
{
	HEAT_PER_CONVERSION = 50
	SPEED_FACTOR = 300%
	POWER_USE_FACTOR = 125%
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

MODIFIERS
{
	OVERCLOCK_LERP
	{
		Type = Buff
		BuffType = Overclock
		ModificationMode = Lerp
	}
}

Part : &<../base_part_terran_factories.rules>/Part
{
	//IDs
	ID = SW.factory_aluminium
	//OtherIDs = [factory_aluminium]

	//StringKeys
	NameKey = "Parts/FactoryAluminium"
	IconNameKey = "Parts/FactoryAluminiumIcon"
	DescriptionKey = "Parts/FactoryAluminiumDesc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups ["Production", "SWTechII"]
	TypeCategories : ^/0/TypeCategories [provides_SW.aluminium_ingots, uses_SW.aluminium, uses_power, SW_Tech_II]
	//RequiresCategories = []

	//Resoures&Size&Health
	Resources
	[
		[steel, 60]
		[coil, 20]
		[coil2, 40]
		[SW.aluminium, 20]
	]
	Size = [4, 4]
	MaxHealth = 16000

	//Selections
	SelectionPriority = 1
	//SelectionTypeID = "factory"

	//PartSpecific
	IsFlippable = true

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs [Factory]

	//Doors&Etc
	BlockedTravelCells
	[
		[0, 0]
		[1, 0]
		[2, 0]
		[3, 0]
		[0, 1]
//		[1, 1]
		[2, 1]
		[3, 1]
	]
	ForceManhattanPathInPart = true
	AllowedDoorLocations
	[
		[-1, 2]
		[-1, 3]
		[0, 4]
		[1, 4]
		[2, 4]
		[3, 4]
		[4, 3]
		[4, 2]
	]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		IsOperational : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [PowerToggle, AluminiumStorage, BatteryStorage]
			Mode = All
		}

		CommandConsumptionToggle : ^/0/CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [PowerToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 4000
			DeliveryLocation = [1.5, 1.5]
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			ResupplyThreshold = 500
			OperationalToggle = PowerToggle
		}
		BatteryStorageBar
		{
			Type = ProgressBar
			OperationalToggle = BatteryStorage
			ShowProgressFor = BatteryStorage
			LowColor = [64, 64, 0]
			HighColor = [250, 250, 0]
			FullColor = [255, 255, 0]
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 1
		}

		AluminiumStorage
		{
			Type = TypedResourceGrid
			ResourceType = SW.aluminium
			GridRect = [0, 2, 2, 2]
			Layer = "doodads_low"
			SpriteInset = [8/64, 6/64, 2/64, 9/64]
			ToggleOnResources = &../ResourceConverter/From/0/Quantity
			ToggleOffResources = (&ToggleOnResources) - 1
			RandomSpriteRotation = true
			AllowExternalPickupAndDelivery = true
		}
		AluminiumConsumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = SW.aluminium
			Storage = AluminiumStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = PowerToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}

		AluminiumIngotStorage
		{
			Type = TypedResourceGrid
			ResourceType = SW.aluminium_ingot
			GridRect = [2, 2, 2, 2]
			Layer = "doodads_low"
			SpriteInset = [2/64, 6/64, 8/64, 9/64]
			SuppliesResources = true
			SupplyToggleButtonOffset = [0, -.4]
			RandomSpriteRotation = true
			InitToMaxResources = 0
			AllowExternalPickupAndDelivery = true
		}

		ResourceConverter
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			From
			[
				{
					Storage = AluminiumStorage
					Quantity = 1
				}
				{
					Storage = BatteryStorage
					Quantity
					{
						BaseValue = 40
						Modifiers
						[
							: ~/MODIFIERS/OVERCLOCK_LERP 
							{
								MinValue = &../../BaseValue
								MaxValue = (&MinValue) * (&~/OVERCLOCK/POWER_USE_FACTOR)
							}
						]
					}
					MinQuantityForConversion = 1
				}
			]
			ToStorage = AluminiumIngotStorage
			ToQuantity = 1
			Interval
			{
				BaseValue = 1
				Modifiers
				[
					{ Type = Buff; BuffType = Factory; ModificationMode = Divide; }
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
						ModificationMode = Divide
					}
				]
			}
			CheckResourceLimits = true
		}

		ConvertEffects
		{
			Type = TriggeredEffects
			Trigger = ResourceConverter
			Location = [2, 2]
			MediaEffects
			[
				&/SW_SOUNDS/Bullet_Create
			]
		}

		BuffProvider
		{
			Type = GridBuffProvider
			BuffType = Factory
			BuffAmount = 25%
			GridDistance = 1
			OperationalToggle = BatteryStorage
		}

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}
		
		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		Overclock_ConversionHeatProducer
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_ResourceConverterProxy
			Amount = (&~/OVERCLOCK/HEAT_PER_CONVERSION) * (&~/HEAT_TO_RESOURCE)
		}
		
		Overclock_ResourceConverterProxy
		{
			Type = TriggerProxy
			ProxyToggle = IsOverclocked
			ComponentID = ResourceConverter
		}

		Router
		{
			Type = NetworkRouter
			RouteGenerators
			[
				{
					Type = Simple
					HEAT_INPUT = &~/Part/^/0/HEAT_NETWORK_INPUT
					Routes
					[
						[&../../HEAT_INPUT, Port_Thermal_Left0, 0]
						[&../../HEAT_INPUT, Port_Thermal_Left1, 0]
						[&../../HEAT_INPUT, Port_Thermal_Down0, 0]
						[&../../HEAT_INPUT, Port_Thermal_Down1, 0]
						[&../../HEAT_INPUT, Port_Thermal_Down2, 0]
						[&../../HEAT_INPUT, Port_Thermal_Down3, 0]
						[&../../HEAT_INPUT, Port_Thermal_Right0, 0]
						[&../../HEAT_INPUT, Port_Thermal_Right1, 0]
					]
				}
			]
		}

		Port_Thermal_Left0 : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 2]
			Direction = Left
		}
		Port_Thermal_Left1 : Port_Thermal_Left0
		{
			Location = [0, 3]
		}
		Port_Thermal_Down0 : Port_Thermal_Left0
		{
			Location = [0, 3]
			Direction = Down
		}
		Port_Thermal_Down1 : Port_Thermal_Down0
		{
			Location = [1, 3]
		}
		Port_Thermal_Down2 : Port_Thermal_Down0
		{
			Location = [2, 3]
		}
		Port_Thermal_Down3 : Port_Thermal_Down0
		{
			Location = [3, 3]
		}
		Port_Thermal_Right0 : Port_Thermal_Left0
		{
			Location = [3, 2]
			Direction = Right
		}
		Port_Thermal_Right1 : Port_Thermal_Right0
		{
			Location = [3, 3]
		}

		FloorSprite
		{
			Type = Sprite
			OnlyWithFlip = false
			Location = [2, 2]
			Layer = "floors"
			DamageLevels
			[
				{
					File = "floor.png"
					Size = [4, 4]
				}
				{
					File = "floor_33.png"
					Size = [4, 4]
				}
				{
					File = "floor_66.png"
					Size = [4, 4]
				}
			]
		}

		FloorSpriteFlipped
		{
			Type = Sprite
			OnlyWithFlip = true
			Location = [2, 2]
			Layer = "floors"
			DamageLevels
			[
				{
					File = "floor_flipped.png"
					Size = [4, 4]
				}
				{
					File = "floor_flipped_33.png"
					Size = [4, 4]
				}
				{
					File = "floor_flipped_66.png"
					Size = [4, 4]
				}
			]
		}

		BeltSpeedFactor
		{
			Type = BuffableValue
			Value = { BaseValue=1; BuffType=Factory; BuffMode=Multiply; }
		}

		Graphics
		{
			Type = Graphics
			Location = [2, 2]
			OperationalToggle = IsOperational
			DoodadToggle = ResourceConverter
			AnimationSpeedFactor = BeltSpeedFactor
			ToggleOnDoodad
			{
				Layer = "doodads_low"
				Offset = [0, -.5]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_on1.png"
							"doodads_on2.png"
							"doodads_on3.png"
							"doodads_on4.png"
							"doodads_on5.png"
							"doodads_on6.png"
							"doodads_on7.png"
							"doodads_on8.png"
						]
						Size = [4, 3]
						AnimationInterval = 0.125
					}
					{
						AnimationFiles
						[
							"doodads_on1_33.png"
							"doodads_on2_33.png"
							"doodads_on3_33.png"
							"doodads_on4_33.png"
							"doodads_on5_33.png"
							"doodads_on6_33.png"
							"doodads_on7_33.png"
							"doodads_on8_33.png"
						]
						Size = [4, 3]
						AnimationInterval = 0.125
					}
					{
						AnimationFiles
						[
							"doodads_on1_66.png"
							"doodads_on2_66.png"
							"doodads_on3_66.png"
							"doodads_on4_66.png"
							"doodads_on5_66.png"
							"doodads_on6_66.png"
							"doodads_on7_66.png"
							"doodads_on8_66.png"
						]
						Size = [4, 3]
						AnimationInterval = 0.125
					}
				]
			}
			ToggleOffDoodad
			{
				Layer = "doodads_low"
				Offset = [0, -.5]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_idle1.png"
							"doodads_idle2.png"
							"doodads_idle3.png"
							"doodads_idle4.png"
							"doodads_idle5.png"
							"doodads_idle6.png"
							"doodads_idle7.png"
							"doodads_idle8.png"
						]
						Size = [4, 3]
						AnimationInterval = 0.125
						AnimationStartTime = WhenSpawned
					}
					{
						AnimationFiles
						[
							"doodads_idle1_33.png"
							"doodads_idle2_33.png"
							"doodads_idle3_33.png"
							"doodads_idle4_33.png"
							"doodads_idle5_33.png"
							"doodads_idle6_33.png"
							"doodads_idle7_33.png"
							"doodads_idle8_33.png"
						]
						Size = [4, 3]
						AnimationInterval = 0.125
						AnimationStartTime = WhenSpawned
					}
					{
						AnimationFiles
						[
							"doodads_idle1_66.png"
							"doodads_idle2_66.png"
							"doodads_idle3_66.png"
							"doodads_idle4_66.png"
							"doodads_idle5_66.png"
							"doodads_idle6_66.png"
							"doodads_idle7_66.png"
							"doodads_idle8_66.png"
						]
						Size = [4, 3]
						AnimationInterval = 0.125
						AnimationStartTime = WhenSpawned
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				Offset = [0, -.5]
				DamageLevels
				[
					{
						File = "doodads_off.png"
						Size = [4, 3]
					}
					{
						File = "doodads_off_33.png"
						Size = [4, 3]
					}
					{
						File = "doodads_off_66.png"
						Size = [4, 3]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [4, 4]
					}
					{
						File = "walls_33.png"
						Size = [4, 4]
					}
					{
						File = "walls_66.png"
						Size = [4, 4]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [4, 4]
					}
				]
			}
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [-62/64, -57/64]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [5, 5]
						Z = .5 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor = [255*1.4, 0, 0]
					}
				]
			}
		}

		Graphics2
		{
			Type = Graphics
			Location = [2, 2]
			OperationalToggle = IsOperational
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [62/64, -57/64]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [5, 5]
						Z = .5 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor = [255*1.4, 0, 0]
					}
				]
			}
		}

		RoofDoorOpenToggle
		{
			Type = CrewDestinationProximityToggle
			Distance = 3
		}
		RoofDoorSprite
		{
			Type = OpenCloseSprite
			Location = [2, 2]
			OperationalToggle = RoofDoorOpenToggle
			Layer = "roofs"
			OpenDamageLevels
			[
				{
					AnimationFiles
					[
						"roof1.png"
						"roof2.png"
						"roof3.png"
						"roof4.png"
						"roof5.png"
						"roof6.png"
					]
					NormalsAnimationFiles
					[
						"roof_normals1.png"
						"roof_normals2.png"
						"roof_normals3.png"
						"roof_normals4.png"
						"roof_normals5.png"
						"roof_normals6.png"
					]
					Size = [4, 4]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
				}
				{
					AnimationFiles
					[
						"roof1_33.png"
						"roof2_33.png"
						"roof3_33.png"
						"roof4_33.png"
						"roof5_33.png"
						"roof6_33.png"
					]
					NormalsAnimationFiles
					[
						"roof_normals1_33.png"
						"roof_normals2_33.png"
						"roof_normals3_33.png"
						"roof_normals4_33.png"
						"roof_normals5_33.png"
						"roof_normals6_33.png"
					]
					Size = [4, 4]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
				}
				{
					AnimationFiles
					[
						"roof1_66.png"
						"roof2_66.png"
						"roof3_66.png"
						"roof4_66.png"
						"roof5_66.png"
						"roof6_66.png"
					]
					NormalsAnimationFiles
					[
						"roof_normals1_66.png"
						"roof_normals2_66.png"
						"roof_normals3_66.png"
						"roof_normals4_66.png"
						"roof_normals5_66.png"
						"roof_normals6_66.png"
					]
					Size = [4, 4]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
				}
			]
			ClosedDamageLevels
			[
				{
					AnimationFiles
					[
						"roof6.png"
						"roof5.png"
						"roof4.png"
						"roof3.png"
						"roof2.png"
						"roof1.png"
					]
					NormalsAnimationFiles
					[
						"roof_normals6.png"
						"roof_normals5.png"
						"roof_normals4.png"
						"roof_normals3.png"
						"roof_normals2.png"
						"roof_normals1.png"
					]
					Size = [4, 4]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
				}
				{
					AnimationFiles
					[
						"roof6_33.png"
						"roof5_33.png"
						"roof4_33.png"
						"roof3_33.png"
						"roof2_33.png"
						"roof1_33.png"
					]
					NormalsAnimationFiles
					[
						"roof_normals6_33.png"
						"roof_normals5_33.png"
