		BatterySprites
		{
			Type = ResourceSprites
			Location = [84/64, 92/64]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [1, 1]
				}
				{
					File = "batteries2.png"
					Size = [1, 1]
				}
				{
					File = "batteries3.png"
					Size = [1, 1]
				}
				{
					File = "batteries4.png"
					Size = [1, 1]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [2, 2]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/HugePartDestroyed
			Location = [2, 2]
		}

		ScorchedEffects : ^/0/ScorchedEffects
		{
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/MedPartScorched //Small Med Big Huge
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [2, 2]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3,4]
				}
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2,3,4]
				}

				// No aluminium.
				{
					Toggle = AluminiumStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
				
				// Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			OnlyWithFlip = false
			File = "blueprints.png"
			Size = [4, 4]
		}

		BlueprintsFlipped
		{
			Type = BlueprintSprite
			OnlyWithFlip = true
			File = "blueprints_flipped.png"
			Size = [4, 4]
		}
		
		Overclock_HeatProductionInterval
		{
			Type = BuffableValue
			Value = &~/Part/Components/ResourceConverter/Interval
			IncludeInBlueprints = true
		}
		Overclock_HeatPerConversion { Type = StaticValue; Value = &~/OVERCLOCK/HEAT_PER_CONVERSION; }
		HeatGenerationValue
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = Overclock_HeatPerConversion
			ValueTwo = Overclock_HeatProductionInterval
			NaNFallbackValue = 0
			IncludeInBlueprints = true
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = HeatGenerationValue
		}
	}

	//Stats
	Stats
	{
		AluminiumIngotProduction = (&~/Part/Components/ResourceConverter/ToQuantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		AluminiumIngotCapacity = (&~/Part/Components/AluminiumIngotStorage/GridRect/2) * (&~/Part/Components/AluminiumIngotStorage/GridRect/3) * (&<../../../../Resources/aluminium_ingot/aluminium_ingot.rules>/MaxStackSize)
		AluminiumCapacity = (&~/Part/Components/AluminiumStorage/GridRect/2) * (&~/Part/Components/AluminiumStorage/GridRect/3) * (&<../../../../Resources/aluminium/aluminium.rules>/MaxStackSize)
		AluminiumPerAluminiumIngot = (&~/Part/Components/ResourceConverter/From/0/Quantity) / (&~/Part/Components/ResourceConverter/ToQuantity)
		AluminiumPerSecond = (&~/Part/Components/ResourceConverter/From/0/Quantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		AluminiumIngotAluminiumUsage = [&../AluminiumPerAluminiumIngot, &../AluminiumPerSecond]
		PowerPerAluminiumIngot = (&~/Part/Components/ResourceConverter/From/1/Quantity/BaseValue) / (&~/Part/Components/ResourceConverter/ToQuantity) / 1000
		PowerPerSecond = (&~/Part/Components/ResourceConverter/From/1/Quantity/BaseValue) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) / 1000
		AluminiumIngotPowerUsage = [&../PowerPerAluminiumIngot, &../PowerPerSecond]
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		FactoryBuff = (&~/Part/Components/BuffProvider/BuffAmount) * 100

		RecPower = &PowerPerSecond
		RecCrew = (&RecPower) * 4
	}
	
	StatsByCategory
	[
		{
			NameKey = "StatCategories/Overclocked"
			Stats
			{
				AluminiumIngotProduction = (&~/Part/Stats/AluminiumIngotProduction) * (&~/OVERCLOCK/SPEED_FACTOR)
				AluminiumIngotAluminiumUsage = [(&~/Part/Stats/AluminiumIngotAluminiumUsage/0), (&~/Part/Stats/AluminiumIngotAluminiumUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)]
				POWER_PER_ITEM = (&~/Part/Stats/AluminiumIngotPowerUsage/0) * (&~/OVERCLOCK/POWER_USE_FACTOR)
				POWER_PER_SECOND = (&~/Part/Stats/AluminiumIngotPowerUsage/1) * (&~/OVERCLOCK/POWER_USE_FACTOR) * (&~/OVERCLOCK/SPEED_FACTOR)
				AluminiumIngotPowerUsage = [&../POWER_PER_ITEM, &../POWER_PER_SECOND]
				CONVERSION_OUTPUT = (&~/Part/Components/ResourceConverter/ToQuantity)
				HEAT_PER_ITEM = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&CONVERSION_OUTPUT)
				HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_CONVERSION) * (&~/Part/Components/ResourceConverter/Interval/BaseValue) * (&~/OVERCLOCK/SPEED_FACTOR);
				AluminiumIngotHeatGeneration = [&../HEAT_PER_ITEM, &../HEAT_PER_SECOND]
			}
		}
	]
}