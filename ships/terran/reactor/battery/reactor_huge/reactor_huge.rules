			NonOperationalDoodad
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor_on1.png"
						Size = [4, 4]
					}
					{
						File = "floor_off_33.png"
						Size = [4, 4]
					}
					{
						File = "floor_off_66.png"
						Size = [4, 4]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "reactor_core_on.png"
						Size = [3, 3]
					}
					{
						File = "reactor_core_on_33.png"
						Size = [3, 3]
					}
					{
						File = "reactor_core_on_66.png"
						Size = [3, 3]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [4, 4]
					}
					{
						File = "walls_33.png"
						Size = [4, 4]
					}
					{
						File = "walls_66.png"
						Size = [4, 4]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [4, 4]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [4, 4]
