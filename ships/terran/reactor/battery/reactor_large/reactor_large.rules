OVERCLOCK // : &<./Data/ships/terran/reactor_small/reactor_small.rules>/OVERCLOCK
{
	POWER_GENERATION_FACTOR = 150%
	BONUS_BATTERY_SIZE = 1
	HEAT_PER_SECOND = 2400

	BATTERY_PER_SEC = (&~/Part/Components/BatteryProducer/ToQuantity/BaseValue) * (&POWER_GENERATION_FACTOR) / (&~/Part/Components/BatteryProducer/Interval/BaseValue) / 1000
	HEAT_PER_BATTERY = (&HEAT_PER_SECOND) / (&BATTERY_PER_SEC)
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO


Part : &<../base_part_terran_battery.rules>/Part
{
	//IDs
	ID = SW.reactor_large
	// OtherIDs = []

	//StringKeys
	NameKey = "Parts/SW_HeavyReactor"
	IconNameKey = "Parts/SW_HeavyReactorIcon"
	DescriptionKey = "Parts/SW_HeavyReactorDesc"

	//Groups&Categories
	EditorGroups = /* : ^/0/EditorGroups */ [Power, SWTechII, SWTechIII]
	TypeCategories = /* : ^/0/TypeCategories */ [reactor, provides_power, SW_Reactor_Large,SW_Tech_II, SW_Tech_III]
	//RequiresCategories = []

	//Resoures&Size&Health
	Resources
	[
		[SW.durasteel, 170]
		[coil, 232]
		[coil2, 164]
		[enriched_uranium, 32]
	]
	Size = [3, 3]
	MaxHealth = 12000 // Deliberately not increasing this for med/large reactors to make them extra-fragile.

	//Selections
	SelectionPriority = 0
	//SelectionTypeByRotation = true
	IgnoreRotationForMirroredSelection = true
	SelectionTypeID = "reactors"

	//PartSpecific
	AIValueFactor = 5
	IsRotateable = false
	AutoDoorMaxPathLength = 5
	SignificanceToggle = ScorchedToggle
	CreateUnderlyingWhenDestroyed = false

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronDebuff, ElectronNebula]
	BlockedTravelCells
	[
		[1, 1]
	]
	ForceManhattanPathInPart = true

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
			//MipLevels = max
		}
		Size = [64, 64]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		IsOperational // : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles = [NonJunkToggle, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			//Toggles = /* : ^/0/Toggles */ [True]
			Mode = All
		}
//		True
//		{
//			Type = StaticToggle
//			ToggleOn = "true"
//		}

		NonJunkToggle
		{
			Type = JunkToggle
			OnWhenJunk = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		IsNonOverclocked
		{
			Type = MultiToggle
			Toggles = [ IsOverclocked ]
			Mode = None
		}
		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 30000
			StartingResources = &MaxResources
			SuppliesResources = true
			SuppliesResourcesToggle = IsNonOverclocked
			MinResourcesPickUp = 3000
			MaxResourcesPickUp = 3000
			InitPickUp = 2001
			PickUpRate = 2000 / 1.0
			ExpectedResourceGenerationToggle = IsOperational
			ExpectedResourceGenerationRate : ../BatteryProducer/ToQuantity
			{
				BaseValue = (&^/0/BaseValue) / (&../../BatteryProducer/Interval/BaseValue)
			}
			ToggleOnResources = 10001
			ToggleOffResources = 10000
			ProvidedValueRange = 0
			ProvidedValuePerResource = 1/1000
		}
		Overclock_BatteryProviderStorage : BatteryStorage
		{
			Type = MultiResourceStorage
			ResourceType = battery
			ResourceStorages = [ BatteryStorage ]
			SuppliesResources = true
			SuppliesResourcesToggle = IsOverclocked
			MinResourcesPickUp = (&../BatteryStorage/MinResourcesPickUp) + (1000 * (&~/OVERCLOCK/BONUS_BATTERY_SIZE))
			MaxResourcesPickUp = &MinResourcesPickUp
			InitPickUp = 3001
			ToggleOnResources = (&MinResourcesPickUp) * 2 + 1
			ToggleOffResources = (&MinResourcesPickUp) * 2
		}

		HasPowerNonOverclocked
		{
			Type = MultiToggle
			Toggles = [BatteryStorage, IsNonOverclocked]
			Mode = All
		}
		HasPowerOverclocked
		{
			Type = MultiToggle
			Toggles = [Overclock_BatteryProviderStorage, IsOverclocked]
			Mode = All
		}
		HasPower
		{
			Type = MultiToggle
			Toggles = [ HasPowerNonOverclocked, HasPowerOverclocked]
			Mode = Any
		}

		BatteryProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			ToStorage = BatteryStorage
			ToQuantity
			{
				BaseValue = 1000
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/POWER_GENERATION_FACTOR)]
					}
				]
			}
			Interval = { BaseValue=2/27; BuffType=ElectronDebuff; BuffMode=Divide; }
		}

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		Overclock_PowerGenerationTrigger
		{
			Type = ValueChangeTrigger
			OperationalToggle = IsOverclocked
			ValueSource = BatteryStorage
			TriggerOnDecrease = false;
		}

		Overclock_GenerationHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_PowerGenerationTrigger
			Amount { BaseValue=ceil((&~/OVERCLOCK/HEAT_PER_BATTERY) * (&~/HEAT_TO_RESOURCE)); EffectScaleExponent=1 }
		}

		// 3x3 PART: All edge (perimeter) tiles have ports facing outward

		// --- Top edge (y=0), x=0 to x=2
		Port_Thermal_Top_0 : ~/Part/^/0/BASE_THERMAL_PORT
		{
		    Location = [0,0]     // Top-left
		    Direction = Up
		}
		Port_Thermal_Top_1 : Port_Thermal_Top_0
		{
		    Location = [1,0]     // Top-middle
		}
		Port_Thermal_Top_2 : Port_Thermal_Top_0
		{
		    Location = [2,0]     // Top-right
		}

		// --- Bottom edge (y=2), x=0 to x=2
		Port_Thermal_Bottom_0 : Port_Thermal_Top_0
		{
		    Location = [0,2]     // Bottom-left
		    Direction = Down
		}
		Port_Thermal_Bottom_1 : Port_Thermal_Bottom_0
		{
		    Location = [1,2]     // Bottom-middle
		}
		Port_Thermal_Bottom_2 : Port_Thermal_Bottom_0
		{
		    Location = [2,2]     // Bottom-right
		}

		// --- Left edge (x=0), y=1 (middle row only, corners handled above)
		Port_Thermal_Left_1 : Port_Thermal_Top_0
		{
		    Location = [0,1]     // Left edge, middle
		    Direction = Left
		}

		// --- Right edge (x=2), y=1 (middle row only)
		Port_Thermal_Right_1 : Port_Thermal_Top_0
		{
		    Location = [2,1]     // Right edge, middle
		    Direction = Right
		}

		Graphics
		{
			Type = Graphics
			OperationalToggle = IsOperational
			Location = [1.5, 1.5]
			Floor
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "reactor_off.png"
						Size = [2, 2]
					}
					{
						File = "reactor_off_33.png"
						Size = [2, 2]
					}
					{
						File = "reactor_off_66.png"
						Size = [2, 2]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "floors"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"floor_on1.png"
							"floor_on2.png"
							"floor_on3.png"
							"floor_on4.png"
							"floor_on5.png"
							"floor_on6.png"
							"floor_on7.png"
							"floor_on8.png"
						]
						Size = [3, 3]
						AnimationInterval = 0.095*(&~/Scale)
					}
					{
						AnimationFiles
						[
							"floor_on1_33.png"
							"floor_on2_33.png"
							"floor_on3_33.png"
							"floor_on4_33.png"
							"floor_on5_33.png"
							"floor_on6_33.png"
							"floor_on7_33.png"
							"floor_on8_33.png"
						]
						Size = [3, 3]
						AnimationInterval = 0.095*(&~/Scale)
					}
					{
						AnimationFiles
						[
							"floor_on1_66.png"
							"floor_on2_66.png"
							"floor_on3_66.png"
							"floor_on4_66.png"
							"floor_on5_66.png"
							"floor_on6_66.png"
							"floor_on7_66.png"
							"floor_on8_66.png"
						]
						Size = [3, 3]
						AnimationInterval = 0.095*(&~/Scale)
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor_on1.png"
						Size = [3, 3]
					}
					{
						File = "floor_on1_33.png"
						Size = [3, 3]
					}
					{
						File = "floor_on1_66.png"
						Size = [3, 3]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "reactor_core_on.png"
						Size = [2, 2]
					}
					{
						File = "reactor_core_on_33.png"
						Size = [2, 2]
					}
					{
						File = "reactor_core_on_66.png"
						Size = [2, 2]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [3, 3]
					}
					{
						File = "walls_33.png"
						Size = [3, 3]
					}
					{
						File = "walls_66.png"
						Size = [3, 3]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [3, 3]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [3, 3]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [3, 3]
					}
				]
			}
		}

		ReactorLights_Graphics
		{
			Type = Graphics
			OperationalToggle = IsOperational
			Location = [1.5, 1.5]
			DoodadToggle = IsOverclocked
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"lights1.png"
							"lights2.png"
							"lights3.png"
							"lights4.png"
							"lights5.png"
							"lights6.png"
							"lights7.png"
							"lights8.png"
						]
						Size = [3, 3]
						AnimationInterval = 0.065*(&~/Scale)
						VertexColor = [255*0.5, 255*0.5, 255*0.5]
					}
					{
						AnimationFiles
						[
							"lights1.png"
							"lights2.png"
							"lights3.png"
							"lights4.png"
							"lights5.png"
							"lights6.png"
							"lights7.png"
							"lights8.png"
						]
						Size = [3, 3]
						AnimationInterval = 0.065/1.75*(&~/Scale)
						VertexColor = [255*0.5, 255*0.5, 255*0.5]
					}
					{
						AnimationFiles
						[
							"lights1.png"
							"lights2.png"
							"lights3.png"
							"lights4.png"
							"lights5.png"
							"lights6.png"
							"lights7.png"
							"lights8.png"
						]
						Size = [3, 3]
						AnimationInterval = 0.065/2.5*(&~/Scale)
						VertexColor = [255*0.5, 255*0.5, 255*0.5]
					}
				]
			}
			ToggleOnDoodad
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "OCLights.png"
						Size = [3, 3]
					}
				]
			}
		}

		NonOverclocked_Components
		{
			Type = ToggledComponents
			Toggle = IsNonOverclocked
			Components
			{
				BatterySprites
				{
					Type = ResourceSprites
					Location = [1.5, 1.5]
					ResourceStorage = BatteryStorage
					Layer = "doodads_high"
					Round = Down
					ResourceLevels
					[
						{
							File = "batteries1.png"
							Offset = [0.375, -1]
							Size = [1, 1]
						}
						{
							File = "batteries2.png"
							Offset = [0.5, -0.5]
							Size = [2, 2]
						}
						{
							File = "batteries3.png"
							Offset = [0.5, 0]
							Size = [2, 3]
						}
						{
							File = "batteries4.png"
							Offset = [0.5, 0]
							Size = [2, 3]
						}
						{
							File = "batteries5.png"
							Size = [3, 3]
						}
						{
							File = "batteries6.png"
							Size = [3, 3]
						}
						{
							File = "batteries7.png"
							Size = [3, 3]
						}
						{
							File = "batteries8.png"
							Size = [3, 3]
						}
					]
				}
			}
		}

		Overclocked_Components
		{
			Type = ToggledComponents
			Toggle = IsOverclocked
			Components
			{
				OCBatterySprites
				{
					Type = ResourceSprites
					Location = [1.5, 1.5]
					ResourceStorage = BatteryStorage
					Layer = "doodads_high"
					Round = Down
					ResourceLevels
					[
						{
							File = "OCbatteries1.png"
							Offset = [0.375, -1]
							Size = [1, 1]
						}
						{
							File = "OCbatteries2.png"
							Offset = [0.5, -0.5]
							Size = [2, 2]
						}
						{
							File = "OCbatteries3.png"
							Offset = [0.5, 0]
							Size = [2, 3]
						}
						{
							File = "OCbatteries4.png"
							Offset = [0.5, 0]
							Size = [2, 3]
						}
						{
							File = "OCbatteries5.png"
							Size = [3, 3]
						}
						{
							File = "OCbatteries6.png"
							Size = [3, 3]
						}
						{
							File = "OCbatteries7.png"
							Size = [3, 3]
						}
						{
							File = "OCbatteries8.png"
							Size = [3, 3]
						}
					]
				}
			}
		}

		ReactorHum
		{
			Type = ContinuousEffects
			Location = [1.5, 1.5]
			OnlyWhenOperational = true
			MaxMediaEffectsZoom = 4
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					Sound = "./Data/ships/terran/reactor_small/operating.wav"
					Volume = .5
					Speed = .5
					MaxConcurrent = 1
					DynamicVolume : ^/0/DynamicVolume
					{
						ExteriorVolume = .5*(&~/Scale)
					}
				}
			]
		}

		ElectronDebuffToggle
		{
			Type = BuffToggle
			BuffType = ElectronDebuff
		}

		ElectronNebulaEffects
		{
			Type = ContinuousEffects
			OperationalToggle = ElectronDebuffToggle
			Location = [1.5, 1.5]
			MediaEffectsIntensityFactor = { BaseValue=1; BuffType=ElectronNebula; BuffMode=Multiply; }
			MediaEffects
			[
				&<./Data/nebulas/electron/particles/electron_reactor_light.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./Data/nebulas/electron/sounds/electron_cloud_reactor_weaken.wav"
					Volume = 1
					MaxConcurrentVolume = &Volume
					MaxConcurrent = 1
				}
			]
		}
		ElectronNebulaShipEffects
		{
			Type = ContinuousEffects
			OperationalToggle = ElectronDebuffToggle
			Location = [1.5, 1.5]
			ParentToShip = true
			MediaEffectsIntensityFactor = { BaseValue=1; BuffType=ElectronNebula; BuffMode=Multiply; }
			MediaEffects
			[
				&<./Data/nebulas/electron/particles/electron_reactor_sizzle.rules>
			]
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = [1.5, 1.5]
			HitEffects
			[
				{
					Type = ExplosiveResourceDrain
					ResourceType = battery
					TotalDrain = { BaseValue = 250000; EffectScaleExponent = 1 }
					Radius = 18
					Delay = .05
					ExpandDuration = .4
					ExpandStartRadius = 4
					ExpandLoss = 100%
					Filter
					{
						Friendlies = true
					}

					MediaEffectsOnDrainFactor = .0015
					MediaEffectsOnDrain
					[
						&<./Data/shots/missile_emp/particles/missile_emp_hit_sizzle.rules>
						&<./Data/shots/missile_emp/particles/missile_emp_lightning.rules>
						&<./Data/shots/missile_emp/particles/missile_emp_drain.rules>

						: /BASE_SOUNDS/AudioExterior
						{
							Sound = "./Data/shots/disruptor_bolt/discharge.wav"
							Volume = 1
							SpeedVariation = .2
						}
					]
				}
			]
			MediaEffects : /COMMON_EFFECTS/HugePartScorched
			[
				&<./Data/shots/missile_emp/particles/missile_emp_hit_orb.rules>
				&<./Data/shots/missile_emp/particles/missile_emp_hit_bolts.rules>
				&<./Data/shots/missile_emp/particles/missile_emp_hit_shockwave.rules>
			]
		}

		DestroyedEffects
		{
			Type = DeathEffects
			Location = [1.5, 1.5]

			MediaEffects
			[
				&<./Data/ships/terran/reactor_large/particles/reactor_explode_large.rules>
				&<./Data/ships/terran/reactor_large/particles/reactor_explode_flash_large.rules>
				&<./Data/ships/terran/reactor_large/particles/reactor_shockwave_large.rules>
				&<./Data/common_effects/particles/explosions/huge_part_explode_debris.rules>
				&<./Data/common_effects/particles/explosions/huge_part_explode_smoke.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./Data/ships/terran/reactor_small/destroyed.wav"
					Volume = 2
					Speed = .5
					SpeedVariation = .25 * (&Speed)
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .75
					Duration = 4
				}
			]

			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = 610000
					Radius = 12
					Delay = .05
					ExpandDuration = .35
					ExpandStartRadius = 4
					ExpandLoss = 100%
					StatusType = cosmoteer.fire
					StatusChancePerNDamage = 25%
					StatusValue = 1
					StatusValueType = Interpolated
					ImpulsePerNDamage = 10
					NDamage = 1000
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage = 120000
					Radius = 10
					Delay = .05
					ExpandDuration = .2
					ExpandStartRadius = 4
					ExpandLoss = 100%
					ImpulsePerNDamage = 5
					NDamage = 1000
					Filter
					{
						OperationalHealth = false
						StructuralHealth = true
						Friendlies = true
					}
				}
			]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1.5, 1.5]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2]
				}
				// Out of power.
				{
					Toggle = HasPower
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
				// Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [3, 3]
		}

		PeakHeatGenerationStatValue
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/HEAT_PER_SECOND)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationStatValue
		}
	}

	Stats
	{
		PowerGeneration = (&~/Part/Components/BatteryProducer/ToQuantity/BaseValue) / (&~/Part/Components/BatteryProducer/Interval/BaseValue) / 1000
		BatterySize = (&~/Part/Components/BatteryStorage/MaxResourcesPickUp) / 1000
		BatteryFillTime = 1000 / (&~/Part/Components/BatteryStorage/PickUpRate)
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
	}

	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		Stats
		{
			BatterySize = (&~/Part/Stats/BatterySize) + (&~/OVERCLOCK/BONUS_BATTERY_SIZE)
			PowerGeneration = (&~/Part/Stats/PowerGeneration) * (&~/OVERCLOCK/POWER_GENERATION_FACTOR)
			PowerHeatGeneration = [&~/OVERCLOCK/HEAT_PER_BATTERY, &~/OVERCLOCK/HEAT_PER_SECOND]
		}
	}
}
Size = Medium
Scale = (1/1)