OVERCLOCK // : &<./Data/ships/terran/reactor_small/reactor_small.rules>/OVERCLOCK
{
	POWER_GENERATION_FACTOR = 300%
	EXTRA_CAPACITY_FACTOR = 200%
	HEAT_PER_SECOND = 800

	BATTERY_PER_SEC = (&~/Part/Components/BatteryProducer/ToQuantity/BaseValue) * (&POWER_GENERATION_FACTOR) / (&~/Part/Components/BatteryProducer/Interval/BaseValue) / 1000
	HEAT_PER_BATTERY = (&HEAT_PER_SECOND) / (&BATTERY_PER_SEC)
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO


Part : &<../base_part_terran_battery.rules>/Part
{
	//IDs
	ID = SW.reactor_small
	OtherIDs = [SW.reactor, SW.reactor_medium]

	//StringKeys
	NameKey = "Parts/SW_SmallReactor"
	IconNameKey = "Parts/SW_SmallReactorIcon"
	DescriptionKey = "Parts/SW_SmallReactorDesc"

	//Groups&Categories
	EditorGroups = /* : ^/0/EditorGroups */ [Power, SWTechII]
	TypeCategories = /* : ^/0/TypeCategories */ [reactor, provides_power, SW_Reactor_Small, SW_Tech_I, SW_Tech_II]
	//RequiresCategories = []

	//Resoures&Size&Health
	Resources
	[
		[SW.durasteel, 126]
		[coil, 164]
		[coil2, 80]
		[enriched_uranium, 16]
	]
	Size = [2, 2]
	MaxHealth = 8000

	//Selections
	SelectionPriority = 0
	//SelectionTypeByRotation = true
	IgnoreRotationForMirroredSelection = true
	SelectionTypeID = "reactors"

	//PartSpecific
	AIValueFactor = 5
	IsRotateable = false
	AutoDoorMaxPathLength = 5
	SignificanceToggle = ScorchedToggle
	CreateUnderlyingWhenDestroyed = false

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronDebuff, ElectronNebula]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
			//MipLevels = max
		}
		Size = [56, 56]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		IsOperational // : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles = [NonJunkToggle, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		NonJunkToggle
		{
			Type = JunkToggle
			OnWhenJunk = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		IsNonOverclocked
		{
			Type = MultiToggle
			Toggles = [ IsOverclocked ]
			Mode = None
		}
		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 16000
			StartingResources = &MaxResources
		}
		Overclock_BatteryStorage : BatteryStorage
		{
			MaxResources = (&^/0/MaxResources) * (&~/OVERCLOCK/EXTRA_CAPACITY_FACTOR)
			StartingResources = &MaxResources
		}
		Overclock_BatteryStorageProxy
		{
			Type = ResourceStorageProxy
			ComponentID = Overclock_BatteryStorage
			ProxyToggle = IsOverclocked
			ResourceType = battery
		}
		CombinedBatteryStorage : BatteryStorage
		{
			Type = MultiResourceStorage
			ResourceType = battery
			ResourceStorages = [ BatteryStorage, Overclock_BatteryStorageProxy ]
			SuppliesResources = true
			MinResourcesPickUp = 2000
			MaxResourcesPickUp = 2000
			ExpectedResourceGenerationToggle = IsOperational
			ExpectedResourceGenerationRate : ../BatteryProducer/ToQuantity
			{
				BaseValue = (&^/0/BaseValue) / (&../../BatteryProducer/Interval/BaseValue)
			}
			ToggleOnResources = 2001
			ToggleOffResources = (&ToggleOnResources)-1
			ProvidedValueRange = 0
			ProvidedValuePerResource = 1/1000
		}
		OverclockChangedTrigger
		{
			Type = MultiTrigger
			Triggers = [OverclockEnabledTrigger, OverclockDisabledTrigger]
		}
		Overclock_DepleteBatteryOnOverclockChanged
		{
			Type = ResourceChange
			Trigger = OverclockChangedTrigger
			ResourceStorage = Overclock_BatteryStorage
			Amount = -(&../Overclock_BatteryStorage/MaxResources)
		}

		BatteryProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			ToStorage = CombinedBatteryStorage
			ToQuantity
			{
				BaseValue = 2000
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/POWER_GENERATION_FACTOR)]
					}
				]
			}
			Interval = { BaseValue=2/3; BuffType=ElectronDebuff; BuffMode=Divide; }
		}

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		Overclock_PowerGenerationTrigger
		{
			Type = ValueChangeTrigger
			OperationalToggle = IsOverclocked
			ValueSource = CombinedBatteryStorage
			TriggerOnDecrease = false;
		}

		Overclock_GenerationHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_PowerGenerationTrigger
			Amount { BaseValue=ceil((&~/OVERCLOCK/HEAT_PER_BATTERY) * (&~/HEAT_TO_RESOURCE)); EffectScaleExponent=1 }
		}

		Port_Thermal_TopLeft : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0,0]
			Direction = Left
		}
		Port_Thermal_LeftUp : Port_Thermal_TopLeft
		{
			Location = [0, 0]
			Direction = Up
		}
		Port_Thermal_RightUp : Port_Thermal_LeftUp
		{
			Location = [1, 0]
		}
		Port_Thermal_TopRight : Port_Thermal_RightUp
		{
			Direction = Right
		}
		Port_Thermal_BottomRight : Port_Thermal_TopRight
		{
			Location = [1,1]
		}
		Port_Thermal_RightDown : Port_Thermal_BottomRight
		{
			Direction = Down
		}
		Port_Thermal_LeftDown : Port_Thermal_RightDown
		{
			Location = [0,1]
		}
		Port_Thermal_BottomLeft : Port_Thermal_LeftDown
		{
			Direction = Left
		}

		Graphics
		{
			Type = Graphics
			OperationalToggle = IsOperational
			Location = [1, 1]
			Floor
			{
				Layer = "doodads_high"
				DamageLevels
