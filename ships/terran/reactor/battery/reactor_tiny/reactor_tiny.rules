OVERCLOCK // : &<./Data/ships/terran/reactor_small/reactor_small.rules>/OVERCLOCK
{
	POWER_GENERATION_FACTOR = 300%
	EXTRA_CAPACITY_FACTOR = 200%
	HEAT_PER_SECOND = 800

	BATTERY_PER_SEC = (&~/Part/Components/BatteryProducer/ToQuantity/BaseValue) * (&POWER_GENERATION_FACTOR) / (&~/Part/Components/BatteryProducer/Interval/BaseValue) / 1000
	HEAT_PER_BATTERY = (&HEAT_PER_SECOND) / (&BATTERY_PER_SEC)
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO


Part : &<../base_part_terran_battery.rules>/Part
{
	//IDs
	ID = SW.reactor_tiny
	OtherIDs = [reactor_small1,SW.reactor_small1]

	//StringKeys
	NameKey = "Parts/SW_TinyReactor"
	IconNameKey = "Parts/SW_TinyReactorIcon"
	DescriptionKey = "Parts/SW_TinyReactorDesc"

	//Groups&Categories
	EditorGroups = /*: ^/0/EditorGroups*/ [Power, SWTechI]
	TypeCategories = /*: ^/0/TypeCategories*/ [reactor, provides_power, SW_Reactor_Tiny, SW_Tech_I]
	//RequiresCategories = []

	//Resoures&Size&Health
	Resources
	[
		[SW.durasteel, 8]
		[steel, 8]
		[coil, 20]
		[enriched_uranium, 2]
	]
	Size = [1, 1]
	MaxHealth = 1000

	//Selections
	SelectionPriority = 0
	//SelectionTypeByRotation = true
	IgnoreRotationForMirroredSelection = true
	SelectionTypeID = "reactors"

	//PartSpecific
	AIValueFactor = 5
	IsRotateable = false
	AutoDoorMaxPathLength = 5
	SignificanceToggle = ScorchedToggle
	CreateUnderlyingWhenDestroyed = false

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronDebuff, ElectronNebula]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "../reactor_small/icon.png"
			SampleMode = Linear
			//MipLevels = max
		}
		Size = [32, 32]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		IsOperational // : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles = [NonJunkToggle, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		NonJunkToggle
		{
			Type = JunkToggle
			OnWhenJunk = false
		}


		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		IsNonOverclocked
		{
			Type = MultiToggle
			Toggles = [ IsOverclocked ]
			Mode = None
		}
		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 2000
			StartingResources = &MaxResources
		}
		Overclock_BatteryStorage : BatteryStorage
		{
			MaxResources = (&^/0/MaxResources) * (&~/OVERCLOCK/EXTRA_CAPACITY_FACTOR)
			StartingResources = &MaxResources
		}
		Overclock_BatteryStorageProxy
		{
			Type = ResourceStorageProxy
			ComponentID = Overclock_BatteryStorage
			ProxyToggle = IsOverclocked
			ResourceType = battery
		}
		CombinedBatteryStorage : BatteryStorage
		{
			Type = MultiResourceStorage
			ResourceType = battery
			ResourceStorages = [ BatteryStorage, Overclock_BatteryStorageProxy ]
			SuppliesResources = true
			MinResourcesPickUp = 500
			MaxResourcesPickUp = 500
			ExpectedResourceGenerationToggle = IsOperational
			// InitPickUp = 500
			// PickUpRate = 500 / 1.0
			ExpectedResourceGenerationRate : ../BatteryProducer/ToQuantity
			{
				BaseValue = (&^/0/BaseValue) / (&../../BatteryProducer/Interval/BaseValue)
			}
			ToggleOnResources = 501
			ToggleOffResources = (&ToggleOnResources)-1
			ProvidedValueRange = 0
			ProvidedValuePerResource = 1/1000
		}
		OverclockChangedTrigger
		{
			Type = MultiTrigger
			Triggers = [OverclockEnabledTrigger, OverclockDisabledTrigger]
		}
		Overclock_DepleteBatteryOnOverclockChanged
		{
			Type = ResourceChange
			Trigger = OverclockChangedTrigger
			ResourceStorage = Overclock_BatteryStorage
			Amount = -(&../Overclock_BatteryStorage/MaxResources)
		}

		BatteryProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			ToStorage = CombinedBatteryStorage
			ToQuantity
			{
				BaseValue = 500
				Modifiers
				[
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, (&~/OVERCLOCK/POWER_GENERATION_FACTOR)]
					}
				]
			}
			Interval = { BaseValue=2/3; BuffType=ElectronDebuff; BuffMode=Divide; }
		}

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		Overclock_PowerGenerationTrigger
		{
			Type = ValueChangeTrigger
			OperationalToggle = IsOverclocked
			ValueSource = CombinedBatteryStorage
			TriggerOnDecrease = false;
		}

		Overclock_GenerationHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_PowerGenerationTrigger
			Amount { BaseValue=ceil((&~/OVERCLOCK/HEAT_PER_BATTERY) * (&~/HEAT_TO_RESOURCE)); EffectScaleExponent=1 }
		}

		// 1x1 PART: Only one cell at [0,0]. Four ports (Up, Right, Down, Left) on that cell.

		Port_Thermal_Left : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 0]
			Direction = Left
		}
		Port_Thermal_Up : Port_Thermal_Left
		{
			Direction = Up
		}
		Port_Thermal_Right : Port_Thermal_Left
		{
			Direction = Right
		}
		Port_Thermal_Down : Port_Thermal_Left
		{
			Direction = Down
		}

		Graphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"../reactor_small/floor_on1.png"
							"../reactor_small/floor_on2.png"
							"../reactor_small/floor_on3.png"
							"../reactor_small/floor_on4.png"
							"../reactor_small/floor_on5.png"
							"../reactor_small/floor_on6.png"
							"../reactor_small/floor_on7.png"
							"../reactor_small/floor_on8.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.095*(&~/Scale)
					}
					{
						AnimationFiles
						[
							"../reactor_small/floor_on1_33.png"
							"../reactor_small/floor_on2_33.png"
							"../reactor_small/floor_on3_33.png"
							"../reactor_small/floor_on4_33.png"
							"../reactor_small/floor_on5_33.png"
							"../reactor_small/floor_on6_33.png"
							"../reactor_small/floor_on7_33.png"
							"../reactor_small/floor_on8_33.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.095*(&~/Scale)
					}
					{
						AnimationFiles
						[
							"../reactor_small/floor_on1_66.png"
							"../reactor_small/floor_on2_66.png"
							"../reactor_small/floor_on3_66.png"
							"../reactor_small/floor_on4_66.png"
							"../reactor_small/floor_on5_66.png"
							"../reactor_small/floor_on6_66.png"
							"../reactor_small/floor_on7_66.png"
							"../reactor_small/floor_on8_66.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.095*(&~/Scale)
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "../reactor_small/reactor.png"
						Size = [1, 1]
					}
					{
						File = "../reactor_small/reactor_33.png"
						Size = [1, 1]
					}
					{
						File = "../reactor_small/reactor_66.png"
						Size = [1, 1]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"../reactor_small/lights1.png"
							"../reactor_small/lights2.png"
							"../reactor_small/lights3.png"
							"../reactor_small/lights4.png"
							"../reactor_small/lights5.png"
							"../reactor_small/lights6.png"
							"../reactor_small/lights7.png"
							"../reactor_small/lights8.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.075*(&~/Scale)
						VertexColor = [255*0.5, 255*0.5, 255*0.5]
					}
					{
						AnimationFiles
						[
							"../reactor_small/lights1.png"
							"../reactor_small/lights2.png"
							"../reactor_small/lights3.png"
							"../reactor_small/lights4.png"
							"../reactor_small/lights5.png"
							"../reactor_small/lights6.png"
							"../reactor_small/lights7.png"
							"../reactor_small/lights8.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.075/1.75*(&~/Scale)
						VertexColor = [255*0.5, 255*0.5, 255*0.5]
					}
					{
						AnimationFiles
						[
							"../reactor_small/lights1.png"
							"../reactor_small/lights2.png"
							"../reactor_small/lights3.png"
							"../reactor_small/lights4.png"
							"../reactor_small/lights5.png"
							"../reactor_small/lights6.png"
							"../reactor_small/lights7.png"
							"../reactor_small/lights8.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.075/2.5*(&~/Scale)
						VertexColor = [255*0.5, 255*0.5, 255*0.5]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "../reactor_small/floor_on1.png"
						Size = [1, 1]
					}
					{
						File = "../reactor_small/floor_off_33.png"
						Size = [1, 1]
					}
					{
						File = "../reactor_small/floor_off_66.png"
						Size = [1, 1]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [1, 1]
					}
					{
						File = "walls_33.png"
						Size = [1, 1]
					}
					{
						File = "walls_66.png"
						Size = [1, 1]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "../reactor_small/roof.png"
						NormalsFile = "../reactor_small/roof_normals.png"
						Size = [1, 1]
					}
					{
						File = "../reactor_small/roof_33.png"
						NormalsFile = "../reactor_small/roof_normals_33.png"
						Size = [1, 1]
					}
					{
						File = "../reactor_small/roof_66.png"
						NormalsFile = "../reactor_small/roof_normals_66.png"
						Size = [1, 1]
					}
				]

			}

		}
		ReactorLights_NonOverclocked_Components
		{
			Type = ToggledComponents
			Toggle = IsNonOverclocked
			Components
			{
			}
		}


		ReactorLights_Overclocked_Components
		{
			Type = ToggledComponents
			Toggle = IsOverclocked
			Components
			{

				}

				OCLights_Graphics
				{
					Type = Graphics
					OperationalToggle = IsOperational
					DoodadToggle = IsOverclocked
					Location = [0.5, 0.5]
					ToggleOnDoodad
					{
						Layer = "lights_add"
						DamageLevels
						[
							{
								File = "../reactor_small/OCLights.png"
								Size = [1, 1]
							}
						]
					}
				}
			}
		}

		ReactorHum
		{
			Type = ContinuousEffects
			Location = [0.5, 0.5]
			MaxMediaEffectsZoom = 2
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					Sound = "./Data/ships/terran/reactor_small/operating.wav"
					Volume = .5
					Speed = .75
					MaxConcurrent = 1
					DynamicVolume : ^/0/DynamicVolume
					{
						ExteriorVolume = .5*(&~/Scale)
					}
				}
			]
		}

		ElectronDebuffToggle
		{
			Type = BuffToggle
			BuffType = ElectronDebuff
		}

		ElectronNebulaEffects
		{
			Type = ContinuousEffects
			OperationalToggle = ElectronDebuffToggle
			Location = [0.5, 0.5]
			MediaEffectsIntensityFactor = { BaseValue=1; BuffType=ElectronNebula; BuffMode=Multiply; }
			MediaEffects
			[
				&<./Data/nebulas/electron/particles/electron_reactor_light.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "./Data/nebulas/electron/sounds/electron_cloud_reactor_weaken.wav"
					Volume = 1
					MaxConcurrentVolume = &Volume
					MaxConcurrent = 1
				}
			]
		}
		
		ElectronNebulaShipEffects
		{
			Type = ContinuousEffects
			OperationalToggle = ElectronDebuffToggle
			Location = [0.5, 0.5]
			ParentToShip = true
			MediaEffectsIntensityFactor = { BaseValue=1; BuffType=ElectronNebula; BuffMode=Multiply; }
			MediaEffects
			[
				&<./Data/nebulas/electron/particles/electron_reactor_sizzle.rules>
			]
		}

		BatterySprites
		{
			Type = ResourceSprites
			Location = [0.5, 0.5]
			ResourceStorage = CombinedBatteryStorage
			Layer = "doodads_high"
			Round = Down
			ResourceLevels
			[
				{
					File = "../reactor_small/batteries4.png"
					Size = [1, 1]
				}
				{
					File = "../reactor_small/batteries8.png"
					Size = [1, 1]
				}
			]
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = [0.5, 0.5]
			HitEffects
			[
				{
					Type = ExplosiveResourceDrain
					ResourceType = battery
					TotalDrain = { BaseValue = 20000; EffectScaleExponent = .75 }
					Radius = 4
					Delay = .05
					ExpandDuration = .1
					ExpandStartRadius = 1
					ExpandLoss = 100%
					Filter
					{
						Friendlies = true
					}
					MediaEffectsOnDrainFactor = .00025
					MediaEffectsOnDrain
					[
						&<./Data/shots/missile_emp/particles/missile_emp_hit_sizzle.rules>
						&<./Data/shots/missile_emp/particles/missile_emp_lightning.rules>
						&<./Data/shots/missile_emp/particles/missile_emp_drain.rules>

						: /BASE_SOUNDS/AudioExterior
						{
							Sound = "./Data/shots/disruptor_bolt/discharge.wav"
							Volume = 1
							SpeedVariation = .2
						}
					]
				}
			]
			MediaEffects : /COMMON_EFFECTS/MedPartScorched
			[
				&<./Data/shots/missile_emp/particles/missile_emp_hit_orb.rules>
				&<./Data/shots/missile_emp/particles/missile_emp_hit_bolts.rules>
				&<./Data/shots/missile_emp/particles/missile_emp_hit_shockwave.rules>
			]
		}

		DestroyedEffects
		{
			Type = DeathEffects
			Location = [0.5, 0.5]

			MediaEffects
			[
				&<./Data/ships/terran/reactor_small/particles/reactor_explode_small.rules>
				&<./Data/ships/terran/reactor_small/particles/reactor_explode_flash_small.rules>
				&<./Data/ships/terran/reactor_small/particles/reactor_shockwave_small.rules>
				&<./Data/common_effects/particles/explosions/med_part_explode_debris.rules>
				&<./Data/common_effects/particles/explosions/big_part_explode_smoke.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "destroyed.wav"
					Volume = 1
					SpeedVariation = .25
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .25
					Duration = 2
				}
			]

			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = 50000
					Radius = 4
					Delay = .05
					ExpandDuration = .1
					ExpandStartRadius = 2
					ExpandLoss = 100%
					StatusType = cosmoteer.fire
					StatusChancePerNDamage = 25%
					StatusValue = 1
					StatusValueType = Interpolated
					ImpulsePerNDamage = 5
					NDamage = 500
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage = 10000
					Radius = 2
					Delay = .05
					ExpandDuration = .05
					ExpandStartRadius = 1
					ExpandLoss = 100%
					ImpulsePerNDamage = 2
					NDamage = 500
					Filter
					{
						OperationalHealth = false
						StructuralHealth = true
						Friendlies = true
					}
				}
			]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [0.5, 0.5]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2]
				}
				// Out of power.
				{
					Toggle = CombinedBatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [0.5, 0.5]
					}
				}
				// Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [0.5, 0.5]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "../reactor_small/blueprints.png"
			Size = [1, 1]
		}

		PeakHeatGenerationStatValue
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/HEAT_PER_SECOND)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationStatValue
		}
	}

	Stats
	{
		PowerGeneration = (&~/Part/Components/BatteryProducer/ToQuantity/BaseValue) / (&~/Part/Components/BatteryProducer/Interval/BaseValue) / 1000
		BatterySize = (&~/Part/Components/CombinedBatteryStorage/MaxResourcesPickUp) / 1000
		BatteryFillTime = 0
		PowerCapacity = (&~/Part/Components/CombinedBatteryStorage/MaxResources) / 1000
	}

	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		Stats
		{
			PowerCapacity = (&~/Part/Stats/PowerCapacity) * (1 + (&~/OVERCLOCK/EXTRA_CAPACITY_FACTOR))
			PowerGeneration = (&~/Part/Stats/PowerGeneration) * (&~/OVERCLOCK/POWER_GENERATION_FACTOR)
			PowerHeatGeneration = [&~/OVERCLOCK/HEAT_PER_BATTERY, &~/OVERCLOCK/HEAT_PER_SECOND]
		}
	}

Size = Tiny
Scale = (1/4)