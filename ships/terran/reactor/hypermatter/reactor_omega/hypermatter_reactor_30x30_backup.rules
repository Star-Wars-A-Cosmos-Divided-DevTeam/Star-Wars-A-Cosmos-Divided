{
	//IDs
	ID = SW.hypermatter_reactor_30x30

	//StringKeys
	NameKey = "Parts/HypermatterReactor30x30"
	IconNameKey = "Parts/HypermatterReactor30x30Icon"
	DescriptionKey = "Parts/HypermatterReactor30x30Desc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups [ SWTechIII ]
	TypeCategories : ^/0/TypeCategories [hypermatter_reactor, reactor, provides_power, consumes_hypermatter, SW_Reactor_Omega, SW_Tech_III]
	RequiresCategories = [SW_Bridge, SW_WarRoom]

	//Resoures&Size&Health
	Resources
	[
		[steel, 2300]
		[coil, 1300]
		[coil2, 130]
		[tristeel, 230]
		[processor, 111]
	]  //Cost = 9550000
	Size = [30, 30]
	MaxHealth = 1000000

	//Selections
	SelectionPriority = 0
	//SelectionTypeByRotation = true
	IgnoreRotationForMirroredSelection = true
	SelectionTypeID = "hypermatter-reactors"

	//PartSpecific
	AIValueFactor = 5
	IsRotateable = false
	AutoDoorMaxPathLength = 5
	CreateUnderlyingWhenDestroyed = false

	//Crew
	CrewSpeedFactor = 1
	CrewCongestedSpeedFactor = .5

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs []

	//Doors&Etc
