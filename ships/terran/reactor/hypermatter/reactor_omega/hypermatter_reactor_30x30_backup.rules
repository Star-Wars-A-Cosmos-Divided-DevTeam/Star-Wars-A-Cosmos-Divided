	//Editor
	EditorIcon
	{
		Texture
		{
			File = "../reactor_giga/icon.png"
			SampleMode = Linear
		}
		Size = [92, 92]
	}

	//Components&Inheritance
	Components : ^/0/Components, <graphics_30x30.rules>, &<doodad_components.rules>
	{
		IsOperational : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [True, PowerToggle]
			Mode = All
		}
		True
		{
			Type = StaticToggle
			ToggleOn = "true"
		}
		ColorPicker
		{
			Type = UIColor
			ColorID = "SW_Part_Color"
			Default = [128, 128, 128, 255]//.85 saturation
			RequiresCommand = false
		}
		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 2000000
			StartingResources = 0
			SuppliesResources = true
			MinResourcesPickUp = 3000
			MaxResourcesPickUp = 3000
			InitPickUp = 3000
			PickUpRate = 100000
			ExpectedResourceGenerationRate = { BaseValue = (&../../BatteryProducer/ToQuantity) / (&../../BatteryProducer/Interval/BaseValue) / 4; BuffType=ElectronDebuff; BuffMode=Multiply; }
			ToggleOnResources = 3000
			ToggleOffResources = (&ToggleOnResources)-1
		}
		BatteryProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperationalAndHypermatterReactorToggle
			From
			[
				{
					Storage = HypermatterStorage
					Quantity = 10
				}
			]
			ToStorage = BatteryStorage
			ToQuantity = 2000
			Interval =  { BaseValue=(1/30); BuffType=ElectronDebuff; BuffMode=Divide; }//1/30
			//CheckResourceLimits = true
		}
		BatteryStorageBar
		{
			Type = ProgressBar
			OperationalToggle = True
			ShowProgressFor = BatteryStorage
			LowColor = [64, 64, 0]
			HighColor = [250, 250, 0]
			FullColor = [255, 255, 0]
		}

		HypermatterStorage
		{
			Type = ResourceStorage
			ResourceType = SW.hypermatter
			MaxResources = 45000
			StartingResources = 0
			//SuppliesResources = true
			MinResourcesPickUp = 1000
			MaxResourcesPickUp = 3000
			ExpectedResourceGenerationRate = { BaseValue = (&../../HypermatterProducer/ToQuantity) / (&../../HypermatterProducer/Interval/BaseValue); BuffType=ElectronDebuff; BuffMode=Multiply; }
			ToggleOnResources = 1000
			ToggleOffResources = (&ToggleOnResources) -1
		}
		HypermatterProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			ToStorage = HypermatterStorage
			ToQuantity = 20
			Interval = { BaseValue=(1/30); BuffType=ElectronDebuff; BuffMode=Divide; } //1/10
		}
		HypermatterConsumer
		{
			Type = ResourceConsumer
			ResourceType = SW.hypermatter
			Storage = HypermatterStorage
			DefaultPriority = &/PRIORITIES/Defense_Supply
			ResupplyThreshold = 0
			OperationalToggle = PowerToggle
		}
		HypermatterStorageBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = HypermatterStorage
			LowColor = [0, 32, 64]
			HighColor = [0, 250, 250]
			FullColor = [0, 255, 255]
		}

		IsOperationalAndHypermatterReactorToggle
		{
			Type = MultiToggle
			Toggles = [IsOperational, HypermatterReactorToggle]
			Mode = All
		}

		HypermatterReactorToggle
		{
			Type = TriggeredToggle
			OperationalToggle = IsOperational
			OnTrigger = BatteryStorageTurnsReactorOn
			OffTrigger = BatteryStorageTurnsReactorOff
		}
		BatteryStorageTurnsReactorOn
		{
			Type = ThresholdTrigger
			AmountFrom = BatteryStorage
			MaxAmount = 10%
		}
		BatteryStorageTurnsReactorOff
		{
			Type = ThresholdTrigger
			AmountFrom = BatteryStorage
			MinAmount = 100%
		}

