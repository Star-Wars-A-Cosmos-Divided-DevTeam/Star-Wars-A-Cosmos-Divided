Part : &<../base_part_terran_sw_scorched.rules>/Part
{
	EditorGroups : ^/0/EditorGroups [Control]

	TypeCategories : ^/0/TypeCategories []

	ReceivableBuffs : ^/0/ReceivableBuffs []

	Components : ^/0/Components 
	{
		IsOperationalAndCommandToggle : ^/0/IsOperationalAndCommandToggle 
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [IsOperational, CommandToggle]
			Mode = All
		}

		CommandToggle
		{
			Type = CommandToggle
		}
	}	
}