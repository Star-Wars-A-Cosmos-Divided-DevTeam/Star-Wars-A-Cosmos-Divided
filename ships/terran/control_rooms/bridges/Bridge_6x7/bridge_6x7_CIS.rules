		Graphics
		{
			Type = Graphics
			OperationalToggle = IsOperational
			Location = [3, 3.5]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "CIS/floor.png"
						Size = [6, 7]
					}
					{
						File = "CIS/floor_33.png"
						Size = [6, 7]
					}
					{
						File = "CIS/floor_66.png"
						Size = [6, 7]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "CIS/lights.png"
						Size = [6, 7]
						VertexColor = [72, 72, 164]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"CIS/doodads_on.png"
							"CIS/doodads_on1.png"
							"CIS/doodads_on2.png"
							"CIS/doodads_on3.png"
						]
						Size = [6, 7]
						AnimationInterval = 0.80
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "CIS/walls.png"
						Size = [6, 7]
					}
					{
						File = "CIS/walls_33.png"
						Size = [6, 7]
					}
					{
						File = "CIS/walls_66.png"
						Size = [6, 7]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "CIS/roof.png"
						NormalsFile = "CIS/roof_normals.png"
						Size = [6, 7]
					}
					{
						File = "CIS/roof_33.png"
						NormalsFile = "CIS/roof_33_normals.png"
						Size = [6, 7]
					}
					{
						File = "CIS/roof_66.png"
						NormalsFile = "CIS/roof_66_normals.png"
						Size = [6, 7]
					}
				]
			}
		}
