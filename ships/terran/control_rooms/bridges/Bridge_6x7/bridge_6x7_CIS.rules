		BatterySprites
		{
			Type = ResourceSprites
			Location = [3, 3.5]
			ResourceStorage = BatteryStorage
			Layer = "doodads_low"
			HasZeroResourceSprite = false
			ResourceLevels
			[
				{
					File = "CIS/batteries1.png"
					Size = [6, 7]
				}
				{
					File = "CIS/batteries2.png"
					Size = [6, 7]
				}
				{
					File = "CIS/batteries3.png"
					Size = [6, 7]
				}
				{
					File = "CIS/batteries4.png"
					Size = [6, 7]
				}
				{
					File = "CIS/batteries5.png"
					Size = [6, 7]
				}
				{
					File = "CIS/batteries6.png"
					Size = [6, 7]
				}
				{
