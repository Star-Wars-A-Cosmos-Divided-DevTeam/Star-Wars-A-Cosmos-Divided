					Size = [6, 7]
				}
				{
					File = "CIS/batteries8.png"
					Size = [6, 7]
				}
				{
					File = "CIS/batteries9.png"
					Size = [6, 7]
				}
				{
					File = "CIS/batteries10.png"
					Size = [6, 7]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Toggle = IsOperational
			Location = [3, 3.5]
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}
		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/HugePartDestroyed
			Location = [3, 3.5]
		}
		OperationSoundLoop
		{
			Type = ContinuousEffects
			Location = [3, 3.5]
			OperationalToggle = IsOperational
			MaxMediaEffectsZoom = 4
			MediaEffects
			[
				&/SW_SOUNDS/ControlRoomSmallOperating
			]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [3, 3.5]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3]
				}

				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [2, 2]
					}
					HidesIndicators = [2,3]
				}

				//Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [3, 3]
					}
				}

				//No crew.
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [4, 4]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "CIS/blueprints.png"
			Size = [6, 7]
		}
	}

	//Stats
	Stats
	{
		CrewRequired = (&~/Part/Components/PartCrewCaptian/Crew) + (&~/Part/Components/PartCrewNavigatorsL/Crew) + (&~/Part/Components/PartCrewNavigatorsR/Crew) + (&~/Part/Components/PartCrewOfficers/Crew)
		PowerUsageContinuousMinutes = (&~/Part/Components/PowerDrain/FromQuantity) / (&~/Part/Components/PowerDrain/Interval) / 1000 * 60
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		SightRange = (&~/Part/Components/SelfBuffProvider/BuffAmount)^0.5
		RadarRange = (&~/Part/Components/SelfBuffProviderRadar/BuffAmount)^0.5

		RecPower = (&PowerUsageContinuousMinutes) / 60
		RecCrew = (&CrewRequired) + (&RecPower) * 4
	}
	Features
	[
		CanBuffSWSensor
	]
}