            Components
            {
                NozzleRoofCoverGraphics0
                {
                    Type = Graphics
                    Location = [.5, 1]
			        Roof
			        {
			        	Layer = "roofs"
			        	DamageLevels
			        	[
			        		{
			        			File = "roof.png"
