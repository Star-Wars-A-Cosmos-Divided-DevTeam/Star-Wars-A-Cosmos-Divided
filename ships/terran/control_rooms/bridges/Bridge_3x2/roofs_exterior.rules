			        Roof
			        {
			        	Layer = "roofs"
                        //Offset = [0, 0.5] // Offset X = 0 (no change) Offset Y = remainder of loc to end of part + half of roof cover Size height (Y) (e.g., Location of mid part = .5, .5, Roof Size = [1, 7] then offset for Y is .5 + 3.5 = 4)
			        	DamageLevels
			        	[
			        		{
			        			File = "full_roof.png"
			        			NormalsFile = "full_roof_normals.png"
			        			Size = [3, 2]
			        		}
			        		{
			        			File = "full_roof_33.png"
			        			NormalsFile = "full_roof_33_normals.png"
			        			Size = [3, 2]
			        		}
			        		{
			        			File = "full_roof_66.png"
			        			NormalsFile = "full_roof_66_normals.png"
			        			Size = [3, 2]
			        		}
			        	]
