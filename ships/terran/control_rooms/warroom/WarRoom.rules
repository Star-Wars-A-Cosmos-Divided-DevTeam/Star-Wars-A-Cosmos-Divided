Part : &<../base_part_terran_control_rooms.rules>/Part
{
	//IDs
	ID = SW.WarRoom

	//StringKeys
	NameKey = "Parts/WarRoom"
	IconNameKey = "Parts/WarRoomIcon"
	DescriptionKey = "Parts/WarRoomDesc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups [SWTechIII]
	RequiresCategories = [SW_Bridge]
	TypeCategories : ^/0/TypeCategories [command, uses_power, is_crewed, SW_WarRoom, SW_Tech_III]

	//Resources&Size&Health
	Resources
	[
		[steel, 720]//[steel, 360]
		[SW.durasteel, 480] 
		[SW.doonium_ingot, 360]
		[coil2, 160]//[coil2, 80]
		[processor, 48]//[processor, 16]
	]
	Size = [6, 7]
	MaxHealth = 20000

	//Selections
	SelectionPriority = 0
	SelectionTypeID = "SW_war_room"

	//PartSpecific
	AIValueFactor = 5
	//IsContiguityOrigin = true
	//IsShipForward = true
	ContiguityOriginPriority = 5

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs [SW_Sensor]

	//SpecialCells
	ForceManhattenPathInPart = true
	BlockedTravelCells
	[
		[1, 1]
		[1, 5]
		//[2, 3]
		//[3, 3]
		[4, 1]
		[4, 5]
	]
	HasNonContiguousPathing = true
	BlockedTravelCellDirections
	[
		{
			Key = [2, 2]
			Value = [Down]
		}
		{
			Key = [2, 3]
			Value = [Right]
		}
		{
			Key = [2, 4]
			Value = [Up]
		}

		{
			Key = [3, 2]
			Value = [Down]
		}
		{
			Key = [3, 4]
			Value = [Up]
		}
	]

	//Doors&Etc
	AutoDoorMaxPathLength = 5
	AllowedDoorLocations
	[
		[3, -1]
		[2, -1]

		[-1, 2]
		[6, 2]
		[-1, 3]
		[6, 3]
		[-1, 4]
		[6, 4]

		[3, 7]
		[2, 7]
	]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Point
			MipLevels = max
		}
		Size = [47, 55]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		IsOperational : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [PowerToggle, BatteryStorage,  PartCrew]
			Mode = All
		}

		IsOperationalAndCommandToggle : ^/0/IsOperationalAndCommandToggle 
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [IsOperational, CommandToggle]
			Mode = All
		}

		CommandToggle
		{
			Type = CommandToggle
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		FtlBeacon
		{
			Type = FtlBeacon
			OperationalToggle = IsOperationalAndCommandToggle
		}
		Pulse
		{
			Type = ContinuousEffects
			Location = [3, 3.5]
			OperationalToggle = IsOperationalAndCommandToggle
			FactorMediaEffectsIntensityWith = RoofOpacity
			MediaEffects
			[
				&<hyperdrive_beacon_pulse.rules>
			]
		}
		RoofOpacity
		{
			Type = RoofOpacity // DO NOT EVER USE COMPONENTS OF THIS TYPE FOR GAMEPLAY LOGIC!!! IT WILL CAUSE DESYNCS!!! USE FOR RENDERING ONLY!!!
		}

		CommandProvider
		{
			Type = CommandProvider
			OperationalToggle = IsOperational
			CommandPoints = 3600 // Remember to update tooltip.
		}
		/*
		GridBuffProvider
		{
			Type = GridBuffProvider
			BuffType = SW_Sensor
			BuffAmount = 50%
			GridDistance = 100
			OperationalToggle = IsOperational
		}

		SelfBuffProvider
		{
			Type = SelfBuffProvider
			BuffType =	SW_Sensor
			ChainsFromBuffType = SW_Sensor
			BuffAmount = { BaseValue=100%; BuffType=SW_Sensor; BuffMode=Add; }
		}

		Sensor
		{
			Type = Sensor
			OperationalToggle = IsOperationalAndCommandToggle
			SightRadius = { BaseValue=1500; BuffType=SW_Sensor; BuffMode=Multiply; MaxValue=3000; } //was 2500
			RadarRadius = { BaseValue=2500; BuffType=SW_Sensor; BuffMode=Multiply; MaxValue=5000; } //was 4500
		}
		*/
		Sensor
		{
			Type = Sensor
			OperationalToggle = IsOperationalAndCommandToggle
			SightRadius = 2500
			RadarRadius = 4500
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 8000
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/ControlRoom_Supply
			ResupplyThreshold = 1000
			OperationalToggle = PowerToggle
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		PowerDrain
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			FromStorage = BatteryStorage
			FromQuantity = 1000
			MinFromQuantityForConversion = 1
			Interval = 10 // Drains 1 power every 10 seconds.
		}

		CrewLocation1 //CircleTop
		{
			Type = CrewLocation
			Location = [3, 2.27]
			Rotation = 180d
		}
		CrewLocation2 //CircleLeft
		{
			Type = CrewLocation
			Location = [1.75, 3.5]
			Rotation = 90d
		}
		CrewLocation3 //CircleRight
		{
			Type = CrewLocation
			Location = [4.25, 3.5]
			Rotation = 270d
		}
		CrewLocation4 //CircleBottom
		{
			Type = CrewLocation
			Location = [3, 4.72]
			Rotation = 0d
		}
		CrewLocation5
		{
			Type = CrewLocation
			Location = [1.5, 1.85]
			Rotation = 0d
		}
		CrewLocation6
		{
			Type = CrewLocation
			Location = [4.5, 1.85]
			Rotation = 0d
		}
		CrewLocation7
		{
			Type = CrewLocation
			Location =  [1.85, 5.5]
			Rotation = 270d
		}
		CrewLocation8
		{
			Type = CrewLocation
			Location = [4.15, 5.5]
			Rotation = 90d
		}

		PartCrew
		{
			Type = PartCrew
			Crew = 8
			DefaultPriority = &/PRIORITIES/ControlRoom_Crew
			PrerequisitesBeforeCrewing = [PowerToggle]
			HighPriorityPrerequisites = [BatteryStorage]
			AbandonWhenOnFire = false
			CrewDestinations
			[
				[3, 2.27]
				[1.75, 3.5]
				[4.25, 3.5]
				[3, 4.72]

				[1.5, 2]
				[4.5, 2]
				[2, 5.5]
				[3.99, 5.5]
			]
			CrewLocations
			[
				CrewLocation1
				CrewLocation2
				CrewLocation3
				CrewLocation4
				CrewLocation5
				CrewLocation6
				CrewLocation7
				CrewLocation8
			]
			//SwitchLocationInterval = [5, 10]
		}

		DarknessGrid : &/SW_GRAPHICS/DarknessGrid/GridSize_1x1/Darkness
		{
			OperationalToggle = IsOperationalAndCommandToggle
			InvertOperationalToggle = true
		}

		Graphics
		{
			Type = Graphics
			OperationalToggle = IsOperational

			Location = [3,3.5]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [6, 7]
					}
					{
						File = "floor_33.png"
						Size = [6, 7]
					}
					{
						File = "floor_66.png"
						Size = [6, 7]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [6,7]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads1.png"
							"doodads2.png"
						]
						Size = [6,7]
						AnimationInterval = 0.80
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "doodads.png"
						Size = [6, 7]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [6, 7]
					}
					{
						File = "walls_33.png"
						Size = [6, 7]
					}
					{
						File = "walls_66.png"
						Size = [6, 7]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [6, 7]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [6, 7]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [6, 7]
					}
				]
			}
		}
		BatterySprites
		{
			Type = ResourceSprites
			Location = [3, 3.5]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			ResourceLevels
			[
				{
					File = "batteries_1.png"
					Size = [2, 2]
				}
				{
					File = "batteries_2.png"
					Size = [2, 2]
				}
				{
					File = "batteries_3.png"
					Size = [2, 2]
				}
				{
					File = "batteries_4.png"
					Size = [2, 2]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Toggle = IsOperational

			Location = [1, 1]
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [3,3.5]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [3, 3.5]
			Indicators
			[
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [4, 4]
					}
					HidesIndicators = [1,2]
				}
				//Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [4, 4]
					}
				}
				//No crew.
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [4, 4]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [6, 7]
		}
	}
	//Stats
	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		PowerUsageContinuousMinutes = (&~/Part/Components/PowerDrain/FromQuantity) / (&~/Part/Components/PowerDrain/Interval) / 1000 * 60
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		SightRange = &~/Part/Components/Sensor/SightRadius // /BaseValue
		RadarRange = &~/Part/Components/Sensor/RadarRadius // /BaseValue
		CommandPoints =  &~/Part/Components/CommandProvider/CommandPoints

		RecPower = (&PowerUsageContinuousMinutes) / 60
		RecCrew = (&CrewRequired) + (&RecPower) * 4
	}
	Features
	[
		CanBuffSWSensor
	]
}