Part : &<base_part_terran_overclock.rules>/Part, &<base_part_terran_sw_scorched.rules>/Part
{
	TypeCategories : ^/1/TypeCategories [SW_Tech_OC]

	ReceivableBuffs : ^/0/ReceivableBuffs, ^/1/ReceivableBuffs []

	Components : ^/0/Components, ^/1/Components
	{
		IsOperational : ^/1/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [&~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}
	}
}

/*
*/
/* 
*	WHY?	--	This File Allows us for short/long term avoid changes made to base part terran && Make Modifications to all Parts Drawing from here at once.
*	Like?	--	We could do SW part specific effects or IDK what.
*/