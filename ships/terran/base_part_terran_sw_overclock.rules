Part : &<./Data/ships/terran/base_part_terran_overclock.rules>/Part, &<base_part_terran_scorched.rules>/Part
{
	TypeCategories : ^/0/TypeCategories []

	ReceivableBuffs : ^/0/ReceivableBuffs []

	Components : ^/0/Components, ^/1/Components
	{
		IsOperational : ^/1/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [OverclockReset]
			Mode = All
		}
		Indicators : ^/1/Indicators
		{
			Indicators : ^/0/Indicators
			[

			]
		}
	}
}

