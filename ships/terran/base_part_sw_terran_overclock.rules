Part : &<./Data/ships/terran/base_part_terran_overclock.rules>/Part, &<base_part_sw_terran_scorched.rules>/Part
{
	TypeCategories : ^/0/TypeCategories, ^/1/TypeCategories []

	ReceivableBuffs : ^/0/ReceivableBuffs, ^/1/ReceivableBuffs []

	Components : ^/0/Components, ^/1/Components
	{
		Indicators : ^/0/Indicators, ^/1/Indicators
		{
			Indicators : ^/0/Indicators, ^/1/Indicators []
		}
	}
}

