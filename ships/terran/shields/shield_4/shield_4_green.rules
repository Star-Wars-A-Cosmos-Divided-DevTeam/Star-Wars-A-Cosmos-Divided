Components
	{
		ArcShield
		{
			Type = ArcShield
			Radius = &<../ShieldTuner.rules>/Huge/Radius
			Arc = &<../ShieldTuner.rules>/All/Arc
			Rotation = -90d
			OperationalToggle = IsOperational
			BlockedByOperationalParts = &<../ShieldTuner.rules>/All/BlockedByOperationalParts
			DrainResourcesFrom = BatteryStorage
			Location = &<../ShieldTuner.rules>/Huge/Location
			PenetrationResistance = &<../ShieldTuner.rules>/Huge/PenetrationResistance
			ResourceDrainPerDamage = &<../ShieldTuner.rules>/All/ResourceDrainPerDamage

			BlueprintArcSprite
			{
				Texture
				{
					File =	"./Data/ships/terran/shield_gen_small/shield_energy.png"
					UVMode = Wrap
					SampleMode = Linear
					MipLevels = 1
				}
				_xScale = &<ShieldTuner.rules>/Huge/_xScale
				Size = &<../ShieldTuner.rules>/Huge/Size
				Color = [0, 0, 255, 127]
			}
			BlueprintArcSpriteSegments = 64

			CoverageArcSprite
			{
				Texture
				{
					File = "./Data/ships/terran/shield_gen_small/shield_energy.png"
					UVMode = Wrap
					SampleMode = Linear
					MipLevels = 1
				}
				Size = &<../ShieldTuner.rules>/Huge/Size
				Color = [255, 255, 255, 127]
			}
			CoverageArcSpriteSegments = 64

			ShieldMediaEffects
			[
				{
					Type = ArcShield
					Radius = &<../ShieldTuner.rules>/Huge/Radius
					Arc = &<../ShieldTuner.rules>/All/Arc
					FadeInTime = .25
					FadeOutTime = .25
					FadeFromScale = .8
					//ArcAngleAffectsUVs = true
					UPerNinetyDegrees = 1
					ArcSprite
					{
						Texture
						{
							File = "./Data/ships/terran/shield_gen_small/shield_energy.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = 1
						}
						Shader = "./Data/ships/terran/shield_gen_small/shield.shader"
						_waveTex
						{
							File = "./Data/ships/terran/shield_gen_small/shield_energy_wave.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = max
						}
						_maskTex
						{
							File = "./Data/ships/terran/shield_gen_small/shield_mask.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = 1
						}
						_waveSpeed = &<../ShieldTuner.rules>/Huge/_waveSpeed
						_waveAlpha = &<../ShieldTuner.rules>/All/_waveAlpha
						_waveCurveInterval = &<../ShieldTuner.rules>/Huge/_waveCurveInterval
						_waveCurveMagnitude = &<../ShieldTuner.rules>/Huge/_waveCurveMagnitude
						_waveCurveUOffsetPerSecond = &<../ShieldTuner.rules>/Huge/_waveCurveUOffsetPerSecond
						_fullPowerColor1 = &<../ShieldTuner.rules>/Green/_fullPowerColor1
						_lowPowerColor1 = &<../ShieldTuner.rules>/Green/_lowPowerColor1
						_fullPowerColor2 = &<../ShieldTuner.rules>/Green/_fullPowerColor2
						_lowPowerColor2 = &<../ShieldTuner.rules>/Green/_lowPowerColor2
						_lowPowerThicknessExponent = &<../ShieldTuner.rules>/All/_lowPowerThicknessExponent
						_xScale = &<../ShieldTuner.rules>/Huge/_xScale
						_hexDamageIntensity = 0.5
						TargetBlendMode = Add
						Size = &<../ShieldTuner.rules>/Huge/Size
					}
					ArcSpriteSegments = 64
					Bucket = Lower2
				}

/*
				: /BASE_SOUNDS/AudioExteriorDetail
				{
					Sound = "./Data/ships/terran/shield_gen_small/sounds/shield_emitter_loop.wav"
					Volume = .15
					Speed = .5
					MaxConcurrent = 1
					MaxConcurrentVolume = .3
					DynamicVolume : ^/0/DynamicVolume
					{
						MinDistance = .75
						MaxDistance = 1.5
					}
					IgnoreIntensity = true
				}
*/
			]

			HitMediaEffects
			[
				{
					Type = ArcShield
					FadeInTime = .1
					FadeOutTime = .5
					Radius = &<../ShieldTuner.rules>/Huge/Radius
					Arc = &<../ShieldTuner.rules>/All/HitArc
					ArcSprite
					{
						Texture
						{
							File = "./Data/ships/terran/shield_gen_small/shield_energy_original.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = max
						}
						Shader = "./Data/ships/terran/shield_gen_small/shield.shader"
						_waveTex
						{
							File = "./Data/ships/terran/shield_gen_small/shield_energy_wave.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = max
						}
						_maskTex
						{
							File = "./Data/ships/terran/shield_gen_small/shield_energy_original.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = max
						}
						_waveSpeed = -2*(&<../ShieldTuner.rules>/Huge/_waveSpeed)
						_waveAlpha = 0.75*(&<../ShieldTuner.rules>/All/_waveAlpha)
						_waveCurveInterval = &<../ShieldTuner.rules>/Huge/_waveCurveInterval
						_waveCurveMagnitude = (5/7)*(&<../ShieldTuner.rules>/Huge/_waveCurveMagnitude)
						_waveCurveUOffsetPerSecond = 0
						_fullPowerColor1 = &<../ShieldTuner.rules>/Green/_fullPowerColor1
						_lowPowerColor1 = &<../ShieldTuner.rules>/Green/_lowPowerColor1
						_fullPowerColor2 = &<../ShieldTuner.rules>/Green/_fullPowerColor2
						_lowPowerColor2 = &<../ShieldTuner.rules>/Green/_lowPowerColor2
						_lowPowerThicknessExponent = &<../ShieldTuner.rules>/All/_lowPowerThicknessExponent
						_xScale = &<../ShieldTuner.rules>/Huge/_xScale
						Size = &<../ShieldTuner.rules>/Huge/Size
						TargetBlendMode = Add
					}
					ArcSpriteSegments = 6
					Bucket = Upper3
				}
				&/SW_SOUNDS/ShieldHit
			]
		}
		
		OverclockEffect
		{
			Type = ShieldArcsMimic
			Shield = ArcShield
			ChainedTo = ArcShield
			FactorMediaEffectsIntensityWith = BatteryStorage
			MimicFadeInStartTime = false
			OperationalToggle = OverclockedEffectToggle
			ContinuousEffects
			[
				{
					Type = ArcShield
					Radius = &~/Components/ArcShield/Radius
					Arc = &~/Components/ArcShield/Arc
					FadeInTime = .25
					FadeOutTime = .25
					FadeFromScale = 1.025
					ArcSprite
					{
						Texture
						{
							File = "./Data/ships/terran/shield_gen_small/shield_energy_oc.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = 1
						}
						Shader = "./Data/ships/terran/shield_gen_small/shield.shader"
						_waveTex
						{
							File = "./Data/ships/terran/shield_gen_small/shield_energy_wave.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = max
						}
						_maskTex
						{
							File = "./Data/ships/terran/shield_gen_small/shield_mask_oc.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = 1
						}
						_waveSpeed = 1*(&<../ShieldTuner.rules>/Huge/_waveSpeed)
						_waveAlpha = 1*(&<../ShieldTuner.rules>/All/_waveAlpha)
						_waveCurveInterval = &<../ShieldTuner.rules>/Huge/_waveCurveInterval
						_waveCurveMagnitude = (5/7)*(&<../ShieldTuner.rules>/Huge/_waveCurveMagnitude)
						_waveCurveUOffsetPerSecond = .2
						_fullPowerColor1 = [203, 80, 33, 127]
						_lowPowerColor1 = [255, 0, 0, 127]
						_fullPowerColor2 = [255, 134, 36, 255]
						_lowPowerColor2 = [255, 50, 0, 127]
						_lowPowerThicknessExponent = &<../ShieldTuner.rules>/All/_lowPowerThicknessExponent
						_xScale = &<../ShieldTuner.rules>/Huge/_xScale
						Size = &<../ShieldTuner.rules>/Huge/Size
						_hexDamageIntensity = 0.8
						TargetBlendMode = Add
					}
					ArcSpriteSegments = 64
					Bucket = Lower1
				}
			]
		}
		
		OverloadEffect
		{
			Type = ShieldArcsMimic
			Shield = ArcShield
			ChainedTo = ArcShield
			FactorMediaEffectsIntensityWith = BatteryStorage
			FactorRedVertexColorWith = OverloadValue
			OperationalToggle = IsOperationalOverloaded
			ContinuousEffects
			[
				{
					Type = ArcShield
					Radius = &~/Components/ArcShield/Radius
					Arc = &~/Components/ArcShield/Arc
					FadeInTime = 0.5
					FadeOutTime = 0.5
					FadeFromScale = .8
					//ArcAngleAffectsUVs = true
					//UPerNinetyDegrees = 1
					ArcSprite
					{
						Texture
						{
							File = "./Data/ships/terran/shield_gen_small/shield_overload.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = 1
						}
						Shader = "./Data/ships/terran/shield_gen_small/shield_overload.shader"
						_noiseTex1
						{
							File = "./Data/statuses/fire/particles/fire_noise.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = max
						}
						_noiseTex2
						{
							File = "./Data/statuses/fire/particles/fire_noise.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = max
						}
						_baseShieldTex
						{
							File = ./Data/ships/terran/shield_gen_small/shield_mask.png
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = 1
						}
						_waveSpeed = 1*(&<../ShieldTuner.rules>/Huge/_waveSpeed)
						_waveAlpha = 1*(&<../ShieldTuner.rules>/All/_waveAlpha)
						_waveCurveInterval = &<../ShieldTuner.rules>/Huge/_waveCurveInterval
						_waveCurveMagnitude = (5/7)*(&<../ShieldTuner.rules>/Huge/_waveCurveMagnitude)
						_waveCurveUOffsetPerSecond = .2
						
						_color1 = [255, 0, 255 * 0.31, 0]
						_color2 = [255, 255 * 0.41, 0, 0]
						_maxGreen = 0.9
						
						_xScale = &<../ShieldTuner.rules>/Huge/_xScale
						_gradientXWidth = 1.05
						Size = &<../ShieldTuner.rules>/Huge/Size
						_hexDamageIntensity = 0.8
						TargetBlendMode = Add
					}
					ArcSpriteSegments = 64
					Bucket = Lower1
				}
			]
		}

		EmitterEffect
		{
			Type = ContinuousEffects
			ChainedTo = ArcShield
			Rotation = 90d
			FactorMediaEffectsIntensityWith = BatteryStorage
			MaxMediaEffectsZoom = 16
			Location = [0, (&<../ShieldTuner.rules>/Huge/Size/1)/2]
			OperationalToggle = ShieldEmitterEffectToggleAndIsOperational
			//BlockedByOperationalParts = &<../ShieldTuner.rules>/All/BlockedByOperationalParts
			ParentToShip = true
			MediaEffects
			[
				{
					Type = ArcShield
					Radius = (&<../ShieldTuner.rules>/Huge/Size/1)/2
					Arc = &<../ShieldTuner.rules>/All/Arc
					FadeInTime = .25
					FadeOutTime = .25
					ArcSprite
					{
						Texture
						{
							File = "./Data/ships/terran/shield_gen_small/shield_energy.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = 1
						}
						UVRect = [0, 1, 1, -1]
						Shader = "./Data/ships/terran/shield_gen_small/shield.shader"
						_waveTex
						{
							File = "./Data/ships/terran/shield_gen_small/shield_energy_wave.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = max
						}
						_maskTex
						{
							File = "./Data/ships/terran/shield_gen_small/shield_mask.png"
							UVMode = Wrap
							SampleMode = Linear
							MipLevels = 1
						}
						_waveSpeed = -1*(&<../ShieldTuner.rules>/Huge/_waveSpeed)
						_waveAlpha = &<../ShieldTuner.rules>/All/_waveAlpha
						_waveCurveInterval = &<../ShieldTuner.rules>/Huge/_waveCurveInterval
						_waveCurveMagnitude = &<../ShieldTuner.rules>/Huge/_waveCurveMagnitude
						_waveCurveUOffsetPerSecond = &<../ShieldTuner.rules>/Huge/_waveCurveUOffsetPerSecond
						_fullPowerColor1 = &<../ShieldTuner.rules>/Green/_fullPowerColor1
						_lowPowerColor1 = &<../ShieldTuner.rules>/Green/_lowPowerColor1
						_fullPowerColor2 = &<../ShieldTuner.rules>/Green/_fullPowerColor2
						_lowPowerColor2 = &<../ShieldTuner.rules>/Green/_lowPowerColor2
						_lowPowerThicknessExponent = &<../ShieldTuner.rules>/All/_lowPowerThicknessExponent
						_hexDamageIntensity = 0.5
						TargetBlendMode = Add
						_xScale = (&<../ShieldTuner.rules>/Huge/_xScale)/8
						Size = [0, (&<../ShieldTuner.rules>/Huge/Size/1)/2]
					}
					ArcSpriteSegments = 64
					Bucket = Upper1
				}
			]
		}

		ArcShield90 : ArcShield
		{
			Rotation = 90d
		}

		OverclockEffect90 : OverclockEffect
		{
			Shield = ArcShield90
			ChainedTo = ArcShield90
		}

		OverloadEffect90 : OverloadEffect
		{
			Shield = ArcShield90
			ChainedTo = ArcShield90
		}

		EmitterEffect90 : EmitterEffect
		{
			ChainedTo = ArcShield90
		}
	}