Part :  &<../base_part_terran_sw_overclock.rules>/Part /* &<./Data/ships/base_part_overclock.rules>*/
{
	TypeCategories : ^/0/TypeCategories []

	ReceivableBuffs : ^/0/ReceivableBuffs [SW_Fusion_Energy_Grid]

	Components : ^/0/Components
	{
		FusionEnergyGridToggle
		{
			Type = BuffToggle
			BuffType = SW_Fusion_Energy_Grid
		}
		IsOperationalOverclocked
		{
			Type = MultiToggle
			Toggles = [ IsOperational, IsOverclocked ]
			Mode = All
		}
		IsOperationalNonOverclocked
		{
			Type = MultiToggle
			Toggles = [ IsOperational, { Toggle=IsOverclocked; Invert=true } ]
			Mode = All
		}
	}
}