/*USED FOR MELTDOWN PARTS*/
Part : &<../base_part_terran_sw_meltdown.rules>/Part
{
	TypeCategories : ^/0/TypeCategories []

	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronDebuff]

	Components : ^/0/Components
	{
		IsOperational : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [ElectronDebuffToggle]
			Mode = All
		}

		ElectronDebuffToggle
		{
			Type = BuffToggle
			BuffType = ElectronDebuff
			Invert = true
		}
	}
}