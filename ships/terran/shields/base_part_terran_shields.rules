Part :  &<../base_part_terran_sw_overclock.rules>/Part
{
	TypeCategories : ^/0/TypeCategories []

	ReceivableBuffs : ^/0/ReceivableBuffs [ ShieldOverclockReinforced ]

	Components : ^/0/Components
	{
		IsOperationalOverclocked
		{
			Type = MultiToggle
			Toggles = [ IsOperational, IsOverclocked ]
			Mode = All
		}
		IsOperationalNonOverclocked
		{
			Type = MultiToggle
			Toggles = [ IsOperational, { Toggle=IsOverclocked; Invert=true } ]
			Mode = All
		}
	}
}