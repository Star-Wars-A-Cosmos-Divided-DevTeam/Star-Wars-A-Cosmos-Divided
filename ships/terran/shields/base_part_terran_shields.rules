Part : &<../base_part_sw_terran.rules>/Part
{
	ReceivableBuffs : ^/0/ReceivableBuffs [ElectronDebuff]

	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, BatteryStorage, ElectronDebuffToggle]
			Mode = All
		}

		ElectronDebuffToggle
		{
			Type = BuffToggle
			BuffType = ElectronDebuff
			Invert = true
		}
	}
}