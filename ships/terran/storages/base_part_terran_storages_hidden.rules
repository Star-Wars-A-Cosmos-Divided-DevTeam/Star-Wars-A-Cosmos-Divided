COST = &<base_part_terran_storages.rules>/COST
MAXHEALTH = &<base_part_terran_storages.rules>/MAXHEALTH

Part : &<base_part_terran_storages.rules>/Part
{
	//PartSpecific
	IsWalled = false
	GeneratorRequiresDoor = false

	EditorGroups : ^/0/EditorGroups [SWTechI]
	
	TypeCategories : ^/0/TypeCategories [corridor, SW_Hidden, SW_Tech_I]

	ReceivableBuffs : ^/0/ReceivableBuffs []

	Components : ^/0/Components 
	{
		IsOperational
		{
			Type = CommandToggle
		}
	}
}