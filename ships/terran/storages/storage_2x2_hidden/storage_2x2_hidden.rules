SCALE = (1)
SIZE = [2, 2]
MULTIPLIKATOR = (&~/SCALE) * (&~/SIZE/0) * (&~/SIZE/1)
LOCATION = [((&~/SIZE/0)/2), ((&~/SIZE/1)/2)]
COST = &<../base_part_terran_storages_hidden.rules>/COST
MAXHEALTH = &<../base_part_terran_storages_hidden.rules>/MAXHEALTH

Part : &<../base_part_terran_storages_hidden.rules>/Part
{
	//IDs
	ID = SW.storage_2x2_hidden
	OtherIDs = []

	//StringKeys
	NameKey = "Parts/Storage2x2Int"
	IconNameKey = "Parts/Storage2x2IntIcon"
	DescriptionKey = "Parts/Storage2x2IntDesc"

	//Resources&Size&Health
	Resources
	[
		[steel, ceil((&~/COST)*(&~/MULTIPLIKATOR))]
	]
	Size = [&~/SIZE/0, &~/SIZE/1]
	MaxHealth = ceil((&~/MAXHEALTH)*(&~/MULTIPLIKATOR))

	//PartSpecific
	IsRotateable = false

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs []

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [40, 40]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		Storage
		{
			Type = FlexResourceGrid
			GridRect = [0, 0, &~/SIZE/0, &~/SIZE/1]
			OverridePriorityPart = cosmoteer.storage_2x2
			Layer = "doodads_low"
			SpriteInset = 0/64
			RandomSpriteRotation = true
			AllowExternalPickupAndDelivery = false
		}

		WallsBlend : <./Data/ships/terran/walls/walls.rules>
		{
			Type = BlendSpriteGrid
			Location = [0.5, 0.5]
			BlendsWithCategories = [corridor]
		}

		FloorGrid : &/SW_GRAPHICS/FloorGrid/GridSize_1x1/Floor_Storage_Hidden/RDL
		{

		}

		RoofGrid : &/SW_GRAPHICS/RoofGrid/GridSize_1x1/Roof_Vanilla/RDL
		{

		}

//		Darkness_Components
//		{
//			Type = ToggledComponents
//			Toggle = IsOperational
//			Invert = true
//			Components
//			{
//				DarknessGrid : &/SW_GRAPHICS/DarknessGrid/GridSize_1x1/Darkness
//				{
//					Type = BlendSpriteGrid
//					Location = [.5, .5]
//					BlendsWithCategories = [corridor]
//				}
//			}
//		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyedDry
			Location = [&~/LOCATION/0, &~/LOCATION/1]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [&~/SIZE/0, &~/SIZE/1]
		}
	}

	Stats
	{
		StorageTiles = (&~/Part/Components/Storage/GridRect/2) * (&~/Part/Components/Storage/GridRect/3)
	}
}