Part : &<../base_part_terran_storages.rules>/Part
{
	//IDs
	ID = SW.storage_6x4
	//OtherIDs = [storage_6x4]

	//StringKeys
	NameKey = "Parts/Storage6x4"
	IconNameKey = "Parts/Storage6x4Icon"
	DescriptionKey = "Parts/Storage6x4Desc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups [SWTechI]
	TypeCategories : ^/0/TypeCategories [Storage, SW_Tech_I]
	RequiresCategories = []

	//Resources&Size&Health
	Resources
	[
		[steel, 288]
	]
	Size = [1, 2]
	MaxHealth = 1000

	//Selections
	SelectionTypeID = "storage"
	IgnoreRotationForMirroredSelection = true

	//PartSpecific
	IsRotateable = false

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs []

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 64]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		Storage
		{
			Type = FlexResourceGrid
			GridRect = [0, 0, 1, 2]
			Layer = "doodads_low"
			SpriteInset = 0/64
			RandomSpriteRotation = true
			AllowExternalPickupAndDelivery = true
		}

		Graphics
		{
			Type = Graphics
			Location = [0.5, 1.0]
