COST = 12
MAXHEALTH = 1000

Part : &<../base_part_terran_sw.rules>/Part
{
	//Selections
	SelectionTypeID = "storage"
	IgnoreRotationForMirroredSelection = true

	//PartSpecific
	CrewSpeedFactor = 1
	CrewCongestedSpeedFactor = .5

	EditorGroups : ^/0/EditorGroups [Storage]

	TypeCategories : ^/0/TypeCategories [storage, SW_Storage]

	Components : ^/0/Components 
	{
		IsOperational
		{
			Type = CommandToggle
		}
	}
}