Part : &<../base_part_terran_storages.rules>/Part
{
	//IDs
	ID = SW.storage_1x1_hidden
	OtherIDs = [SW.storage_1x1_rojama, SW.Modular_Storage_Floor,SW_Modular_Storage_Floor]

	//StringKeys
	NameKey = "Parts/Storage1x1Int"
	IconNameKey = "Parts/Storage1x1IntIcon"
	DescriptionKey = "Parts/Storage1x1IntDesc"

	//Groups&Categories
	EditorGroups : ^/0/EditorGroups [SWTechI]
	TypeCategories : ^/0/TypeCategories [corridor, storage, SW_Hidden, SW_Storage, SW_Tech_I]
	RequiresCategories = []

	//Resources&Size&Health
	Resources
	[
		[steel, 12]
	]
	Size = [1, 1]
	MaxHealth = 1000

	//Selections
	SelectionTypeID = "storage"
	IgnoreRotationForMirroredSelection = true

	//PartSpecific
	IsRotateable = false
	CrewSpeedFactor = 1
	CrewCongestedSpeedFactor = .5
	IsWalled = false
	GeneratorRequiresDoor = false

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs []

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		Storage
		{
			Type = FlexResourceGrid
			GridRect = [0, 0, 1, 1]
			Layer = "doodads_low"
			SpriteInset = 0/64
			RandomSpriteRotation = true
			AllowExternalPickupAndDelivery = false
		}

		WallsBlend : <./Data/ships/terran/walls/walls.rules>
		{
			Type = BlendSprite
			Location = [0.5, 0.5]
			BlendsWithCategories = [corridor]
		}

		Darkness_Components : <./Data/ships/terran/corridor/corridor.rules>/Part/Components/Darkness_Components {}

		FloorGrid : &/SW_GRAPHICS/FloorGrid/GridSize_1x1/Floor_Storage_Hidden/DL
		{
			GridSize = &~/Part/Size
		}

		RoofGrid : &/SW_GRAPHICS/RoofGrid/GridSize_1x1/Roof_Vanilla/DL
		{
			GridSize = &~/Part/Size
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [0.5, 0.5]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 1]
		}

		BlueprintWallsX0Y0 : &<./Data/ships/terran/walls/blueprint_walls.rules>
		{
			Location = [0.5, 0.5]
			BlendsWithCategories = [corridor]
		}
	}

	Stats
	{
		StorageTiles = (&~/Part/Components/Storage/GridRect/2) * (&~/Part/Components/Storage/GridRect/3)
	}
}