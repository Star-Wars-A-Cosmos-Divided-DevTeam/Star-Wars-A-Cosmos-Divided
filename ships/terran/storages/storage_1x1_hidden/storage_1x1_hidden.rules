Part : &<../base_part_terran_storages.rules>/Part
{
	//IDs
	ID = SW.storage_1x1_hidden
	OtherIDs = [SW.storage_1x1_rojama, SW.Modular_Storage_Floor,SW_Modular_Storage_Floor]

	//StringKeys
	NameKey = "Parts/Storage1x1Int"
	IconNameKey = "Parts/Storage1x1IntIcon"
	DescriptionKey = "Parts/Storage1x1IntDesc"

	//Groups&Categories
	EditorGroups = ["Storage", "SWTechI"]
	TypeCategories : ^/0/TypeCategories [corridor, storage, SW_Hidden, SW_Storage, SW_Tech_I]
	RequiresCategories = []

	//Resources&Size&Health
	Resources
	[
		[steel, 8]
	]
	Size = [1, 1]
	MaxHealth = 1000

	//Selections
	SelectionTypeID = "storage"
	IgnoreRotationForMirroredSelection = true

	//PartSpecific
	IsRotateable = false
	CrewSpeedFactor = 1
	CrewCongestedSpeedFactor = .5
	IsWalled = false
	GeneratorRequiresDoor = false

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs []

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		Storage
		{
			Type = FlexResourceGrid
			GridRect = [0, 0, 1, 1]
			Layer = "doodads_low"
			SpriteInset = 8/64
			RandomSpriteRotation = true
			AllowExternalPickupAndDelivery = false
		}

		WallsBlend : <./Data/ships/terran/walls/walls.rules>
		{
			Type = BlendSprite
			Location = [.5, .5]
			BlendsWithCategories = [corridor]
		}

		Darkness_Components
		{
			Type = ToggledComponents
			Toggle = IsOperational
			Invert = true
			Components
			{
				DarknessBlend : <./Data/ships/terran/corridor/darkness/darkness.rules>
				{
					Type = BlendSprite
					Location = [.5, .5]
					BlendsWithCategories = [corridor]
				}
			}
		}

		Graphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			Floor
			{
				Layer = "floors"
				RandomUVRotation = true
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [1, 1]
					}
					{
						File = "floor_33.png"
						Size = [1, 1]
					}
					{
						File = "floor_66.png"
						Size = [1, 1]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				RandomUVRotation = true
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [1, 1]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [1, 1]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [1, 1]
					}
				]
			}
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [1, 1]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 1]
		}

		BlueprintWalls : &<./Data/ships/terran/walls/blueprint_walls.rules>
		{
			Location = [0.5, 0.5]
			BlendsWithCategories = [corridor]
		}
	}

	Stats
	{
		StorageTiles = (&~/Part/Components/Storage/GridRect/2) * (&~/Part/Components/Storage/GridRect/3)
	}
}