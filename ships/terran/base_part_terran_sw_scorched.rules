Part : &<base_part_terran_sw_operational.rules>/Part
{
	SignificanceToggle = ScorchedToggle

	TypeCategories : ^/0/TypeCategories [SW_SC_Parts]

	ReceivableBuffs : ^/0/ReceivableBuffs []

	Components : ^/0/Components
	{
		IsOperational : ^/0/IsOperational
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [ScorchedToggle]
			Mode = All
		}

		CommandConsumptionToggle : ^/0/CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [ScorchedToggle]
			Mode = All
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = [0.5, 0.5]
			//Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/SmallPartScorched
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [0.5, 0.5]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					//HidesIndicators = [1,2,3]
				}
			]
		}
	}
}

/*
*/
/* 
*	WHY?	--	This File Allows us for short/long term avoid changes made to base part terran && Make Modifications to all Parts Drawing from here at once.
*	Like?	--	We could do SW part specific effects or IDK what.
*/