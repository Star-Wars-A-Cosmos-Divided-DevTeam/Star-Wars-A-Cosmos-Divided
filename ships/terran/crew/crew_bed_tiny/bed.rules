CLASSIFICATION = Tiny
SCALE = (1/1)
SIZE = [1, 1]
MULTIPLIKATOR = (&~/SCALE) * (&~/SIZE/0) * (&~/SIZE/1)
LOCATION = [((&~/SIZE/0)/2), ((&~/SIZE/1)/2)]

Part : &<../base_part_terran_crew.rules>/Part
{
	//IDs
	ID = SW.bed1
	OtherIDs = ["bed1"]

	//StringKeys
	NameKey = "Parts/Smallbed"
	IconNameKey = "Parts/Smallbed"
	DescriptionKey = "Parts/SmallbedDesc"
	//JobsNameKey = "JobNames/General"
	//JobsIcon = &<./Data/gui/game/crew/crew_gui.rules>/ToolIcon
	
	//Groups&Categories
	EditorGroups : ^/0/EditorGroups [ SWTechI ]
	TypeCategories : ^/0/TypeCategories [provides_crew, SW_Tech_I]
	//RequiresCategories = []

	//Resources&Size&Health
	Resources
	[
		[steel, 12]
	]
	Size = [&~/SIZE/0, &~/SIZE/1]
	MaxHealth = 1000

	//Selections
	SelectionTypeID = "quarters"

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs []


	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}

	//Components&Inheritance
	Components : ^/0/Components 
	{
		CommandToggle
		{
			Type = CommandToggle
		}

		CrewSource
		{
			Type = CrewSource
			Crew = 1
			IdleLocations [ [0.5, 0.5] ]
			ColorSRange = [0, 0.25]
			ColorVRange = [0.5, 0.75]
		}

		Graphics
		{
			Type = Graphics
			Location = [&~/LOCATION/0, &~/LOCATION/1]
			OperationalToggle = CommandToggle
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "bed_concept.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "bed_concept_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "bed_concept_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
			NonOperationalDoodad	
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "./data/ships/terran/darkness/darkness1x1.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/walls/wall00.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "./Data/ships/terran/walls/wall00_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "./Data/ships/terran/walls/wall00_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				RandomUVRotation = true
				DamageLevels
				[
					{
						File = "./Data/ships/terran/corridor/roof.png"
						NormalsFile = "./Data/ships/terran/corridor/roof_normals.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "./Data/ships/terran/corridor/roof_33.png"
						NormalsFile = "./Data/ships/terran/corridor/roof_normals_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "./Data/ships/terran/corridor/roof_66.png"
						NormalsFile = "./Data/ships/terran/corridor/roof_normals_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}			
		}

		ColoredGraphics
		{
			Type = Graphics
			Location = [&~/LOCATION/0, &~/LOCATION/1]
			GetColorFrom = CrewSource
			Floor
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "sheets.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "sheets_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "sheets_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [&~/LOCATION/0, &~/LOCATION/1]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [&~/SIZE/0, &~/SIZE/1]
		}
	}
}