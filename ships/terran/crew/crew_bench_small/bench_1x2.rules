CLASSIFICATION = Small
SCALE = (1/1)
SIZE = [1, 2]
MULTIPLIKATOR = (&~/SCALE) * (&~/SIZE/0) * (&~/SIZE/1)
LOCATION = [((&~/SIZE/0)/2), ((&~/SIZE/1)/2)]

Part : &<../base_part_terran_crew.rules>/Part
{
	//IDs
	ID = SW.bench_1x2
	OtherIDs = [SW.bench1x2_LSW, bench1x2_LSW, bench1x2_RSW, SW.bench1x2_RSW]
	FlipWhenLoadingIDs = [bench1x2_RSW, SW.bench1x2_RSW]

	//StringKeys
	NameKey = "Parts/BenchSW1x2"
	IconNameKey = "Parts/BenchSW1x2Icon"
	DescriptionKey = "Parts/BenchSW1x2Desc"
	JobsNameKey = "JobNames/General"
	JobsIcon = &<./Data/gui/game/crew/crew_gui.rules>/ToolIcon
	
	//Groups&Categories
	EditorGroups : ^/0/EditorGroups [ SWTechI ]
	TypeCategories : ^/0/TypeCategories [provides_crew, SW_Tech_I]
	//RequiresCategories = []

	//Resources&Size&Health
	Resources
	[
		[steel, 24]
		[coil, 8]
	]
	Size = [&~/SIZE/0, &~/SIZE/1]
	MaxHealth = 2000

	//Selections
	SelectionTypeID = "quarters"

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs []

	//Doors&Etc
	MaxDoors = 3
	AllowedDoorLocations
	[
		[0, -1]
		[-1, 0]
		[1, 1]
		[0, 2]
	]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 64]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		CommandToggle
		{
			Type = CommandToggle
		}

		CrewSource
		{
			Type = CrewSource
			Crew = 4
			ColorSRange = [0, 0.25]
			ColorVRange = [0.5, 0.75]
		}

		Graphics
		{
			Type = Graphics
			Location = [&~/LOCATION/0, &~/LOCATION/1]
			OperationalToggle = CommandToggle
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "floor_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "floor_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
			NonOperationalDoodad	
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						File = "./data/ships/terran/darkness/darkness1x2.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "walls_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "walls_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
		}

		ColoredGraphics
		{
			Type = Graphics
			Location = [&~/LOCATION/0, &~/LOCATION/1]
			GetColorFrom = CrewSource
			Floor
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "sheets.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "sheets_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "sheets_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [&~/LOCATION/0, &~/LOCATION/1]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [&~/SIZE/0, &~/SIZE/1]
		}
	}
}