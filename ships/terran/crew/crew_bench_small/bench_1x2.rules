Part : &<../base_part_terran_crew.rules>/Part
{
	//IDs
	ID = SW.bench_1x2
	OtherIDs = [SW.bench1x2_LSW, bench1x2_LSW, bench1x2_RSW, SW.bench1x2_RSW]
	FlipWhenLoadingIDs = [bench1x2_RSW, SW.bench1x2_RSW]

	//StringKeys
	NameKey = "Parts/BenchSW1x2"
	IconNameKey = "Parts/BenchSW1x2Icon"
	DescriptionKey = "Parts/BenchSW1x2Desc"
	JobsNameKey = "JobNames/General"
	JobsIcon = &<./Data/gui/game/crew/crew_gui.rules>/ToolIcon
	
	//Groups&Categories
	EditorGroups : ^/0/EditorGroups [SWTechI]
	TypeCategories : ^/0/TypeCategories [provides_crew, SW_Tech_I]
	//RequiresCategories = []

	//Resources&Size&Health
	Resources
	[
		[steel, 24]
		[coil, 8]
	]
	Size = [1, 2]
	MaxHealth = 2000

	//Selections
	SelectionTypeID = "quarters"

	//PartSpecific
	FlipHRotate = [0, 3, 2, 1]
	FlipVRotate = [2, 1, 0, 3]
	IsFlippable = true

	//ReceivableBuffs&Prohibits
	ReceivableBuffs : ^/0/ReceivableBuffs []

	//Doors&Etc
	MaxDoors = 3
	AllowedDoorLocations
	[
		[0, -1]
		[-1, 0]
		[1, 1]
		[0, 2]
	]
	ExternalWallsByCell
	[
		{
			Key = [0, 0]
			Value = [Left, TopLeft, Top, TopRight, Right]
		}
		{
			Key = [0, 1]
			Value = [Right, BottomRight, Bottom, BottomLeft, Left]
		}
	]
	/*
	InternalWallsByCell
	[
		{
			Key = [0, 0]
			Value = [Left, TopLeft, Top, TopRight, Right]
		}
		{
			Key = [0, 1]
			Value = [Right, BottomRight, Bottom, BottomLeft, Left]
		}
	]
	*/

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Point
			MipLevels = max
		}
		Size = [32, 64]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		IsOperationalAndCommandToggle : ^/0/IsOperationalAndCommandToggle 
		{
			Type = MultiToggle
			Toggles : ^/0/Toggles [IsOperational, CommandToggle]
			Mode = All
		}

		CommandToggle
		{
			Type = CommandToggle
		}

		CrewSource
		{
			Type = CrewSource
			Crew = 4
			ColorSRange = [0, 0.25]
			ColorVRange = [0.5, 0.75]
		}

//		DarknessGrid : &/SW_GRAPHICS/DarknessGrid/GridSize_1x1/Darkness
//		{
//			OperationalToggle = IsOperationalAndCommandToggle
//			InvertOperationalToggle = true
//		}

		Graphics
		{
			Type = Graphics
			Location = [0.5, 1]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor01.png"
						Size = [1, 2]
					}
					{
						File = "floor01_33.png"
						Size = [1, 2]
					}
					{
						File = "floor01_66.png"
						Size = [1, 2]
					}
				]
			}

			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "benches_4single.png"
						Size = [1, 2]
					}
					{
						File = "benches_4single_33.png"
						Size = [1, 2]
					}
					{
						File = "benches_4single_66.png"
						Size = [1, 2]
					}
				]
			}

			NonOperationalDoodad = &OperationalDoodad	
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [1, 2]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [1, 2]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [1, 2]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [1, 2]
					}
					{
						File = "walls_33.png"
						Size = [1, 2]
					}
					{
						File = "walls_66.png"
						Size = [1, 2]
					}
				]
			}
		}

		ColoredGraphics
		{
			Type = Graphics
			Location = [0.5, 1]
			GetColorFrom = CrewSource
			Floor
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "sheets.png"
						Size = [1, 2]
					}
					{
						File = "sheets_33.png"
						Size = [1, 2]
					}
					{
						File = "sheets_66.png"
						Size = [1, 2]
					}
				]
			}
		}
		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [0.5, 1]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 2]
		}
	}
}
Size = Small