Part
{
	Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [ScorchedToggle]
			Mode = All
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = [0.5, 0.5]
			//Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/SmallPartScorched
		}

		 Indicators
		{
			Type = IndicatorSprites
			Location = [0.5, 0.5]
			 Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					//HidesIndicators = [1,2,3]
				}
			]
		}
	}
}