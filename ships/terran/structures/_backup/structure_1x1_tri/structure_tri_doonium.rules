SCALE = (1/4)
SIZE = [1, 1]
MULTIPLIKATOR = (&~/SCALE) * (&~/SIZE/0) * (&~/SIZE/1)
LOCATION = [((&~/SIZE/0)/2), ((&~/SIZE/1)/2)]
COST = &<../base_part_terran_structure_doonium.rules>/COST
MAXHEALTH = &<../base_part_terran_structure_doonium.rules>/MAXHEALTH

Part : &<../base_part_terran_structure_doonium.rules>/Part
{
	//IDs
	ID = SW.structure_tri_doonium
	OtherIDs = [structure_tri_doonium]

	//StringKeys
	NameKey = "Parts/DooniumStructureTri"
	IconNameKey = "Parts/DooniumStructureTriIcon"
	DescriptionKey = "Parts/DooniumStructureTriDesc"

	//Resources&Size&Health
	Resources
	[
		[SW.doonium_ingot, ceil((&~/COST)*(&~/MULTIPLIKATOR))]
	]
	Size = [&~/SIZE/0, &~/SIZE/1]
	MaxHealth = ceil((&~/MAXHEALTH) * (&~/MULTIPLIKATOR))
	FractionalCostToRepair = (ceil((&Resources/0/1)/2)/(&Resources/0/1))
	
	//PartSpecific
	EditorReplacementPartID = ""
	AllowedContiguity = [ Bottom ]

	IsRotateable = true
	IsFlippable = true

	FlipHRotate = [0, 3, 2, 1]
	FlipVRotate = [2, 1, 0, 3]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "structure_doonium.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		Collider
		{
			Type = PolygonCollider
			Vertices
			[
				[0, 1]
				[0.5, 0.5]
				[1, 1]
			]
		}

		Graphics
		{
			Type = Graphics
			Location = [&~/LOCATION/0, &~/LOCATION/1]
			Floor
			{
				Layer = "structure"
				//
				DamageLevels
				[
					{
						File = "structure_doonium.png"
						NormalsFile = "structure_normals.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "structure_doonium_33.png"
						NormalsFile = "structure_normals_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "structure_doonium_66.png"
						NormalsFile = "structure_normals_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
		}

		ConstructionEffects
		{
			Type = Sprite
			IncludeWhenUnderConstruction = true
			IncludeWhenNotUnderConstruction = false
			GetColorFrom = ConstructionTracker
			Location = [&~/LOCATION/0, &~/LOCATION/1]
			AtlasSprite
			{
				File = "structure_mask_combined.png"
				NormalsFile = "structure_normals.png"
				Size = [&~/SIZE/0, &~/SIZE/1]
			}
			RandomUVRotation = false
			Layer = "structure_construction"
			UseConstructionProgressAsDamage = true
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [&~/SIZE/0, &~/SIZE/1]
		}
	}
}