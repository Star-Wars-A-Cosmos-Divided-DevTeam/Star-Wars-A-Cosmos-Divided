SCALE = (39/50)
SIZE = [1, 1]
MULTIPLIKATOR = (&~/SCALE) * (&~/Size/0) * (&~/Size/1)
LOCATION = [((&~/Size/0)/2), ((&~/Size/1)/2)]
COST = &<../base_part_terran_structure_steel.rules>/COST
MAXHEALTH = &<../base_part_terran_structure_steel.rules>/MAXHEALTH

Part : &<../base_part_terran_structure_steel.rules>/Part
{
	//IDs
	ID = SW.structure_1x1_roundbig_steel
	OtherIDs = [structure1x1_RoundBig, SW.structure1x1_RoundBig]

	//StringKeys
	NameKey = "Parts/structure1x1_RoundBig"
	IconNameKey = "Parts/structure1x1_RoundBigIcon"
	DescriptionKey = "Parts/structure1x1_RoundBigDesc"

	//Resources&Size&Health
	Resources
	[
		[steel, ceil((&~/COST)*(&~/MULTIPLIKATOR))]
	]
	Size = [&~/SIZE/0, &~/SIZE/1]
	MaxHealth = ceil((&~/MAXHEALTH) * (&~/MULTIPLIKATOR))
	FractionalCostToRepair = (ceil((&Resources/0/1)/2)/(&Resources/0/1))

	//PartSpecific
	AllowedContiguity = [ Bottom ]

	IsRotateable = true
	IsFlippable = true

	FlipHRotate = [0, 3, 2, 1]
	FlipVRotate = [2, 1, 0, 3]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		Collider
		{
			Type = PolygonCollider
			Vertices
			[
				[0.5, 0]
				[0.64,0.08]
				[0.875,0.4]
				[0.95,0.7]
				[1, 1]
				[0, 1]
				[0.05,0.7]
				[0.125,0.4]
				[0.36,0.08]
			]
		}
		Graphics
		{
			Type = Graphics
			Location = [&~/LOCATION/0, &~/LOCATION/1]
			Floor
			{
				Layer = "structure"
				//
				DamageLevels
				[
					{
						File = "structure_steel.png"
						NormalsFile = "structure_normals.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
						UVRotation = 0
					}
					{
						File = "structure_steel_33.png"
						NormalsFile = "structure_normals_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
						UVRotation = 0
					}
					{
						File = "structure_steel_66.png"
						NormalsFile = "structure_normals_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
						UVRotation = 0
					}
				]
			}
		}

		ConstructionEffects
		{
			Type = Sprite
			IncludeWhenUnderConstruction = true
			IncludeWhenNotUnderConstruction = false
			GetColorFrom = ConstructionTracker
			Location = [&~/LOCATION/0, &~/LOCATION/1]
			AtlasSprite
			{
				File = "structure_mask_combined.png"
				NormalsFile = "structure_normals.png"
				Size = [&~/SIZE/0, &~/SIZE/1]
			}
			RandomUVRotation = false
			Layer = "structure_construction"
			UseConstructionProgressAsDamage = true
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [&~/SIZE/0, &~/SIZE/1]
		}
	}
}