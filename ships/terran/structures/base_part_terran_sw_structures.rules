Part : &<../base_part_terran_sw_structure.rules>/Part
{

	AIValueFactor = 0
	SelectionTypeID = "structure"
	Density = .333
	ConstructionWork = 0.25
	WorkPerRepairedHealth = 0.25 / 1000
	HealthType = Structural

	UnderlyingPartPerTile = ""
	CreatePartPerTileWhenGrabbed = ""
	InitialPenetrationResistance = 0
	ContinuingPenetrationResistance = &InitialPenetrationResistance
	CrewSpeedFactor = 0
	AllowedDoorLocations = []
	IsExternal = true
	ExternalWalls = [None]
	InternalWalls = [All]
	IsRotateable = false
	IsWalled = false
	IsSelfDestructible = false
	GeneratorRequiresDoor = false
	NoAutoDoors = true
	IgnoreRotationForMirroredSelection = true

	EditorGroups : ^/0/EditorGroups [Structure]

	TypeCategories : ^/0/TypeCategories [structure, non_flammable]

	ReceivableBuffs : ^/0/ReceivableBuffs []

	DamageResistances : ^/0/DamageResistances {thermal=60%}

	Components : ^/0/Components {}
}