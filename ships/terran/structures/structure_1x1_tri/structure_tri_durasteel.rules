SCALE = (1/4)
SIZE = [1, 1]
MULTIPLIKATOR = (&~/SCALE) * (&~/Size/0) * (&~/Size/1)
LOCATION = [((&~/Size/0)/2), ((&~/Size/1)/2)]
COST = &<../base_part_terran_structure_durasteel.rules>/COST
MAXHEALTH = &<../base_part_terran_structure_durasteel.rules>/MAXHEALTH

Part : &<../base_part_terran_structure_durasteel.rules>/Part
{
	//IDs
	ID = SW.structure_tri_durasteel
	OtherIDs = [structure_tri_durasteel, SW.structure_tri_duratseel]

	//StringKeys
	NameKey = "Parts/DurasteelStructureTri"
	IconNameKey = "Parts/DurasteelStructureTriIcon"
	DescriptionKey = "Parts/DurasteelStructureTriDesc"

	//Resources&Size&Health
	Resources
	[
		[SW.durasteel, ceil((&~/COST)*(&~/MULTIPLIKATOR))]
	]
	Size = [&~/SIZE/0, &~/SIZE/1]
	MaxHealth = ceil((&~/MAXHEALTH) * (&~/MULTIPLIKATOR))
	FractionalCostToRepair = (ceil((&Resources/0/1)/2)/(&Resources/0/1))

	//PartSpecific
	AllowedContiguity = [Bottom]

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "structure_durasteel.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		Collider
		{
			Type = PolygonCollider
			Vertices
			[
				[0, 1]
				[0.5, 0.5]
				[1, 1]
			]
		}

		Graphics
		{
			Type = Graphics
			Location = [&~/LOCATION/0, &~/LOCATION/1]
			Floor
			{
				Layer = "structure"
				//RandomUVRotation = true
				DamageLevels
				[
					{
						File = "structure_durasteel.png"
						NormalsFile = "structure_normals.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "structure_durasteel_33.png"
						NormalsFile = "structure_normals_33.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
					{
						File = "structure_durasteel_66.png"
						NormalsFile = "structure_normals_66.png"
						Size = [&~/SIZE/0, &~/SIZE/1]
					}
				]
			}
		}

		ConstructionEffects
		{
			Type = Sprite
			IncludeWhenUnderConstruction = true
			IncludeWhenNotUnderConstruction = false
			GetColorFrom = ConstructionTracker
			Location = [&~/LOCATION/0, &~/LOCATION/1]
			AtlasSprite
			{
				File = "structure_mask_combined.png"
				NormalsFile = "structure_normals.png"
				Size = [&~/SIZE/0, &~/SIZE/1]
			}
			RandomUVRotation = false
			Layer = "structure_construction"
			UseConstructionProgressAsDamage = true
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [&~/SIZE/0, &~/SIZE/1]
		}
	}
}