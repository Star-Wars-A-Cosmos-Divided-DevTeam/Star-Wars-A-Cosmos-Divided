Part : <../base_part_terran_structure.rules>/Part
{
	//IDs
	ID = SW.durasteel_structure
	OtherIDs = ["structure_durasteel", "SW.structure_durasteel"]
	EditorGroups : ^/0/EditorGroups [ SWDurasteel ]
	//StringKeys
	NameKey = "Parts/DurasteelStructure"
	IconNameKey = "Parts/DurasteelStructureIcon"
	//DontStackInEditorGroups : ^/0/ DontStackInEditorGroups [SWDoonium]
	EditorParentParts = []

	//Resources&Size&Health
	Resources
	[
		[&<../base_part_terran_structure.rules>/DefaultResource, ceil((ceil((&<../base_part_terran_structure.rules>/Cost)*(&~/Scale)))/4)]
	]
	AllowedContiguity = [Top, Bottom, Right, Bottom]
	MaxHealth = floor((&<../base_part_terran_structure.rules>/DefaultHealth) * (&~/Scale))
	InitialPenetrationResistance = ceil((&<../base_part_terran_structure.rules>/DefaultInitialPenetrationResistance) * (&~/Scale) * 0.9)
	Density = (&<../base_part_terran_structure.rules>/DefaultDensity)
	CellOccupancyFactor = ceil((&~/Scale))

	//PartSpecific
	UnderlyingPartPerTile = ""
	CreatePartPerTileWhenGrabbed = ""

	IsRotateable = false //base true
	IsFlippable = false	//base true

	//FlipHRotate = [0, 3, 2, 1]
	//FlipVRotate = [2, 1, 0, 3]

	GenerateRectCollider = true

	//Editor
	EditorIcon
	{
		Texture
		{
			File = "structure_durasteel.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}

	//Components&Inheritance
	Components : ^/0/Components
	{
		//
		//
			//
			//
			//
				//
				//
				//
				//
			//
		//
		Graphics
		{
			Type = Graphics
			Location = [0.5, 0.5]
			Floor
			{
				Layer = "structure"
				RandomUVRotation = true
				DamageLevels
				[
					{
						File = "structure_durasteel.png"
						NormalsFile = "structure_normals.png"
						Size = [1, 1]
						//UVRotation = 0
					}
					{
						File = "structure_durasteel_33.png"
						NormalsFile = "structure_normals_33.png"
						Size = [1, 1]
						//UVRotation = 0
					}
					{
						File = "structure_durasteel_66.png"
						NormalsFile = "structure_normals_66.png"
						Size = [1, 1]
						//UVRotation = 0
					}
				]
			}
		}

		ConstructionEffects
		{
			Type = Sprite
			IncludeWhenUnderConstruction = true
			IncludeWhenNotUnderConstruction = false
			GetColorFrom = ConstructionTracker
			Location = [.5, .5]
			AtlasSprite
			{
				File = "structure_mask_combined.png"
				NormalsFile = "structure_normals.png"
				Size = [1, 1]
				//VertexColor = [255, 0, 0, 255]
			}
			RandomUVRotation = false
			Layer = "structure_construction"
			UseConstructionProgressAsDamage = true
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/StructureDestroyed
			Location = [.5, .5]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 1]
		}
	}
}
Scale = (1)