//
MAXHEALTH = (&<../base_part_terran_sw_structure.rules>/MAXHEALTH) * (&~/HP_MULTIPLIKATOR)
DENSITY = (&<../base_part_terran_sw_structure.rules>/DENSITY) * (&~/DN_MULTIPLIKATOR)
COST = (&<../base_part_terran_sw_structure.rules>/COST) * (&~/CT_MULTIPLIKATOR)
HP_MULTIPLIKATOR = 2.25
DN_MULTIPLIKATOR = 2.0
CT_MULTIPLIKATOR = 1.2

Part : &<../base_part_terran_sw_structure.rules>/Part
{
	//NameKey
	//IconNameKey
	//ID
	//OtherIDs
	//FlipWhenLoadingIDs
	EditorGroups : ^/0/EditorGroups [ SWDoonium ]
	DescriptionKey = "Parts/DooniumStructureDesc"
	//
	Resources
	[
		[SW.doonium_ingot, floor(&~/COST)]
	]
	//
	//
	//IsFlippable = true
	//
	//AllowedContiguity = [ Right, Bottom ]
	Density = (&~/DENSITY)
	//
	//
	//
	//
	//
	TypeCategories : ^/0/TypeCategories [ doonium_structure ]
	//
	//
	TempConstructionPartPerTile = SW.structure_doonium
	//
	//
	//
	//
	//
	//
	//
	//
	//IsRotateable = true
	//
	//
	//
	//
	//
	//
	//
	//GenerateRectCollider = false
	//
	//ConstructionDuration = 0.5
	//RepairDuration = 0.5
	EditorParentParts = [ "SW.structure_doonium" ]

	EditorIcon
	{
		Texture
		{
			File = "structure_1x1/structure_doonium.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}
	Components : ^/0/Components
	{
		ConstructionEffects
		{
			Type = Sprite
			IncludeWhenUnderConstruction = true
			IncludeWhenNotUnderConstruction = false
			GetColorFrom = ConstructionTracker
			Location = [.5, .5]
			AtlasSprite
			{
				File = "./Data/ships/terran/structure/structure_mask_combined.png"
				NormalsFile = "./Data/ships/terran/structure/structure_normals.png"
				Size = [1, 1]
			}
			RandomUVRotation = false
			Layer = "structure_construction"
			UseConstructionProgressAsDamage = true
		}

		//
		//
			//
			//
			//
		//

		//
		//
			//
			//
			//
		//
	}
}