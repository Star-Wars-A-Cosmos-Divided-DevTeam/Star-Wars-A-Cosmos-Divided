MAXHEALTH = (&<../base_part_terran_sw_structure.rules>/MAXHEALTH) * (&~/HP_MULTIPLIKATOR)
DENSITY = (&<../base_part_terran_sw_structure.rules>/DENSITY) * (&~/DN_MULTIPLIKATOR)
COST = (&<../base_part_terran_sw_structure.rules>/COST) * (&~/CT_MULTIPLIKATOR)
HP_MULTIPLIKATOR = 2.25
DN_MULTIPLIKATOR = 1.5
CT_MULTIPLIKATOR = 1.2

Part : &<../base_part_terran_sw_structure.rules>/Part
{
	DescriptionKey = "Parts/DooniumStructureDesc"

	EditorGroups : ^/0/EditorGroups [SWDoonium]
	EditorParentParts = [ "SW.structure_doonium" ]

	Density = (&~/DENSITY)

	ConstructionDuration = 0.5
	RepairDuration = 0.5

	TypeCategories : ^/0/TypeCategories [doonium_structure]

	Components : ^/0/Components {}
}