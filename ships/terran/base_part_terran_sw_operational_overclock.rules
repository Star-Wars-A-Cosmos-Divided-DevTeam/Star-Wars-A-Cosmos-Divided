Part : &<base_part_terran_sw_overclock.rules>/Part
{
	EditorGroups : ^/0/EditorGroups []

	TypeCategories : ^/0/TypeCategories []

	RequiresCategories : ^/0/RequiresCategories []

	ReceivableBuffs : ^/0/ReceivableBuffs []

	DamageResistances : ^/0/DamageResistances {}

	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = []
			Mode = All
		}

		IsOperationalAndCommandToggle
		{
			Type = MultiToggle
			Toggles = [IsOperational, CommandToggle]
			Mode = All
		}

		CommandToggle
		{
			Type = CommandToggle
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = []
			Mode = All
		}
	}
}

/* 
*	WHY?	--	This File Allows us for short/long term avoid changes made to base part terran && Make Modifications to all Parts Drawing from here at once.
*	Like?	--	We could do SW part specific effects or IDK what.
*/