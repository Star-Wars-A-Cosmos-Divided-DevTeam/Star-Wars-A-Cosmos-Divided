	//Factories
	FactoryAluminium = "Aluminium Forge"
	FactoryAluminiumIcon = "Aluminium Forge"
	FactoryAluminiumDesc = "Manufactures Aluminium plates, which are used to construct some advanced armor parts. Consumes aluminium ore. Gains +25% production speed for each adjacent factory of any type.<string id='CommonStringModIDSWACD'/>"

	FactoryAgrinium = "Agrinium Forge"
	FactoryAgriniumIcon = "Agrinium"
	FactoryAgriniumDesc = "Manufactures Agrinium plates, which are used to construct some advanced armor parts. Consumes aluminium ingots. Gains +25% production speed for each adjacent factory of any type.<string id='CommonStringModIDSWACD'/>"

	FactoryDuraSteel = "Fundidora de Duracero"
	FactoryDuraSteelIcon = "Duracero"
	FactoryDuraSteelDesc = "Fabrica placas de Duracero, utilizadas para construir algunas partes avanzadas de armadura. Consume carbón y mineral de zersium. Aumenta un +25% la velocidad de producción por cada fábrica adyacente de cualquier tipo. <string id='CommonStringModIDSWACD'/>"
	
	FactoryDoonium = "Forja de Doonium"
	FactoryDooniumIcon = "Forja de Doonium"
	FactoryDooniumDesc = "Fabrica placas de Doonium, utilizadas para construir algunas partes avanzadas de armadura. Consume mineral de doonium. Aumenta un +25% la velocidad de producción por cada fábrica adyacente de cualquier tipo. <string id='CommonStringModIDSWACD'/>"

	//Utilities
	SWMiningLaserHuge = "Láser Minero XG Divisor de Roca Corelliano"
	SWMiningLaserHugeIcon = "Divisor Corelliano RS-XG"
	SWMiningLaserHugeDesc = "Fabricado por <cyan>Corporación de Ingeniería Corelliana</cyan>, este láser minero extra grande emite haces duales de precisión mejorados con kyber capaces de extraer recursos rápidamente incluso de los asteroides más resistentes como Duracero y Doonium. También es eficiente en operaciones de salvamento de naves y, cuando es necesario, puede servir como un láser ofensivo de corto alcance. <string id='CommonStringModIDSWACD'/>"

	SWResourceCollectorTiny = "Manipulator Beam Emitter XS"
	SWResourceCollectorTinyIcon = "Manipulator Beam XS"
	SWResourceCollectorTinyDesc = "Projects up to 4 small, roof-mounted tractor beams that can collect resources and boost flying crew. A single crew can control up to four beams, and they will only go to the Manipulator Beam Emitter when there are tasks to help with.<string id='CommonStringModIDSWACD'/>"

	//Thrusters
	IonThruster_1x1 = "Propulsor Iónico 1x1"
	IonThruster_1x1_Icon = &IonThruster_1x1
	IonThruster_1x1_Desc = "Fabricados por <cyan>Astilleros de Kuat</cyan>, estos versátiles Propulsores Iónicos están diseñados para ser escalables y compatibles con una amplia gama de clases de naves estelares, desde pequeños cazas hasta grandes naves capitales. Su eficiente propulsión iónica asegura un rendimiento confiable en diversas aplicaciones. Conocidos por su empuje constante y precisión, sobresalen en varios contextos operativos. <string id='CommonStringModIDSWACD'/>"
	/* AI ENHANCED FROM "A propulsion engine capable of pushing the ship with a great amount of force." */ 
	IonThruster_1x2 = "Propulsor Iónico 1x2"
	IonThruster_1x2_Icon = &IonThruster_1x2
	IonThruster_1x2_Desc = &IonThruster_1x1_Desc

	IonThruster_2x2 = "Propulsor Iónico 2x2"
	IonThruster_2x2_Icon = &IonThruster_2x2
	IonThruster_2x2_Desc = &IonThruster_1x1_Desc

	IonThruster_2x3 = "Propulsor Iónico 2x3 \"Booster\""
	IonThruster_2x3_Icon = "Propulsor \"Booster\" 2x3"
	IonThruster_2x3_Desc = "Una variante especializada del propulsor iónico 2x2 de <cyan>Kuat Drive Yards</cyan>, este modelo puede inyectar hypermateria cruda directamente en su cámara de ionización para un impulso potente pero efímero. La entrega de energía se suspende mientras se impulsa, concentrando todos los recursos en el aumento de aceleración. <string id='CommonStringModIDSWACD'/>"

	IonThruster_3x3 = "Propulsor Iónico 3x3"
	IonThruster_3x3_Icon = &IonThruster_3x3
	IonThruster_3x3_Desc = &IonThruster_1x1_Desc

	IonThruster_3x4 = "Propulsor Iónico 3x4 \"Hauler\""
	IonThruster_3x4_Icon = "\"Hauler\" Propulsor 3x4"
	IonThruster_3x4_Desc = "Mejorado por los reputados <cyan>Kuat Drive Yards</cyan>, el propulsor Iónico \"Hauler\" 3x4 se basa en la fundación establecida por su predecesor, el modelo 3x3. Mientras mantiene la escalabilidad y compatibilidad en diversas clases de naves estelares, este modelo ofrece una durabilidad mejorada y una velocidad significativamente aumentada para viajes largos y continuos a través del cosmos. Su sofisticado sistema de propulsión iónica promete no solo un rendimiento confiable, sino también un empuje superior y precisión durante operaciones de largo alcance. <string id='CommonStringModIDSWACD'/>"

	IonThruster_7x10 = "Propulsor Iónico 7x10"
	IonThruster_7x10_Icon = &IonThruster_7x10
	IonThruster_7x10_Desc = "<orange>Requiere Puente de Mando</orange>\n\n<cyan>Astilleros de Kuat</cyan> diseñó estos Propulsores Iónicos solo para las naves capitales más grandes. Su eficiente propulsión iónica asegura un rendimiento confiable en diversas aplicaciones. Conocidos por su empuje constante y precisión, sobresalen en varios contextos operativos. <string id='CommonStringModIDSWACD'/>"
	/* AI ENHANCED FROM "A propulsion engine capable of pushing the ship with a great amount of force. Requires Bridge1." */ 

	IonThruster_8x16 = "Propulsor Iónico 8x16"
	IonThruster_8x16_Icon = &IonThruster_8x16
	IonThruster_8x16_Desc = &IonThruster_7x10_Desc

	IonThruster_10x14 = "Propulsor Iónico 10x14"
	IonThruster_10x14_Icon = &IonThruster_10x14
	IonThruster_10x14_Desc = &IonThruster_7x10_Desc

	IonThruster_20x26 = "Propulsor Iónico 20x26"
	IonThruster_20x26_Icon = &IonThruster_20x26
	IonThruster_20x26_Desc = "<orange>Requiere Puente de Mando, Sala de Guerra, &amp; Hyperdrive Grande</orange>\n\n<cyan>Astilleros de Kuat</cyan> diseñó estos Propulsores Iónicos solo para las naves capitales más grandes. Su eficiente propulsión iónica asegura un rendimiento confiable en diversas aplicaciones. Conocidos por su empuje constante y precisión, sobresalen en varios contextos operativos. <string id='CommonStringModIDSWACD'/>"

	rcs = "Propulsor de Dirección"
	rcsIcon = "Propulsor de Dirección"
	rcsDesc = "Diseñado por <cyan>Industrias Arakyd</cyan>, este Propulsor de Dirección ofrece maniobrabilidad precisa para una variedad de naves estelares en diferentes facciones. Aunque proporciona solo una cantidad modesta de fuerza, es esencial para ajustar finamente la orientación de la nave y lograr maniobras delicadas en la vastedad del espacio. \n\nConfiado por ingenieros de la República, pilotos rebeldes e incluso tácticos del Imperio, su confiabilidad y precisión lo convierten en un elemento básico tanto en naves de combate como de exploración.<string id='CommonStringModIDSWACD'/>"/* IA MEJORADO DE "Un motor de propulsión débil capaz de empujar la nave con una cantidad muy pequeña de fuerza." */

	XWingThrusterSingle = "Propulsor de X-Wing (Individual)"
	XWingThrusterSingleIcon = "Propulsor de X-Wing (Individual)"
	XWingThrusterSingleDesc = "Derivado del diseño icónico del T-65 X-Wing, esta unidad de propulsor individual ofrece maniobrabilidad y velocidad mejoradas para un lado de una nave estelar. Su motor compacto pero potente es perfecto para giros ágiles y aceleración rápida, lo que lo hace ideal para cazas y pequeñas naves que requieren empuje asimétrico.<string id='CommonStringModIDSWACD'/>" // GENERADO POR IA

	XWingThrusterDual = "Propulsor de X-Wing (Dual)"
	XWingThrusterDualIcon = "Propulsor de X-Wing (Dual)"
	XWingThrusterDualDesc = "Este propulsor de dos motores, inspirado en el legendario T-65 X-Wing, proporciona propulsión equilibrada y robusta para una variedad de naves espaciales. Ofreciendo potencia y control sincronizados, es ideal para lograr una velocidad y estabilidad superiores, especialmente en naves medianas y cazas que requieren capacidades de empuje simétricas.<string id='CommonStringModIDSWACD'/>" // GENERADO POR IA

	//Turret Weapons Large -> Small
	SiegeTurbolaser12x12 = "Doble Turboláser Superpesado 70TT"
	SiegeTurbolaser12x12Icon = "D70TT SH-Turboláser"
	SiegeTurbolaser12x12Desc = "<orange>Requiere Puente de Mando</orange> \n\nEl Doble Turboláser Superpesado 70TT, también conocido como 'Torreta de Asedio', es un arma formidable de guerra. Diseñado para asedios, lanza disparos láser explosivos en un arco limitado, devastando fortificaciones enemigas y naves capitales. Aunque su lenta tasa de disparo y movimiento puede limitar su efectividad contra cazas ágiles, el poder destructivo de la torreta la convierte en un activo crítico para romper las defensas más firmes. <string id='CommonStringModIDSWACD'/>"
	SiegeTurbolaser12x12Overclock = "Overclocked Dual 70TT Superheavy Siege Turbolaser"
	SiegeTurbolaser12x12OverclockDesc = "Increased concussive laser damage, velocity, and accuracy, but stops penetration once its damage potential is exhausted.  Produces waste heat when firing." /* AI ENHANCED FROM "" */

	TurbolaserHuge01 = "TurbolaserHuge01"
	TurbolaserHuge01Icon = "Heavy Teraton Turbolaser Triple"
	TurbolaserHuge01Desc = "TurbolaserHuge01  triple barrel version"

	TurbolaserHuge02 = "TurbolaserHuge02"
	TurbolaserHuge02Icon = "Heavy Teraton Turbolaser Quad"
	TurbolaserHuge02Desc = "TurbolaserHuge02 quad barrel version"

	TurbolaserHuge03 = "TurbolaserHuge03"
	TurbolaserHuge03Icon = "Heavy Teraton Turbolaser"
	TurbolaserHuge03Desc = "TurbolaserHuge03"

	OctupleBarbetteTurbolaser = "Turboláser Barbette Octuple"
	OctupleBarbetteTurbolaserIcon = "Turboláser Barbette Octuple"
	OctupleBarbetteTurbolaserDesc = "<orange>Requiere Puente de Mando</orange> \n\nUna imponente torreta Turboláser Barbette Octuple, símbolo del poder Imperial. Cuenta con ocho cañones pesados capaces de entregar una barrera devastadora. Particularmente efectivo contra naves capitales e instalaciones, pero menos efectivo contra cazas ágiles. Un elemento central en el arsenal ofensivo de la flota Imperial.<string id='CommonStringModIDSWACD'/>" // IA MEJORADO De "Poderosa barrera de tecnología pesada de Turboláser Imperial. Requiere Puente de Mando. <string id='CommonStringModIDSWACD'/>"
	OctupleBarbetteTurbolaserOverclock = "Overclocked Octuple Barbette Turbolaser"
	OctupleBarbetteTurbolaserOverclockDesc = "Increases the damage of each laser shot and adds splash damage, but reduces the rate of fire. Produces waste heat when firing." // AI ENHANCED From "Powerful Barrage of Heavy Imperial Turbolaser Technology. Requires Command Bridge."

	QuadBarbetteTurbolaser = "Turboláser Barbette Cuádruple"
	QuadBarbetteTurbolaserIcon = "Turboláser Barbette Cuádruple"
	QuadBarbetteTurbolaserDesc = "<orange>Requiere Puente de Mando</orange> \n\nUna formidable torreta Turboláser Barbette Cuádruple, combinando cuatro cañones para un golpe concentrado y poderoso. Ideal para enfrentamientos a media distancia tanto contra naves capitales como medianas. Equilibra el poder de fuego y la tasa de disparo para uso versátil en varios escenarios de combate.<string id='CommonStringModIDSWACD'/>" // IA MEJORADO De "Versión de cuatro cañones del Turboláser Barbette Cuádruple"
	QuadBarbetteTurbolaserOverclock = "Overclocked Quad-Barbette Turbolaser"
	QuadBarbetteTurbolaserOverclockDesc = "Increases the damage of each laser shot and adds splash damage, but reduces the rate of fire. Produces waste heat when firing." // AI ENHANCED From "Powerful Barrage of Heavy Imperial Turbolaser Technology. Requires Command Bridge."

	MediumTurbolaserQuadswitchable = "Turboláser Pesado de Cuatro Cañones"
	MediumTurbolaserQuadswitchableIcon = "Turboláser Pesado de Cuatro Cañones" // ¿Turboláser Medio de Cuatro Cañones?
	MediumTurbolaserQuadswitchableDesc = "Un versátil Turboláser Pesado de Cuatro Cañones, una torreta <orange>conmutable</orange> que ofrece un equilibrio de alto daño y precisión con una tasa de disparo moderada, adecuada para una variedad de objetivos. Una excelente elección para comandantes que buscan flexibilidad en sus armamentos.<string id='CommonStringModIDSWACD'/>"/* IA MEJORADO De "MediumTurbolaserQuadswitchable" */

	CISturbolaserswitchable = "Turboláser Pesado CIS ZS"
	CISturbolaserswitchableIcon = "Turboláser Pesado CIS"
	CISturbolaserswitchableDesc = "<orange>Requiere Puente de Mando</orange> \n\nLa gran torreta de doble cañón, lenta en movimiento, permite un daño significativo en área y penetración, aunque a costa de la precisión y la tasa de disparo. Es efectiva contra naves grandes pero menos contra objetivos rápidos, equilibrando el daño entre armadura y escudos. \n\nNotable por su despliegue en los acorazados de clase Lucrehulk de <cyan>Hoersch-Kessel Drive, Inc</cyan>.<string id='CommonStringModIDSWACD'/>"	// IA MEJORADO De "<orange>Requiere Puente de Mando</orange> Gran torreta de Turboláser <orange>conmutable</orange> de doble cañón que inflige gran daño en área y penetración a costa de precisión y tasa de disparo. Ideal para objetivos grandes, débil contra objetivos rápidos. Este turboláser proporciona buen daño tanto a armadura como a escudos."
	// AI ENHANCED From "<orange>Requires Command Bridge</orange> Large, slow-moving, double-barreled <orange>switchable</orange> Turbolaser which deals very great area damage and penetration at the expensive of accuracy and rate of fire. Ideal for targetting large ships, weak against fast-moving targets. This turbolaser provides both good damage to armor and shields." 

	Imperialturbolaserswitchable = "Turboláser Pesado Imperial"
	ImperialturbolaserswitchableIcon = "Turboláser Pesado Imperial"
	ImperialturbolaserswitchableDesc = "<orange>Requiere Puente de Mando</orange> \n\nGran torreta de Turboláser de doble cañón, lenta en movimiento, que inflige gran daño en área y penetración a costa de precisión y tasa de disparo. Ideal para objetivos grandes, débil contra objetivos rápidos. Este turboláser inflige más daño a la armadura a costa del daño a los escudos. <string id='CommonStringModIDSWACD'/>"

	Republicturbolaserswitchable = "Turboláser Pesado DBY-827 de la República"
	RepublicturbolaserswitchableIcon = "Turboláser Pesado de la República"
	RepublicturbolaserswitchableDesc = "<orange>Requiere Puente de Mando</orange> \n\nGran torreta de Turboláser de doble cañón, lenta en movimiento, que inflige gran daño en área y penetración a costa de precisión y tasa de disparo. Ideal para objetivos grandes, débil contra objetivos rápidos. Este turboláser inflige más daño a los escudos a costa del daño a la armadura. \n\nNotable por su despliegue en el Destructor Estelar de clase Venator de <cyan>Kuat Systems Engineering</cyan>. <string id='CommonStringModIDSWACD'/>"

	HeavyIonCannon = "Cañón de Iones Pesado"
	HeavyIonCannonIcon = "Cañón de Iones Pesado"
	HeavyIonCannonDesc = "<orange>Requiere Puente de Mando</orange> \n\nUna formidable torreta de Cañón de Iones de doble cañón conocida por deshabilitar escudos enemigos mientras causa un daño mínimo al casco. Esencial en enfrentamientos estratégicos, puede influir significativamente en el resultado de la batalla. \n\nNotablemente utilizado en el Destructor Estelar clase Interdictor de <cyan>Sienar Fleet Systems</cyan>, donde juega un papel crítico en las batallas de flotas al debilitar las defensas enemigas.<string id='CommonStringModIDSWACD'/>"/* IA MEJORADO DE "Potente arma de iones capaz de deshabilitar escudos y causar poco o ningún daño a la nave enemiga, si se usa correctamente, unos pocos Cañones de Iones Pesados pueden cambiar el resultado de la batalla." */

	Heavyturbolaserswitchable = "Turboláser Pesado"
	HeavyturbolaserswitchableIcon = "Turboláser Pesado"
	HeavyturbolaserswitchableDesc = "Gran torreta de Turboláser <orange>conmutable</orange> de doble cañón, que entrega un daño formidable y alta penetración, a costa de precisión y tasa de disparo. Optimizada para enfrentar objetivos grandes, estacionarios o de movimiento lento, pero menos efectiva contra adversarios ágiles y rápidos. \n\nNotable por su despliegue en los Destructores Estelares clase Imperial de <cyan>Kuat Drive Yards</cyan>.<string id='CommonStringModIDSWACD'/>"/*IA MEJORADO DE "Gran torreta de Turboláser <orange>conmutable</orange> de doble cañón que inflige gran daño en área y penetración a costa de precisión y tasa de disparo. Ideal para objetivos grandes, débil contra objetivos rápidos." */

	XX9turbolaserswitchable = "Torreta Turboláser XX-9"
	XX9turbolaserswitchableIcon = "Torreta Turboláser"
	XX9turbolaserswitchableDesc = "La icónica torreta Turboláser XX-9, famosa desde la legendaria escena del ataque al canal, combina asequibilidad con versatilidad. Este modelo <orange>conmutable</orange> permite un ajuste rápido entre diferentes modos de combate, haciéndola una opción popular entre varias clases de naves estelares. Conocida por su rendimiento confiable y rentabilidad, la XX-9 sigue siendo un elemento básico en arsenales a través de la galaxia, encarnando una mezcla perfecta de significado histórico y utilidad práctica en el campo de batalla.<string id='CommonStringModIDSWACD'/>"/*IA MEJORADO DE "El turboláser <orange>conmutable</orange> original de la escena del ataque al canal, el turboláser XX-9 era un turboláser ampliamente asequible." */

	TripleTurbolaser = "Turboláser Triple"
	TripleTurbolaserIcon = "Turboláser Triple"
	TripleTurbolaserDesc = "Una torreta Turboláser Triple <orange>conmutable</orange> compacta pero potente. Ligeramente más pequeña que los turbolasers pesados estándar pero significativamente más robusta que los modelos de turboláser ligeros, esta torreta de tres cañones ofrece una mezcla equilibrada de poder de fuego y agilidad. Su funcionalidad conmutable permite flexibilidad táctica en varios escenarios de combate, haciéndola una opción versátil para naves estelares que buscan un equilibrio entre tamaño y efectividad en combate.<string id='CommonStringModIDSWACD'/>"/*IA MEJORADO DE "Una torreta Turboláser Triple <orange>conmutable</orange>" */

	TurbolaserMedLR01 = "Turboláser Mediano de Largo Alcance"
	TurbolaserMedLR01Icon = "Turboláser MLR"
	TurbolaserMedLR01Desc = "El Turboláser Medio de Largo Alcance, distinguido por su diseño de torreta de un solo cañón <orange>conmutable</orange>, está optimizado para enfrentamientos a larga distancia. A pesar de su tamaño compacto, comparable con los modelos de turboláser ligero, presume de un alcance de disparo extendido y una alta velocidad de fuego. Este turboláser destaca en el ataque a objetivos enemigos a distancias significativas, proporcionando un fuego preciso y constante.<string id='CommonStringModIDSWACD'/>"/*IA MEJORADO DE "TurbolaserMed largo alcance 01" */

	Medturbolaserswitchable = "Turboláser Mediano"
	MedturbolaserswitchableIcon = "Turboláser Mediano"
	MedturbolaserswitchableDesc = "Esta torreta Turboláser <orange>conmutable</orange> es una versión más ágil del clásico Turboláser Pesado. Ofreciendo un compromiso equilibrado entre el poder bruto de la variante pesada y la precisión de los turbolasers más ligeros, está diseñada para naves que requieren versatilidad sin sacrificar demasiado poder de fuego. \n\nSu adaptabilidad la hace una vista común en una variedad de naves, desde las elegantes fragatas Nebulon-B de <cyan>Kuat Drive Yards</cyan> hasta los imponentes cruceros Mon Calamari de <cyan>Astilleros Mon Calamari</cyan>, donde su capacidad de cambiar rápidamente de modos de disparo es muy valorada.<string id='CommonStringModIDSWACD'/>"/*IA MEJORADO DE "Una versión <orange>conmutable</orange> más ligera del Turboláser Pesado" */

	MediumIonCannon = "Cañón de Iones Mediano"
	MediumIonCannonIcon = "Cañón de Iones Mediano"
	MediumIonCannonDesc = "El Cañón de Iones Mediano, una herramienta estratégica en el arsenal de cualquier flota, se especializa en deshabilitar escudos enemigos mientras inflige daño mínimo al casco. Sus disparos ionizados están diseñados para interrumpir sistemas electrónicos, haciéndolo una torreta ideal para neutralizar defensas enemigas sin destruir la nave. \n\nFrecuentemente equipado en las fragatas Nebulon-B de <cyan>Kuat Drive Yards</cyan> y las Corbetas de <cyan>Corporación de Ingeniería Corelliana</cyan>, este cañón juega un papel crucial en deshabilitar naves enemigas, permitiendo su captura o haciéndolas vulnerables a ataques posteriores.<string id='CommonStringModIDSWACD'/>"/*IA MEJORADO DE "Arma de iones capaz de deshabilitar escudos y causar poco o ningún daño a la nave enemiga." */

	LightTurbolaserswitchable = "Turboláser Ligero"
	LightTurbolaserswitchableIcon = "Turboláser Ligero"
	LightTurbolaserswitchableDesc = "Compacto y de rápida acción, esta torreta Turboláser Ligera <orange>conmutable</orange> combina versatilidad con precisión. Ideal para combatir cazas rápidos, también tiene suficiente poder para enfrentarse a naves capitales. \n\nNotable por su alta tasa de disparo y precisión, este turboláser es un producto de la ingeniería innovadora de <cyan>Taim &amp; Bak</cyan>. Es una elección popular para naves ágiles como las corbetas CR90 de <cyan>Corporación de Ingeniería Corelliana</cyan>, ofreciendo un equilibrio entre poder de fuego y velocidad.<string id='CommonStringModIDSWACD'/>"
	LightTurbolaserswitchableOverclock = "Overclocked Light Turbolaser"
	LightTurbolaserswitchableOverclockDesc = "Increases the damage of each laser shot and adds splash damage, but reduces the rate of fire. Produces waste heat when firing."

	DualLaserCannonSwitchable = "Cañón Láser Doble"
	DualLaserCannonSwitchableIcon = "Cañón Láser Doble"
	DualLaserCannonSwitchableDesc = "Esta torreta de Cañón Láser Doble <orange>conmutable</orange> está diseñada para un rápido compromiso y alta precisión. Su diseño aerodinámico permite un disparo rápido, siendo altamente efectiva contra cazas enemigos ágiles. \n\nCon un alcance más corto pero una tasa de disparo aumentada, sobresale en batallas a corta distancia, a menudo montada en naves de patrulla y escolta, como las corbetas modificadas de <cyan>Industrias BlasTech</cyan>, donde una respuesta rápida y la supresión de cazas son cruciales.<string id='CommonStringModIDSWACD'/>"/*MEJORADO POR IA DE "Un cañón láser doble <orange>conmutable</orange>, cuyo propósito principal es derribar cazas enemigos" */

	FalconLaserCannon = "Láser Cuádruple AG-2G"
	FalconLaserCannonIcon = "Cañón Cuádruple AG-2G" /*MEJORADO POR IA DE "Cañón Láser del Halcón Milenario" */
	FalconLaserCannonDesc = "El Cañón Láser Cuádruple AG-2G, conocido por su alta tasa de disparo y formidable potencia de fuego, es la torreta ideal para compromisos rápidos con cazas estelares. \n\nEspecialmente equipado en el icónico Halcón Milenario de <cyan>Corporación de Ingeniería Corelliana</cyan>, y las fragatas clase Lancer del Imperio, este cañón es un testimonio de la versatilidad y eficiencia en situaciones de combate.<string id='CommonStringModIDSWACD'/>"/*MEJORADO POR IA DE "Potente cañón láser cuádruple. Notablemente utilizado en el Halcón Milenario y fragatas clase Lancer Imperiales. Efectivo contra cazas estelares." */

	TurbolaserLightPD4 = "Turboláser Ligero de Defensa Puntual Clase Sentinel" /*MEJORADO POR IA DE "TurbolaserLightPD4" */
	TurbolaserLightPD4Icon = "Turboláser LPD" /*MEJORADO POR IA DE "TurbolaserLightPD4" */
	TurbolaserLightPD4Desc = "Este avanzado turboláser ligero de defensa puntual es excepcionalmente efectivo para interceptar y neutralizar <orange>lásers y disparos de iones</orange>, una capacidad rara entre las torretas de PD. Optimizado para apuntar a una variedad de tipos de proyectiles, su característica especializada de neutralización de disparos de iones es crucial para contrarrestar tácticas de guerra electrónica. \n\nNotable por su despliegue en el Destructor Estelar clase Imperial II de <cyan>Astilleros de Kuat</cyan>.<string id='CommonStringModIDSWACD'/>"/* MEJORADO POR IA DE "TurbolaserLightPD4 puede derribar disparos de iones" */

	TurbolaserTiny01 = "Turboláser Compacto - Ráfaga" // "Turboláser de Defensa Puntual 1"
	TurbolaserTiny01Icon = "T-LC Ráfaga" // "Turboláser Compacto 1"
	TurbolaserTiny01Desc = "Una torreta pequeña pero poderosa, la versión de Ráfaga del Turboláser Compacto se especializa en daño de ráfaga, ideal para neutralizar rápidamente amenazas menores. Este es un Cañón Láser <orange>conmutable</orange>, operado por tripulación.<string id='CommonStringModIDSWACD'/>" // "Puede ser cambiado para defenderse de proyectiles o atacar naves enemigas"

	TurbolaserTiny02 = "Turboláser Compacto - Pesado" // "Turboláser de Defensa Puntual 2"
	TurbolaserTiny02Icon = "T-LC Pesado" // "Turboláser Compacto 2"
	TurbolaserTiny02Desc = "Una torreta pequeña pero resistente, el Turboláser Compacto - Pesado está construido para durabilidad y fuego sostenido, haciéndolo efectivo contra una amplia gama de objetivos. Este es un Cañón Láser <orange>conmutable</orange>, operado por tripulación.<string id='CommonStringModIDSWACD'/>" // "Puede ser cambiado para defenderse de proyectiles o atacar naves enemigas"

	TurbolaserTiny03 = "Turboláser Compacto - Rápido" // "Híbrido de Turboláser Ligero/Defensa Puntual"
	TurbolaserTiny03Icon = "T-LC Rápido" // "Turboláser Compacto 3"
	TurbolaserTiny03Desc = "Combinando lo mejor de ambos mundos en una torreta, el Turboláser Compacto - Rápido ofrece un enfoque equilibrado tanto para el daño de ráfaga como para la resistencia. Este es un Cañón Láser <orange>conmutable</orange>, operado por tripulación.<string id='CommonStringModIDSWACD'/>" // "Puede ser cambiado para defenderse de proyectiles o atacar naves enemigas"

	SmallLaserCannonSwitchable = "Cañón Láser Compacto Montado en el Techo" /*MEJORADO POR IA DE "Cañón Láser Dual Pequeño Montado en el Techo" */
	SmallLaserCannonSwitchableIcon = "Láser de Techo Compacto" /*MEJORADO POR IA DE "Cañón Láser Dual Pequeño Montado en el Techo" */
	SmallLaserCannonSwitchableDesc = "El Cañón Láser Montado en el Techo <orange>conmutable</orange> ofrece versatilidad y compacidad, ideal para cazas pesados y naves ligeras. Su diseño prioriza la agilidad en combate, sacrificando durabilidad por un tamaño reducido y una maniobrabilidad mejorada. \n\nLa adaptabilidad de este modelo lo hace una elección popular para cazas estelares personalizados y naves de patrulla donde la flexibilidad en combate es clave. Se utiliza notablemente en varias naves modificadas que requieren un equilibrio entre velocidad y poder de fuego.<string id='CommonStringModIDSWACD'/>"/* MEJORADO POR IA DE "Cañón Láser Pequeño Montado en el Techo comúnmente instalado en cazas pesados." */

	//Fixed & Directional Weapons Large -> Small
	TurbolaserFlakCannon01 = "Cañón de Flak Pesado de Cubierta"
	TurbolaserFlakCannon01Icon = "Cañón de Flak Pesado" //Anteriormente "Cañón de Flak Pesado de Cubierta"
	TurbolaserFlakCannon01Desc = "<orange>Requiere Puente de Mando</orange> \n\nDiseñado para defensa, el Turboláser Cañón de Flak sobresale en interceptar y neutralizar una amplia gama de amenazas, incluyendo <orange>balas, disparos de iones, láseres, minas y misiles</orange>. Su diseño permite integración detrás de una sola capa de bloques de armadura, mejorando las capacidades de defensa estratégica. \n\nAunque no es estándar en ninguna clase de nave estelar, es una mejora posterior del mercado favorecida por comandantes para reforzar defensas contra amenazas de misiles, especialmente prevalentes en sectores ricos en recursos que priorizan protección avanzada.<string id='CommonStringModIDSWACD'/>"/* MEJORADO POR IA DE "Requiere Fábrica de Municiones" */

	TurbolaserCarronade = "Batería Turboláser Carronade"
	TurbolaserCarronadeIcon = "Turboláser Carronade"
	TurbolaserCarronadeDesc = "La Carronade Turboláser, una batería Turboláser de cubierta de alta potencia <orange>conmutable</orange>, sobresale en asaltos de costado y bombardeos de flota. Su diseño único permite la colocación detrás de bloques de armadura, aumentando la eficiencia en combate nave a nave. \n\nFavorita por su versatilidad, este turboláser no es estándar en ninguna nave, pero se utiliza ampliamente en modificaciones, notablemente en corbetas CR90 modificadas por flotas privadas y grupos marginales para una mayor potencia de fuego.<string id='CommonStringModIDSWACD'/>"/* MEJORADO POR IA DE "Batería Turboláser de cubierta, perfecta para maniobras de costado. Se puede colocar detrás de una capa de bloques de armadura." */

	FixedHeavyLaser = "Cañón Láser Pesado"
	FixedHeavyLaserIcon = "Cañón Láser Pesado"
	FixedHeavyLaserDesc = "El Cañón Láser Pesado, un arma formidable de precisión y poder, está diseñado para golpes directos e impactantes. A pesar de su posición fija, cuenta con un arco de disparo limitado pero efectivo, permitiendo fuego concentrado en objetivos enemigos. Este cañón es conocido por su capacidad de entregar golpes devastadores, capaz de destruir cruceros medianos a grandes y cazas estelares con facilidad. \n\nNotable por su uso en el Destructor Estelar clase Victoria de <cyan>Astilleros de Kuat</cyan>, ejemplificando la fuerza del fuego concentrado en la guerra espacial.<string id='CommonStringModIDSWACD'/>"/* MEJORADO POR IA DE "Potente Cañón Láser con suficiente poder para destruir cruceros medianos a grandes y cazas estelares." */

	FixedMediumLaser = "Cañón Láser Mediano"
	FixedMediumLaserIcon = "Cañón Láser Mediano"
	FixedMediumLaserDesc = "El Cañón Láser Mediano ofrece una combinación equilibrada de poder y precisión. Aunque más pequeño en tamaño comparado con su contraparte pesada, tiene un impacto significativo, hábil en destruir cruceros más pequeños y cazas estelares. Su colocación fija asegura una plataforma de disparo estable y confiable, con un arco de disparo modesto que permite asaltos dirigidos a naves enemigas. \n\nNotable por su integración en el Crucero Pesado clase Dreadnought de <cyan>Rendili StarDrive</cyan>, este cañón láser representa un componente crítico en el arsenal de naves capitales de tamaño mediano.<string id='CommonStringModIDSWACD'/>"/* MEJORADO POR IA DE "Cañón Láser de Mediana Potencia con suficiente poder para destruir cruceros más pequeños y cazas estelares." */

	Smallpointlaser = "Cañón Láser Pequeño"
	SmallpointlaserIcon = "Cañón Láser Pequeño"
	SmallpointlaserDesc = "El Cañón Láser Pequeño <orange>conmutable</orange> es un arma compacta pero formidable, diseñada para un rápido compromiso contra cazas y naves pequeñas. A pesar de su tamaño, inflige daño eficientemente, y cuando se usa en grupos, se convierte en una amenaza creíble para naves más grandes como fragatas y cruceros. Su versatilidad y poder lo hacen una herramienta común y esencial en el combate espacial. \n\nNotable por su integración en la Nave Ligera YT-1300 de <cyan>Corporación de Ingeniería Corelliana</cyan>, este láser es un componente clave en el arsenal defensivo de muchas naves multiusos en la galaxia.<string id='CommonStringModIDSWACD'/>"/* MEJORADO POR IA DE "<orange>Conmutable</orange> Un pequeño láser multipropósito con la capacidad de infligir daño rápidamente y efectivamente a cazas y naves pequeñas, mientras también tiene la capacidad de infligir daño sustancial a fragatas y cruceros en números más grandes. Cañones láser como este son una vista común en la galaxia." */

	FixedLaser = "Cañón Láser KX9"
	FixedLaserIcon = "Cañón Láser KX9"
	FixedLaserDesc = "Un armamento básico, el cañón X-Wing <orange>conmutable</orange> ofrece fuego confiable y preciso basado en energía. Este cañón láser ofrece un equilibrio de daño y precisión, ideal para combates de perros y ataques precisos contra naves enemigas. Su diseño fijo asegura un rendimiento estable sin necesidad de configuraciones adicionales. \n\nFamoso por su despliegue en los icónicos cazas estelares T-65 X-Wing y creado por <cyan>Taim &amp; Bak</cyan>.<string id='CommonStringModIDSWACD'/>"/* MEJORADO POR IA DE "El Cañón Láser KX9 fue creado por <green>Taim &amp;Bak</green> y fue conocido por ser utilizado en cazas estelares T6x X-Wing." */

	FixedLaserL = "Cañón Láser KX9"
	FixedLaserR = "Cañón Láser KX9"

	AWFixedLaserL = "Cañón Láser RG-9 Borstel"
	AWFixedLaserLIcon = "Cañón Láser RG-9" // "Cañón Láser A-Wing Izquierdo"
	AWFixedLaserLDesc = &AWFixedLaserRDesc

	AWFixedLaserR = &AWFixedLaserL
	AWFixedLaserRIcon = "Cañón Láser RG-9" // "Cañón Láser A-Wing Derecho"
	AWFixedLaserRDesc = "El Cañón Láser RG-9 de <cyan>Borstel</cyan>, un elemento básico del arsenal del caza estelar RZ-1 A-Wing, sobresale en daño al casco con su alta tasa de disparo. Su diseño <orange>conmutable</orange> está adaptado para agilidad y precisión, reflejando el estilo de combate rápido del A-Wing. Este cañón láser combina fuego formidable con capacidades de disparo rápido, ideal para intensos combates de perros.<string id='CommonStringModIDSWACD'/>"/* MEJORADO POR IA DE "Cañón Láser RG-9 Borstel, famoso por su uso en el caza estelar RZ-1 A-Wing. Conocido por infligir buen daño al casco. Alta tasa de disparo." */

	fixedlasercannon = "Cañón Repetidor TIE" // "Cañón Láser Fijo"
	fixedlasercannonIcon = "Cañón Repetidor TIE" // "Cañón Láser Fijo"
	fixedlasercannonDesc = "El Cañón Repetidor TIE es un arma láser aerodinámica pero potente, inspirada en el armamento de los cazas TIE del <cyan>Imperio Galáctico</cyan>. Este cañón láser fijo <orange>conmutable</orange> maximiza la tasa de disparo dentro de un diseño compacto, haciéndolo altamente efectivo contra objetivos móviles rápidos. Su requisito mínimo de espacio permite que se ajuste a varios tamaños de naves, sirviendo como arma principal en naves más pequeñas o como opción secundaria en naves más grandes. \n\nAmpliamente utilizado en modificaciones personalizadas de naves, el Cañón Repetidor TIE es una elección popular para pilotos que valoran capacidades de disparo rápido combinadas con la eficiencia legendaria de la tecnología de cazas TIE.<string id='CommonStringModIDSWACD'/>"	/* MEJORADO POR IA DE "Cañón Láser Ligero Inmóvil que deja una pequeña huella." */

	dualfixedioncannon = "Cañón de Iones Montado Dual, Edición Compacta"
	dualfixedioncannonIcon = "Ion Dual EC" // "Cañón Láser Fijo"
	dualfixedioncannonDesc = "El <cyan>Alianza Rebelde's</cyan> Cañón de Iones Montado Dual, Edición Compacta; un cañón de iones de doble cañón, montado en la parte inferior y fijo, diseñado para ataques de precisión y deshabilitación de sistemas enemigos. Perfecto para cazas y cargueros ligeros en tácticas de golpear y correr. \n\nNotable por su despliegue en el <cyan>BTL Y-wing Starfighter</cyan>. <string id='CommonStringModIDSWACD'/>"

	SWMissileLauncherMedium = "Lanzamisiles Mediano de Sistemas Kuat"
	SWMissileLauncherMediumIcon = "Lanzador Mediano KSE"
	SWMissileLauncherMediumDesc = "Un lanzador automatizado bien protegido y reforzado con duracero, capaz de disparar varios tipos de misiles incluyendo <color r='255' g='69' b='0' a='255'>Racimo</color>, <color r='255' g='165' b='0' a='255'>Conmoción</color>, <color r='30' g='144' b='255' a='255'>Intruso</color>, y <color r='34' g='139' b='34' a='255'>Hex</color>. \n\nDestacado por su despliegue en el <cyan>Kuat Systems Engineering</cyan> Destructor Estelar clase Venator. \n\n<bad>Límite 20 por nave</bad> <string id='CommonStringModIDSWACD'/>"

	MissileLauncherCompact = "Lanzador de Misiles Compacto de Sistemas Kuat"
	MissileLauncherCompactIcon = "Lanzador Compacto KSE"
	MissileLauncherCompactDesc = "Un lanzador automatizado bien protegido y reforzado con duracero, capaz de disparar varios tipos de misiles incluyendo <color r='255' g='69' b='0' a='255'>Racimo</color>, <color r='255' g='165' b='0' a='255'>Conmoción</color>, <color r='30' g='144' b='255' a='255'>Intruso</color>, y <color r='34' g='139' b='34' a='255'>Hex</color>. \n\nDestacado por su despliegue en el <cyan>Kuat Systems Engineering</cyan> Destructor Estelar clase Venator. \n\n<bad>Límite 20 por nave</bad> <string id='CommonStringModIDSWACD'/>"

	DiscordMissileLauncher = "Lanzamisiles Discord"
	DiscordMissileLauncherIcon = "Lanzador Discord"
	DiscordMissileLauncherDesc = "<yellow>Usa partes de mina</yellow>\n\nEl Lanzamisiles Discord envía una carga mecanizada que detona a corta distancia de su objetivo, liberando un enjambre de 5-7 Droides Zumbadores que devoran la armadura y los componentes esenciales de la nave enemiga. Los Droides Zumbadores pueden ser contrarrestados con la mayoría de los sistemas de torretas de defensa puntual.\n\nOriginalmente desplegados por la <cyan>Confederación de Sistemas Independientes</cyan> durante las Guerras Clon, estos misiles se hicieron famosos por su efecto devastador en los cazas estelares de la República.<string id='CommonStringModIDSWACD'/>"

	ProtonLauncher = "Lanzador de Torpedos de Protones"
	ProtonLauncherIcon = "Lanzador de Torpedos de Protones"
	ProtonLauncherDesc = "Este Lanzador de Protones, capaz de desplegar devastadores Torpedos de Protones, sirve como un activo crítico en el combate de nave a nave. Los Torpedos de Protones, conocidos por su alta eficiencia en penetrar defensas y destruir componentes internos de naves enemigas, son una herramienta temida en cualquier arsenal espacial. Con un enfoque en daño interno sobre impacto superficial, estos torpedos son particularmente efectivos contra naves más grandes y menos maniobrables. \n\nNotable por su uso en varias flotas, a menudo se encuentra en naves estelares fabricadas por <cyan>Astilleros de Kuat</cyan> y <cyan>Sistemas de Flota Sienar</cyan>.<string id='CommonStringModIDSWACD'/>"	/* MEJORADO POR IA DE "Lanza Torpedos de Protones. Los torpedos de protones son un tipo de munición explosiva utilizada en toda la galaxia. Son altamente eficientes en destruir componentes internos de la nave." */
	/* AI ENHANCED FROM "Launches Proton Torpedoes. Proton torpedoes are a type of explosive ordnance used throughout the galaxy. They are highly efficient at destroying a ship's internal components." */


	//Cockpits and Command Bridges
	WarRoom = "Sala de Guerra"
	WarRoomIcon = "Sala de Guerra"
	WarRoomDesc = "<orange>Requiere Puente de Mando</orange>\n\n<yellow>Desbloquea Nivel de Tecnología 2</yellow>\n\n<green>Incluye Baliza &amp; Sensores</green> \n\nLa Sala de Guerra sirve como un centro de comunicaciones y planificación, proporcionando <good>+3600<image name='command_points' colored='true'/></good> Puntos de Comando adicionales. Está equipada con una baliza, sensores de largo alcance y poderosos navicomputadores esenciales para los cálculos de navegación hiperespacial. <string id='CommonStringModIDSWACD'/>"
/* AI ENHANCED FROM "The war room is a communications and planning center, that provides an additional +3600 Command Points. It is fully equiped with a beacon, long range sensors, and powerful navicomputers that makes the calculations necessary to navigate through hyperspace." */

	CommandBridge = "Puente de Mando"
	CommandBridgeIcon = "Puente de Mando"
	CommandBridgeDesc = "<yellow>Desbloquea Nivel Tecnológico 1</yellow> \n\nPermite que la nave vuele y coordine sus armas proporcionando <good>+1200<image name='command_points' colored='true'/></good> Puntos de Mando. <string id='CommonStringModIDSWACD'/>"

	CommandBridgeCIS = "Confederacy of Independent Systems Command Bridge"
	CommandBridgeCISIcon = "CIS Bridge"

	CommandBridge2 = "Puente de Mando"
	CommandBridge2Icon = "Puente de Mando II"
	CommandBridge2Desc = "Desbloquea artículos de Tecnología II"

	SWBridge2x3 = "Corellian TradeRunner Cockpit"
	SWBridge2x3Icon = "CEC-TR Cockpit (2x3)"
	SWBridge2x3Desc = "<green>Includes Airlock &amp; Fire Extinguisher</green>\n\n<cyan>Corellian Engineering Corporation's</cyan> flagship cockpit for the smuggler who doesn't like to be noticed twice. This cockpit provides <good>+125<image name='command_points' colored='true'/></good> Command Points, making it an excellent choice for versatile freighter captains who value adaptability and performance. \n\n<magenta>Fully customizable exterior</magenta><string id='CommonStringModIDSWACD'/>"

	SWBridge3x2 = "Gallofree GalaxyHauler Cockpit"
	SWBridge3x2Icon = "GY-GH Cockpit (3x2)"
	SWBridge3x2Desc = "<green>Includes Airlock &amp; Fire Extinguisher</green>\n\n<cyan>Gallofree Yards, Inc</cyan> has created the ultimate cockpit for the freighter captain who likes to blend in at every port. This cockpit provides <good>+125<image name='command_points' colored='true'/></good> Command Points, ensuring reliable command and control for your cargo operations. \n\n<magenta>Fully customizable exterior</magenta><string id='CommonStringModIDSWACD'/>"

	Cockpit = "Cabina de Mando T-65B X-Wing"
	CockpitIcon = "Cabina de Mando T-65B X-Wing"
	CockpitDesc = "<green>Incluye Esclusa de Aire &amp; Extintor</green> \n\nHábilmente creada para reflejar el diseño icónico del T-65B X-Wing Starfighter de <cyan>Incom Corporation</cyan>, esta cabina ofrece <good>+35<image name='command_points' colored='true'/></good> Puntos de Mando y combina un control preciso con durabilidad robusta. Conocida por su papel en numerosas victorias rebeldes, proporciona el equilibrio perfecto de funcionalidad y comodidad para cualquier piloto aspirante.<string id='CommonStringModIDSWACD'/>\n\n<bad>Límite (2) por Nave</bad>"

	CockpitT85 = "T-85 X-Wing Cockpit"
	CockpitT85Icon = "T-85 X-Wing Cockpit"
	CockpitT85Desc = "<green>Includes Airlock &amp; Fire Extinguisher</green> \n\nExpertly crafted to mirror the iconic design of the <cyan>Incom Corporation's</cyan> T-85 X-Wing Starfighter, this cockpit provides <good>+50<image name='command_points' colored='true'/></good> Command Points while offering a blend of precision control and rugged durability. Renowned for its role in numerous Rebel victories, it provides the perfect balance of functionality and comfort for any aspiring pilot.<string id='CommonStringModIDSWACD'/>\n\n<bad>Limit (1) per Ship</bad>"

	CockpitHid = "Cabina de Mando Oculta"
	CockpitHidIcon = "Cabina de Mando Oculta"
	CockpitHidDesc = "<green>Incluye Extintor</green> \n\nDiseñada para el sigilo y la sutileza, esta cabina oculta mantiene todas las características esenciales integrándose perfectamente en el diseño de tu cazador estelar. Proporciona <good>+25<image name='command_points' colored='true'/></good> Puntos de Mando para misiones que requieren un perfil bajo sin sacrificar la funcionalidad.<string id='CommonStringModIDSWACD'/>"/* MEJORADO POR IA DE "Misma cabina, pero oculta para adaptarse a sus necesidades de construcción de cazas estelares, y las nuestras." */

	CockpitARC = "Cabina de Mando de Caza Estelar ARC"
	CockpitARCIcon = "Cabina de Mando de Caza Estelar ARC"
	CockpitARCDesc = "<green>Incluye Esclusa de Aire &amp; Extintor</green> \n\nUna cabina multipropósito diseñada para los cazadores estelares ARC de <cyan>Kuat Systems Engineering</cyan>, conocidos por su robustez y versatilidad. Esta cabina proporciona <good>+50<image name='command_points' colored='true'/></good> Puntos de Mando.<string id='CommonStringModIDSWACD'/>\n\n<bad>Límite (2) por Nave</bad>"

	Cockpit2 = "Cabina de Mando de Caza TIE"
	Cockpit2Icon = "Cabina de Mando de Caza TIE"
	Cockpit2Desc = "<green>Incluye Esclusa de Aire &amp; Extintor</green> \n\nReflejando el estilo distintivo de los cazas TIE de <cyan>Sistemas de Flota Sienar</cyan>, esta cabina está diseñada para pilotos solitarios. Ofrece <good>+45<image name='command_points' colored='true'/></good> Puntos de Mando, una vista despejada y sistemas de control compactos, epitomizando la eficiencia y minimalismo del diseño Imperial.<string id='CommonStringModIDSWACD'/>.\n\n<red>Límite (1) por Nave</red>"

	Cockpit2_1 = "Cabina de Mando Serie TIE MK1"
	Cockpit2_1Icon = "Cabina de Mando de Caza TIE MK1"
	Cockpit2_1Desc = "Cabina de Mando simplificada de Caza TIE. Equipada con motores iónicos rápidos, un reactor de ionización solar Ia3-b, un casco de titanio y doble arreglo de sensores Fabritech. <string id='CommonStringModIDSWACD'/>"

	Cockpit2_2 = "Cabina de Mando Serie TIE MK2"
	Cockpit2_2Icon = "Cabina de Mando de Caza TIE MK2"
	Cockpit2_2Desc = "Cabina de Mando estándar de Caza TIE. Equipada con motores iónicos rápidos, cañones láser dobles Ls-1, un reactor de ionización solar Ia3-b, un casco de titanio y doble arreglo de sensores Fabritech. <string id='CommonStringModIDSWACD'/>"

	Eta2 = "Cabina de Mando del Interceptador Eta-2 Actis (Armada)"// "Cabina de Mando Eta-2 (+ Cañones Láser)"
	Eta2Icon = "Cabina de Mando Eta-2"//"Cabina de Mando del Interceptador Eta-2 Actis"
	Eta2Desc = "<green>Incluye Esclusa de Aire, Extintor &amp; Cama</green> \n\nCreada a imagen del Interceptor Eta-2 Actis de <cyan>Kuat Systems Engineering</cyan>, esta cabina está equipada con cañones láser frontales dobles. Proporciona <good>+45<image name='command_points' colored='true'/></good> Puntos de Mando y ofrece una combinación armónica de agilidad y potencia de fuego, personificando la precisión y elegancia del caza estelar Jedi. Diseñada para misiones extendidas, incluye un área de descanso compacta para un miembro de la tripulación, asegurando la preparación para compromisos prolongados.<string id='CommonStringModIDSWACD'/> \n\n<bad>Límite (1) por Nave</bad>"
	/* AI ENHANCED FROM "Cockpit from Eta-2 Actis Interceptor with front-mounted dual Laser Cannons." */


	//Crew Quarters Large -> Small
	BenchSW1x2 = "Sala de Asientos"
	BenchSW1x2Icon = "Sala de Asientos"
	BenchSW1x2Desc = "Proporciona asientos para 4 miembros de la tripulación. <string id='CommonStringModIDSWACD'/>"

	Smallbed = "Litera"
	SmallbedDesc = "Proporciona una cama para 1 miembro de la tripulación. <string id='CommonStringModIDSWACD'/>"


	//Durasteel Reinforced Reactors
	SW_TinyReactor = "Reactor Reforzado Compacto"
	SW_TinyReactorIcon = "Reactor Compacto"
	SW_TinyReactorDesc = "Reactor Reforzado Compacto de <cyan>Astilleros de Kuat</cyan>; Una unidad elegante, blindada con duracero, que ofrece alta eficiencia para naves estelares pequeñas a medianas. Su diseño prioriza la optimización del espacio, prescindiendo de modelos voluminosos y obsoletos. <string id='CommonStringModIDSWACD'/>"

	SW_SmallReactor = "Reactor Reforzado Ligero"
	SW_SmallReactorIcon = "Reactor Ligero"
	SW_SmallReactorDesc = "Reactor Reforzado Ligero de <cyan>Corporación de Ingeniería Corelliana</cyan>; Diseñado con refuerzo de duracero, este reactor combina eficiencia con un uso mínimo de espacio, ideal para cruceros medianos a grandes y fragatas que buscan soluciones de energía de última generación. <string id='CommonStringModIDSWACD'/>"

	SW_HeavyReactor = "Reactor Reforzado Pesado"
	SW_HeavyReactorIcon = "Reactor Pesado"
	SW_HeavyReactorDesc = "Reactor Reforzado Pesado de <cyan>Sistemas de Flota Sienar</cyan>; Una central eléctrica blindada con duracero, diseñada para destructores estelares grandes y naves insignia. Este reactor ejemplifica la eficiencia y el diseño compacto, dejando de lado modelos voluminosos y obsoletos. <string id='CommonStringModIDSWACD'/>"

	//Hypermatter Reactors
	HypermatterReactor12x12 = "Reactor de Hiperespacio Enorme"
	HypermatterReactor12x12Icon = "Reactor de Hiperespacio Enorme"
	HypermatterReactor12x12Desc = "Un reactor de hiperespacio para naves enormes. <string id='CommonStringModIDSWACD'/>"
	HypermatterReactor30x30 = "Reactor de Hiperespacio Colosal"
	HypermatterReactor30x30Icon = "Reactor de Hiperespacio Colosal"
	HypermatterReactor30x30Desc = "Un reactor de hiperespacio para naves masivas. <string id='CommonStringModIDSWACD'/>"

	//Hyperium Generators
	HypermatterReactor2x2 = "Reactor de Hiperespacio Ligero"
	HypermatterReactor2x2Icon = "Reactor de Hiperespacio Ligero"
	HypermatterReactor2x2Desc = "Un reactor de hiperespacio para naves pequeñas a medianas. <string id='CommonStringModIDSWACD'/>"

