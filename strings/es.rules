	Structure1x2_Round = "Estructura 1x2 Redonda"
	Structure1x2_RoundIcon = &Structure1x2_Round
	Structure1x2_RoundDesc = "El armazón estructural subyacente que mantiene unida a la nave.\nLa estructura se incluye automáticamente con todas las habitaciones y corredores.\n\n<color r='255' g='196' b='0'><b>Casco</b></color>\nPuntos de impacto: 1500\nResistencia a la Penetración: 0\nPeso (Toneladas): 0.5"

