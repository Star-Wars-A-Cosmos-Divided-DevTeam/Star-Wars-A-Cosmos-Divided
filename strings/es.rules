MissileTypes
{
	SW_Cluster = "<color r='255' g='69' b='0' a='255'>Misil de Racimo</color>"
	SW_Cluster_alt = "Cluster Missile"
	SW_ClusterDesc = "Misiles guiados de despliegue rápido que dispersan múltiples ojivas, cada una causando daños significativos en un área pequeña. \n\nInspirados en la capacidad de varias naves de ataque para disparar rápidamente estos misiles, son excelentes para romper las defensas enemigas concentradas."

	SW_Intruder = "<color r='30' g='144' b='255' a='255'>Misil Intruso</color>"
	SW_Intruder_alt = "Intruder Missile"
	SW_IntruderDesc = "Un misil guiado sofisticado diseñado para emitir un potente pulso electromagnético al impactar, apuntando específicamente a drenar energía de los sistemas enemigos. \n\nCreado por <cyan>Slayn &amp; Korpil</cyan> para la Alianza Rebelde, estos misiles se especializan en incapacitar grandes naves sobrecargando los generadores de escudos, provocando daños subsecuentes."

	SW_Concussion = "<color r='255' g='165' b='0' a='255'>Misil de Conmoción</color>"
	SW_Concussion_alt = "Concussion Missile"
	SW_ConcussionDesc = "Un misil de alto rendimiento y movimiento lento que produce una explosión devastadora, causando daños masivos en un área amplia. \n\nUn estándar en los arsenales militares, fabricado por <cyan>Dymek</cyan>, y utilizado en una variedad de roles, desde bombardeos planetarios hasta enfrentamientos contra naves capitales, demostrando versatilidad y poder."

	SW_HEX = "<color r='34' g='139' b='34' a='255'>Misil Hex</color>"
	SW_HEX_alt = "Hex Missile"
	SW_HEXDesc = "Armado con una carga mortal de trihexalon, estos misiles guiados son capaces de infligir daños y bajas catastróficas. \n\nPrimero desplegados en el ataque a Maramere, estos misiles encarnan el potencial aterrador de la guerra química en el espacio, convirtiéndolos en un arma temida en toda la galaxia."

	SW_Discord = "<color r='211' g='211' b='211' a='255'>Misil Discord</color>"
	SW_Discord_alt = "Discord Missile"
	SW_DiscordDesc = "Lanza misiles Discord \n\nLos misiles Discord detonan a corta distancia de su objetivo y liberan un enjambre de 5-7 Droides Zumbadores que devoran la armadura y los componentes esenciales de la nave enemiga. Los Droides Zumbadores pueden ser contrarrestados con torretas de defensa puntual.\n\n <gray>Usa partes de mina</gray>"
}

