	//Hyperdrives
	SmallHyperdrive = "Hiperimpulsor Pequeño"
	SmallHyperdriveDesc = "<orange>Requiere Droide Astromecánico</orange> \n\nUna unidad de hiperimpulsor ligero mejor adecuada para cazas pequeños y naves bombarderas. <string id='CommonStringModIDSWACD'/>"

	Navicomputer = "Computadora de Navegación"
	NavicomputerIcon = "Navicomputer"
	NavicomputerDesc = "<yellow>Desbloquea Hiperimpulsor Medio</yellow>\n\n<green>Incluye Sensores</green> \n\nUn ordenador de navegación, también conocido como navicomputadora, es un dispositivo que realiza los cálculos precisos necesarios para navegar a través del hiperespacio. <string id='CommonStringModIDSWACD'/>"

	MedHyperdrive = "Hiperimpulsor Mediano"
	MedHyperdriveDesc = "<orange>Requiere Computadora de Navegación</orange> \n\nUna unidad de hiperimpulsor de tamaño medio comúnmente encontrada en cargueros, naves estelares y otras naves pequeñas y medianas. <string id='CommonStringModIDSWACD'/>"

	HyperdriveNodeMed = "Nodo de Hiperimpulsor Mediano"
	HyperdriveNodeMedIcon = "Nodo de Hiperimpulsor (M)"
	HyperdriveNodeMedDesc = "<orange>Requiere Hiperimpulsor Mediano</orange> \n\nUn nodo utilizado para expandir la eficiencia de FTL para Hiperimpulsores Medianos. <string id='CommonStringModIDSWACD'/>"

	LargeHyperdrive = "Hiperimpulsor Grande"
	LargeHyperdriveDesc = "<orange>Requiere Cuarto de Guerra</orange> \n\nUn hiperimpulsor de gran tamaño comúnmente encontrado en destructores estelares y otras naves grandes. <string id='CommonStringModIDSWACD'/>"

	HyperdriveNode = "Nodo de Hiperimpulsor Grande"
	HyperdriveNodeIcon = "Nodo de Hiperimpulsor (L)"
	HyperdriveNodeDesc = "<orange>Requiere Hiperimpulsor Grande</orange> \n\nUn nodo utilizado para expandir la eficiencia de FTL para Hiperimpulsores Grandes. <string id='CommonStringModIDSWACD'/>"


	GravityWellProjector = "Gravity Well Projector"
	GravityWellProjectorIcon = "Gravity Well Projector"
	GravityWellProjectorDesc = "<orange>Requires Gravity Well Projector Control</orange> \n\nThe gravity well projector is used to interdict hyperspace travel, hence, forces ships out of hyperspace or prevent them from going to hyperspace. <string id='CommonStringModIDSWACD'/>"
	GravityWellProjectorControl = "Gravity Well Projector Control"
	GravityWellProjectorControlIcon = "Gravity Well Projector Control"
	GravityWellProjectorControlDesc = "<orange>Requires Command Bridge</orange> \n\nThe gravity well projector control is needed to control a gravity well projector(s). <string id='CommonStringModIDSWACD'/>"

	SuperIonEnergyCell = "Super Ion Energy Cell"
	SuperIonEnergyCellIcon = "Super Ion Energy Cell"
	SuperIonEnergyCellDesc = "Super Ion Energy Cell"

	SuperlaserCommand = "Death Star Superlaser Command"
	SuperlaserCommandIcon = "Superlaser Command"
	SuperlaserCommandDesc = "The DSS Command Room is required for the DSS. It must be placed behind all Superlaser Emitters and within 1000 tiles of the furthest emitter, and 500 tiles to the sides. Requires WarRoom. <string id='CommonStringModIDSWACD'/>"

	DSLaserTunnel = "Death Star Superlaser Tunnel"
	DSLaserTunnelIcon = "Superlaser Tunnel"
	DSLaserTunnelDesc = "DSS Tunnel, similar to railgun accelerator. Must be placed on top of the Superlaser Core. Requires Superlaser Command Room. <string id='CommonStringModIDSWACD'/>"
	DSLaserEmitter = "Death Star Superlaser Emitter"
	DSLaserEmitterIcon = "Superlaser Emitter"
	DSLaserEmitterDesc = "DSS Emitter, similar to railgun launcher. Must be placed on top of the Superlaser Tunnel. Requires Superlaser Command Room. <string id='CommonStringModIDSWACD'/>"
	DSLaserDirector = "Death Star Superlaser Director"
	DSLaserDirectorIcon = "Superlaser Director"
	DSLaserDirectorDesc = "DSS Director, directs and merges laser beam. Similar to ion prism. Must be in front of the rest of the components. <string id='CommonStringModIDSWACD'/>"
	DSLaserCore = "Death Star Superlaser Ignition Core"
	DSLaserCoreIcon = "Superlaser Ignition Core"
	DSLaserCoreDesc = "The DSS Core, similar to railgun loader. Requires Superlaser Command Room, WarRoom. <string id='CommonStringModIDSWACD'/>"
	DirectorConnector = "Death Star Superlaser Director Connector"
	DirectorConnectorIcon = "Superlaser Director Connector"
	DirectorConnectorDesc = "The director connector is used to connect with the Superlaser Director as replacement for unsightly structures. It will self destruct if it's not connected in a line with the director. Requires Superlaser Director. <string id='CommonStringModIDSWACD'/>"

	IonThrusterAccelerator5x10 = "Acelerador de propulsores iónicos Ligero (5x10)"
	IonThrusterAccelerator5x10Icon = "Acelerador Ión Lt"
	IonThrusterAccelerator5x10Desc = "<orange>Requiere Puente de Mando</orange>\n\nUn acelerador de propulsores iónicos para una construcción interna más eficiente. Proporciona <yellow>Energía</yellow> y un buff de <yellow>Velocidad</yellow> a los propulsores iónicos. Consulte el plano para el área de cobertura.<string id='CommonStringModIDSWACD'/>"
/*Switchable for use with different side and part sizes. Buff value depends on number of accelerators and thruster size.  Requires power. */
	IonThrusterAccelerator10x20 = "Acelerador de Propulsor Iónico (10x20)"
	IonThrusterAccelerator10x20Icon = "Acelerador Ión Hvy"
	IonThrusterAccelerator10x20Desc = "<orange>Requiere Puente de Mando</orange>\n\nUn Acelerador de Propulsor Iónico para una construcción interna más eficiente. Proporciona <yellow>Energía</yellow> y un aumento de <yellow>Velocidad</yellow> a los Propulsores Iónicos. Consulta el plano para ver el área de cobertura. <string id='CommonStringModIDSWACD'/>"
/*Switchable for use with different side and part sizes. Buff value depends on number of accelerators and thruster size.  Requires power. */


