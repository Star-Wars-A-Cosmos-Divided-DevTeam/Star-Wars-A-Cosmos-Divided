	ImperialProbeDroid = "Droide Sonda Viper"
	ImperialProbeDroidIcon = "Droide Sonda"
	ImperialProbeDroidDesc = "El Droide Sonda Viper, fabricado por <cyan>Industrias Arakyd</cyan>, es un droide autosuficiente que puede ser utilizado para exploración del espacio profundo y reconocimiento. <string id='CommonStringModIDSWACD'/>"

	R2Armor = "Droide Astromecánico"
	R2ArmorDesc = "<yellow>Desbloquea Hiperimpulsor Pequeño</yellow> \n\n<green>Incluye Sensores</green> \n\nMejora la navegación de la nave e incluye módulos de reparación para componentes adyacentes. \n\nFabricados por <cyan>Automatización Industrial</cyan>, los droides astromecánicos son esenciales para operaciones eficientes de naves estelares en toda la galaxia. <string id='CommonStringModIDSWACD'/>"
	/* AI ENHANCED FROM "Includes Sensors \n\nManufactured by Industrial Automaton, Astromech droids serve as an onboard navigation computer, increase your ships sensor range, and can repair damage to adjacent components." */
