	R2Armor2Icon = "R3-CD"
	R2Armor3Icon = "R2-Q3"
	R4Icon = "R4-A22"
	R5Icon = "R5-K6"


	//Structures
	Structure1x1_Round_Small = "Estructura 1x1 Redonda Pequeña"
	Structure1x1_Round_SmallIcon = &Structure1x1_Round_Small
	Structure1x1_Round_SmallDesc = "El armazón estructural subyacente que mantiene unida a la nave.\nLa estructura se incluye automáticamente con todas las habitaciones y corredores.\n\n<color r='255' g='196' b='0'><b>Casco</b></color>\nPuntos de impacto: 250\nResistencia a la Penetración: 0\nPeso (Toneladas): 0.1"

	Structure1x1_Round_Big = "Estructura 1x1 Redonda Grande"
	Structure1x1_Round_BigIcon = &Structure1x1_Round_Big
	Structure1x1_Round_BigDesc = "El armazón estructural subyacente que mantiene unida a la nave.\nLa estructura se incluye automáticamente con todas las habitaciones y corredores.\n\n<color r='255' g='196' b='0'><b>Casco</b></color>\nPuntos de impacto: 720\nResistencia a la Penetración: 0\nPeso (Toneladas): 0.24"

	Structure1x1_Triangle_ = "Estructura 1x1 Triángulo"
	Structure1x1_Triangle_Icon = &Structure1x1_Triangle_
	Structure1x1_Triangle_Desc = "El armazón estructural subyacente que mantiene unida a la nave.\nLa estructura se incluye automáticamente con todas las habitaciones y corredores.\n\n<color r='255' g='196' b='0'><b>Casco</b></color>\nPuntos de impacto: 250\nResistencia a la Penetración: 0\nPeso (Toneladas): 0.1"

	Structure1x1_Triangle_Big = "Estructura 1x1 Triángulo Grande"
	Structure1x1_Triangle_BigIcon = &Structure1x1_Triangle_Big
	Structure1x1_Triangle_BigDesc = "El armazón estructural subyacente que mantiene unida a la nave.\nLa estructura se incluye automáticamente con todas las habitaciones y corredores.\n\n<color r='255' g='196' b='0'><b>Casco</b></color>\nPuntos de impacto: 500\nResistencia a la Penetración: 0\nPeso (Toneladas): 0.16"

	Structure1x1_Round_Wedge = "Estructura 1x1 Cuña Redonda"
	Structure1x1_Round_WedgeIcon = &Structure1x1_Round_Wedge
	Structure1x1_Round_WedgeDesc = "El armazón estructural subyacente que mantiene unida a la nave.\nLa estructura se incluye automáticamente con todas las habitaciones y corredores.\n\n<color r='255' g='196' b='0'><b>Casco</b></color>\nPuntos de impacto: 800\nResistencia a la Penetración: 0\nPeso (Toneladas): 0.27"

	Structure1x3_Wedge = "Estructura 1x3 Cuña (L)"
	Structure1x3_WedgeIcon = &Structure1x3_Wedge
	Structure1x3_WedgeDesc = "El armazón estructural subyacente que mantiene unida a la nave.\nLa estructura se incluye automáticamente con todas las habitaciones y corredores.\n\n<color r='255' g='196' b='0'><b>Casco</b></color>\nPuntos de impacto: 1500\nResistencia a la Penetración: 0\nPeso (Toneladas): 0.5"

	Structure1x3_wedgeR = "Estructura 1x3 Cuña (R)"
