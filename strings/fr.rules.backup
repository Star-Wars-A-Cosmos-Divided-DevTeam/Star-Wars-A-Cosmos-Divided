	ImperialProbeDroid = "Droide sonde vipère"
	ImperialProbeDroidIcon = "Droide sonde"
	ImperialProbeDroidDesc = "Le droide sonde vipère, conçu par les <cyan>Industries Arakyd</cyan>, est un droide autonome pouvant être utilisé pour l'exploration et la reconnaissance dans l'espace profond."

	R2Armor = "Droide astromécano"
	R2ArmorDesc = "<yellow>Débloque l'hyperdrive petit</yellow> \n\n<green>Comprend des capteurs</green> \n\nAméliore la navigation du vaisseau et inclut des modules de réparation pour les composants adjacents. \n\nMFabriqués par <cyan>Industrial Automaton</cyan>, les droides astromécano sont essentiels au bon fonctionnement des vaisseaux spatiaux à travers la galaxie." 
	R2ArmorIcon = "R2-D2"
	R2Armor2Icon = "R3-CD"
	R2Armor3Icon = "R2-Q3"
	R4Icon = "R4-A22"
	R5Icon = "R5-K6"


	//Structures
	Structure1x1_RoundSmall = "Structure arrondie petite 1x1"
	Structure1x1_RoundSmallIcon = "Structure arrondie petite 1x1"
	Structure1x1_RoundSmallDesc = "L'ossature structurelle, véritable charpente du vaisseau.\nLa structure est automatiquement incluse dans toutes les salles et couloirs.\n\n<color r='255' g='196' b='0'><b>Coque</b></color>\nPoints de dégâts : 250\nRésistance à la pénétration : 0\nMasse (Tonnes) : 0.1"

	Structure1x1_RoundBig = "Structure arrondie grande 1x1"
	Structure1x1_RoundBigIcon = "Structure arrondie grande 1x1"
	Structure1x1_RoundBigDesc = "L'ossature structurelle, véritable charpente du vaisseau.\nLa structure est automatiquement incluse dans toutes les salles et couloirs.\n\n<color r='255' g='196' b='0'><b>Coque</b></color>\nPoints de dégâts : 720\nRésistance à la pénétration : 0\nMasse (Tonnes) : 0.24"

	Structure1x1_Triangle = "Structure triangulaire 1x1"
