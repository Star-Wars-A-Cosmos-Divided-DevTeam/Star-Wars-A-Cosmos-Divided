	//Hyperdrives
	SmallHyperdrive = "Hyperdrive petit"
	SmallHyperdriveDesc = "<orange>Nécessite un droide astromécano</orange> \n\nUne unité d'hyperpropulsion légère, mieux adaptée aux petits chasseurs et aux bombardiers.\n\n<bad>Limite de (16) par vaisseau</bad><string id='CommonStringModIDSWACD'/>"

	Navicomputer = "Ordinateur de navigation"
	NavicomputerIcon = "Ordinateur de navigation"
	NavicomputerDesc = "<yellow>Déverrouille l'hyperdrive moyen</yellow>\n\n<green>Comprend des capteurs</green> \n\nUn ordinateur de navigation est un appareil qui effectue les calculs précis nécessaires pour naviguer dans l'hyperespace.<string id='CommonStringModIDSWACD'/>"

	MedHyperdrive = "Hyperdrive moyen"
	MedHyperdriveDesc = "<orange>Nécessite un ordinateur de navigation</orange> \n\nUne unité d'hyperpropulsion de taille moyenne, couramment utilisée dans les cargos, vaisseaux stellaires et autres vaisseaux de petite et moyenne taille.\n\n<bad>Limite de (16) par vaisseau</bad><string id='CommonStringModIDSWACD'/>"

	HyperdriveNodeMed = "Noeud d'hyperdrive moyen"
	HyperdriveNodeMedIcon = "Noeud d'hyperdrive moyen (M)"
	HyperdriveNodeMedDesc = "<orange>Nécessite un hyperdrive moyen</orange> \n\nUn noeud utilisé pour améliorer les voyages en hyperespace des hyperdrives moyens.\n\n<bad>Limite de (8) par vaisseau</bad><string id='CommonStringModIDSWACD'/>"

	LargeHyperdrive = "Hyperdrive grand"
	LargeHyperdriveDesc = "<orange>Nécessite une salle de guerre</orange> \n\nUne unité d'hyperpropulsion de grande taille, couramment utilisée dans les destroyers stellaires et autres vaisseaux de grande envergure.\n\n<bad>Limite de (16) par vaisseau</bad><string id='CommonStringModIDSWACD'/>"

	HyperdriveNode = "Noeud d'hyperdrive grand"
	HyperdriveNodeIcon = "Noeud d'hyperdrive (G)"
	HyperdriveNodeDesc = "<orange>Nécessite un hyperdrive grand</orange> \n\nUn noeud utilisé pour améliorer les voyages en hyperespace des grands hyperdrives.<string id='CommonStringModIDSWACD'/>"


	GravityWellProjector = "Projecteur de puits gravitationnel"
	GravityWellProjectorIcon = "Projecteur de puits gravitationnel"
	GravityWellProjectorDesc = "<orange>Nécessite un contrôleur de projecteur de puits gravitationnel</orange> \n\nLe projecteur de puits gravitationnel est utilisé pour interdire les voyages en hyperespace ; il force ainsi les vaisseaux à sortir de l'hyperespace ou les empêche d'y entrer."
	GravityWellProjectorControl = "Contrôleur de projecteur de puits gravitationnel"
	GravityWellProjectorControlIcon = "Contrôleur de projecteur de puits gravitationnel"
	GravityWellProjectorControlDesc = "<orange>Nécessite un pont de commandement</orange> \n\nLe contrôle du projecteur de puits gravitationnel est nécessaire pour piloter un ou plusieurs projecteurs de puits gravitationnel."

	SuperIonEnergyCell = "Super cellule d'énergie ionique"
	SuperIonEnergyCellIcon = "Super cellule d'énergie ionique"
	SuperIonEnergyCellDesc = "Super cellule d'énergie ionique"

	SuperlaserCommand = "Salle de commande de superlaser de l'Étoile de la Mort"
	SuperlaserCommandIcon = "Salle de commande du superlaser"
	SuperlaserCommandDesc = "La salle de commande de superlaser de l'Étoile de la Mort est nécessaire pour le superlaser de l'Étoile de la Mort. Elle doit être placée derrière tous les émetteurs de superlaser, à moins de 1000 cases de l’émetteur le plus éloigné, et à 500 cases maximum sur les côtés. Nécessite une salle de guerre."

	DSLaserTunnel = "Tunnel de superlaser de l'Étoile de la Mort"
	DSLaserTunnelIcon = "Tunnel de superlaser"
	DSLaserTunnelDesc = "Le tunnel de superlaser, similaire à un accélérateur pour canon électromagnétique. Doit être placé au sommet du noyau du superlaser. Nécessite une salle de commande du superlaser."
	DSLaserEmitter = "Émetteur de superlaser de l'Étoile de la Mort"
	DSLaserEmitterIcon = "Émetteur de superlaser"
	DSLaserEmitterDesc = "L'émetteur de superlaser, similaire à un lanceur pour canon électromagnétique. Doit être placé au sommet du tunnel du superlaser. Nécessite une salle de commande du superlaser."
	DSLaserDirector = "Orienteur de superlaser de l'Étoile de la Mort"
	DSLaserDirectorIcon = "Orienteur de superlaser"
	DSLaserDirectorDesc = "L'orienteur de superlaser, guide et fusionne les faisceaux lasers. Similaire à un prisme ionique. Doit être placé devant les autres composants."
	DSLaserCore = "Coeur d’activation du superlaser de l’Étoile de la Mort"
	DSLaserCoreIcon = "Coeur d’activation du superlaser"
	DSLaserCoreDesc = "Le noyau de superlaser de l'Étoile de la Mort, similaire au chargeur pour canon électromagnétique. Nécessite une salle de commande du superlaser et une salle de guerre."
	DirectorConnector = "Connecteur de l'orienteur de superlaser de l'Étoile de la Mort"	
	DirectorConnectorIcon = "Connecteur de l'orienteur de superlaser"
	DirectorConnectorDesc = "Le connecteur de superlaser permet de relier le connecteur avec l'orienteur de façon esthétique. Il s'autodétruit s'il n'est pas correctement aligné avec l'orienteur. Nécessite un orienteur de superlaser."

	IonThrusterAccelerator5x10 = "Accélérateur de propulseur à ion léger (5x10)"
	IonThrusterAccelerator5x10Icon = "Accélérateur à ion léger"
	IonThrusterAccelerator5x10Desc = "<orange>Nécessite un pont de commandement</orange>\n\nUn accélérateur de propulseur à ion conçu pour une construction interne plus efficace. Fournit de l’<yellow>énergie</yellow> et un bonus de <yellow>vitesse</yellow> aux propulseurs à ion. Consultez le plan pour connaître la zone de couverture.<string id='CommonStringModIDSWACD'/>"
/* À fonctionnement modulable pour s’adapter à différentes tailles de côtés et de pièces. La valeur du bonus dépend du nombre d’accélérateurs et de la taille du propulseur. Nécessite de l’énergie. */
