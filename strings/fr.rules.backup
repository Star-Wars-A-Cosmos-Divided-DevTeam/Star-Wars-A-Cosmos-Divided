MissileTypes
{
	SW_Cluster = "<color r='255' g='69' b='0' a='255'>Missile à sous-munitions</color>"
	SW_Cluster_alt = "Missile à sous-munitions"
	SW_ClusterDesc = "Missiles guidés à déploiement rapide qui dispersent plusieurs ogives, chacune causant des dégâts significatifs sur une petite zone. \n\nConçus en s'inspirant de la capacité des chasseurs d'attaque à tirer rapidement des missiles, ils excellent à percer les défenses ennemies concentrées.\n\n <gray>Utilise des composants de missiles HE</gray>"

	SW_Intruder = "<color r='30' g='144' b='255' a='255'>Missile disrupteur</color>"
	SW_Intruder_alt = "Missile disrupteur"
	SW_IntruderDesc = "Un missile guidé sophistiqué conçu pour émettre une puissante impulsion électromagnétique à l'impact, ciblant spécifiquement et drainant l'énergie des systèmes ennemis. \n\nCréés par <cyan>Slayn et Korpil</cyan> pour l'Alliance Rebelle, ces missiles sont spécialisés dans l'immobilisation des grands vaisseaux en surchargeant les générateurs de boucliers, causant ainsi des dommages ultérieurs.\n\n <gray>Utilise des composants de missiles IEM</gray>"

	SW_Concussion = "<color r='255' g='165' b='0' a='255'>Missile à concussion</color>"
	SW_Concussion_alt = "Missile à concussion"
	SW_ConcussionDesc = "Un missile à haut rendement et à déplacement lent qui produit une explosion dévastatrice, causant des dégâts massifs sur une large zone. \n\nUn standard dans les arsenaux militaires, fabriqué par <cyan>Dymek</cyan>, et utilisé dans divers rôles, des bombardements planétaires aux engagements contre les vaisseaux capitaux, démontrant polyvalence et puissance.\n\n <gray>Utilise des composants de missiles HE</gray>"

	SW_HEX = "<color r='34' g='139' b='34' a='255'>Missile Hex</color>"
	SW_HEX_alt = "Missile Hex"
	SW_HEXDesc = "Armés d'une charge mortelle de trihexalon, ces missiles guidés sont capables d'infliger des dégâts et des pertes catastrophiques. \n\nDéployés pour la première fois lors de l'attaque sur Maramere, ces missiles incarnent le potentiel terrifiant de la guerre chimique dans l'espace, faisant d'eux une arme redoutée dans toute la galaxie.\n\n <gray>Utilise des composants d'ogives nucléaires</gray>"

	SW_Discord = "<color r='211' g='211' b='211' a='255'>Missile Discorde</color>"
	SW_Discord_alt = "Missile Discorde"
	SW_DiscordDesc = "Les missiles Discorde détonnent à courte distance de leur cible et libèrent un essaim de 5 à 7 vibro-droides qui dévorent l'armure et les composants essentiels du vaisseau ennemi. Les vibro-droides peuvent être contrés avec des tourelles de défense rapprochée.\n\n <gray>Utilise des composants de mines</gray>"
}

Tips
{
	SW_LauncherTypes
	{
		Title = "Types de lanceurs"
		Tip = "Vous pouvez changer à tout moment le type de missile ou de mine qu'un lanceur tire, y compris en pleine bataille. Utilisez cette fonction pour surprendre votre ennemi avec quelques missiles HEX inattendus !"
	}
	SW_LaserTypes
