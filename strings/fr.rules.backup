	DurasteelArmorStructureHybrid1x1 = "Blindage en duracier + structure en coin"
	DurasteelArmorStructureHybrid1x1Icon = "Bl. dur. + str.\nen coin"
	DurasteelArmorStructureHybrid1x1Desc = "Absorbe une grande quantité de tirs ennemis, protégeant les précieuses entrailles du vaisseau. Agit également comme un \"paratonnerre\" pour les effets IEM. \n\nLe blindage fabriqué en duracier est plus léger que le blindage traditionnel."

	DurasteelArmorStructureHybrid1x2 = "Blindage en duracier + structure en coin 1x2"
