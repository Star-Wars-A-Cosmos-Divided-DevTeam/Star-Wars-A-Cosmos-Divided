	//Factories
		FactoryDuraSteel = "Usine à duracier"
	FactoryDuraSteelIcon = "Duracier"
	FactoryDuraSteelDesc = "Fabrique des plaques de duracier servant à construire certains composants avancés de vaisseau. Consomme du carbone et du zersium. Toute usine adjacente (quel que soit son type) augmente de 25 % la vitesse de production.<string id='CommonStringModIDSWACD'/>"
	
	FactoryDoonium = "Usine à doonium"
	FactoryDooniumIcon = "Doonium"
	FactoryDooniumDesc = "Fabrique des plaques de doonium servant à construire certains composants avancés de vaisseau. Consomme du doonium. Toute usine adjacente (quel que soit son type) augmente de 25 % la vitesse de production.<string id='CommonStringModIDSWACD'/>"

	//Utilities
	SWMiningLaserHuge = "Laser de forage corellien XL"
	SWMiningLaserHugeIcon = "Corellien XL"
	SWMiningLaserHugeDesc = "Fabriqué par la <cyan>Corporation Technique Corellienne</cyan>, ce laser de forage XL émet deux rayons de précision améliorés par des cristaux kyber, capables de rapidement extraire des ressources des astéroïdes les plus résistants (notamment les astéroïdes de zersium et de doonium). Également efficaces pour exploiter des épaves, et en cas de coup dur, peuvent servir d'arme courte portée.<string id='CommonStringModIDSWACD'/>"

	SWResourceCollectorCompact = "Rayon manipulateur corellien EC"
	SWResourceCollectorCompactIcon = "Corellien EC"
	SWResourceCollectorCompactDesc = "Fabriqué par la <cyan>Corporation Technique Corellienne</cyan>, ce rayon manipulateur extra compact émet un rayon tracteur de précision automatique capable d'extraire rapidement des ressources sans avoir besoin de membre d'équipage. Également efficace pour exploiter des épaves, et en cas de coup dur, peut servir de rayon tracteur de faible force de traction.<string id='CommonStringModIDSWACD'/>"


	//Thrusters
	IonThruster01_1x1 = "Propulseur à ion 1x1"
	IonThruster01_1x1_Icon = "Propulseur à ion 1x1"
	IonThrusterDesc = "Ces propulseurs ioniques polyvalents sont conçus pour être modulables et compatibles avec une large gamme de classes de vaisseaux spatiaux, allant des petits chasseurs aux grands vaisseaux capitaux. Leur propulsion ionique efficace garantit des performances fiables dans toutes les applications. Réputés pour leur poussée constante et leur précision, ils excellent dans divers contextes opérationnels.<string id='CommonStringModIDSWACD'/>"
	IonThruster01_1x2 = "Propulseur à ion 1x2"
	IonThruster01_1x2_Icon = "Propulseur à ion 1x2"
	IonThruster01_1x2_Desc = "Ces propulseurs ioniques polyvalents sont conçus pour être modulables et compatibles avec une large gamme de classes de vaisseaux spatiaux, allant des petits chasseurs aux grands vaisseaux capitaux. Leur propulsion ionique efficace garantit des performances fiables dans toutes les applications. Réputés pour leur poussée constante et leur précision, ils excellent dans divers contextes opérationnels."

	IonThruster01_2x2 = "Propulseur à ion 2x2"
	IonThruster01_2x2_Icon = "Propulseur à ion 2x2"
	IonThruster01_2x2_Desc = "Ces propulseurs ioniques polyvalents sont conçus pour être modulables et compatibles avec une large gamme de classes de vaisseaux spatiaux, allant des petits chasseurs aux grands vaisseaux capitaux. Leur propulsion ionique efficace garantit des performances fiables dans toutes les applications. Réputés pour leur poussée constante et leur précision, ils excellent dans divers contextes opérationnels."

	IonThruster01_2x3 = "Propulseur à ion 2x3 \"Boost\""
	IonThruster01_2x3_Icon = "Propulseur \"Boost\" 2x3"
	IonThruster01_2x3_Desc = "Une variante du propulseur à ion 2x2, ce modèle peut injecter de l'hypermatière brute directement dans sa chambre d'ionisation pour un boost puissant mais éphémère. La livraison de puissance est suspendue pendant le boost, concentrant toutes les ressources sur la poussée d'accélération.<string id='CommonStringModIDSWACD'/>"

	IonThruster01_3x3 = "Propulseur à ion 3x3"
	IonThruster01_3x3_Icon = "Propulseur à ion 3x3"
	IonThruster01_3x3_Desc = "Ces propulseurs ioniques polyvalents sont conçus pour être modulables et compatibles avec une large gamme de classes de vaisseaux spatiaux, allant des petits chasseurs aux grands vaisseaux capitaux. Leur propulsion ionique efficace garantit des performances fiables dans toutes les applications. Réputés pour leur poussée constante et leur précision, ils excellent dans divers contextes opérationnels."

	IonThruster01_3x4 = "Propulseur à ion 3x4 \"Cargo\""
	IonThruster01_3x4_Icon = "Propulseur à ion \"Cargo\" 3x4"
	IonThruster01_3x4_Desc = "Amélioré par les renommés <cyan>Chantiers Navals de Kuat</cyan>, le propulseur à ion \"Cargo\" 3x4 s'appuie sur les fondations établies par son prédécesseur, le modèle 3x3. Tout en conservant les caractéristiques de scalabilité et de compatibilité à travers différentes classes de vaisseaux spatiaux, ce modèle offre une durabilité améliorée et une vitesse nettement accrue pour des voyages prolongés et sans interruption à travers le cosmos. Son système de propulsion ionique sophistiqué promet non seulement une performance fiable, mais également une poussée et une précision supérieures lors des opérations de longue distance.<string id='CommonStringModIDSWACD'/>"

	IonThruster01_7x10 = "Propulseur à ion 7x10"
	IonThruster01_7x10_Icon = "Propulseur à ion 7x10"
	IonThrusterBigDesc = "<orange>Nécessite un pont de commandement</orange>\n\nLes <cyan>Chantiers Navals de Kuat</cyan> ont conçu spécialement pour les plus grands vaisseaux capitaux, ces propulseurs ioniques. Ils offrent une propulsion efficace garantissant des performances fiables dans de multiples applications. Réputés pour leur poussée constante et leur précision, ils excellent dans divers contextes opérationnels.<string id='CommonStringModIDSWACD'/>"

	IonThruster01_8x16 = "Propulseur à ion 8x16"
	IonThruster01_8x16_Icon = "Propulseur à ion 8x16"
	IonThruster01_8x16_Desc = "<orange>Nécessite un pont de commandement</orange>\n\nLes <cyan>Chantiers Navals de Kuat</cyan> ont conçu spécialement pour les plus grands vaisseaux capitaux, ces propulseurs ioniques. Ils offrent une propulsion efficace garantissant des performances fiables dans de multiples applications. Réputés pour leur poussée constante et leur précision, ils excellent dans divers contextes opérationnels.<string id='CommonStringModIDSWACD'/>"

	IonThruster01_10x14 = "Propulseur à ion 10x14"
	IonThruster01_10x14_Icon = "Propulseur à ion 10x14"
	IonThruster01_10x14_Desc = "<orange>Nécessite un pont de commandement</orange>\n\nLes <cyan>Chantiers Navals de Kuat</cyan> ont conçu spécialement pour les plus grands vaisseaux capitaux, ces propulseurs ioniques. Ils offrent une propulsion efficace garantissant des performances fiables dans de multiples applications. Réputés pour leur poussée constante et leur précision, ils excellent dans divers contextes opérationnels.<string id='CommonStringModIDSWACD'/>"

	IonThruster01_20x26 = "Propulseur à ion 20x26 \"Capital\""
	IonThruster01_20x26_Icon = "Propulseur à ion 20x26"
	IonThruster01_20x26_Desc = "<orange>Nécessite un pont de commandement, une salle de guerre, et un grand hyperdrive</orange>\n\nLes <cyan>Chantiers Navals de Kuat</cyan> ont conçu spécialement pour les plus grands vaisseaux capitaux, ces propulseurs ioniques. Ils offrent une propulsion efficace garantissant des performances fiables dans de multiples applications. Réputés pour leur poussée constante et leur précision, ils excellent dans divers contextes opérationnels.<string id='CommonStringModIDSWACD'/>"

	rcs = "Propulseur directionnel"
	rcsIcon = "Propulseur directionnel"
	rcsDesc = "Fabriqué par les <cyan>Industries Arakyd</cyan>, le propulseur directionnel offre une maniabilité précise pour une grande variété de vaisseaux stellaires appartenant à différentes factions. Bien qu'il ne fournisse qu'une force modeste, il est essentiel pour ajuster finement l'orientation d'un vaisseau et réaliser des manœuvres délicates dans l'immensité de l'espace. \n\nPlébiscité par les ingénieurs de la République, les pilotes de l'Alliance Rebelle et même les tacticiens de l’Empire, sa fiabilité et sa précision en font un incontournable des vaisseaux de combat comme d'exploration.<string id='CommonStringModIDSWACD'/>"

	XWingThrusterSingle = "Propulseur de X-Wing (Seul)"
	XWingThrusterSingleIcon = "Propulseur de X-Wing (Seul)"
	XWingThrusterSingleDesc = "Dérivé du célèbre X-Wing T-65, ce propulseur unique offre une maniabilité et une vitesse accrues pour un seul côté d'un vaisseau. Son moteur compact mais puissant est parfait pour effectuer des virages agiles et des accélérations rapides, ce qui en fait un choix idéal pour les chasseurs et les petits appareils nécessitant une poussée asymétrique.\n\n<bad>Limite de (2) par vaisseau</bad><string id='CommonStringModIDSWACD'/>" 

	XWingThrusterDual = "Propulseur de X-Wing (Double)"
	XWingThrusterDualIcon = "Propulseur de X-Wing (Double)"
	XWingThrusterDualDesc = "Ce propulseur double, inspiré du légendaire X-Wing T-65, offre une propulsion équilibrée et robuste pour une grande variété de vaisseaux spatiaux. Grâce à une puissance et un contrôle synchronisés, il est idéal pour atteindre une vitesse et une stabilité supérieures, en particulier pour les vaisseaux de taille moyenne et les chasseurs nécessitant des capacités de poussée symétrique.\n\n<bad>Limite de (1) par vaisseau</bad><string id='CommonStringModIDSWACD'/>"

	//Turret Weapons Large -> Small
	SiegeTurbolaser12x12 = "Turbolaser de siège superlourd 70TT à canon double"
	SiegeTurbolaser12x12Icon = "Turbolaser 70TT-DC"
	SiegeTurbolaser12x12Desc = "<orange>Nécessite une salle de guerre</orange> \n\nLe turbolaser de siège superlourd 70TT à double canon, aussi connu sous le nom de 'Tourelle de siège', est une arme de guerre formidable. Conçu pour les sièges, le turbolaser envoie des tirs lasers explosifs dans un arc de tir limité, réduisant à néant les fortifications ennemies et les vaisseaux capitaux. Bien que disposant d'une cadence de tir et une vitesse faible, la puissance de destruction de la tourelle en fait un atout crucial pour percer les défenses les plus solides.<string id='CommonStringModIDSWACD'/>"

	TurbolaserHuge01 = "Turbolaser Teraton lourd (canon simple)"
	TurbolaserHuge01Icon = "Turbolaser TL-CS"
	TurbolaserHuge01Desc = "<orange>Nécessite une salle de guerre</orange> \n\nCe turbolaser à canon simple lourd tire des rafales de lasers pour une haute pénétration et des dégâts explosifs. Il offre une cadence de tir et une rotation plus rapides par rapport aux versions à double et triple canons. \n\nNotable pour son utilisation sur les destroyers stellaires de classe Venator.<string id='CommonStringModIDSWACD'/>"

	TurbolaserHuge02 = "Turbolaser Teraton lourd (canon double)"
	TurbolaserHuge02Icon = "Turbolaser TL-CD"
	TurbolaserHuge02Desc = "<orange>Nécessite une salle de guerre</orange> \n\nCe turbolaser à canon double lourd tire des rafales de lasers pour une haute pénétration et des dégâts explosifs. Il offre une cadence de tir et une vitesse moins rapides que la version à canon simple, mais plus rapides que la version à canons triples. \n\nNotable pour son utilisation sur les destroyers stellaires de classe Venator.<string id='CommonStringModIDSWACD'/>"

	TurbolaserHuge03 = "Turbolaser Teraton lourd (canon triple)"
	TurbolaserHuge03Icon = "Turbolaser TL-CT"
	TurbolaserHuge03Desc = "<orange>Nécessite une salle de guerre</orange> \n\nCe turbolaser à canon double lourd tire des rafales de lasers pour une haute pénétration et des dégâts explosifs. Il offre une cadence de tir et une vitesse moins rapides par rapport aux versions à simple et double canons. \n\nNotable pour son utilisation sur les destroyers stellaires de classe Venator.<string id='CommonStringModIDSWACD'/>"

	OctupleBarbetteTurbolaser = "Turbolaser à huit canons monté sur plateforme"
	OctupleBarbetteTurbolaserIcon = "Turbolaser à huit canons monté sur plateforme"
	OctupleBarbetteTurbolaserDesc =  "<orange>Nécessite un pont de commandement</orange> \n\nUne imposante tourelle de turbolaser à huit canons montée sur plateforme, symbole de la puissance impériale. Dotée de huit canons lourds capables de délivrer des tirs de barrage dévastateurs. Particulièrement efficace contre les vaisseaux capitaux et les fortifications, mais moins performante contre les chasseurs agiles. Véritable pièce maîtresse de l'arsenal offensif de la flotte impériale.<string id='CommonStringModIDSWACD'/>"

	QuadBarbetteTurbolaser = "Turbolaser à quatre canons monté sur plateforme"
	QuadBarbetteTurbolaserIcon = "Turbolaser à quatre canons monté sur plateforme"
	QuadBarbetteTurbolaserDesc = "<orange>Nécessite un pont de commandement</orange> \n\nUne formidable tourelle de turbolaser à quatre canons montée sur plateforme, combinant quatre canons pour une frappe concentrée et puissante. Idéale pour les engagements à moyenne portée contre des vaisseaux capitaux et de taille intermédiaire. Elle combine puissance de feu et cadence de tir pour une utilisation polyvalente dans divers scénarios de combat.<string id='CommonStringModIDSWACD'/>" 

	MediumTurbolaserQuadswitchable = "Turbolaser à quatre canons lourd"
	MediumTurbolaserQuadswitchableIcon = "Turbolaser à quatre canons lourd"
	MediumTurbolaserQuadswitchableDesc = "Le turbolaser à quatre canons lourd est polyvalent, <orange>à fonctionnement modulable</orange> est une tourelle offrant un équilibre entre de lourds dégâts et une grande précision, avec une cadence de tir modérée, ce qui la rend adaptée à une variété de cibles. Un excellent choix pour les commandants recherchant de la flexibilité dans leur armement.<string id='CommonStringModIDSWACD'/>"

	CISturbolaserswitchable = "Turbolaser lourd de la CSI"
	CISturbolaserswitchableIcon = "Turbolaser lourd de la CSI"
	CISturbolaserswitchableDesc = "<orange>Nécessite un pont de commandement</orange> \n\nLa grande tourelle à double canon, lente à manœuvrer, inflige d'importants dégâts de zone et dispose d'une forte capacité de pénétration, au prix toutefois d'une précision et d'une cadence de tir réduites. Elle est efficace contre les grands vaisseaux, mais moins contre les cibles rapides, équilibrant sa puissance de feu entre blindage et boucliers. \n\nElle est notamment célèbre pour son déploiement sur les cuirassés de classe Lucrehulk de <cyan>Hoersch-Kessel Drive, Inc</cyan>.<string id='CommonStringModIDSWACD'/>" 

	Imperialturbolaserswitchable = "Turbolaser lourd impérial"
	ImperialturbolaserswitchableIcon = "Turbolaser lourd impérial"
	ImperialturbolaserswitchableDesc = "<orange>Nécessite un pont de commandement</orange> \n\nGrande tourelle turbolaser à double canon, lente à manœuvrer, infligeant d'importants dégâts de zone et une forte pénétration, au détriment de la précision et de la cadence de tir. Idéale pour cibler les grands vaisseaux, mais peu efficace contre les cibles rapides. Ce turbolaser inflige davantage de dégâts au blindage, au détriment des dégâts contre les boucliers.<string id='CommonStringModIDSWACD'/>"

	Republicturbolaserswitchable = "Turbolaser lourd DBY-827 de la République"
	RepublicturbolaserswitchableIcon = "Turbolaser lourd de la République"
	RepublicturbolaserswitchableDesc = "<orange>Nécessite un pont de commandement</orange> \n\nGrande tourelle de turbolaser à double canon, lente, infligeant d'importants dégâts de zone et bénéficiant d'une grande capacité de pénétration, au détriment de la précision et de la cadence de tir. Idéale pour cibler de grands vaisseaux, mais peu efficace contre des cibles rapides. Ce turbolaser inflige davantage de dégâts aux boucliers, au prix d'une efficacité réduite contre le blindage. \n\nNotable pour son utilisation sur les destroyers stellaires de classe Venator.<string id='CommonStringModIDSWACD'/>"

	HeavyIonCannon = "Canon à ion lourd"
	HeavyIonCannonIcon = "Canon à ion lourd"
	HeavyIonCannonDesc = "<orange>Nécessite un pont de commandement</orange> \n\nUne formidable tourelle à double canon à ion, réputée pour neutraliser les boucliers ennemis tout en causant peu de dégâts à la coque. Essentielle lors des affrontements stratégiques, elle peut influencer de manière décisive l’issue d’une bataille. \n\nNotable pour son utilisation sur les destroyers stellaires de classe Interdictor, où elle joue un rôle crucial dans les batailles de flotte en affaiblissant les défenses ennemies.<string id='CommonStringModIDSWACD'/>"	

	Heavyturbolaserswitchable = "Turbolaser lourd"
	HeavyturbolaserswitchableIcon = "Turbolaser lourd"
	HeavyturbolaserswitchableDesc = "Grande tourelle de turbolaser <orange>à fonctionnement modulable</orange> à double canon, lente, infligeant des dégâts considérables et possédant une forte capacité de pénétration, au détriment de la précision et de la cadence de tir. Optimisée pour engager des cibles grandes, stationnaires ou lentes, mais moins efficace contre des adversaires agiles et rapides. \n\nNotable pour son utilisation sur les destroyers stellaires de classe Imperial I.<string id='CommonStringModIDSWACD'/>"

	XX9turbolaserswitchable = "Batterie turbolaser XX-9"
	XX9turbolaserswitchableIcon = "Batterie turbolaser"
	XX9turbolaserswitchableDesc = "L’emblématique tourelle de turbolaser XX-9, rendue célèbre par la légendaire scène de l’attaque de la tranchée, allie accessibilité et polyvalence. Ce modèle <orange>à fonctionnement modulable</orange> permet un passage rapide entre différents modes de combat, ce qui en fait un choix populaire parmi de nombreuses classes de vaisseaux. Réputée pour sa fiabilité et son excellent rapport qualité-prix, la XX-9 demeure un pilier des arsenaux à travers la galaxie, incarnant un équilibre parfait entre héritage historique et efficacité pratique sur le champ de bataille.<string id='CommonStringModIDSWACD'/>"

	TripleTurbolaser = "Triple turbolaser"
	TripleTurbolaserIcon = "Triple turbolaser"
	TripleTurbolaserDesc = "Une tourelle compacte mais puissante de triple turbolaser <orange>à fonctionnement modulable</orange>. Légèrement plus petite que les turbolasers lourds standards mais nettement plus robuste que les modèles de turbolasers légers, cette tourelle à trois canons offre un équilibre idéal entre puissance de feu et agilité. Sa fonction commutable permet une flexibilité tactique dans divers scénarios de combat, en faisant un choix polyvalent pour les vaisseaux cherchant un compromis entre encombrement et efficacité au combat.<string id='CommonStringModIDSWACD'/>"

	TurbolaserMedLR01 = "Turbolaser moyen à longue portée"
	TurbolaserMedLR01Icon = "Turbolaser longue portée"
	TurbolaserMedLR01Desc = "Le turbolaser moyen à longue portée, reconnaissable à sa tourelle à canon unique <orange>à fonctionnement modulable</orange>, est optimisé pour les engagements à longue distance. Malgré sa taille compacte, comparable à celle des modèles de turbolasers légers, il bénéficie d'une portée de tir étendue et d'une cadence de tir rapide. Ce turbolaser excelle dans l'engagement de cibles ennemies à grande distance, en délivrant une puissance de feu précise et soutenue. \n\nIl est couramment déployé sur des vaisseaux de patrouille et de reconnaissance tels que les croiseurs légers de classe Carrack et les canonnières corelliennes, où il est indispensable pour les capacités d'engagement à longue portée.<string id='CommonStringModIDSWACD'/>"

	Medturbolaserswitchable = "Turbolaser moyen"
	MedturbolaserswitchableIcon = "Turbolaser moyen"
	MedturbolaserswitchableDesc = "Cette tourelle de turbolaser <orange>à fonctionnement modulable</orange> est une version plus agile par rapport à la tourelle de turbolaser lourde classique. Elle offre un bon compromis entre la puissance des versions plus lourdes et la précision des versions plus légères. Elle est conçue pour les vaisseaux qui nécessitent de la polyvalence sans sacrifier trop de puissance de feu. \n\nSon adaptabilité en fait un équipement courant sur une grande variété de vaisseaux, allant des élégantes frégates Nebulon-B aux imposants croiseurs Mon Calamari, où sa capacité à changer rapidement de mode de tir est particulièrement appréciée.<string id='CommonStringModIDSWACD'/>"

	MediumIonCannon = "Turbolaser à ion moyen"
	MediumIonCannonIcon = "Turbolaser à ion moyen"
	MediumIonCannonDesc = "Le turbolaser à ion moyen, un outil stratégique dans l'arsenal de toute flotte, est spécialisé dans la neutralisation des boucliers ennemis tout en infligeant des dégâts minimes à la coque. Ses salves ionisées sont conçues pour perturber les systèmes électroniques, ce qui en fait un choix idéal de tourelle pour neutraliser les défenses ennemies sans détruire le vaisseau. \n\nFréquemment installé sur les frégates Nebulon-B et les corvettes corelliennes,  ce canon joue un rôle crucial en désactivant les vaisseaux ennemis, permettant ainsi leur capture ou les rendant vulnérables à des attaques ultérieures.<string id='CommonStringModIDSWACD'/>"

	LightTurbolaserswitchable = "Turbolaser léger"
	LightTurbolaserswitchableIcon = "Turbolaser léger"
	LightTurbolaserswitchableDesc = "Compacte et à tir rapide, cette tourelle de turbolaser léger <orange>à fonctionnement modulable</orange> allie polyvalence et précision. Idéale pour combattre des chasseurs rapides, elle possède également une puissance suffisante pour engager des vaisseaux capitaux. \n\nNotable pour sa cadence de tir élevée et sa grande précision, ce turbolaser est issu de l'ingénierie innovante de <cyan>Taim et Bak</cyan>. C'est un choix populaire pour les vaisseaux agiles comme les corvettes CR90 de la <cyan>Corporation Technique Corellienne</cyan>, offrant un équilibre entre puissance de feu et rapidité.<string id='CommonStringModIDSWACD'/>"

	DualLaserCannonSwitchable = "Canon laser double"
	DualLaserCannonSwitchableIcon = "Canon laser double"
	DualLaserCannonSwitchableDesc = "Cette tourelle à canon laser double <orange>à fonctionnement modulable</orange> est conçue pour des engagements rapides et une haute précision. Son design épuré permet une cadence de tir rapide, la rendant particulièrement efficace contre les chasseurs ennemis agiles. \n\nAvec une portée réduite mais une fréquence de tir accrue, elle excelle dans les combats rapprochés. On la retrouve fréquemment montée sur des vaisseaux de patrouille et d'escorte, comme les corvettes modifiées des <cyan>Industries BlasTech</cyan> , où la réactivité rapide et la suppression des chasseurs sont essentielles.<string id='CommonStringModIDSWACD'/>"

	FalconLaserCannon = "Quadruple canon laser AG-2G"
	FalconLaserCannonIcon = "Quadruple canon laser AG-2G"
	FalconLaserCannonDesc = "Le quadruple canon laser AG-2G, réputé pour sa cadence de tir élevée et sa puissance de feu redoutable, est la tourelle idéale pour des engagements rapides contre les chasseurs stellaires. \n\nNotamment installé sur l'emblématique Faucon Millenium de la <cyan>Corporation Technique Corellienne</cyan> ainsi que sur les frégates de classe Lancer de l'Empire, ce canon est un véritable symbole de polyvalence et d'efficacité en situation de combat.<string id='CommonStringModIDSWACD'/>"

	TurbolaserLightPD4 = "Turbolaser léger de défense rapprochée de classe Sentinel"
	TurbolaserLightPD4Icon = "Turbolaser L-DR"
	TurbolaserLightPD4Desc = "Ce turbolaser de défense rapprochée avancé et léger est particulièrement efficace pour intercepter et neutraliser les <orange>tirs lasers et tirs ioniques</orange>, une capacité rare parmi les tourelles de défense rapprochée. Optimisé pour cibler une grande variété de types de projectiles, sa capacité spécialisée à neutraliser les tirs ioniques est essentielle pour contrer les tactiques de guerre électronique. \n\nIl est notamment déployé sur le destroyer stellaire de classe Imperial II.<string id='CommonStringModIDSWACD'/>"

	TurbolaserTiny01 = "Turbolaser compact - rafale" // "Turbolaser de défense rapprochée 1"
	TurbolaserTiny01Icon = "TL-C rafale" // "Turbolaser compact 1"
	TurbolaserTiny01Desc = "Petite mais puissante, la tourelle turbolaser compact à rafale est spécialisée dans les dégâts en rafale, idéale pour neutraliser rapidement les menaces de petite taille. Il s'agit d'un canon laser <orange>à fonctionnement modulable</orange>, opéré par un membre d'équipage.<string id='CommonStringModIDSWACD'/>" // "Peut être modulé pour défendre contre les projectiles ou attaquer les vaisseaux ennemis"

	TurbolaserTiny02 = "Turbolaser compact - lourd" // "Turbolaser de défense rapprochée 2"
	TurbolaserTiny02Icon = "TL-C lourd" // "Turbolaser compact 2"
	TurbolaserTiny02Desc = "Une tourelle minuscule mais robuste, le turbolaser compact lourd est conçu pour avoir une grande durabilité et une puissance de feu soutenue, ce qui le rend efficace contre une large gamme de cibles. C'est un canon laser <orange>à fonctionnement modulable</orange>, opéré par un membre d'équipage.<string id='CommonStringModIDSWACD'/>" // "Peut être modulé pour défendre contre les projectiles ou attaquer les vaisseaux ennemis"

	TurbolaserTiny03 = "Turbolaser compact - rapide" // "Turbolaser de défense rapprochée hybride"
	TurbolaserTiny03Icon = "TL-C rapide" // "Turbolaser compact 3"
	TurbolaserTiny03Desc = "Combinant le meilleur des deux mondes, le turbolaser compact rapide offre une approche équilibrée entre les dégâts en rafale et la durabilité au combat. C'est un canon laser <orange>à fonctionnement modulable</orange>, opéré par un membre d'équipage.<string id='CommonStringModIDSWACD'/>" // "Peut être modulé pour défendre contre les projectiles ou attaquer les vaisseaux ennemis"

	SmallLaserCannonSwitchable = "Canon laser compact monté sur toit"
	SmallLaserCannonSwitchableIcon = "Laser compact monté sur toit"
	SmallLaserCannonSwitchableDesc = "Le canon laser compact monté sur toit <orange>à fonctionnement modulable</orange> offre polyvalence et compacité, idéal pour les chasseurs lourds et les vaisseaux légers. Sa conception privilégie l'agilité en combat, sacrifiant la durabilité au profit d'une taille réduite et d'une maniabilité accrue. \n\nL'adaptabilité de ce modèle en fait un choix populaire pour les chasseurs stellaires personnalisés et les vaisseaux de patrouille, où la flexibilité en combat est primordiale. Il est notamment utilisé sur divers vaisseaux modifiés nécessitant un équilibre entre vitesse et puissance de feu.<string id='CommonStringModIDSWACD'/>"

	//Fixed & Directional Weapons Large -> Small
	TurbolaserFlakCannon01 = "Canon de pont anti-projectiles lourd"
	TurbolaserFlakCannon01Icon = "Canon anti-projectiles lourd"
	TurbolaserFlakCannon01Desc = "<orange>Nécessite un pont de commandement</orange> \n\nConçu pour la défense, le canon de pont anti-projectiles lourd excelle dans l'interception et la neutralisation d'une large gamme de menaces, notamment les <orange>balles, tirs ioniques, lasers, mines et missiles</orange>. Sa conception permet une intégration derrière une seule couche de blindage, renforçant ainsi les capacités de défense stratégique. \n\nBien qu'il ne soit pas standard sur aucune classe de vaisseau, il est un ajout très prisé sur le marché secondaire parmi les commandants souhaitant renforcer leurs défenses contre les menaces de missiles, particulièrement dans les secteurs riches en ressources où la protection avancée est prioritaire.<string id='CommonStringModIDSWACD'/>"

	TurbolaserCarronade = "Turbolaser de type caronade"
	TurbolaserCarronadeIcon = "Turbolaser caronade"
	TurbolaserCarronadeDesc = "Le turbolaser de type caronade, une tourelle turbolaser de pont à haute puissance <orange>à fonctionnement modulable</orange>, excelle dans les assauts de flanc et les bombardements de flotte. Son design unique permet une installation derrière le blindage, augmentant ainsi l'efficacité lors des combats entre vaisseaux. \n\nAppréciée pour sa polyvalence, cette caronade n'est standard sur aucun vaisseau, cette caronade est fréquemment montée sur des corvettes CR90 modifiées par des flottes privées et des groupes paramilitaires afin de renforcer leur capacité de feu.<string id='CommonStringModIDSWACD'/>"

	FixedHeavyLaser = "Canon laser lourd"
	FixedHeavyLaserIcon = "Canon laser lourd"
	FixedHeavyLaserDesc = "Le canon laser lourd, arme redoutable alliant précision et puissance, est conçu pour des frappes directes et percutantes. Malgré sa position fixe, il dispose d'un arc de tir limité mais efficace, permettant de concentrer le feu sur des cibles ennemies. Ce canon est réputé pour sa capacité à infliger des frappes dévastatrices, capable de détruire sans difficulté des croiseurs moyens à grands ainsi que des chasseurs stellaires. \n\nNotamment utilisé sur le destroyer stellaire de classe Victory, il illustre la capacité dévastatrice des frappes précises en combat spatial.<string id='CommonStringModIDSWACD'/>"

	FixedMediumLaser = "Canon laser moyen"
	FixedMediumLaserIcon = "Canon laser moyen"
	FixedMediumLaserDesc = "Le canon laser moyen offre un équilibre parfait entre puissance et précision. Bien que plus petit que son homologue lourd, il reste redoutable, capable de détruire des croiseurs légers et des chasseurs stellaires. Sa fixation fixe garantit une plateforme de tir stable et fiable, avec un arc de tir modeste permettant des attaques ciblées contre les vaisseaux ennemis. \n\notamment utilisé sur le croiseur lourd Dreadnought, this laser cannon represents a critical component in the arsenal of medium-sized capital ships.<string id='CommonStringModIDSWACD'/>"

	Smallpointlaser = "Canon laser petit"
	SmallpointlaserIcon = "Canon laser petit"
	SmallpointlaserDesc = "Le petit canon laser <orange>à fonctionnement modulable</orange> est une arme compacte mais redoutable, conçue pour des engagements rapides contre les chasseurs et les petits vaisseaux. Malgré sa taille réduite, il inflige efficacement des dégâts et, utilisé en groupe, il représente une menace crédible pour des vaisseaux plus imposants comme les frégates et les croiseurs. Sa polyvalence et sa puissance en font un outil courant et indispensable dans les combats spatiaux. \n\nParticulièrement connu pour son intégration sur le cargo léger YT-1300, ce canon laser est un élément clé de l’arsenal défensif de nombreux vaisseaux polyvalents à travers la galaxie.<string id='CommonStringModIDSWACD'/>"

	FixedLaser = "Canon laser KX9"
	FixedLaserIcon = "Canon laser KX9"
	FixedLaserDesc = "Arme emblématique, le canon laser KX9 <orange>à fonctionnement modulable</orange> de X-Wing offre une puissance de feu énergétique fiable et précise. Ce canon laser combine habilement dégâts et précision, ce qui le rend idéal pour les combats aériens rapprochés et les frappes ciblées contre les vaisseaux ennemis. Sa conception fixe garantit des performances constantes, sans nécessiter de configurations supplémentaires. \n\nCélèbre pour son déploiement sur les emblématiques chasseurs stellaires T-65 X-Wing, il a été conçu par <cyan>Taim et Bak</cyan>.<string id='CommonStringModIDSWACD'/>"

	FixedLaserL = "Canon laser KX9"
	FixedLaserR = "Canon laser KX9<string id='CommonStringModIDSWACD'/>"

	AWFixedLaserL = "Canon laser RG-9"
	AWFixedLaserLIcon = "Canon laser RG-9" // "Canon laser gauche de A-Wing"
	AWFixedLaserLDesc = "Le canon laser RG-9 <orange>à fonctionnement modulable</orange> par <cyan>Borstel</cyan> est une pièce maîtresse dans l’arsenal du chasseur stellaire A-Wing RZ-1, il se distingue par sa capacité à infliger d’importants dégâts à la coque grâce à sa cadence de tir élevée. Son designest spécialement conçu pour favoriser l’agilité et la précision, en parfaite adéquation avec le style de combat rapide de l’A-Wing. Ce canon laser allie une puissance de feu redoutable à une vitesse de tir fulgurante, le rendant idéal pour les combats spatiaux intenses.<string id='CommonStringModIDSWACD'/>"
	
	AWFixedLaserR = "Canon laser RG-9"
	AWFixedLaserRIcon = "Canon laser RG-9" // "Canon laser droite de A-Wing"
	AWFixedLaserRDesc = "Le canon laser RG-9 <orange>à fonctionnement modulable</orange> par <cyan>Borstel</cyan> est une pièce maîtresse dans l’arsenal du chasseur stellaire A-Wing RZ-1, il se distingue par sa capacité à infliger d’importants dégâts à la coque grâce à sa cadence de tir élevée. Son designest spécialement conçu pour favoriser l’agilité et la précision, en parfaite adéquation avec le style de combat rapide de l’A-Wing. Ce canon laser allie une puissance de feu redoutable à une vitesse de tir fulgurante, le rendant idéal pour les combats spatiaux intenses.<string id='CommonStringModIDSWACD'/>"

	fixedlasercannon = "Canon à répétition de TIE" // "Canon laser fixe"
	fixedlasercannonIcon = "Canon à répétition de TIE" // "Canon laser fixe"
	fixedlasercannonDesc = "Le canon à répétition de TIE est une arme laser à la fois épurée et puissante, inspirée de l’armement des chasseurs TIE de <cyan>l’Empire Galactique</cyan>. Ce canon laser <orange>à fonctionnement modulable</orange> fixe maximise la cadence de tir tout en conservant un design compact, ce qui le rend particulièrement efficace contre les cibles rapides. Son encombrement réduit permet son installation sur une grande variété de vaisseaux, servant d’arme principale sur les plus petits ou d’armement secondaire sur les plus grands. \n\nTrès souvent utilisé pour modifier les vaisseaux personnalisés, le canon à répétition de TIE est un choix prisé des pilotes qui recherchent une cadence de tir élevée alliée à l'efficacité légendaire de la technologie des chasseurs TIE.<string id='CommonStringModIDSWACD'/>" 

	dualfixedioncannon = "Canon monté à ion double - édition compacte"
	dualfixedioncannonIcon = "Canon monté à ion double - EC"
	dualfixedioncannonDesc = "Le canon monté à ion double édition compacte de <cyan>l’Alliance Rebelle</cyan> est un canon ionique fixe à double canon, monté sous le vaisseau, conçu pour des frappes précises et la neutralisation des systèmes ennemis. Idéal pour les chasseurs et les cargos légers lors d’attaques éclair. \n\nConnu notamment pour son utilisation sur le chasseur stellaire BTL Y-wing.<string id='CommonStringModIDSWACD'/>"  

	SWMissileLauncherMedium = "Lance-missiles moyen des Systèmes d'ingénierie de Kuat"
	SWMissileLauncherMediumIcon = "Lance-missiles moyen SIK"
	SWMissileLauncherMediumDesc = "Une baie de lancement bien protégée, renforcée en duracier, capable de tirer différents types de missiles, notamment des missiles <color r='255' g='69' b='0' a='255'>à sous-munitions</color>, <color r='255' g='165' b='0' a='255'>à concussion</color>, <color r='30' g='144' b='255' a='255'>disrupteurs</color>, and <color r='34' g='139' b='34' a='255'>hex</color>. \n\nUtilisé notamment sur le destroyer stellaire de classe Victory des <cyan>Chantiers Navals de Kuat</cyan>.<string id='CommonStringModIDSWACD'/>"

	MissileLauncherCompact = "Lance-missiles compact des Systèmes d'ingénierie de Kuat"
	MissileLauncherCompactIcon = "Lance-missiles compact SIK"
	MissileLauncherCompactDesc = "Une baie de lancement automatisée, bien protégée et renforcée en duracier, capable de tirer différents types de missiles, notamment des missiles <color r='255' g='69' b='0' a='255'>à sous-munitions</color>, <color r='255' g='165' b='0' a='255'>à concussion</color>, <color r='30' g='144' b='255' a='255'>disrupteurs</color>, and <color r='34' g='139' b='34' a='255'>hex</color>. \n\nUtilisé notamment sur le destroyer stellaire de classe Venator des <cyan>Chantiers Navals de Kuat</cyan>. \n\n<bad>Limite de 20 par vaisseau</bad><string id='CommonStringModIDSWACD'/>"

	DiscordMissileLauncher = "Lance-missiles Discorde"
	DiscordMissileLauncherIcon = "Lanceur Discorde"
	DiscordMissileLauncherDesc = "<yellow>Utilise des composants de mines</yellow>\n\nLe lance-missiles Discorde envoie une charge qui explose à courte distance de sa cible, libérant un essaim de 5 à 7 vibro-droides. Ces droïdes attaquent l’armure et les composants essentiels du vaisseau ennemi. Les vibro-droides peuvent être neutralisés par la plupart des systèmes de tourelles de défense rapprochée. \n\nInitialement déployés par la <cyan>Confédération des Systèmes Indépendants</cyan> pendant la Guerre des Clones, ces missiles sont devenus tristement célèbres pour leurs effets dévastateurs sur les chasseurs de la République.<string id='CommonStringModIDSWACD'/>"

	ProtonLauncher = "Lance-torpilles à proton"
	ProtonLauncherIcon = "Lance-torpilles à proton"
	ProtonLauncherDesc = "Le lance-torpilles à proton, capable de déployer de redoutables torpilles à Protons, constitue un atout crucial dans les combats entre vaisseaux. Les torpilles à protons, réputées pour leur grande efficacité à percer les défenses et à détruire les composants internes des vaisseaux ennemis, sont un outil redouté dans tout arsenal spatial. En mettant l’accent sur les dégâts internes plutôt que sur l’impact en surface, ces torpilles sont particulièrement efficaces contre les vaisseaux plus grands et moins manœuvrables. \n\nNotamment utilisé dans diverses flottes, on le retrouve souvent sur des vaisseaux produits par les <cyan>Chantiers Navals de Kuat</cyan> et les <cyan>Systèmes de Flotte Sienar</cyan>.<string id='CommonStringModIDSWACD'/>" 


	//Cockpits and Command Bridges
	WarRoom = "Salle de guerre"
	WarRoomIcon = "Salle de guerre"
	WarRoomDesc = "<orange>Nécessite un pont de commandement</orange>\n\n<yellow>Déverrouille des technologies supplémentaires</yellow>\n\n<green>Comprend une balise et des capteurs</green> \n\nLa salle de guerre sert de centre de communication et de planification, fournissant un bonus de <good>+3600<image name='command_points' colored='true'/></good> points de commandement. Elle est équipée d'une balise, de capteurs longue portée et de puissants navordinateurs, essentiels pour les calculs de navigation en hyperespace.<string id='CommonStringModIDSWACD'/>" 

	CommandBridge = "Pont de commandement"
	CommandBridgeIcon = "Pont de commandement"
	CommandBridgeDesc = "<yellow>Déverrouille des technologies supplémentaires</yellow> \n\nPermet au vaisseau de voler et de coordonner ses armes en fournissant <good>+1200<image name='command_points' colored='true'/></good> points de commandement.<string id='CommonStringModIDSWACD'/>"

	CommandBridge2 = "Pont de commandement II"
	CommandBridge2Icon = "Pont de commandement II"
	CommandBridge2Desc = "Déverrouille des technologies de niveau II"

	SWBridge2x3 = "Poste de pilotage de commerce corellien"
	SWBridge2x3Icon = "Poste de pilotage corellien (2x3)"
	SWBridge2x3Desc = "<green>Comprend un sas et un extincteur</green>\n\nLe poste de pilotage phare de la <cyan>Corporation Technique Corellienne</cyan>, conçu pour les contrebandiers qui préfèrent passer inaperçus. Ce poste de pilotage offre un bonus de <good>+125<image name='command_points' colored='true'/></good> points de commandement, ce qui en fait un excellent choix pour les capitaines de cargos polyvalents qui privilégient l’adaptabilité et les performances. \n\n<magenta>Extérieur entièrement personnalisable</magenta><string id='CommonStringModIDSWACD'/>" 

	SWBridge3x2 = "Poste de pilotage de transport Gallofree"
	SWBridge3x2Icon = "Poste de pilotage G (3x2)"
	SWBridge3x2Desc = "<green>Comprend un sas et un extincteur</green>\n\n Les <cyan>Chantiers Navals Gallofree</cyan> ont crée le poste de pilotage ultime pour le capitaine de cargo qui préfère se fondre dans la masse à chaque port. Ce poste de pilotage offre <good>+125<image name='command_points' colored='true'/></good> points de commandement, garantissant un contrôle fiable de vos opérations de fret. \n\n<magenta>Extérieur entièrement personnalisable</magenta><string id='CommonStringModIDSWACD'/>" 

	Cockpit = "Poste de pilotage de X-Wing T-65B"
	CockpitIcon = "Poste de pilotage T-65B"
	CockpitDesc = "<green>Comprend un sas, un extincteur et un réacteur</green> \n\nConçu avec soin pour reproduire le design emblématique du X-Wing T-65B de la <cyan>Corporation Incom</cyan>, ce poste de pilotage offre <good>+35<image name='command_points' colored='true'/></good> points de commandement, tout en alliant contrôle précis et durabilité robuste. Réputé pour son rôle dans de nombreuses victoires de l’Alliance Rebelle, il offre un équilibre parfait entre fonctionnalité et confort pour tout pilote en herbe. Transfère automatiquement l’énergie de la batterie vers certains systèmes grâce à la grille énergétique à hypermatière.\n\n<bad>Limite de (2) par vaisseau</bad><string id='CommonStringModIDSWACD'/>" 

	CockpitT85 = "Poste de pilotage de X-Wing T-85"
	CockpitT85Icon = "Poste de pilotage T-85"
	CockpitT85Desc = "<green>Comprend un sas, un extincteur et un réacteur</green> \n\nConçu avec soin pour reproduire le design emblématique du X-Wing T-85 de la <cyan>Corporation Incom</cyan>, ce poste de pilotage offre <good>+50<image name='command_points' colored='true'/></good> points de commandement, tout en alliant contrôle précis et durabilité robuste. Réputé pour son rôle dans de nombreuses victoires de l’Alliance Rebelle, il offre un équilibre parfait entre fonctionnalité et confort pour tout pilote en herbe. Transfère automatiquement l’énergie de la batterie vers certains systèmes grâce à la grille énergétique à hypermatière.\n\n<bad>Limite de (1) par vaisseau</bad><string id='CommonStringModIDSWACD'/>" 

	CockpitHid = "Poste de pilotage dissimulé"
	CockpitHidIcon = "Poste de pilotage dissimulé"
	CockpitHidDesc = "<green>Comprend un extincteur</green> \n\nConçu pour la discrétion et la furtivité, ce poste de pilotage dissimulé conserve toutes les fonctionnalités essentielles tout en s'intégrant parfaitement au design de votre chasseur stellaire. Offre <good>+25<image name='command_points' colored='true'/></good> points de commandement pour les missions nécessitant de la discrétion sans compromettre la fonctionnalité. \n\n<magenta>Extérieur entièrement personnalisable</magenta><string id='CommonStringModIDSWACD'/>" 

	CockpitARC = "Poste de pilotage de chasseur ARC"
	CockpitARCIcon = "Poste de pilotage ARC"
	CockpitARCDesc = "<green>Comprend un sas, un extincteur et un réacteur</green> \n\nPoste de pilotage polyvalent conçu pour les chasseurs stellaires ARC des <cyan>Chantiers Navals de Kuat</cyan>, réputés pour leur robustesse et leur polyvalence. Ce poste de pilotage offre <good>+50<image name='command_points' colored='true'/></good>  points de commandement. Transfère automatiquement l’énergie de la batterie vers certains systèmes grâce à la grille énergétique à hypermatière.\n\n<magenta>Extérieur entièrement personnalisable</magenta>\n\n<bad>Limite de (2) par vaisseau</bad><string id='CommonStringModIDSWACD'/>"

	Cockpit2 = "Poste de pilotage de chasseur TIE"
	Cockpit2Icon = "Poste de pilotage TIE"
	Cockpit2Desc = "<green>Comprend un sas, un extincteur et un réacteur</green> \n\nReflétant le style distinctif des chasseurs TIE des <cyan>Systèmes de Flotte Sienar</cyan>, ce poste de pilotage est conçu pour les pilotes solitaires. Offre <good>+45<image name='command_points' colored='true'/></good> points de commandement, une vue dégagée et des systèmes de contrôle compacts, incarnant l'efficacité et le minimalisme du design impérial. Transfère automatiquement l’énergie de la batterie vers certains systèmes grâce à la grille énergétique à hypermatière.\n\n<red>Limite de (1) par vaisseau</red><string id='CommonStringModIDSWACD'/>"

	Cockpit2_1 = "Poste de pilotage de chasseur TIE MK1 (2x2)"
	Cockpit2_1Icon = "Poste de pilotage TIE MK1"
	Cockpit2_1Desc = "<greenComprend un sas, un extincteur, deux canons à répétition TIE et un réacteur</green>\n\nPoste de pilotage simplifié de chasseur TIE. Équipé de moteurs ioniques rapides, d’un réacteur d’ionisation solaire Ia3-b, d’une coque en titane et de deux réseaux de capteurs Fabritech. Transfère automatiquement l’énergie de la batterie vers certains systèmes grâce à la grille énergétique à hypermatière.<string id='CommonStringModIDSWACD'/>"

	Cockpit2_2 = "Poste de pilotage de chasseur TIE MK2"
	Cockpit2_2Icon = "Poste de pilotage TIE MK2"
	Cockpit2_2Desc = "Poste de pilotage standard de chasseur TIE. Équipé de moteurs ioniques rapides, de deux canons laser Ls-1, d’un réacteur d’ionisation solaire Ia3-b, d’une coque en titane et de deux réseaux de capteurs Fabritech. Transfère automatiquement l’énergie de la batterie vers certains systèmes grâce à la grille énergétique à hypermatière.<string id='CommonStringModIDSWACD'/>"

	Eta2 = "Poste de pilotage de l'Intercepteur Actis Eta-2 (Armé)"// "Poste de pilotage Eta-2 (+canons laser)"
	Eta2Icon = "Poste de pilotage Eta-2"//"Poste de pilotage de l'Intercepteur Actis Eta-2"
	Eta2Desc = "<green>Comprend un sas, un extincteur, des sièges pour l’équipage et un réacteur</green> \n\nConçu à l’image de l’Intercepteur Eta-2 Actis par les <cyan>Systèmes d'ingénierie de Kuat</cyan>, ce poste de pilotage est équipé de deux canons laser montés à l’avant. Offrant <good>+45<image name='command_points' colored='true'/></good>  points de commandement, il allie agilité et puissance de feu, incarnant la précision et l’élégance du chasseur Jedi. Pensé pour les missions prolongées, il comprend un espace de repos compact pour un membre d’équipage, garantissant une préparation optimale pour les engagements de longue durée. Transfère automatiquement l’énergie de la batterie vers certains systèmes grâce à la grille énergétique à hypermatière.\n\n<bad>Limite de (1) par vaisseau</bad><string id='CommonStringModIDSWACD'/>"


	//Crew Quarters Large -> Small
	BenchSW1x2 = "Espace pour l’équipage"
	BenchSW1x2Icon = "Espace pour l’équipage"
	BenchSW1x2Desc = "Offre des sièges pour 4 membres d’équipage.<string id='CommonStringModIDSWACD'/>"

	Smallbed = "Couchage"
	SmallbedDesc = "Offre un siège pour 1 membre d’équipage.<string id='CommonStringModIDSWACD'/>"


	//Durasteel Reinforced Reactors
	SW_TinyReactor = "Réacteur renforcé compact"
	SW_TinyReactorIcon = "Réacteur renforcé"
	SW_TinyReactorDesc = "Les <cyan>Chantiers Navals de Kuat</cyan> présente le réacteur renforcé compact : Une unité élégante, blindée en duracier, offrant un rendement élevé pour les vaisseaux de petite à moyenne taille. Son design privilégie l’optimisation de l’espace, délaissant les modèles encombrants et obsolètes.<string id='CommonStringModIDSWACD'/>"

	SW_SmallReactor = "Réacteur renforcé léger"
	SW_SmallReactorIcon = "Réacteur léger"
	SW_SmallReactorDesc = "La <cyan>Corporation Technique Corellienne</cyan> présente le réacteur renforcé léger : conçu avec un renforcement en duracier, ce réacteur allie efficacité et encombrement minimal, idéal pour les croiseurs et frégates de taille moyenne à grande en quête de solutions énergétiques de pointe.<string id='CommonStringModIDSWACD'/>"

	SW_HeavyReactor = "Réacteur renforcé lourd"
	SW_HeavyReactorIcon = "Réacteur lourd"
	SW_HeavyReactorDesc = "Les <cyan>Systèmes de Flotte Sienar</cyan> présente le réacteur renforcé lourd : un concentré de puissance blindé en duracier, conçu pour les destroyers stellaires de grande taille et les vaisseaux amiraux. Ce réacteur incarne l'efficacité et la compacité, reléguant au second plan les modèles encombrants et obsolètes.<string id='CommonStringModIDSWACD'/>"

	//Hypermatter Reactors
	HypermatterReactor12x12 = "Réacteur à hypermatière immense WIP!"
	HypermatterReactor12x12Icon = "Réacteur à hypermatière immense WIP!"
	HypermatterReactor12x12Desc = "Un réacteur à hypermatière destiné aux vaisseaux de très grande taille. WIP!<string id='CommonStringModIDSWACD'/>"
	HypermatterReactor30x30 = "Réacteur à hypermatière colossal WIP!"
	HypermatterReactor30x30Icon = "Réacteur à hypermatière colossal WIP!"
	HypermatterReactor30x30Desc = "Un réacteur à hypermatière pour vaisseaux massifs. WIP!<string id='CommonStringModIDSWACD'/>"

	//Hyperium Generators
	HypermatterReactor2x2 = "Réacteur à hypermatière léger WIP!"
	HypermatterReactor2x2Icon = "Réacteur à hypermatière léger WIP!"
	HypermatterReactor2x2Desc = "Un réacteur à hypermatière destiné aux vaisseaux de petite à moyenne taille. WIP!<string id='CommonStringModIDSWACD'/>"

	HypermatterReactor4x4 = "Réacteur à hypermatière lourd WIP!"
	HypermatterReactor4x4Icon = "Réacteur à hypermatière lourd WIP!"
	HypermatterReactor4x4Desc = "Un réacteur à hypermatière destiné aux vaisseaux de grande taille. WIP!<string id='CommonStringModIDSWACD'/>"


	//Durasteel Keys
	DurasteelArmorDesc = "Absorbe une grande quantité de tirs ennemis, protégeant les précieuses entrailles du vaisseau. Agit également comme un \"paratonnerre\" pour les effets IEM. \n\nLe blindage fabriqué en duracier est plus léger que le blindage traditionnel."
