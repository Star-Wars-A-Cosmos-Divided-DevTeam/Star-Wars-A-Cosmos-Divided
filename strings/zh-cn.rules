	MedHyperdrive = "中型超空间驱动器"
	MedHyperdriveDesc = "<orange>需要导航计算机</orange> \n\n一款平均大小的超空间驱动器,通常用于货船、星际飞船和其他小型和中型舰船.<string id='CommonStringModIDSWACD'/>"

	HyperdriveNodeMed = "中型超空间驱动节点"
	HyperdriveNodeMedIcon = "超空间驱动节点(M)"
	HyperdriveNodeMedDesc = "<orange>需要中型超空间驱动器</orange> \n\n用于提高中型超空间驱动效率的节点.<string id='CommonStringModIDSWACD'/>"

	LargeHyperdrive = "大型超空间驱动器"
	LargeHyperdriveDesc = "<orange>需要战争指挥室</orange> \n\n一款常见于星际驱逐舰和其他大型舰船的大型超空间驱动器.<string id='CommonStringModIDSWACD'/>"

	HyperdriveNode = "大型超空间驱动节点"
	HyperdriveNodeIcon = "超空间驱动节点(L)"
	HyperdriveNodeDesc = "<orange>需要大型超空间驱动器</orange> \n\n用于提高大型超空间驱动效率的节点.<string id='CommonStringModIDSWACD'/>"


	GravityWellProjector = "引力阱投射器"
	GravityWellProjectorIcon = "引力阱投射器"
	GravityWellProjectorDesc = "<orange>需要引力阱投射器控制器</orange> \n\n引力阱投射器用于截断超空间旅行,迫使飞船离开超空间或阻止它们进入超空间."
	GravityWellProjectorControl = "引力阱投射器控制器"
	GravityWellProjectorControlIcon = "引力阱投射器控制器"
	GravityWellProjectorControlDesc = "<orange>需要指挥舰桥</orange> \n\n引力阱投射器控制器用于控制引力阱投射器(s)."

	SuperIonEnergyCell = "超级离子能量电池"
	SuperIonEnergyCellIcon = "超级离子能量电池"
	SuperIonEnergyCellDesc = "超级离子能量电池"

	SuperlaserCommand = "死星超级激光指挥中心"
	SuperlaserCommandIcon = "超级激光指挥中心"
	SuperlaserCommandDesc = "死星超级激光指挥中心是死星超级激光系统所需的指挥室.它必须安置在所有超级激光发射器后面,并且距离最远的发射器不超过1000格,两侧不超过 500格.需要战争指挥室."

	DSLaserTunnel = "死星超级激光隧道"
	DSLaserTunnelIcon = "超级激光隧道"
	DSLaserTunnelDesc = "超级激光隧道,类似于电磁炮加速器.必须放置在超级激光核心上方.需要超级激光指挥中心."
	DSLaserEmitter = "死星超级激光发射器"
	DSLaserEmitterIcon = "超级激光发射器"
	DSLaserEmitterDesc = "超级激光发射器,类似于电磁炮发射器.必须放置在超级激光隧道上方.需要超级激光指挥中心."
	DSLaserDirector = "死星超级激光引导器"
	DSLaserDirectorIcon = "死星超级激光引导器"
	DSLaserDirectorDesc = "死星超级激光引导器,指导和合并激光束.类似于离子棱镜.必须放置在其余组件的前方."
	DSLaserCore = "死星超级激光点火核心"
	DSLaserCoreIcon = "超级激光点火核心"
	DSLaserCoreDesc = "超级激光点火核心,类似于电磁炮装弹器.需要超级激光指挥中心和战争指挥室."
	DirectorConnector = "死星超级激光引导器连接装置"
	DirectorConnectorIcon = "超级激光引导器连接装置"
	DirectorConnectorDesc = "用于与超级激光引导器连接,作为结构的替代物.如果没有与引导器连接在一条线上,它将自毁.需要超级激光引导器."

	IonThrusterAccelerator5x10 = "离子推进器加速器 轻型 (5x10)"
	IonThrusterAccelerator5x10Icon = "离子加速器 轻"
	IonThrusterAccelerator5x10Desc = "<orange>需要指挥舰桥</orange>\n\n用于更高效内部建造的离子推进器加速器.为离子推进器提供<yellow>电力</yellow>和<yellow>速度</yellow>增益.请参阅覆盖区域的蓝图.<string id='CommonStringModIDSWACD'/>"
