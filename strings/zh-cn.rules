	//Factories
	FactoryAluminium = "Aluminium Forge"
	FactoryAluminiumIcon = "Aluminium Forge"
	FactoryAluminiumDesc = "Manufactures Aluminium plates, which are used to construct some advanced armor parts. Consumes aluminium ore. Gains +25% production speed for each adjacent factory of any type.<string id='CommonStringModIDSWACD'/>"

	FactoryAgrinium = "Agrinium Forge"
	FactoryAgriniumIcon = "Agrinium"
	FactoryAgriniumDesc = "Manufactures Agrinium plates, which are used to construct some advanced armor parts. Consumes aluminium ingots. Gains +25% production speed for each adjacent factory of any type.<string id='CommonStringModIDSWACD'/>"

	FactoryDuraSteel = "耐钢冶炼厂"
	FactoryDuraSteelIcon = "耐钢"
	FactoryDuraSteelDesc = "制造耐钢,可用于制造一些先进的装甲部件.消耗碳和耐铁.与之相邻的所有工厂都获得+25%生产速度.<string id='CommonStringModIDSWACD'/>"
	
	FactoryDoonium = "杜恩板锻造厂"
	FactoryDooniumIcon = "杜恩板锻造厂"
	FactoryDooniumDesc = "制造杜恩板,可用于制造一些先进的装甲部件.消耗杜恩素原.与之相邻的所有工厂都获得+25%生产速度.<string id='CommonStringModIDSWACD'/>"

	//Utilities
	SWMiningLaserHuge = "科瑞利安裂岩者XL采矿激光器"
	SWMiningLaserHugeIcon = "科瑞利安裂岩者X"
	SWMiningLaserHugeDesc = "<cyan>科瑞利安工程公司制造</cyan>,这个特大型采矿激光器发射双重精准的合成水晶增强光束,能够迅速从坚韧的小行星中提取资源,如耐铁和杜恩素. 同时擅长进行船只打捞作业,必要时还可作为短程攻击激光器使用.<string id='CommonStringModIDSWACD'/>"

	SWResourceCollectorTiny = "操控光束发射器 XS"
	SWResourceCollectorTinyIcon = "操控光束 XS"
	SWResourceCollectorTinyDesc = "最多可投射4道小型、安装于甲板上的牵引光束,用于收集资源或助推飞行中的船员.单个船员最多可控制四道光束,并且仅在需要协助完成任务时,他们才会前往操控光束发射器.<string id='CommonStringModIDSWACD'/>"

	//Thrusters
	IonThruster01_1x1 = "离子推进器 1x1"
	IonThruster01_1x1_Icon = &IonThruster01_1x1
	IonThrusterDesc = "<cyan>夸特动力船坞制造</cyan>,这些多用途的离子推进器设计具有可扩展性,并与各类星际飞船兼容,从小型战斗机到大型母舰.其高效的离子推进确保在各种应用中可靠性能.以其一致的推力和精准性而闻名,它们在各种操作环境中表现出色.<string id='CommonStringModIDSWACD'/>"
	/* AI ENHANCED FROM "A propulsion engine capable of pushing the ship with a great amount of force." */ 
	IonThruster01_1x2 = "离子推进器 1x2"
	IonThruster01_1x2_Icon = &IonThruster01_1x2
	IonThruster01_1x2_Desc = &IonThrusterDesc

	IonThruster01_2x2 = "离子推进器 2x2"
	IonThruster01_2x2_Icon = &IonThruster01_2x2
	IonThruster01_2x2_Desc = &IonThrusterDesc

	IonThruster01_2x3 = "离子推进器 2x3 \"助推器\""
	IonThruster01_2x3_Icon = "\"助推器\" 推进器 2x3"
	IonThruster01_2x3_Desc = "这是<cyan>夸特动力船坞制造</cyan>离子推进器 2x2的一种特殊变体,该型号可以直接将原始超物质注入其电离室,以获得强大但短暂的推动力.在增强期间暂停功率传输,集中所有资源加速推进.<string id='CommonStringModIDSWACD'/>"

	IonThruster01_3x3 = "离子推进器 3x3"
	IonThruster01_3x3_Icon = &IonThruster01_3x3
	IonThruster01_3x3_Desc = &IonThrusterDesc

	IonThruster01_3x4 = "离子推进器 3x4 \"运输机\""
	IonThruster01_3x4_Icon = "\"运输机\" 离子推进器 3x4"
	IonThruster01_3x4_Desc = "由著名的<cyan>夸特动力船坞制造</cyan>增强, \"运输机\" 推进器 3x4 在其前身3x3型号的基础上进行了建设.在保持适用于各种星际飞船级别的可扩展性和兼容性的同时,该型号提供了更强的耐用性和显著提高的速度,适用于长时间的连续穿越宇宙旅行.其先进的离子推进系统不仅保证了可靠的性能,还提供了在长途操作中的超强推力和精准度.<string id='CommonStringModIDSWACD'/>"

	IonThruster01_7x10 = "离子推进器 7x10"
	IonThruster01_7x10_Icon = &IonThruster01_7x10
	IonThrusterBigDesc = "需要<orange>指挥舰桥</orange>\n\n<cyan>夸特动力船坞</cyan>专为最大型的母舰设计的这些离子推进器.其高效的离子推进确保在各种应用中可靠性能.以其一致的推力和精准性而闻名,它们在各种操作环境中表现出色.<string id='CommonStringModIDSWACD'/>"
	/* AI ENHANCED FROM "A propulsion engine capable of pushing the ship with a great amount of force. Requires Bridge1." */ 

	IonThruster01_8x16 = "离子推进器 8x16"
	IonThruster01_8x16_Icon = &IonThruster01_8x16
	IonThruster01_8x16_Desc = &IonThrusterBigDesc

	IonThruster01_10x14 = "离子推进器 10x14"
	IonThruster01_10x14_Icon = &IonThruster01_10x14
	IonThruster01_10x14_Desc = &IonThrusterBigDesc

	IonThruster01_20x26 = "离子推进器 20x26\"旗舰\""
	IonThruster01_20x26_Icon = &IonThruster01_20x26
	IonThruster01_20x26_Desc = "<orange>需要指挥舰桥、作战室和大型超空间引擎</orange>\n\n<cyan>夸特驱动器造船厂</cyan>为最大的资本舰设计了这些离子推进器.它们高效的离子推进保证了在各种应用中的可靠性能.以持续推力和精确性著称,它们在不同的操作环境中表现出色.<string id='CommonStringModIDSWACD'/>"

	rcs = "转向推进器"
	rcsIcon = "转向推进器"
	rcsDesc = "<cyan>阿拉基德工业设计</cyan>,这个转向推进器为不同派系的各种星际飞船提供精确的操纵性能.尽管它提供的推力较低,但在辽阔的太空中,它对于微调飞船的方向和实现精密机动至关重要.\n\n得到共和国工程师、反抗军飞行员,甚至帝国战术家的信任,其可靠性和精准性使其成为战斗和探索飞船中的重要组成部分.<string id='CommonStringModIDSWACD'/>"

	XWingThrusterSingle = "X翼推进器(单个)"
	XWingThrusterSingleIcon = "X翼推进器(单个)"
	XWingThrusterSingleDesc = "源自标志性的T-65 X翼设计,这个单推进器单元为星际飞船的一侧提供了增强的机动性和速度.其紧凑而强大的引擎非常适合敏捷的转弯和快速加速,是对需要不对称推力的战斗机和小型飞船的理想选择.<string id='CommonStringModIDSWACD'/>"

	XWingThrusterDual = "X翼推进器(一对)"
	XWingThrusterDualIcon = "X翼推进器(一对)"
	XWingThrusterDualDesc = "这个受传奇T-65 X翼启发的双引擎推进器为各种宇宙飞船提供平衡而强大的推进力.提供同步的动力和控制,非常适合在中型船只和需要对称推力能力的战斗机中实现卓越的速度和稳定性.<string id='CommonStringModIDSWACD'/>"

	//Turret Weapons Large -> Small
	SiegeTurbolaser12x12 = "双重70TT超重型涡轮激光炮"
	SiegeTurbolaser12x12Icon = "D70TT SH-涡轮激光"
	SiegeTurbolaser12x12Desc = "<orange>需要指挥舰桥</orange> \n\n双重70TT超重型涡轮激光炮,亦称为‘攻城炮台’,是一种强大的战争武器.专为围攻而设计,它在有限的弧度内发射爆炸性激光射击,摧毁敌人的防御工事和主力舰.虽然其缓慢的射击速率和移动性可能限制了对抗敏捷战斗机的效果,但炮台的巨大破坏力使其成为突破最坚固防御的关键资产.<string id='CommonStringModIDSWACD'/>"
	SiegeTurbolaser12x12Overclock = "Overclocked Dual 70TT Superheavy Siege Turbolaser"
	SiegeTurbolaser12x12OverclockDesc = "Increased concussive laser damage, velocity, and accuracy, but stops penetration once its damage potential is exhausted.  Produces waste heat when firing." /* AI ENHANCED FROM "" */

	TurbolaserHuge01 = "重型泰拉顿涡轮激光炮(单管)"
	TurbolaserHuge01Icon = "SH-TT 涡轮激光炮"
	TurbolaserHuge01Desc = "<orange>需要战争室</orange> \n\n单管重型涡轮激光炮,发射爆发轮次以实现高穿透力和爆炸伤害.相比双管和三管版本,射击和旋转速度更快. \n\n以部署在<cyan>夸特系统工程</cyan>胜利者级星际驱逐舰上而闻名.<string id='CommonStringModIDSWACD'/>"

	TurbolaserHuge02 = "重型泰拉顿涡轮激光炮(双管)"
	TurbolaserHuge02Icon = "DH-TT 涡轮激光炮"
	TurbolaserHuge02Desc = "<orange>需要战争室</orange> \n\n双管重型涡轮激光炮,发射爆发轮次以实现高穿透力和爆炸伤害.相比单管版本,射击和旋转速度较慢,但比三管版本更快. \n\n以部署在<cyan>夸特系统工程</cyan>胜利者级星际驱逐舰上而闻名.<string id='CommonStringModIDSWACD'/>"

	TurbolaserHuge03 = "重型泰拉顿涡轮激光炮(三管)"
	TurbolaserHuge03Icon = "TH-TT 涡轮激光炮"
	TurbolaserHuge03Desc = "<orange>需要战争室</orange> \n\n三管重型涡轮激光炮,发射爆发轮次以实现高穿透力和爆炸伤害.相比单管和双管版本,射击和旋转速度更慢. \n\n以部署在<cyan>夸特系统工程</cyan>胜利者级星际驱逐舰上而闻名.<string id='CommonStringModIDSWACD'/>"

	OctupleBarbetteTurbolaser = "八联装栏式超级激光炮"
	OctupleBarbetteTurbolaserIcon = "八联装栏式超级激光炮"
	OctupleBarbetteTurbolaserDesc = "<orange>需要指挥舰桥</orange> \n\n一座令人印象深刻的八联装栏式超级激光炮炮塔,是帝国强大力量的象征.拥有八个重型炮管,能够发射毁灭性的弹幕.对抗巨型舰船和设施特别有效,但对灵活的战斗机效果较弱.是帝国舰队攻击武库中的核心装备.<string id='CommonStringModIDSWACD'/>"
	OctupleBarbetteTurbolaserOverclock = "Overclocked Octuple Barbette Turbolaser"
	OctupleBarbetteTurbolaserOverclockDesc = "Increases the damage of each laser shot and adds splash damage, but reduces the rate of fire. Produces waste heat when firing." // AI ENHANCED From "Powerful Barrage of Heavy Imperial Turbolaser Technology. Requires Command Bridge."

	QuadBarbetteTurbolaser = "四联装栏式超级激光炮"
	QuadBarbetteTurbolaserIcon = "四联装栏式超级激光炮"
	QuadBarbetteTurbolaserDesc = "<orange>需要指挥舰桥</orange> \n\n一座强大的四联装栏式超级激光炮炮塔,结合四个炮管进行集中而强大的打击.在中程战斗中对巨型和中型舰船都非常理想.在各种战斗情景中,平衡了火力和射速,具有多用途的作战能力.<string id='CommonStringModIDSWACD'/>"
	QuadBarbetteTurbolaserOverclock = "Overclocked Quad-Barbette Turbolaser"
	QuadBarbetteTurbolaserOverclockDesc = "Increases the damage of each laser shot and adds splash damage, but reduces the rate of fire. Produces waste heat when firing." // AI ENHANCED From "Powerful Barrage of Heavy Imperial Turbolaser Technology. Requires Command Bridge."

	MediumTurbolaserQuadswitchable = "四管重型超级激光炮"
	MediumTurbolaserQuadswitchableIcon = "四管重型超级激光炮" // Quad-Barrel Medium?
	MediumTurbolaserQuadswitchableDesc = "一座多用途的四管重型超级激光炮,<orange>多模式</orange>提供了高伤害和精准度的平衡,射速适中,适用于各种目标.对于寻求武器灵活性的指挥官来说,这是一个极好的选择..<string id='CommonStringModIDSWACD'/>"

	CISturbolaserswitchable = "独立星系联邦海军重型超级激光炮"
	CISturbolaserswitchableIcon = "CIS重型超级激光炮"
	CISturbolaserswitchableDesc = "<orange>需要指挥舰桥</orange> \n\n这座大型、缓慢移动的双管炮塔可以造成显著的区域伤害和穿透,尽管以精准度和射速为代价.它对大型舰船有效,但对快速移动的目标效果较差,平衡了对装甲和护盾之间的伤害输出. \n\n以部署在<cyan>霍尔什-凯瑟尔推进公司</cyan>制造的鲁克里胡克级战列舰而闻名.<string id='CommonStringModIDSWACD'/>"
	// AI ENHANCED From "<orange>Requires Command Bridge</orange> Large, slow-moving, double-barreled <orange>switchable</orange> Turbolaser which deals very great area damage and penetration at the expensive of accuracy and rate of fire. Ideal for targetting large ships, weak against fast-moving targets. This turbolaser provides both good damage to armor and shields." 

	Imperialturbolaserswitchable = "帝国重型涡轮激光炮"
	ImperialturbolaserswitchableIcon = "重型涡轮激光炮"
	ImperialturbolaserswitchableDesc = "<orange>需要指挥舰桥</orange> \n\n这是一种大型、移动缓慢、双管涡轮激光炮炮塔,以牺牲精确度和射速为代价,提供非常强大的区域伤害和穿透力.它适用于瞄准大型舰船,但对于移动速度较快的目标效果较差.这种涡轮激光炮对装甲的伤害更大,但对护盾的伤害较弱.<string id='CommonStringModIDSWACD'/>"

	Republicturbolaserswitchable = "共和DBY-827重型涡轮激光炮"
	RepublicturbolaserswitchableIcon = "共和重型涡轮激光炮"
	RepublicturbolaserswitchableDesc = "<orange>需要指挥舰桥</orange> \n\n这是一种大型、移动缓慢、双管涡轮激光炮炮塔,以牺牲精确度和射速为代价,提供非常强大的区域伤害和穿透力.它适用于瞄准大型舰船,但对于移动速度较快的目标效果较差.这种涡轮激光炮对装甲的伤害更大,但对护盾的伤害较弱. \n\n以部署在<cyan>夸特系统工程</cyan>制造的猎兵级歼星舰上而闻名.<string id='CommonStringModIDSWACD'/>"

	HeavyIonCannon = "重离子炮"
	HeavyIonCannonIcon = "重离子炮"
	HeavyIonCannonDesc = "<orange>需要指挥舰桥</orange> \n\n一种强大的双管离子炮塔,以禁用敌人的护盾为特点,同时对敌舰的船体造成最小的损害.在战略性的战斗中至关重要,它可以显著影响战斗结果. \n\n主要用于由<cyan>西纳舰队系统公司</cyan>制造的拦截者级星际驱逐舰上,通过削弱敌方防御在舰队战斗中发挥着至关重要的作用.<string id='CommonStringModIDSWACD'/>"

	Heavyturbolaserswitchable = "重型涡轮激光炮"
	HeavyturbolaserswitchableIcon = "重型涡轮激光炮"
	HeavyturbolaserswitchableDesc = "大型、缓慢移动、双管道<orange>多模式</orange>涡轮激光炮炮塔,提供强大的伤害和高穿透力,以牺牲准确性和射速为代价.优化用于攻击大型、静止或缓慢移动的目标,但对敏捷、快速移动的对手效果较差.\n\n以部署在<cyan>夸特动力船坞</cyan>制造的帝国级歼星舰而闻名.<string id='CommonStringModIDSWACD'/>"

	XX9turbolaserswitchable = "XX-9涡轮激光塔"
	XX9turbolaserswitchableIcon = "涡轮激光塔"
	XX9turbolaserswitchableDesc = "标志性的XX-9涡轮激光塔,以传奇的战壕突袭场景而闻名,将经济性与多功能性结合在一起. 这款<orange>多模式</orange>型号可以在不同的战斗模式之间进行快速调整,因此在各种星舰类别中都备受欢迎. 以其可靠的性能和经济性而闻名,XX-9依然是银河系各地军械库中的主打武器,体现了历史意义和实用战场效用的完美结合.<string id='CommonStringModIDSWACD'/>"

	TripleTurbolaser = "三联涡轮激光炮"
	TripleTurbolaserIcon = "三联涡轮激光炮"
	TripleTurbolaserDesc = "一个紧凑而强大的<orange>多模式</orange>三管涡轮激光炮塔.比标准重型激光炮略小,但比轻型激光炮模型更为坚固,这个三管炮塔提供了火力和灵活性的平衡混合.其多模式功能允许在各种战斗情景中进行战术灵活性,是寻求尺寸和战斗效果平衡的星舰的不二之选.<string id='CommonStringModIDSWACD'/>"

	TurbolaserMedLR01 = "中远程涡轮激光炮"
	TurbolaserMedLR01Icon = "中远程涡轮激光炮"
	TurbolaserMedLR01Desc = "中远程涡轮激光炮以其单管炮塔设计而著称,被优化用于远程交战.尽管其紧凑的尺寸与轻型涡轮激光模型相当,但中远程涡轮激光炮却以其扩展的射程和快速的射击速度而引人瞩目. 这款涡轮激光炮在与敌方目标进行重要距离的交战中表现出色,提供精准而一致的火力支援.\n\n通常部署在巡逻和侦察舰艇上,如<cyan>夸特动力船坞</cyan> 的卡里克轻型巡洋舰和<cyan>科瑞利安工程公司</cyan>的炮艇,这是确保远程交战能力的关键装备.<string id='CommonStringModIDSWACD'/>"

	Medturbolaserswitchable = "中型涡轮激光炮"
	MedturbolaserswitchableIcon = "中型涡轮激光炮"
	MedturbolaserswitchableDesc = "涡轮激光炮炮塔是经典重型涡轮激光炮的更灵活版本.它在重型变体的强大火力和轻型涡轮激光的精确性之间提供了平衡的折中,专为那些需要多功能性而又不愿牺牲过多火力的舰船而设计.\n\n它的适应性使其成为各种舰船上常见的一种装备,从流线型的<cyan>夸特动力船坞</cyan>星云B护卫舰到强大的<cyan>蒙卡拉马里船坞</cyan>的蒙卡拉马里巡洋舰,其快速切换射击模式的能力备受重视.<string id='CommonStringModIDSWACD'/>"

	MediumIonCannon = "中型离子炮"
	MediumIonCannonIcon = "中型离子炮"
	MediumIonCannonDesc = "中型离子炮是任何舰队军火库中的战略工具,专门用于禁用敌方护盾,同时对敌舰造成最小化的船体损伤.其离子冲击专门设计用于干扰电子系统,使其成为瓦解敌方防御而不摧毁舰船的理想炮塔选择.\n\n经常配备在<cyan>夸特动力船坞</cyan> 星云-B护卫舰 和 <cyan>科瑞利安工程公司</cyan>的小型护卫舰,这门炮在禁用敌舰能量系统方面发挥着关键作用,使其能够被捕获或使其易受后续攻击.<string id='CommonStringModIDSWACD'/>"

	LightTurbolaserswitchable = "轻型涡轮激光炮"
	LightTurbolaserswitchableIcon = "轻型涡轮激光炮"
	LightTurbolaserswitchableDesc = "这个<orange>多模式</orange>轻型涡轮激光炮炮塔将多功能性与精确性结合在一起.适用于对抗快速移动的战斗机,同时它还具备足够的威力来应对大型舰船.\n\n以其高射速和精准度而著称,这款涡轮激光炮是<cyan>泰姆&amp;巴克</cyan>创新工程的产物.它是敏捷舰船的热门选择,比如<cyan>科瑞利安工程公司</cyan>的CR90巡洋艇,提供了火力和速度的平衡.<string id='CommonStringModIDSWACD'/>"
	LightTurbolaserswitchableOverclock = "Overclocked Light Turbolaser"
	LightTurbolaserswitchableOverclockDesc = "Increases the damage of each laser shot and adds splash damage, but reduces the rate of fire. Produces waste heat when firing."

	DualLaserCannonSwitchable = "双重激光炮"
	DualLaserCannonSwitchableIcon = "双重激光炮"
	DualLaserCannonSwitchableDesc = "这个<orange>多模式</orange>双重激光炮炮塔专为快速交战和高精度而设计.其流线型设计使其能够快速射击,对敏捷的敌方战机非常有效.\n\n尽管射程较短但射速增加,它在近距离战斗中表现卓越,常常装备在巡逻和护航舰艇上,比如<cyan>爆能科技工业公司</cyan>的改装巡洋艇,其中快速响应和对战斗机的压制至关重要.<string id='CommonStringModIDSWACD'/>"

	FalconLaserCannon = "AG-2G四连激光炮"
	FalconLaserCannonIcon = "AG-2G四连激光炮" //AI ENHANCED
	FalconLaserCannonDesc = "AG-2G四连激光炮以其高射速和强大的火力而闻名,是与星际战斗机进行迅速交战的理想炮塔.\n\n这门激光炮显著装备在标志性的<cyan>科瑞利安工程公司</cyan>的千年隼号和帝国的长矛级护卫舰上,它是在战斗中用途广泛和高效的明证.<string id='CommonStringModIDSWACD'/>"

	TurbolaserLightPD4 = "哨兵级轻型点防御涡轮激光炮"//AI ENHANCED
	TurbolaserLightPD4Icon = "L-PD涡轮激光炮"//AI ENHANCED
	TurbolaserLightPD4Desc = "这款先进的、轻型的点防御涡轮激光炮在拦截和中和<orange>激光和离子射击</orange>方面表现异常出色,这是点防御炮台中的一项罕见能力.为瞄准各种弹丸类型而优化,其专门的离子射击中和功能在对抗电子战术方面至关重要.\n\n因其在<cyan>夸特动力船坞</cyan>的帝国II级星际驱逐舰上的部署而引人注目.<string id='CommonStringModIDSWACD'/>"

	TurbolaserTiny01 = "紧凑型涡轮激光炮 - 爆裂模式" // "Point Defense Turbolaser 1"
	TurbolaserTiny01Icon = "C-TL爆裂模式" // "Compact Turbolaser 1"
	TurbolaserTiny01Desc = "作为一个小巧而强大的炮塔,紧凑型涡轮激光炮 - 爆裂模式专注于爆裂伤害,非常适合迅速处理较小的威胁.这是一个<orange>多模式</orange>、由船员操作的激光炮.<string id='CommonStringModIDSWACD'/>" // "Can be toggled to defend against projectiles or attack enemy ships"

	TurbolaserTiny02 = "紧凑型涡轮激光炮 - 重型" // "Point Defense Turbolaser 2"
	TurbolaserTiny02Icon = "C-TL重型" // "Compact Turbolaser 2"
	TurbolaserTiny02Desc = "作为一个小巧但坚固的炮塔,紧凑型涡轮激光炮 - 重型专为耐久性和持续火力而设计,使其对多种目标都非常有效.这是一个<orange>多模式</orange>、由船员操作的激光炮.<string id='CommonStringModIDSWACD'/>" // "Can be toggled to defend against projectiles or attack enemy ships"

	TurbolaserTiny03 = "紧凑型涡轮激光炮 - 快速模式" // "Point Defense/Light Turbolaser Hybrid"
	TurbolaserTiny03Icon = "C-TL快速模式" // "Compact Turbolaser 3"
	TurbolaserTiny03Desc = "紧凑型涡轮激光炮 - 快速模式在炮塔中融合了两个世界的优点,提供了在爆发伤害和持久力方面的平衡解决方案.这是一个<orange>多模式</orange>、由船员操作的激光炮.<string id='CommonStringModIDSWACD'/>" // "Can be toggled to defend against projectiles or attack enemy ships"

	SmallLaserCannonSwitchable = "紧凑式甲板激光炮" //AI ENHANCED
	SmallLaserCannonSwitchableIcon = "紧凑式甲板激光炮" //AI ENHANCED
	SmallLaserCannonSwitchableDesc = "这款<orange>多模式</orange>甲板安装激光炮提供了多功能性和紧凑性,非常适合重型战斗机和轻型舰艇.其设计在战斗中注重灵活性,以减小尺寸和增强机动性为代价,牺牲了耐久性.\n\n这个型号的适应性使其成为定制星际战斗机和巡逻舰艇的热门选择,其中在战斗中的灵活性是关键.这种型号显著地用于各种需要速度和火力平衡的改装舰艇上.<string id='CommonStringModIDSWACD'/>"

	//Fixed & Directional Weapons Large -> Small
	TurbolaserFlakCannon01 = "重型高射甲板炮"
	TurbolaserFlakCannon01Icon = "重型高射甲板炮" //Previously "Heavy Flak Deck Cannon"
	TurbolaserFlakCannon01Desc = "<orange>需要指挥舰桥</orange>\n\n专为防御而设计的涡轮激光高射炮在拦截和中和各种威胁方面表现出色,包括<orange>子弹、离子射击、激光、地雷和导弹</orange>.其设计使其能够集成在单层装甲块后面,增强了战略防御能力.\n\n虽然在任何星舰级别上都不是标配,但它是指挥官们在强化对导弹威胁的防御方面偏爱的售后升级选择,尤其是在资源丰富的领域中,那些优先考虑先进防护的领域尤为普遍.<string id='CommonStringModIDSWACD'/>"

	TurbolaserCarronade = "涡轮激光加农炮"
	TurbolaserCarronadeIcon = "涡轮激光加农炮"
	TurbolaserCarronadeDesc = "涡轮激光加农炮是一种<orange>多模式</orange>高功率、甲板安装的涡轮激光炮,在贯穿攻击和轰炸方面表现卓越.其独特设计允许将其安装在装甲块后面,增强了舰船间战斗的效率.\n\n由于其多功能性而备受青睐,这种涡轮激光加农炮并不是任何舰艇的标配,但在改装方面得到广泛使用,尤其是由私人舰队和边缘团体对改装的CR90巡洋艇上,以增强火力.<string id='CommonStringModIDSWACD'/>"

	FixedHeavyLaser = "重型激光炮"
	FixedHeavyLaserIcon = "重型激光炮"
	FixedHeavyLaserDesc = "重型激光炮,一种精准而强大的武器,专为直接而有力的打击而设计.尽管其位置固定,但它拥有有限但有效的攻击范围,允许对敌方目标进行集中火力.这门激光炮以能够造成毁灭性打击而闻名,能够轻松摧毁中型到大型巡洋舰和星际战斗机. \n\n这种激光炮以其在<cyan>夸特动力船坞</cyan>的胜利级星际驱逐舰上的应用而引人注目,典型地展示了在太空战争中集中火力的威力.<string id='CommonStringModIDSWACD'/>"

	FixedMediumLaser = "中型激光炮"
	FixedMediumLaserIcon = "中型激光炮"
	FixedMediumLaserDesc = "中型激光炮提供了一种平衡的力量和精准的组合.虽然与其重型对应物相比尺寸较小,但它具有显著的火力,擅长摧毁较小的巡洋舰和星际战斗机. 其固定位置确保了一个稳定而可靠的射击平台,具有适度的射击弧,允许对敌舰进行有针对性的攻击. \n\n这种激光炮因其集成到<cyan>伦迪利歼星舰</cyan>的无畏级重型巡洋舰中而引人注目,代表了中型主力舰武器中的关键组成部分.<string id='CommonStringModIDSWACD'/>"

	Smallpointlaser = "小型激光炮"
	SmallpointlaserIcon = "小型激光炮"
	SmallpointlaserDesc = "这款<orange>多模式</orange>小型激光炮是一种小巧但强大的武器,专为迅速对抗战斗机和小型飞船而设计.尽管尺寸较小,它能够高效造成伤害,当成群使用时,它对于比如护卫舰和巡洋舰这样的较大舰船构成可信的威胁.其多功能性和威力使其成为太空战斗中常见且必不可少的工具.\n\n因其集成在<cyan>科瑞利安工程公司</cyan>的YT-1300轻型货船上而引人注目,这种激光是银河系中许多多用途舰船防御武器中的关键组成部分.<string id='CommonStringModIDSWACD'/>"

	FixedLaser = "KX9激光炮"
	FixedLaserIcon = "KX9激光炮"
	FixedLaserDesc = "作为主要武装,<orange>多模式</orange>X翼激光炮提供可靠而精准的基于能量的火力.这种激光炮提供了损害和准确性的平衡,非常适合空战和对敌舰的精准打击.其固定的设计确保了稳定的性能,无需额外的配置. \n\n因其部署在标志性的T-65 X翼星际战斗机上而闻名,并由<cyan>泰姆&amp;巴克</cyan>公司制造.<string id='CommonStringModIDSWACD'/>"

	FixedLaserL = "KX9激光炮"
	FixedLaserR = "KX9激光炮<string id='CommonStringModIDSWACD'/>"

	AWFixedLaserL = "博斯泰尔 RG-9 激光炮"
	AWFixedLaserLIcon = "RG-9 激光炮" // "A-Wing Laser Cannon Left"
	AWFixedLaserLDesc = &AWFixedLaserRDesc

	AWFixedLaserR = &AWFixedLaserL
	AWFixedLaserRIcon = "RG-9 激光炮" // "A-Wing Laser Cannon Right"
	AWFixedLaserRDesc = "<cyan>博斯泰尔</cyan>RG-9 激光炮是RZ-1 A翼星际战斗机常备武器,以其高射速在船体损伤方面表现出色.其<orange>多模式</orange>设计专为敏捷和精准而打造,与A翼的迅速战斗风格相呼应.这种激光炮将强大的火力与迅速的射击能力结合在一起,非常适合激烈的空战.<string id='CommonStringModIDSWACD'/>"

	fixedlasercannon = "TIE 连发激光炮" // "Fixed Laser Cannon"
	fixedlasercannonIcon = "TIE 连发激光炮" // "Fixed Laser Cannon"
	fixedlasercannonDesc = "TIE 连发激光炮是一种流线型而强大的激光武器,灵感来自于<cyan>银河帝国</cyan>的TIE战斗机的武装.这个<orange>多模式</orange>的固定激光炮在紧凑设计中最大化了射击速率,使其对迅速移动的目标非常有效.其占用的空间最小,可以安装在各种大小的舰船上,既可以作为较小舰艇的主要武器,也可以作为较大舰船的次要选择.\n\n在定制船只改装中广泛使用,TIE 连发激光炮是那些重视快速射击能力并结合TIE战斗机技术传奇效率的飞行员的热门选择.<string id='CommonStringModIDSWACD'/>"

	dualfixedioncannon = "双联装离子炮,紧凑版"
	dualfixedioncannonIcon = "双离子 紧凑"
	dualfixedioncannonDesc = "<cyan>义军同盟</cyan>的双联装离子炮,紧凑版；一种双管、底部安装的固定离子炮,设计用于精确打击和禁用敌方系统. 适用于战斗机和轻型货船的打击战术. \n\n在<cyan>BTL Y翼星际战斗机</cyan>上的部署尤为显著. <string id='CommonStringModIDSWACD'/>"

	SWMissileLauncherMedium = "Kuat Systems Medium Missile Launcher"
	SWMissileLauncherMediumIcon = "KSE Medium Launcher"
	SWMissileLauncherMediumDesc = "A well-protected, durasteel-reinforced launchbay capable of firing various missile types including <color r='255' g='69' b='0' a='255'>Cluster</color>, <color r='255' g='165' b='0' a='255'>Concussion</color>, <color r='30' g='144' b='255' a='255'>Intruder</color>, and <color r='34' g='139' b='34' a='255'>Hex</color> missile payloads. \n\nNotable for its deployment on the <cyan>Kuat Systems Engineering</cyan> Victory-Class Star Destroyer. <string id='CommonStringModIDSWACD'/>"

	MissileLauncherCompact = "库亚特系统紧凑型导弹发射器"
	MissileLauncherCompactIcon = "KSE紧凑型发射器"
	MissileLauncherCompactDesc = "一个保护良好、采用杜拉钢加固的自动发射舱,能够发射各种类型的导弹,包括<color r='255' g='69' b='0' a='255'>集束</color>、<color r='255' g='165' b='0' a='255'>震荡</color>、<color r='30' g='144' b='255' a='255'>入侵者</color>和<color r='34' g='139' b='34' a='255'>六边形</color>导弹载荷. \n\n以部署在<cyan>库亚特系统工程</cyan>的威能级星际驱逐舰上而闻名. \n\n<bad>每艘舰船限量20个</bad> <string id='CommonStringModIDSWACD'/>"

	DiscordMissileLauncher = "不和谐导弹发射器"
	DiscordMissileLauncherIcon = "不和谐发射器"
	DiscordMissileLauncherDesc = "<yellow>使用地雷部件</yellow>\n\n不和谐导弹发射器发射一枚机械化弹头,在目标附近短距离内爆炸,释放出一群5-7个嗡嗡机器人,它们会吞噬敌方飞船的装甲和关键部件.嗡嗡机器人可以被大多数点防御炮塔系统所拦截.\n\n最初由<cyan>独立星系邦联</cyan>在克隆战争期间部署,这些导弹因其对共和国战斗机的毁灭性效果而臭名昭著.<string id='CommonStringModIDSWACD'/>"

	ProtonLauncher = "质子鱼雷发射器"
	ProtonLauncherIcon = "质子鱼雷发射器"
	ProtonLauncherDesc = "这个质子发射器能够发射毁灭性的质子鱼雷,在舰船对舰船的战斗中扮演着关键的角色.质子鱼雷以其在突破防御和摧毁敌舰内部组件方面的高效性而闻名,是太空军火库中备受畏惧的工具.由于专注于对内部造成伤害而非表面冲击,这些鱼雷对于较大、机动性较差的舰船特别有效. \n\n因其在各种舰队中的应用而引人注目,通常可以在<cyan>夸特动力船坞</cyan>和<cyan>西纳舰队系统公司</cyan>制造的星舰上找到.<string id='CommonStringModIDSWACD'/>"
	/* AI ENHANCED FROM "Launches Proton Torpedoes. Proton torpedoes are a type of explosive ordnance used throughout the galaxy. They are highly efficient at destroying a ship's internal components." */


	//Cockpits and Command Bridges
	WarRoom = "战争指挥室"
	WarRoomIcon = "战争指挥室"
	WarRoomDesc = "<orange>需要指挥舰桥</orange>\n\n<yellow>解锁技术等级2</yellow>\n\n战争室是一个通讯和规划中心,配备了长距离传感器和强大的导航计算机,可以进行在超空间中导航所需的计算.<string id='CommonStringModIDSWACD'/>"
/* AI ENHANCED FROM "The war room is a communications and planning center, that provides an additional +3600 Command Points. It is fully equiped with a beacon, long range sensors, and powerful navicomputers that makes the calculations necessary to navigate through hyperspace." */

	CommandBridge = "指挥舰桥"
	CommandBridgeIcon = "指挥舰桥"
	CommandBridgeDesc = "<yellow>解锁技术等级1</yellow> \n\n通过提供<good>+1200<image name='command_points' colored='true'/></good>指挥点,允许飞船飞行并协调其武器系统.<string id='CommonStringModIDSWACD'/>"

	CommandBridgeCIS = "Confederacy of Independent Systems Command Bridge"
	CommandBridgeCISIcon = "CIS Bridge"

	CommandBridge2 = "指挥舰桥"
	CommandBridge2Icon = "指挥舰桥 II"
	CommandBridge2Desc = "解锁技术等级2"

	SWBridge2x3 = "科瑞利安贸易者驾驶舱"
	SWBridge2x3Icon = "CEC-TR 驾驶舱 (2x3)"
	SWBridge2x3Desc = "<green>包括气闸和灭火器</green>\n\n<cyan>科瑞利安工程公司</cyan> 为那些不希望被注意到两次的走私者打造的旗舰驾驶舱.这个驾驶舱提供 <good>+125<image name='command_points' colored='true'/></good> 指挥点,使其成为重视适应性和性能的多功能货船船长的理想选择. \n\n<magenta>完全可定制的外观</magenta><string id='CommonStringModIDSWACD'/>"

	SWBridge3x2 = "加洛弗里银河货船驾驶舱"
	SWBridge3x2Icon = "GY-GH 驾驶舱 (3x2)"
	SWBridge3x2Desc = "<green>包括气闸和灭火器</green>\n\n<cyan>加洛弗里船厂有限公司</cyan> 为喜欢在每个港口融入环境的货船船长打造的终极驾驶舱.这个驾驶舱提供 <good>+125<image name='command_points' colored='true'/></good> 指挥点,确保您的货物操作得到可靠的指挥和控制. \n\n<magenta>完全可定制的外观</magenta><string id='CommonStringModIDSWACD'/>"

	Cockpit = "T-65 X翼战斗机驾驶舱"
	CockpitIcon = "T-65B X翼战斗机驾驶舱"
	CockpitDesc = "<green>包含气闸、灭火器和反应堆</green>\n\n这个驾驶舱精心设计,完美再现了<cyan>印卡姆公司</cyan>的标志性T-65B X翼战斗机的造型,提供<good>+35<image name='command_points' colored='true'/></good>指挥点,并融合了精准控制与坚固耐用的特点.因在多次反抗军胜利中扮演的角色而闻名,它为任何有志飞行员提供了功能性与舒适性的完美平衡.通过超物质能量网自动向有限系统传输电池能量.\n\n<bad>每艘船限用(2)个</bad><string id='CommonStringModIDSWACD'/>"

	CockpitT85 = "T-85 X翼战斗机驾驶舱"
	CockpitT85Icon = "T-85 X翼战斗机驾驶舱"
	CockpitT85Desc = "<green>包含气闸、灭火器和反应堆</green>\n\n这个驾驶舱精心设计,完美再现了<cyan>印卡姆公司</cyan>的标志性T-85 X翼战斗机的造型,提供<good>+50<image name='command_points' colored='true'/></good>指挥点,并融合了精准控制与坚固耐用的特点.因在多次反抗军胜利中扮演的角色而闻名,它为任何有志飞行员提供了功能性与舒适性的完美平衡.通过超物质能量网自动向有限系统传输电池能量.\n\n<bad>每艘船限用(1)个</bad><string id='CommonStringModIDSWACD'/>"

	CockpitHid = "隐藏驾驶舱"
	CockpitHidIcon = "隐藏驾驶舱"
	CockpitHidDesc = "<green>包含灭火器</green>\n\n为了隐蔽与低调而设计,这个隐藏驾驶舱保留了所有必要功能,同时无缝融入你的战斗机设计.提供<good>+25<image name='command_points' colored='true'/></good>指挥点,适用于需要低调执行的任务,而不会牺牲功能性.\n\n<magenta>完全可定制外观</magenta><string id='CommonStringModIDSWACD'/>"

	CockpitARC = "ARC战斗机驾驶舱"
	CockpitARCIcon = "ARC战斗机驾驶舱"
	CockpitARCDesc = "<green>包含气闸、灭火器和反应堆</green>\n\n这款多用途驾驶舱专为<cyan>夸特系统工程公司</cyan>的ARC战斗机设计,以其坚固性和多功能性著称,提供<good>+50<image name='command_points' colored='true'/></good>指挥点.通过超物质能量网自动向有限系统传输电池能量.\n\n<magenta>完全可定制外观</magenta>\n\n<bad>每艘船限用(2)个</bad><string id='CommonStringModIDSWACD'/>"

	Cockpit2 = "TIE战斗机驾驶舱"
	Cockpit2Icon = "TIE战斗机驾驶舱"
	Cockpit2Desc = "<green>包含气闸、灭火器和反应堆</green>\n\n这款驾驶舱反映了<cyan>西纳舰队系统公司</cyan>的TIE战斗机独特风格,专为孤狼飞行员设计.提供<good>+45<image name='command_points' colored='true'/></good>指挥点,具有开阔视野和紧凑的控制系统,充分体现了帝国设计的高效与简洁.通过超物质能量网自动向有限系统传输电池能量.\n\n<red>每艘船限用(1)个</red><string id='CommonStringModIDSWACD'/>"

	Cockpit2_1 = "TIE系列驾驶舱MK1(2x2)"
	Cockpit2_1Icon = "TIE战斗机驾驶舱MK1"
	Cockpit2_1Desc = "<green>包含气闸、灭火器、双TIE重炮和反应堆</green>\n\n简化版TIE战斗机驾驶舱.配备高速离子引擎、Ia3-b太阳离子反应堆、钛合金船体和双法布里泰克传感器阵列.通过超物质能量网自动向有限系统传输电池能量.<string id='CommonStringModIDSWACD'/>"

	Cockpit2_2 = "TIE系列驾驶舱MK2"
	Cockpit2_2Icon = "TIE战斗机驾驶舱MK2"
	Cockpit2_2Desc = "标准版TIE战斗机驾驶舱.配备高速离子引擎、双Ls-1激光炮、Ia3-b太阳离子反应堆、钛合金船体和双法布里泰克传感器阵列.通过超物质能量网自动向有限系统传输电池能量.<string id='CommonStringModIDSWACD'/>"

	Eta2 = "Eta-2阿克蒂斯截击机驾驶舱(武装版)"// "Eta-2 Cockpit (+ Laser Cannons)"
	Eta2Icon = "Eta-2驾驶舱"//"Eta-2 Actis Interceptor Cockpit"
	Eta2Desc = "<green>包含气闸、灭火器、船员座椅和反应堆</green>\n\n按照<cyan>夸特系统工程公司</cyan>的Eta-2阿克蒂斯截击机的形象打造,这款驾驶舱配有双前置激光炮.提供<good>+45<image name='command_points' colored='true'/></good>指挥点,兼具敏捷性与火力,完美体现了绝地战斗机的精准与优雅.专为长时间任务设计,包含一个紧凑的船员休息区,确保在长时间交战中保持战斗状态.通过超物质能量网自动向有限系统传输电池能量.\n\n<bad>每艘船限用(1)个</bad><string id='CommonStringModIDSWACD'/>"
	/* AI ENHANCED FROM "Cockpit from Eta-2 Actis Interceptor with front-mounted dual Laser Cannons." */


	//Crew Quarters Large -> Small
	BenchSW1x2 = "座舱"
	BenchSW1x2Icon = "座舱"
	BenchSW1x2Desc = "为四个船员提供床位.<string id='CommonStringModIDSWACD'/>"

	Smallbed = "小床"
	SmallbedDesc = "为一个船员提供床位.<string id='CommonStringModIDSWACD'/>"


	//Durasteel Reinforced Reactors
	SW_TinyReactor = "紧凑型强化反应堆"
	SW_TinyReactorIcon = "紧凑型强化反应堆"
	SW_TinyReactorDesc = "<cyan>夸特动力船坞</cyan>紧凑型强化反应堆;一台造型时尚、耐钢装甲的单位,为小到中型星舰提供高效能.其设计优先考虑了空间的优化,避免了笨重和过时的型号.<string id='CommonStringModIDSWACD'/>"

	SW_SmallReactor = "轻型强化反应堆"
	SW_SmallReactorIcon = "轻型强化反应堆"
	SW_SmallReactorDesc = "<cyan>科瑞利安工程公司.</cyan>轻型强化反应堆;通过使用耐钢加固技术,这种反应堆将效能与最小空间占用相结合,非常适合寻求先进动力解决方案的中型到大型巡洋舰和护卫舰.<string id='CommonStringModIDSWACD'/>"

	SW_HeavyReactor = "重型强化反应堆"
	SW_HeavyReactorIcon = "重型强化反应堆"
	SW_HeavyReactorDesc = "<cyan>西纳舰队系统公司</cyan>重型强化反应堆;一台耐钢装甲的强力动力源,专为大型星际驱逐舰和旗舰设计.这个反应堆体现了高效和紧凑设计的理念,淘汰了笨重、过时的型号.<string id='CommonStringModIDSWACD'/>"

	//Hypermatter Reactors
	HypermatterReactor12x12 = "巨型超物质反应堆"
	HypermatterReactor12x12Icon = "巨型超物质反应堆"
	HypermatterReactor12x12Desc = "用于巨大舰船的超物质反应堆.<string id='CommonStringModIDSWACD'/>"
	HypermatterReactor30x30 = "巨像级超物质反应堆"
	HypermatterReactor30x30Icon = "巨像级超物质反应堆"
	HypermatterReactor30x30Desc = "用于庞大舰船的超物质反应堆.<string id='CommonStringModIDSWACD'/>"

