MissileTypes
{
	SW_Cluster = "<color r='255' g='69' b='0' a='255'>集束导弹</color>"
	SW_Cluster_alt = "集束导弹"
	SW_ClusterDesc = "快速部署的制导导弹,能够散布多个弹头,每个弹头在小范围内造成显著伤害. \n\n受各种攻击飞船快速发射这些导弹的能力启发,它们擅长突破集中敌方防御."

	SW_Intruder = "<color r='30' g='144' b='255' a='255'>入侵者导弹</color>"
	SW_Intruder_alt = "入侵者导弹"
	SW_IntruderDesc = "一种复杂的制导导弹,设计用于在撞击时发出强大的电磁脉冲,专门针对敌方系统清空能量. \n\n由<cyan>Slayn &amp; Korpil</cyan>为反叛联盟设计,这些导弹专门通过过载护盾发生器瘫痪大型船只,导致后续损害."

	SW_Concussion = "<color r='255' g='165' b='0' a='255'>震荡导弹</color>"
	SW_Concussion_alt = "震荡导弹"
	SW_ConcussionDesc = "一种高产量、慢速移动的导弹,能够造成毁灭性的爆炸,在广泛区域内造成巨大破坏. \n\n军火库中的标准武器,由<cyan>Dymek</cyan>制造,用于各种角色,从行星轰炸到反大型舰船作战,展示出其多功能性和威力."

	SW_HEX = "<color r='34' g='139' b='34' a='255'>六边形导弹</color>"
	SW_HEX_alt = "六边形导弹"
	SW_HEXDesc = "配备致命的三十六氦炸药,这些制导导弹能够造成灾难性的破坏和伤亡. \n\n首次在玛拉梅尔攻击中部署,这些导弹体现了太空化学战的可怕潜力,使其成为整个银河系中令人畏惧的武器."

	SW_Discord = "<color r='211' g='211' b='211' a='255'>不和谐导弹</color>"
	SW_Discord_alt = "不和谐导弹"
	SW_DiscordDesc = "发射不和谐导弹 \n\n不和谐导弹在接近目标时爆炸,释放出5-7个嗡嗡机器人,它们会吞噬敌方飞船的装甲和关键部件.嗡嗡机器人可以被点防御炮塔系统拦截.\n\n <gray>使用地雷部件</gray>"
}

Tips
{
	SW_LauncherTypes
	{
		Title = "发射器类型"
		Tip = "您可以随时更改发射器发射的导弹或地雷类型,包括在战斗中.利用这一点,用几枚意想不到的HEX导弹给敌人个惊喜!"
	}
	SW_LaserTypes
	{
		Title = "激光类型"
		Tip = "您可以随时更改激光的颜色类型,包括在战斗中.利用这一点,用一些意想不到的炫彩颜色给敌人个惊喜!"
	}
}

