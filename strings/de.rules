	//Hyperdrives
	SmallHyperdrive = "Kleiner Hyperantrieb"
	SmallHyperdriveDesc = "Eine kleine Hyperantriebseinheit passend für Raumjäger und Bomber. Benötigt einen Astromech."

	Navicomputer = "Navigations Computer"
	NavicomputerIcon = "Navicomputer"
	NavicomputerDesc = "<yellow>Entsperrt mittleren Hyperantrieb</yellow>\n\n<green>Beinhaltet Sensoren</green> \n\nEin Navigationscomputer, auch Navicomputer genannt, ist ein Gerät, das die sorgfältigen Berechnungen durchführt, die für die Navigation durch den Hyperraum notwendig sind."

	MedHyperdrive = "Mittlerer Hyperantrieb"
	MedHyperdriveDesc = "Ein Standard-Hyperantrieb, üblicherweise in Frachtern, Raumschiffen und anderen kleinen und mittelgroßen Schiffen verwendet. Benötigt einen zugewiesenen Navigationscomputer."

	HyperdriveNodeMed = "Mittlere Hyperdrive-Knotenpunkt"
	HyperdriveNodeMedIcon = "Hyperdrive-Knotenpunkt (M)"
	HyperdriveNodeMedDesc = "<orange>Benötigt mittlere Hyperdrive</orange> \nEin Knotenpunkt, der zur Erweiterung der FTL-Effizienz für Hyperdrives verwendet wird."

	LargeHyperdrive = "Großer Hyperantrieb"
	LargeHyperdriveDesc = "Eine große Hyperantriebseinheit, die üblicherweise in Sternzerstörern und anderen großen Schiffen zu finden ist. Benötigt einen dedizierten Kriegsraum."

	HyperdriveNode = "Große Hyperdrive-Knotenpunkt"
	HyperdriveNodeIcon = "Hyperdrive-Knotenpunkt (L)"
	HyperdriveNodeDesc = "Ein Knotenpunkt, der den Verbrauch von Hyperdrives senkt. Benötigt einen mittleren oder großen Hyperdrive."


	GravityWellProjector = "Gravitationswellenprojektor"
	GravityWellProjectorIcon = "Gravitationswellenprojektor"
	GravityWellProjectorDesc = "Der Gravitationswellenprojektor wird eingesetzt, um Hyperraumreisen zu unterbinden, indem er Schiffe aus dem Hyperraum zwingt oder sie am Eingang in den Hyperraum hindert. Erfordert einen Raum für die Kontrolle des Gravitationswellenprojektors."
	GravityWellProjectorControl = "Gravitationswellenprojektorsteuerung"
	GravityWellProjectorControlIcon = "Gravitationswellenprojektorsteuerung"
	GravityWellProjectorControlDesc = "Die Gravitationswellenprojektorsteuerung ist erforderlich, um einen oder mehrere Gravitationswellenprojektoren zu steuern. Erfordert Brücke 1."

	SuperIonEnergyCell = "Super-Ionenenergiezelle"
	SuperIonEnergyCellIcon = "Super-Ionenenergiezelle"
	SuperIonEnergyCellDesc = "Super-Ionenenergiezelle"

	SuperlaserCommand = "Kommando für den Todesstern-Superlaser"
	SuperlaserCommandIcon = "Superlaser-Kommando"
	SuperlaserCommandDesc = "Der DSS-Kontrollraum ist für den DSS erforderlich. Er muss hinter allen Superlaser-Emittern platziert werden und sich innerhalb von 1000 Kacheln vom entferntesten Emitter und 500 Kacheln von den Seiten befinden. Erfordert Kriegsraum."

	DSLaserTunnel = "Todesstern-Superlaser-Tunnel"
	DSLaserTunnelIcon = "Superlaser-Tunnel"
	DSLaserTunnelDesc = "DSS-Tunnel, ähnlich einem Schienenbeschleuniger. Muss oben auf dem Superlaser-Kern platziert werden. Erfordert Raum für das Superlaser-Kommando."
	DSLaserEmitter = "Todesstern-Superlaser-Emitter"
	DSLaserEmitterIcon = "Superlaser-Emitter"
	DSLaserEmitterDesc = "DSS-Emitter, ähnlich einem Schienenstartgerät. Muss oben auf dem Superlaser-Tunnel platziert werden. Erfordert Raum für das Superlaser-Kommando."
	DSLaserDirector = "Todesstern-Superlaser-Direktor"
	DSLaserDirectorIcon = "Superlaser-Direktor"
	DSLaserDirectorDesc = "DSS-Direktor, lenkt und vereint den Laserstrahl. Ähnlich einem Ionenprisma. Muss vor dem Rest der Komponenten platziert werden."
	DSLaserCore = "Zündkern des Todesstern-Superlasers"
	DSLaserCoreIcon = "Superlaser-Zündkern"
	DSLaserCoreDesc = "Der DSS-Kern, ähnlich einem Schienenlader. Erfordert Raum für das Superlaser-Kommando und den Kriegsraum."
	DirectorConnector = "Verbindungselement für den Todesstern-Superlaser-Direktor"
	DirectorConnectorIcon = "Superlaser-Direktor-Verbindungselement"
	DirectorConnectorDesc = "Das Verbindungselement für den Direktor des Superlasers wird zur Verbindung mit dem Superlaser-Direktor als Ersatz für unansehnliche Strukturen verwendet. Es zerstört sich selbst, wenn es nicht in einer Linie mit dem Direktor verbunden ist. Erfordert Superlaser-Direktor."

	IonThrusterAccelerator5x10 = "Ion-Antriebsbeschleuniger Leicht (5x10)"
	IonThrusterAccelerator5x10Icon = "Ion-Beschl. Lt"
	IonThrusterAccelerator5x10Desc = "<orange>Erfordert Kommandozentrale</orange>\n\nEin Ion-Antriebsbeschleuniger für effizienteres internes Bauen. Bietet <yellow>Energie</yellow> und einen <yellow>Geschwindigkeit</yellow>-Buff für Ion-Antriebe. Siehe Bauplan für Abdeckungsbereich.<string id='CommonStringModIDSWACD'/>"
/*Switchable for use with different side and part sizes. Buff value depends on number of accelerators and thruster size.  Requires power. */
	IonThrusterAccelerator10x20 = "Ion-Antriebsbeschleuniger 10x20"
	IonThrusterAccelerator10x20Icon = "Ion-Antriebsbeschleuniger"
	IonThrusterAccelerator10x20Desc = "Ein Ion-Antriebsbeschleuniger für effizienteres internes Bauen. Umschaltbar für die Verwendung mit verschiedenen Seiten- und Teilegrößen. Siehe Bauplan für Richtungspfeil. Die Stärke des Buffs hängt von der Anzahl der Beschleuniger und der Antriebsgröße ab. Erfordert Energie."
/*Switchable for use with different side and part sizes. Buff value depends on number of accelerators and thruster size.  Requires power. */


