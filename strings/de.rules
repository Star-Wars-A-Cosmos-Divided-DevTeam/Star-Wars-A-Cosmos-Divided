	R2Armor = "R2-D2"
	R2ArmorDesc = "<yellow>Entsperrt kleinen Hyperantrieb</yellow> \n\n<green>Beinhaltet Sensoren</green> \n\nVerbessert die Schiffssteuerung und umfasst Reparaturmodule für angrenzende Komponenten. \n\nHergestellt von <cyan>Industrial Automaton</cyan>, sind Astromech-Droiden für effiziente Raumschiffoperationen in der ganzen Galaxie unerlässlich."
	/* AI ENHANCED FROM "Includes Sensors \n\nManufactured by Industrial Automaton, Astromech droids serve as an onboard navigation computer, increase your ships sensor range, and can repair damage to adjacent components." */
