	HypermatterReactor2x2Desc = "A hypermatter reactor for small to medium ships. Unfinished WIP<string id='CommonStringModIDSWACD'/>"

	HypermatterReactor4x4 = "WIP! Heavy Hypermatter Reactor"
	HypermatterReactor4x4Icon = "WIP! Heavy Hypermatter Reactor"
	HypermatterReactor4x4Desc = "A hypermatter reactor for large ships. Unfinished WIP<string id='CommonStringModIDSWACD'/>"


