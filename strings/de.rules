	//Structures
	Structure1x1_RoundSmall = "Strukturrahmen 1x1 kleine Rundung"
	Structure1x1_RoundSmallIcon = &Structure1x1_RoundSmall
	Structure1x1_RoundSmallDesc = "Der unterliegende Strukturrahmen der alles zusammenhält.\nStruktuhrrahmen sind in Räumen und Korridoren enthalten.\n\n<color r='255' g='196' b='0'><b>Hull</b></color>\nHit points: 250\nPen. Resistance: 0\nWeight (Tons): 0.1"

	Structure1x1_RoundBig = "Strukture 1x1 Round Big"
	Structure1x1_RoundBigIcon = &Structure1x1_RoundBig
	Structure1x1_RoundBigDesc = "Der unterliegende Strukturrahmen der alles zusammenhält.\nStruktuhrrahmen sind in Räumen und Korridoren enthalten.\n\n<color r='255' g='196' b='0'><b>Hull</b></color>\nHit points: 720\nPen. Resistance: 0\nWeight (Tons): 0.24"

