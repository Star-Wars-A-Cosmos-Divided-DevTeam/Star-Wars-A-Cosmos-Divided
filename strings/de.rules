	Structure1x1_TriangleIcon = &Structure1x1_Triangle
	Structure1x1_TriangleDesc = "Der unterliegende Strukturrahmen der alles zusammenhält.\nStruktuhrrahmen sind in Räumen und Korridoren enthalten.\n\n<color r='255' g='196' b='0'><b>Hull</b></color>\nHit points: 250\nPen. Resistance: 0\nWeight (Tons): 0.1"

