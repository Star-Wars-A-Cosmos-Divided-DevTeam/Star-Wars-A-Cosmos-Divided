	Structure1x1_TriangleBigIcon = &Structure1x1_TriangleBig
	Structure1x1_TriangleBigDesc = "Der unterliegende Strukturrahmen der alles zusammenhält.\nStruktuhrrahmen sind in Räumen und Korridoren enthalten.\n\n<color r='255' g='196' b='0'><b>Hull</b></color>\nHit points: 500\nPen. Resistance: 0\nWeight (Tons): 0.16"

