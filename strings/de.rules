{
	SW_LauncherTypes
	{
		Title = "Raketen Typen"
		Tip = "Sie können jederzeit ändern, welche Art von Rakete oder Mine ein Starter abfeuert, auch während der Schlacht. Es gibt jedoch eine leichte Abkühlzeit!"
	}
	SW_LaserTypes
	{
		Title = "Laser Typen"
		Tip = "Sie können jederzeit ändern, welche Art von Laser oder PD-Laser eine Turbolaser abfeuert, auch während der Schlacht. Es gibt jedoch eine leichte Abkühlzeit!"
	}
}

