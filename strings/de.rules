	TurbolaserTiny02Icon = "Kompakter Turbolaser 2"
	TurbolaserTiny02Desc = "Kann umgeschaltet werden, um Projektile abzuwehren oder feindliche Schiffe anzugreifen"

	TurbolaserTiny03 = "Punktverteidigung/Leichter Turbolaser-Hybrid"
	TurbolaserTiny03Icon = "Kompakter Turbolaser 3"
	TurbolaserTiny03Desc = "Kann umgeschaltet werden, um Projektile abzuwehren oder feindliche Schiffe anzugreifen"

	SmallLaserCannonSwitchable = "Kleine dachmontierte Laserkanone"
	SmallLaserCannonSwitchableIcon = "Kleine dachmontierte Doppel-Laserkanone"
	SmallLaserCannonSwitchableDesc = "Kleine dachmontierte Laserkanone, die häufig bei schweren Jägern installiert wird."

	//Fixed & Directional Weapons Large -> Small
	TurbolaserFlakCannon01 = "Schwere Flugabwehrdeckkanone"
	TurbolaserFlakCannon01Icon = "Schwere Flugabwehrdeckkanone"
	TurbolaserFlakCannon01Desc = "Erfordert Munitionsfabrik"

	TurbolaserCarronade = "Turbolaser-Carronadenbatterie"
	TurbolaserCarronadeIcon = "Turbolaser-Carronade"
	TurbolaserCarronadeDesc = "Auf dem Deck montierte Turbolaserbatterie, perfekt für Breitseitemanöver. Kann hinter einer Lage Panzerblocken platziert werden."

	FixedHeavyLaser = "Fester Schwerer Laserkanone"
	FixedHeavyLaserIcon = "Fester Schwerer Laserkanone"
	FixedHeavyLaserDesc = "Kraftvolle Laserkanone mit genug Leistung, um mittelgroße bis große Kreuzer und Sternenjäger zu zerstören."

	FixedMediumLaser = "Fixierte Mittlere Laser Kanone"
	FixedMediumLaserIcon = "Fixierte Mittlere Laser Kanone"
	FixedMediumLaserDesc = "Fixierte Mittlere Laser Kanone mit genug Durchschlagskraft um kleinere Kreuzer und Sternenjäger zu zerstören."

	Smallpointlaser = "Blaster Laser"
	SmallpointlaserIcon = "Small Laser Cannon"
	SmallpointlaserDesc = "Ein kleiner <orange>wechselbarer</orange> Laser mit hoher Feuerrate. Entwickelt für Raumjäger."

	FixedLaser = "KX9 Laserkanone"
	FixedLaserIcon = "X-Wing Laser"
	FixedLaserDesc = "Die KX9 Laserkanone wurde von Taim und Bak entwickelt und ist bekannt durch die Verwendung an den X-Wings."

	FixedLaserL = "KX9 Laserkanone Links"
	FixedLaserR = "KX9 Laserkanone Rechts"

	AWFixedLaserL = "Borstel RG-9 Laserkanone"
	AWFixedLaserLIcon = "A-Wing Laserkanone Links"
	AWFixedLaserLDesc = "Die Borstel RG-9 Laserkanone wird häufig am RZ-1 A-Wing Sternenjäger verwendet. Bekannt dafür, guten Schaden an der Hülle zu verursachen. Hohe Feuerrate."

	AWFixedLaserR = "Borstel RG-9 Laserkanone"
	AWFixedLaserRIcon = "A-Wing Laserkanone Rechts"
	AWFixedLaserRDesc = "Die Borstel RG-9 Laserkanone wird häufig am RZ-1 A-Wing Sternenjäger verwendet. Bekannt dafür, guten Schaden an der Hülle zu verursachen. Hohe Feuerrate."

	fixedlasercannon = "Feststehende Laserkanone"
	fixedlasercannonIcon = "Feststehende Laserkanone"
	fixedlasercannonDesc = "Unbewegliche, leichte Laserkanone mit kleinem Platzbedarf."

	dualfixedioncannon = "Doppelläufiges Ionengeschütz, Kompakte Edition"
	dualfixedioncannonIcon = "Doppel Ion KE" // "Festes Laserkanone"
	dualfixedioncannonDesc = "Das <cyan>Rebellenallianz's</cyan> Doppelläufiges Ionengeschütz, Kompakte Edition; ein doppelläufiges, unten montiertes festes Ionengeschütz, das für präzise Angriffe und das Ausschalten feindlicher Systeme entwickelt wurde. Perfekt für Jäger und leichte Frachter in Hit-and-Run-Taktiken. \n\nBemerkenswert für seinen Einsatz auf dem <cyan>BTL Y-wing Starfighter</cyan>. <string id='CommonStringModIDSWACD'/>"

	SWMissileLauncherMedium = "Kuat-Systeme Mittlerer Raketenwerfer"
	SWMissileLauncherMediumIcon = "KSE Mittlerer Werfer"
	SWMissileLauncherMediumDesc = "Ein gut geschützter, durastahl-verstärkter automatisierter Startbucht, der verschiedene Raketentypen abfeuern kann, darunter <color r='255' g='69' b='0' a='255'>Cluster</color>, <color r='255' g='165' b='0' a='255'>Erschütterung</color>, <color r='30' g='144' b='255' a='255'>Eindringling</color> und <color r='34' g='139' b='34' a='255'>Hex</color>-Raketennutzlasten. \n\nBemerkenswert für seinen Einsatz auf dem <cyan>Kuat Systems Engineering</cyan> Venator-Klasse Sternenzerstörer. \n\n<bad>Limit 20 pro Schiff</bad> <string id='CommonStringModIDSWACD'/>"

	MissileLauncherCompact = "Kompakter Raketwerfer von Kuat Systems"
	MissileLauncherCompactIcon = "KSE Kompaktwerfer"
	MissileLauncherCompactDesc = "Ein gut geschützter, durastahl-verstärkter automatisierter Startbucht, der verschiedene Raketentypen abfeuern kann, darunter <color r='255' g='69' b='0' a='255'>Cluster</color>, <color r='255' g='165' b='0' a='255'>Erschütterung</color>, <color r='30' g='144' b='255' a='255'>Eindringling</color> und <color r='34' g='139' b='34' a='255'>Hex</color>-Raketennutzlasten. \n\nBemerkenswert für seinen Einsatz auf dem <cyan>Kuat Systems Engineering</cyan> Venator-Klasse Sternenzerstörer. \n\n<bad>Limit 20 pro Schiff</bad> <string id='CommonStringModIDSWACD'/>"

	DiscordMissileLauncher = "Discord-Raketenwerfer"
	DiscordMissileLauncherIcon = "Discord-Werfer"
	DiscordMissileLauncherDesc = "<yellow>Verwendet Minenteile</yellow>\n\nDer Discord-Raketenwerfer schickt eine mechanisierte Nutzlast, die in kurzer Entfernung zum Ziel detoniert und einen Schwarm von 5-7 Buzz-Droiden freisetzt, die die Panzerung und wesentliche Komponenten des feindlichen Schiffs zerstören. Buzz-Droiden können mit den meisten Punktverteidigungsgeschützen abgewehrt werden.\n\nUrsprünglich von der <cyan>Konföderation unabhängiger Systeme</cyan> während der Klonkriege eingesetzt, wurden diese Raketen für ihre verheerende Wirkung auf republikanische Sternenjäger berüchtigt.<string id='CommonStringModIDSWACD'/>"

	ProtonLauncher = "Protonentorpedo Abschussrampe"
	ProtonLauncherIcon = "Protonentorpedo"
	ProtonLauncherDesc = "Protonentorpedos sind sehr starke Torpedos die von kleineren Schiffen und Jägern abgefeuert werden können."
	/* AI ENHANCED FROM "Launches Proton Torpedoes. Proton torpedoes are a type of explosive ordnance used throughout the galaxy. They are highly efficient at destroying a ship's internal components." */


	//Cockpits and Command Bridges
	WarRoom = "Kriegs Raum"
	WarRoomIcon = "Kriegs Raum"
	WarRoomDesc = "<orange>Erfordert Kommandobrücke</orange>\n\n<yellow>Entsperrt Technologieebene 2</yellow>\n\n<green>Beinhaltet Signalgeber &amp; Sensoren</green> \n\nDer Kriegsraum dient als Kommunikations- und Planungszentrum und bietet zusätzliche <good>+3600<image name='command_points' colored='true'/></good> Kommandopunkte. Er ist ausgestattet mit einem Signalgeber, Langstreckensensoren und leistungsfähigen Navigationscomputern, die für die Berechnung von Hyperraumnavigationen unerlässlich sind."
/* AI ENHANCED FROM "The war room is a communications and planning center, that provides an additional +3600 Command Points. It is fully equiped with a beacon, long range sensors, and powerful navicomputers that makes the calculations necessary to navigate through hyperspace." */

	CommandBridge = "Kommandobrücke I"
	CommandBridgeIcon = "Kommandobrücke I"
	CommandBridgeDesc = "Entsperrt Tech-I Items"

	CommandBridgeCIS = "Confederacy of Independent Systems Command Bridge"
	CommandBridgeCISIcon = "CIS Bridge"

	CommandBridge2 = "Kommandobrücke II"
	CommandBridge2Icon = "Kommandobrücke II"
	CommandBridge2Desc = "Entsperrt Tech-II Items"

	SWBridge2x3 = "Corellian TradeRunner Cockpit"
	SWBridge2x3Icon = "CEC-TR Cockpit (2x3)"
	SWBridge2x3Desc = "<green>Includes Airlock &amp; Fire Extinguisher</green>\n\n<cyan>Corellian Engineering Corporation's</cyan> flagship cockpit for the smuggler who doesn't like to be noticed twice. This cockpit provides <good>+125<image name='command_points' colored='true'/></good> Command Points, making it an excellent choice for versatile freighter captains who value adaptability and performance. \n\n<magenta>Fully customizable exterior</magenta><string id='CommonStringModIDSWACD'/>"

	SWBridge3x2 = "Gallofree GalaxyHauler Cockpit"
	SWBridge3x2Icon = "GY-GH Cockpit (3x2)"
	SWBridge3x2Desc = "<green>Includes Airlock &amp; Fire Extinguisher</green>\n\n<cyan>Gallofree Yards, Inc</cyan> has created the ultimate cockpit for the freighter captain who likes to blend in at every port. This cockpit provides <good>+125<image name='command_points' colored='true'/></good> Command Points, ensuring reliable command and control for your cargo operations. \n\n<magenta>Fully customizable exterior</magenta><string id='CommonStringModIDSWACD'/>"

	Cockpit = "T-65B X-Wing Cockpit"
	CockpitIcon = "T-65B X-Wing Cockpit"
	CockpitDesc = "<green>Beinhaltet Luftschleuse &amp; Feuerlöscher</green> \n\nMeisterhaft gefertigt, um das ikonische Design des <cyan>Incom Corporation's</cyan> T-65B X-Wing Starfighters zu spiegeln, bietet dieses Cockpit <good>+35<image name='command_points' colored='true'/></good> Kommandopunkte und vereint Präzisionskontrolle mit robuster Haltbarkeit. Bekannt für seine Rolle in zahlreichen Rebellen-Siegen, bietet es die perfekte Balance aus Funktionalität und Komfort für jeden aufstrebenden Piloten.\n\n<bad>Limit (2) pro Schiff</bad>"

	CockpitT85 = "T-85 X-Wing Cockpit"
	CockpitT85Icon = "T-85 X-Wing Cockpit"
	CockpitT85Desc = "<green>Beinhaltet Luftschleuse & Feuerlöscher</green> \n\nMeisterhaft gefertigt, um das ikonische Design des <cyan>Incom Corporation's</cyan> T-85 X-Wing Sternenjägers widerzuspiegeln, bietet dieses Cockpit <good>+50<image name='command_points' colored='true'/></good> Kommandopunkte und vereint präzise Kontrolle mit robuster Haltbarkeit. Bekannt für seine Rolle in zahlreichen Rebellensiegen, bietet es die perfekte Balance aus Funktionalität und Komfort für jeden angehenden Piloten.\n\n<bad>Limit (1) pro Schiff</bad>"

	CockpitHid = "Verstecktes Cockpit"
	CockpitHidIcon = "Verstecktes Cockpit"
	CockpitHidDesc = "<green>Beinhaltet Feuerlöscher</green> \n\nFür Tarnung und Feingefühl entworfen, behält dieses versteckte Cockpit alle wesentlichen Funktionen bei und integriert sich nahtlos in das Design Ihres Sternenjägers. Bietet <good>+25<image name='command_points' colored='true'/></good> Kommandopunkte für Missionen, die ein unauffälliges Profil erfordern, ohne dabei auf Funktionalität zu verzichten."

	CockpitARC = "ARC-Sternenjäger-Cockpit"
	CockpitARCIcon = "ARC-Sternenjäger-Cockpit"
	CockpitARCDesc = "<green>Beinhaltet Luftschleuse &amp; Feuerlöscher</green> \n\nEin Mehrzweck-Cockpit, entworfen für die <cyan>Kuat Systems Engineering's</cyan> ARC Sternenjäger, bekannt für ihre Robustheit und Vielseitigkeit. Dieses Cockpit bietet <good>+50<image name='command_points' colored='true'/></good> Kommandopunkte.\n\n<bad>Limit (2) pro Schiff</bad>"

	Cockpit2 = "TIE-Jäger Cockpit"
	Cockpit2Icon = "<green>Beinhaltet Luftschleuse &amp; Feuerlöscher</green> \n\nSpiegelt den unverwechselbaren Stil der <cyan>Sienar Fleet System's</cyan> TIE-Jäger wider, dieses Cockpit ist für Einzelgänger-Piloten konzipiert. Bietet <good>+45<image name='command_points' colored='true'/></good> Kommandopunkte, eine uneingeschränkte Sicht und kompakte Steuerungssysteme, die die Effizienz und Minimalismus des imperialen Designs verkörpern.\n\n<red>Limit (1) pro Schiff</red>"
	Cockpit2Desc = "Ein Cockpit, das den Stil der Imperialen TIE-Jäger und dessen Varianten ähnelt."

	Cockpit2_1 = "TIE Series Cockpit Mk1"
	Cockpit2_1Icon = "TIE Fighter Cockpit Mk1"
	Cockpit2_1Desc = "Simplified TIE Fighter Cockpit. Equipped with fast Ion Engines, an Ia3-b Solar Ionization Reactor, a Titanium Hull and dual Fabritech Sensor Arrays."

	Cockpit2_2 = "TIE Series Cockpit Mk2"
	Cockpit2_2Icon = "TIE Fighter Cockpit Mk2"
	Cockpit2_2Desc = "Standard-Issue TIE Fighter Cockpit. Equipped with fast Ion Engines, dual Ls-1 Laser Cannons, an Ia3-b Solar Ionization Reactor, a Titanium Hull and dual Fabritech Sensor Arrays."

	Eta2 = "Eta-2 Actis Abfangjäger Cockpit (Bewaffnet)"
	Eta2Icon = "Eta-2 Actis Cockpit"
	Eta2Desc = "<green>Beinhaltet Luftschleuse, Feuerlöscher, &amp; Bett</green> \n\nGefertigt im Bild des Eta-2 Actis Abfangjägers von <cyan>Kuat Systems Engineering</cyan>, ist dieses Cockpit ausgestattet mit zwei frontmontierten Laserkanonen. Bietet <good>+45<image name='command_points' colored='true'/></good> Kommandopunkte und vereint Agilität mit Feuerkraft, und verkörpert die Präzision und Eleganz des Jedi-Sternenjägers. Entworfen für längere Missionen, beinhaltet es einen kompakten Schlafbereich für ein Besatzungsmitglied, um Bereitschaft für langanhaltende Einsätze zu gewährleisten. \n\n<bad>Begrenzung (1) pro Schiff</bad>"
	/* AI ENHANCED FROM "Cockpit from Eta-2 Actis Interceptor with front-mounted dual Laser Cannons." */


	//Crew Quarters Large -> Small
	BenchSW1x2 = "Sitz Raum"
	BenchSW1x2Icon = "Sitze"
	BenchSW1x2Desc = "Ein Raum mit Sitzen für Schiffe die normalerweise nicht auf lange Reisen gehen."

	Smallbed = "Einzelnes Bett"
	SmallbedDesc = "Ein Einzelnes Bett für kleinere Schiffe und Raumjäger."


	//Durasteel Reinforced Reactors
	SW_TinyReactor = "Sternenjäger Reaktor" //Should be "Compact Hypermatter Reactor"
	SW_TinyReactorIcon = "Compact Reactor"
	SW_TinyReactorDesc = "Ein kleinerer, weniger effizienter Reaktor für Sternenjäger und kleinere Schiffe."

	SW_SmallReactor = "Light Reinforced Reactor"
	SW_SmallReactorIcon = "Light Reactor"
	SW_SmallReactorDesc = "<cyan>Corellian Engineering Corp.</cyan> Light Reinforced Reactor; Engineered with durasteel reinforcement, this reactor combines efficiency with minimal space usage, ideal for medium to large cruisers and frigates seeking state-of-the-art power solutions.<string id='CommonStringModIDSWACD'/>"

	SW_HeavyReactor = "Heavy Reinforced Reactor"
	SW_HeavyReactorIcon = "Heavy Reactor"
	SW_HeavyReactorDesc = "<cyan>Sienar Fleet Systems</cyan> Heavy Reinforced Reactor; A durasteel-armored powerhouse, designed for large star destroyers and flagships. This reactor epitomizes efficiency and compact design, sidelining bulky, obsolete models.<string id='CommonStringModIDSWACD'/>"

	//Hypermatter Reactors
	HypermatterReactor12x12 = "Hypermatter Reactor 12x12"
	HypermatterReactor12x12Icon = "Hypermatter Reactor 12x12"
	HypermatterReactor12x12Desc = "Hypermatter Reactor 12x12"
	HypermatterReactor30x30 = "Hypermatter Reactor 30x30"
	HypermatterReactor30x30Icon = "Hypermatter Reactor 30x30"
	HypermatterReactor30x30Desc = "Hypermatter Reactor 30x30"

	//Hyperium Generators
