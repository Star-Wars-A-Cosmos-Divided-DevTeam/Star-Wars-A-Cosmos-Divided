// Raketentypen
MissileTypes
{
	SW_Cluster = "<color r='255' g='69' b='0' a='255'>Cluster-Rakete</color>"
	SW_ClusterDesc = "Schnell einsatzbereite, gelenkte Raketen, die mehrere Sprengköpfe abwerfen, die jeweils erheblichen Schaden in einem kleinen Gebiet verursachen. \n\nInspiriert von der Fähigkeit verschiedener Angriffsschiffe, diese Raketen schnell abzufeuern, sind sie hervorragend geeignet, um konzentrierte feindliche Verteidigungen zu durchbrechen."

	SW_Intruder = "<color r='30' g='144' b='255' a='255'>Eindringlingsrakete</color>"
	SW_IntruderDesc = "Eine hochentwickelte gelenkte Rakete, die beim Aufprall einen starken elektromagnetischen Impuls abgibt und speziell darauf abzielt, Energie aus feindlichen Systemen abzuleiten. \n\nEntwickelt von <cyan>Slayn &amp; Korpil</cyan> für die Rebellenallianz, sind diese Raketen darauf spezialisiert, große Schiffe lahmzulegen, indem sie die Schildgeneratoren überlasten und so nachfolgende Schäden verursachen."

	SW_Concussion = "<color r='255' g='165' b='0' a='255'>Erschütterungsrakete</color>"
	SW_ConcussionDesc = "Eine hochexplosive, langsam fliegende Rakete, die eine verheerende Explosion verursacht und massiven Schaden in einem weiten Gebiet anrichtet. \n\nEin Standard in militärischen Arsenalen, hergestellt von <cyan>Dymek</cyan>, und vielseitig einsetzbar, von planetaren Bombardements bis hin zu Gefechten gegen große Kriegsschiffe."

	SW_HEX = "<color r='34' g='139' b='34' a='255'>Hex-Rakete</color>"
	SW_HEXDesc = "Mit einer tödlichen Trihexalon-Ladung bewaffnet, sind diese gelenkten Raketen in der Lage, katastrophale Schäden und Verluste zu verursachen. \n\nErstmals beim Angriff auf Maramere eingesetzt, verkörpern diese Raketen das schreckliche Potenzial chemischer Kriegsführung im Weltraum und sind daher in der ganzen Galaxis gefürchtet."

	SW_Discord = "<color r='211' g='211' b='211' a='255'>Discord-Rakete</color>"
	SW_DiscordDesc = "Feuert Discord-Raketen ab \n\nDiscord-Raketen detonieren in kurzer Entfernung zu ihrem Ziel und setzen einen Schwarm von 5-7 Buzz-Droiden frei, die die Panzerung und wesentliche Komponenten des feindlichen Schiffs zerstören. Buzz-Droiden können mit Punktverteidigungstürmen abgewehrt werden.\n\n <gray>Verwendet Minenteile</gray>"
}


