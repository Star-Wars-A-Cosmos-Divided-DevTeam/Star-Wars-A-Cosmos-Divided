	SmallHyperdrive = "Kleiner Hyperantrieb"
	SmallHyperdriveDesc = "Eine kleine Hyperantriebseinheit passend für Raumjäger und Bomber. Benötigt einen Astromech."
	MedHyperdrive = "Mittlerer Hyperantrieb"
	MedHyperdriveDesc = "Ein Standard-Hyperantrieb, üblicherweise in Frachtern, Raumschiffen und anderen kleinen und mittelgroßen Schiffen verwendet. Benötigt einen zugewiesenen Navigationscomputer."
	LargeHyperdrive = "Großer Hyperantrieb"
	LargeHyperdriveDesc = "Eine große Hyperantriebseinheit, die üblicherweise in Sternzerstörern und anderen großen Schiffen zu finden ist. Benötigt einen dedizierten Kriegsraum."

	Navicomputer = "Navigations Computer"
	NavicomputerIcon = "Navicomputer"
	NavicomputerDesc = "<yellow>Entsperrt mittleren Hyperantrieb</yellow>\n\n<green>Beinhaltet Sensoren</green> \n\nEin Navigationscomputer, auch Navicomputer genannt, ist ein Gerät, das die sorgfältigen Berechnungen durchführt, die für die Navigation durch den Hyperraum notwendig sind."

	WarRoom = "Kriegs Raum"
	WarRoomIcon = "Kriegs Raum"
	WarRoomDesc = "<orange>Erfordert Kommandobrücke</orange>\n\n<yellow>Entsperrt Technologieebene 2</yellow>\n\n<green>Beinhaltet Signalgeber &amp; Sensoren</green> \n\nDer Kriegsraum dient als Kommunikations- und Planungszentrum und bietet zusätzliche <good>+3600<image name='command_points' colored='true'/></good> Kommandopunkte. Er ist ausgestattet mit einem Signalgeber, Langstreckensensoren und leistungsfähigen Navigationscomputern, die für die Berechnung von Hyperraumnavigationen unerlässlich sind."

	HyperdriveNode = "Große Hyperdrive-Knotenpunkt"
	HyperdriveNodeIcon = "Hyperdrive-Knotenpunkt (L)"
	HyperdriveNodeDesc = "Ein Knotenpunkt, der den Verbrauch von Hyperdrives senkt. Benötigt einen mittleren oder großen Hyperdrive."

	HyperdriveNodeMed = "Mittlere Hyperdrive-Knotenpunkt"
	HyperdriveNodeMedIcon = "Hyperdrive-Knotenpunkt (M)"
	HyperdriveNodeMedDesc = "<orange>Benötigt mittlere Hyperdrive</orange> \nEin Knotenpunkt, der zur Erweiterung der FTL-Effizienz für Hyperdrives verwendet wird."

	GravityWellProjector = "Gravitationswellenprojektor"
	GravityWellProjectorIcon = "Gravitationswellenprojektor"
	GravityWellProjectorDesc = "Der Gravitationswellenprojektor wird eingesetzt, um Hyperraumreisen zu unterbinden, indem er Schiffe aus dem Hyperraum zwingt oder sie am Eingang in den Hyperraum hindert. Erfordert einen Raum für die Kontrolle des Gravitationswellenprojektors."
	GravityWellProjectorControl = "Gravitationswellenprojektorsteuerung"
	GravityWellProjectorControlIcon = "Gravitationswellenprojektorsteuerung"
	GravityWellProjectorControlDesc = "Die Gravitationswellenprojektorsteuerung ist erforderlich, um einen oder mehrere Gravitationswellenprojektoren zu steuern. Erfordert Brücke 1."

	SuperIonEnergyCell = "Super-Ionenenergiezelle"
	SuperIonEnergyCellIcon = "Super-Ionenenergiezelle"
	SuperIonEnergyCellDesc = "Super-Ionenenergiezelle"

	SuperlaserCommand = "Kommando für den Todesstern-Superlaser"
	SuperlaserCommandIcon = "Superlaser-Kommando"
	SuperlaserCommandDesc = "Der DSS-Kontrollraum ist für den DSS erforderlich. Er muss hinter allen Superlaser-Emittern platziert werden und sich innerhalb von 1000 Kacheln vom entferntesten Emitter und 500 Kacheln von den Seiten befinden. Erfordert Kriegsraum."

	DSLaserTunnel = "Todesstern-Superlaser-Tunnel"
	DSLaserTunnelIcon = "Superlaser-Tunnel"
	DSLaserTunnelDesc = "DSS-Tunnel, ähnlich einem Schienenbeschleuniger. Muss oben auf dem Superlaser-Kern platziert werden. Erfordert Raum für das Superlaser-Kommando."
	DSLaserEmitter = "Todesstern-Superlaser-Emitter"
	DSLaserEmitterIcon = "Superlaser-Emitter"
	DSLaserEmitterDesc = "DSS-Emitter, ähnlich einem Schienenstartgerät. Muss oben auf dem Superlaser-Tunnel platziert werden. Erfordert Raum für das Superlaser-Kommando."
	DSLaserDirector = "Todesstern-Superlaser-Direktor"
	DSLaserDirectorIcon = "Superlaser-Direktor"
	DSLaserDirectorDesc = "DSS-Direktor, lenkt und vereint den Laserstrahl. Ähnlich einem Ionenprisma. Muss vor dem Rest der Komponenten platziert werden."
	DSLaserCore = "Zündkern des Todesstern-Superlasers"
	DSLaserCoreIcon = "Superlaser-Zündkern"
	DSLaserCoreDesc = "Der DSS-Kern, ähnlich einem Schienenlader. Erfordert Raum für das Superlaser-Kommando und den Kriegsraum."
	DirectorConnector = "Verbindungselement für den Todesstern-Superlaser-Direktor"	
	DirectorConnectorIcon = "Superlaser-Direktor-Verbindungselement"
	DirectorConnectorDesc = "Das Verbindungselement für den Direktor des Superlasers wird zur Verbindung mit dem Superlaser-Direktor als Ersatz für unansehnliche Strukturen verwendet. Es zerstört sich selbst, wenn es nicht in einer Linie mit dem Direktor verbunden ist. Erfordert Superlaser-Direktor."

	fixedlasercannon = "Feststehende Laserkanone"
	fixedlasercannonIcon = "Feststehende Laserkanone"
	fixedlasercannonDesc = "Unbewegliche, leichte Laserkanone mit kleinem Platzbedarf."

	MediumIonCannon = "Mittlere Ionenkanone"
	MediumIonCannonIcon = "Mittlere Ionenkanone"
	MediumIonCannonDesc = "Ionenwaffe, die in der Lage ist, Schilde zu deaktivieren und dem feindlichen Schiff wenig bis gar keinen Schaden zuzufügen."

	MegaIonImpulseCannon = "Mega-Ionenimpulskanone"
	MegaIonImpulseCannonIcon = "Mega-Ionenimpulskanone"
	MegaIonImpulseCannonDesc = "Die Mega-Ionenimpulskanone auf der Subjugator-Klasse kann eine ganze Flotte lahmlegen. Benötigt Ion Impulse Accelerator Segment Teil."

	IonImpulseAccelerator = "Ionenimpulsbeschleuniger"
	IonImpulseAcceleratorIcon = "Ionenimpulsbeschleuniger"
	IonImpulseAcceleratorDesc = "Ionenimpulsbeschleuniger"

	OctupleBarbetteTurbolaser = "Achtfach-Barbette-Turbolaser"
	OctupleBarbetteTurbolaserIcon = "Achtfach-Barbette-Turbolaser"
	OctupleBarbetteTurbolaserDesc = "Leistungsstarke Salve der schweren imperialen Turbolasertechnologie. Benötigt Kommandobrücke."

	SiegeTurbolaser12x12Desc = "<orange>Benötigt Kommandobrücke</orange> \n\nDer doppelte 70TT Super-Schwere Turbolaser, auch bekannt als 'Belagerungsturm', ist eine gewaltige Kriegswaffe. Entwickelt für Belagerungen, feuert er explosive Laserstrahlen in einem begrenzten Bogen ab, die feindliche Befestigungen und Großkampfschiffe verheeren. Obwohl seine langsame Feuerrate und Bewegung die Wirksamkeit gegen wendige Kämpfer einschränken kann, macht die schiere Zerstörungskraft des Turms ihn zu einem entscheidenden Vermögen beim Durchbrechen der stärksten Verteidigungen."
	SiegeTurbolaser12x12 = "Doppelter 70TT Super-Schwerer Turbolaser"
	SiegeTurbolaser12x12Icon = "D70TT SH-Turbolaser"

	TurbolaserHuge01 = "Schwerer Teraton-Turbolaser (Einzelläufig)"
	TurbolaserHuge01Icon = "SH-TT Turbolaser"
	TurbolaserHuge01Desc = "<orange>Erfordert Kriegsraum</orange> \n\nEinzelläufiger schwerer Turbolaser, der Salven für hohe Durchschlagskraft und Explosionsschaden abfeuert. Schnelleres Feuern und Drehen im Vergleich zu den doppelläufigen und dreiläufigen Versionen. \n\nBekannt für seinen Einsatz auf dem <cyan>Kuat-Triebwerksingenieur</cyan> Venator-Klasse Sternenzerstörer.<string id='CommonStringModIDSWACD'/>"

	TurbolaserHuge02 = "Schwerer Teraton-Turbolaser (Doppelläufig)"
	TurbolaserHuge02Icon = "DH-TT Turbolaser"
	TurbolaserHuge02Desc = "<orange>Erfordert Kriegsraum</orange> \n\nDoppelläufiger schwerer Turbolaser, der Salven für hohe Durchschlagskraft und Explosionsschaden abfeuert. Langsameres Feuern und Drehen als die einzelläufige Version, aber schneller als die dreiläufige Version. \n\nBekannt für seinen Einsatz auf dem <cyan>Kuat-Triebwerksingenieur</cyan> Venator-Klasse Sternenzerstörer.<string id='CommonStringModIDSWACD'/>"

	TurbolaserHuge03 = "Schwerer Teraton-Turbolaser (Dreiläufig)"
	TurbolaserHuge03Icon = "TH-TT Turbolaser"
	TurbolaserHuge03Desc = "<orange>Erfordert Kriegsraum</orange> \n\nDreiläufiger schwerer Turbolaser, der Salven für hohe Durchschlagskraft und Explosionsschaden abfeuert. Langsameres Feuern und Drehen im Vergleich zu den einzelläufigen und doppelläufigen Versionen. \n\nBekannt für seinen Einsatz auf dem <cyan>Kuat-Triebwerksingenieur</cyan> Venator-Klasse Sternenzerstörer.<string id='CommonStringModIDSWACD'/>"


	TurbolaserCarronade = "Turbolaser-Carronadenbatterie"
	TurbolaserCarronadeIcon = "Turbolaser-Carronade"
	TurbolaserCarronadeDesc = "Auf dem Deck montierte Turbolaserbatterie, perfekt für Breitseitemanöver. Kann hinter einer Lage Panzerblocken platziert werden."
