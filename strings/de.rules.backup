	DepositDoonium3xHard = "Doonium 3x Hart"
	DepositDoonium3xHardIcon = "Doonium 3x Hart"

	//Factories
	FactoryDuraSteel = "Durastahl Schmelze"
	FactoryDuraSteelIcon = "Durastahl Schmelze"
	FactoryDuraSteelDesc = "Stellt Durastahl-barren her, die zur Konstruktion einiger fortschrittlicher Rüstungsteile verwendet werden. Verbraucht Kohlenstoff und Zersium. Gewinnt +25% Produktionsgeschwindigkeit für jede angrenzende Fabrik beliebigen Typs."
	
	FactoryDoonium = "Doonium Schmiede"
	FactoryDooniumIcon = "Doonium Schmiede"
	FactoryDooniumDesc = "Stellt Doonium-barren her, die zur Konstruktion einiger fortschrittlicher Rüstungsteile verwendet werden. Verbraucht Doonium. Gewinnt +25% Produktionsgeschwindigkeit für jede angrenzende Fabrik beliebigen Typs."

	SWMiningLaserHuge = "Corellianischer RockSplitter XL"
	SWMiningLaserHugeIcon = &SWMiningLaserHuge
	SWMiningLaserHugeDesc = "Sendet zwei präzise kyber-verstärkte Strahlen aus, die in der Lage sind, Ressourcen aus selbst den widerstandsfähigsten Asteroiden wie Durastahl und Doonium schnell zu extrahieren. Auch geeignet für Schiffsverwertungsoperationen und kann bei Bedarf als Kurzstrecken-Offensivlaser dienen."

	//Thrusters
	IonThruster01_1x1 = "Ionen Antrieb 1x1"
	IonThruster01_1x1_Icon = &IonThruster01_1x1
	IonThrusterDesc = "Ein Antriebsemitter, der das Schiff mithilfe von Ionen-Emission beschleunigen kann. Bei anhaltender Benutzung boostet der Antrieb sich selbst auf 160% der Grund-Antriebskraft. Die Farbe des Antriebs sowie die Art der Effekt können über Schalter verändert werden"

	IonThruster01_1x2 = "Ionen Antrieb 1x2"
	IonThruster01_1x2_Icon = &IonThruster01_1x2
	IonThruster01_1x2_Desc = &IonThrusterDesc

	IonThruster01_2x2 = "Ionen Antrieb 2x2"
	IonThruster01_2x2_Icon = &IonThruster01_2x2
	IonThruster01_2x2_Desc = &IonThrusterDesc

	IonThruster01_2x3 = "Ionen-Triebwerk 2x3 \"Booster\""
	IonThruster01_2x3_Icon = "Booster-Triebwerk 2x3"
	IonThruster01_2x3_Desc = "Eine spezialisierte Variante des <cyan>Kuat Drive Yards</cyan> Ionen-Triebwerks 2x2, dieses Modell kann Roh-Hypermaterie direkt in seine Ionisationskammer einspritzen für einen kraftvollen, doch kurzlebigen Schub. Die Energiezufuhr wird während des Boostens unterbrochen, um alle Ressourcen auf den Beschleunigungsschub zu konzentrieren."
	
	IonThruster01_3x3 = "Ionen Antrieb 3x3"
	IonThruster01_3x3_Icon = &IonThruster01_3x3
	IonThruster01_3x3_Desc = &IonThrusterDesc

	IonThruster01_3x4 = "Ion Thruster 3x4 \"Hauler\""
	IonThruster01_3x4_Icon = "\"Hauler\" Thruster 3x4"
	IonThruster01_3x4_Desc = "Durch die renommierten <cyan>Kuat Drive Yards</cyan> verbessert, baut der Ion \"Hauler\" Thruster 3x4 auf dem Fundament seines Vorgängers, dem 3x3 Modell, auf. Während die Skalierbarkeit und Kompatibilität über verschiedene Raumschiffklassen hinweg beibehalten wird, bietet dieses Modell verbesserte Haltbarkeit und deutlich erhöhte Geschwindigkeit für ausgedehnte, non-stop Reisen durch das Kosmos. Sein ausgeklügeltes Ionenantriebssystem verspricht nicht nur zuverlässige Leistung, sondern auch überlegenen Schub und Präzision bei Langstreckenoperationen."

	IonThruster01_7x10 = "Ionenantrieb 7x10"
	IonThruster01_7x10_Icon = &IonThruster01_7x10
	IonThrusterBigDesc = "Ein Antriebsmotor, der das Schiff mit großer Kraft schieben kann. Erfordert Brücke 1."

	IonThruster01_8x16 = "Ionenantrieb 8x16"
	IonThruster01_8x16_Icon = &IonThruster01_8x16
	IonThruster01_8x16_Desc = &IonThrusterBigDesc

	IonThruster01_10x14 = "Ionenantrieb 10x14"
	IonThruster01_10x14_Icon = &IonThruster01_10x14
	IonThruster01_10x14_Desc = &IonThrusterBigDesc

	IonThruster01_20x26 = "Ionenantrieb 20x26"
	IonThruster01_20x26_Icon = &IonThruster01_20x26
	IonThruster01_20x26_Desc = "<orange>Benötigt Kommandobrücke, Kriegsraum &amp; Großes Hyperantrieb</orange>\n\n<cyan>Kuat-Triebwerkswerften</cyan> haben diese Ionen-Triebwerke speziell für die größten Kapitalschiffe entwickelt. Ihre effiziente Ionenantriebstechnologie gewährleistet eine zuverlässige Leistung für verschiedene Anwendungen. Bekannt für konstanten Schub und Präzision, zeichnen sie sich in verschiedenen Betriebskontexten aus."

	rcs = "Steuerungs Triebwerk"
	rcsIcon = "Steuerungs Triebwerk"
	rcsDesc = "Ein kleines Triebwerk das zum Steuern verwendet wird."

	XWingThrusterSingle = "X-Wing Triebwerk (Einzeln)"
	XWingThrusterSingleIcon = "X-Wing Triebwerk (Einzeln)"
	XWingThrusterSingleDesc = "Abgeleitet vom ikonischen T-65 X-Wing Design, bietet diese einzelne Triebwerkseinheit verbesserte Manövrierfähigkeit und Geschwindigkeit für eine Seite eines Raumschiffs. Sein kompakter, aber leistungsstarker Motor ist perfekt für agile Kurven und schnelle Beschleunigung, was es ideal für Jäger und kleine Raumschiffe macht, die eine asymmetrische Schubkraft benötigen.\n\n<bad>Limit (2) pro Schiff</bad>"

	XWingThrusterDual = "X-Wing Triebwerk (Dual)"
	XWingThrusterDualIcon = "X-Wing Triebwerk (Dual)"
	XWingThrusterDualDesc = "Dieses Dual-Triebwerk, inspiriert von der legendären T-65 X-Wing, bietet ausgewogenen und robusten Antrieb für eine Vielzahl von Raumfahrzeugen. Mit synchronisierter Leistung und Kontrolle ist es ideal für überlegene Geschwindigkeit und Stabilität, insbesondere bei mittelgroßen Schiffen und Jägern, die symmetrische Schubkraftfähigkeiten benötigen.\n\n<bad>Limit (1) pro Schiff</bad>"

	//Weapons
	Heavyturbolaserswitchable = "Schwerer Turbolaser"
	HeavyturbolaserswitchableIcon = "Schwerer Turbolaser"
	HeavyturbolaserswitchableDesc = "Eine <orange>wechselbare</orange> Standardausgabe des schweren Turbolasers, ein häufiger Anblick im <cyan>Star Wars</cyan> Universum"

	Medturbolaserswitchable = "Mittlerer Turbolaser Turm"
	MedturbolaserswitchableIcon = "Mittlerer Turbolaser Turm"
	MedturbolaserswitchableDesc = "Eine <orange>wechselbare</orange> kleinere Version des Schweren Turbolasers"

	CISturbolaserswitchable = "CIS Turbolaser Schwerer"
	CISturbolaserswitchableIcon = "CIS Turbolaser"
	CISturbolaserswitchableDesc = "A Mittlerer-quality, but cheap turbolaser used by the Confederacy of Independant Systems on warships."

	Imperialturbolaserswitchable = "Imperium Turbolaser Schwerer"
	ImperialturbolaserswitchableIcon = "Imperium Turbolaser"
	ImperialturbolaserswitchableDesc = "The highest quality Turbolaser used on Imperial warships and space stations."

	Republicturbolaserswitchable = "Republik Turbolaser"
	RepublicturbolaserswitchableIcon = "Republik Turbolaser"
	RepublicturbolaserswitchableDesc = "A high-quality Turbolaser used on Republic cruisers and warships during the Clone War."

	XX9turbolaserswitchable = "XX-9 Turbolaser Turm"
	XX9turbolaserswitchableIcon = "Schwerer Turbolaser Turm"
	XX9turbolaserswitchableDesc = "Der <orange>wechselbare</orange> originale Turbolaser aus der Grabenlaufszene. Der XX-9 Turbolaser war ein weithin erschwinglicher Turbolaser"

	DualLaserCannonSwitchable = "Doppelläufige Laser Kannone"
	DualLaserCannonSwitchableIcon = "Doppelläufiger Laser Kannonen"
	DualLaserCannonSwitchableDesc =  "Ein <orange>wechselbarer</orange> doppelläufiger Laser Kannonen, dessen Hauptzweck es ist, feindliche Kämpfer zu besiegen"

	LightTurbolaserswitchable = "Leichter Turbolaser"
	LightTurbolaserswitchableIcon = "Leichter Turbolaser"
	LightTurbolaserswitchableDesc = "Ein <orange>wechselbarer</orange> leichter Turbolaser, welcher sowohl gegen Kämpfer als auch gegen Großschiffe wirksam ist"

	TripleTurboLaser = "Dreiläufiger Turbolaser Turm"
	TripleTurboLaserIcon = "Dreiläufiger Turbolaser Turm"
	TripleTurboLaserDesc = "Ein <orange>wechselbarer</orange> Dreiläufiger Turbolaser Turm"

	HeavyIonCannon = "Schwerer Ionen-Kanone"
	HeavyIonCannonIcon = "Schwerer Ionen-Kanone"
	HeavyIonCannonDesc = "Starke Ionenwaffe, die in der Lage ist, Schilde zu deaktivieren und dem feindlichen Schiff wenig bis gar keinen Schaden zuzufügen. Wenn sie richtig eingesetzt wird, können einige schwere Ionenkanonen den Ausgang der Schlacht verändern."

	FixedMediumLaser = "Fixierte Mittlere Laser Kanone"
	FixedMediumLaserIcon = "Fixierte Mittlere Laser Kanone"
	FixedMediumLaserDesc = "Fixierte Mittlere Laser Kanone mit genug Durchschlagskraft um kleinere Kreuzer und Sternenjäger zu zerstören."

	FixedHeavyLaser = "Fester Schwerer Laserkanone"
	FixedHeavyLaserIcon = "Fester Schwerer Laserkanone"
	FixedHeavyLaserDesc = "Kraftvolle Laserkanone mit genug Leistung, um mittelgroße bis große Kreuzer und Sternenjäger zu zerstören."

	FalconLaserCannon = "AG-2G Vierfache Laser Kanone"
	FalconLaserCannonIcon = "Millenium Falcon Laser Kanone"
	FalconLaserCannonDesc = "Starke vierläufige Laser Kannone. Wird insbesondere bei Fregatten der Millennium Falcon- und Imperial Lancer-Klasse verwendet. Wirksam gegen Starfighter."

	Smallbed = "Einzelnes Bett"
	SmallbedDesc = "Ein Einzelnes Bett für kleinere Schiffe und Raumjäger."

	Smallpointlaser = "Blaster Laser"
	SmallpointlaserDesc = "Ein kleiner <orange>wechselbarer</orange> Laser mit hoher Feuerrate. Entwickelt für Raumjäger."

	dualfixedioncannon = "Doppelläufiges Ionengeschütz, Kompakte Edition"
	dualfixedioncannonIcon = "Doppel Ion KE" // "Festes Laserkanone"
	dualfixedioncannonDesc = "Das <cyan>Rebellenallianz's</cyan> Doppelläufiges Ionengeschütz, Kompakte Edition; ein doppelläufiges, unten montiertes festes Ionengeschütz, das für präzise Angriffe und das Ausschalten feindlicher Systeme entwickelt wurde. Perfekt für Jäger und leichte Frachter in Hit-and-Run-Taktiken. \n\nBemerkenswert für seinen Einsatz auf dem <cyan>BTL Y-wing Starfighter</cyan>. <string id='CommonStringModIDSWACD'/>"


	SW_TinyReactor = "Sternenjäger Reaktor" //Should be "Compact Hypermatter Reactor"
	SW_TinyReactorDesc = "Ein kleinerer, weniger effizienter Reaktor für Sternenjäger und kleinere Schiffe."

	Reactor = "Hypermatter Reactor"
	ReactorIcon = "Hypermatter Reactor"
	ReactorDesc = "A hypermatter reactor for small ships."

	HypermatterReactor12x12 = "Hypermatter Reactor 12x12"
	HypermatterReactor12x12Icon = "Hypermatter Reactor 12x12"
	HypermatterReactor12x12Desc = "Hypermatter Reactor 12x12"
	HypermatterReactor30x30 = "Hypermatter Reactor 30x30"
	HypermatterReactor30x30Icon = "Hypermatter Reactor 30x30"
	HypermatterReactor30x30Desc = "Hypermatter Reactor 30x30"

	Cockpit = "T-65B X-Wing Cockpit"
	CockpitIcon = "T-65B X-Wing Cockpit"
	CockpitDesc = "<green>Beinhaltet Luftschleuse &amp; Feuerlöscher</green> \n\nMeisterhaft gefertigt, um das ikonische Design des <cyan>Incom Corporation's</cyan> T-65B X-Wing Starfighters zu spiegeln, bietet dieses Cockpit <good>+35<image name='command_points' colored='true'/></good> Kommandopunkte und vereint Präzisionskontrolle mit robuster Haltbarkeit. Bekannt für seine Rolle in zahlreichen Rebellen-Siegen, bietet es die perfekte Balance aus Funktionalität und Komfort für jeden aufstrebenden Piloten.\n\n<bad>Limit (2) pro Schiff</bad>"

	CockpitT85 = "T-85 X-Wing Cockpit"
	CockpitT85Icon = "T-85 X-Wing Cockpit"
	CockpitT85Desc = "<green>Beinhaltet Luftschleuse & Feuerlöscher</green> \n\nMeisterhaft gefertigt, um das ikonische Design des <cyan>Incom Corporation's</cyan> T-85 X-Wing Sternenjägers widerzuspiegeln, bietet dieses Cockpit <good>+50<image name='command_points' colored='true'/></good> Kommandopunkte und vereint präzise Kontrolle mit robuster Haltbarkeit. Bekannt für seine Rolle in zahlreichen Rebellensiegen, bietet es die perfekte Balance aus Funktionalität und Komfort für jeden angehenden Piloten.\n\n<bad>Limit (1) pro Schiff</bad>"

	CockpitHid = "Verstecktes Cockpit"
	CockpitHidIcon = "Verstecktes Cockpit"
	CockpitHidDesc = "<green>Beinhaltet Feuerlöscher</green> \n\nFür Tarnung und Feingefühl entworfen, behält dieses versteckte Cockpit alle wesentlichen Funktionen bei und integriert sich nahtlos in das Design Ihres Sternenjägers. Bietet <good>+25<image name='command_points' colored='true'/></good> Kommandopunkte für Missionen, die ein unauffälliges Profil erfordern, ohne dabei auf Funktionalität zu verzichten."
	/*AI Enhanced from "Gleiches Cockpit, aber versteckt."*/
	
	CockpitARC = "ARC-Sternenjäger-Cockpit"
	CockpitARCIcon = "ARC-Sternenjäger-Cockpit"
	CockpitARCDesc = "<green>Beinhaltet Luftschleuse &amp; Feuerlöscher</green> \n\nEin Mehrzweck-Cockpit, entworfen für die <cyan>Kuat Systems Engineering's</cyan> ARC Sternenjäger, bekannt für ihre Robustheit und Vielseitigkeit. Dieses Cockpit bietet <good>+50<image name='command_points' colored='true'/></good> Kommandopunkte.\n\n<bad>Limit (2) pro Schiff</bad>"
	/*AI Enhanced from "Ein Mehrzweck-Cockpit, entwickelt für die ARC-Sternenjäger von Kuat Systems Engineering, bekannt für ihre Robustheit und Vielseitigkeit." */

	Cockpit2 = "TIE-Jäger Cockpit"
	Cockpit2Desc = "Ein Cockpit, das den Stil der Imperialen TIE-Jäger und dessen Varianten ähnelt."
	Cockpit2Icon = "<green>Beinhaltet Luftschleuse &amp; Feuerlöscher</green> \n\nSpiegelt den unverwechselbaren Stil der <cyan>Sienar Fleet System's</cyan> TIE-Jäger wider, dieses Cockpit ist für Einzelgänger-Piloten konzipiert. Bietet <good>+45<image name='command_points' colored='true'/></good> Kommandopunkte, eine uneingeschränkte Sicht und kompakte Steuerungssysteme, die die Effizienz und Minimalismus des imperialen Designs verkörpern.\n\n<red>Limit (1) pro Schiff</red>"
	/* AI Enhanced from "TIE-Jäger Cockpit" */
	
	Cockpit2_1 = "TIE Series Cockpit Mk1"
	Cockpit2_1Icon = "TIE Fighter Cockpit Mk1"
	Cockpit2_1Desc = "Simplified TIE Fighter Cockpit. Equipped with fast Ion Engines, an Ia3-b Solar Ionization Reactor, a Titanium Hull and dual Fabritech Sensor Arrays."

	Cockpit2_2 = "TIE Series Cockpit Mk2"
	Cockpit2_2Icon = "TIE Fighter Cockpit Mk2"
	Cockpit2_2Desc = "Standard-Issue TIE Fighter Cockpit. Equipped with fast Ion Engines, dual Ls-1 Laser Cannons, an Ia3-b Solar Ionization Reactor, a Titanium Hull and dual Fabritech Sensor Arrays."

	Eta2 =  "Eta-2 Actis Abfangjäger Cockpit (Bewaffnet)"
	Eta2Icon =  "Eta-2 Actis Cockpit"
	Eta2Desc = "<green>Beinhaltet Luftschleuse, Feuerlöscher, &amp; Bett</green> \n\nGefertigt im Bild des Eta-2 Actis Abfangjägers von <cyan>Kuat Systems Engineering</cyan>, ist dieses Cockpit ausgestattet mit zwei frontmontierten Laserkanonen. Bietet <good>+45<image name='command_points' colored='true'/></good> Kommandopunkte und vereint Agilität mit Feuerkraft, und verkörpert die Präzision und Eleganz des Jedi-Sternenjägers. Entworfen für längere Missionen, beinhaltet es einen kompakten Schlafbereich für ein Besatzungsmitglied, um Bereitschaft für langanhaltende Einsätze zu gewährleisten. \n\n<bad>Begrenzung (1) pro Schiff</bad>"
	/* AI Enhanced from "Cockpit from Eta-2 Actis Interceptor with front-mounted dual Laser Cannons." */
	
	FixedLaser = "KX9 Laserkanone"
	FixedLaserIcon = "X-Wing Laser"
	FixedLaserDesc = "Die KX9 Laserkanone wurde von Taim und Bak entwickelt und ist bekannt durch die Verwendung an den X-Wings."
	FixedLaserL = "KX9 Laserkanone Links"
	FixedLaserR = "KX9 Laserkanone Rechts"
	AWFixedLaserL = "Borstel RG-9 Laserkanone"
	AWFixedLaserLIcon = "A-Wing Laserkanone Links"
	AWFixedLaserLDesc = "Die Borstel RG-9 Laserkanone wird häufig am RZ-1 A-Wing Sternenjäger verwendet. Bekannt dafür, guten Schaden an der Hülle zu verursachen. Hohe Feuerrate."
	AWFixedLaserR = "Borstel RG-9 Laserkanone"
	AWFixedLaserRIcon = "A-Wing Laserkanone Rechts"
	AWFixedLaserRDesc = "Die Borstel RG-9 Laserkanone wird häufig am RZ-1 A-Wing Sternenjäger verwendet. Bekannt dafür, guten Schaden an der Hülle zu verursachen. Hohe Feuerrate."

