	Structure1x3_wedgeLIcon = &Structure1x3_wedgeL
	Structure1x3_wedgeLDesc = "Der unterliegende Strukturrahmen der alles zusammenhält.\nStruktuhrrahmen sind in Räumen und Korridoren enthalten."

