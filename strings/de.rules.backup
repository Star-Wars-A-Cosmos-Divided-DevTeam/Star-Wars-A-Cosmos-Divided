	// Kompakter Raketwerfer von Kuat Systems
	SWMissileLauncherMedium = "Kuat-Systeme Mittlerer Raketenwerfer"
	SWMissileLauncherMediumIcon = "KSE Mittlerer Werfer"
	SWMissileLauncherMediumDesc = "Ein gut geschützter, durastahl-verstärkter automatisierter Startbucht, der verschiedene Raketentypen abfeuern kann, darunter <color r='255' g='69' b='0' a='255'>Cluster</color>, <color r='255' g='165' b='0' a='255'>Erschütterung</color>, <color r='30' g='144' b='255' a='255'>Eindringling</color> und <color r='34' g='139' b='34' a='255'>Hex</color>-Raketennutzlasten. \n\nBemerkenswert für seinen Einsatz auf dem <cyan>Kuat Systems Engineering</cyan> Venator-Klasse Sternenzerstörer. \n\n<bad>Limit 20 pro Schiff</bad> <string id='CommonStringModIDSWACD'/>"

	MissileLauncherCompact = "Kompakter Raketwerfer von Kuat Systems"
	MissileLauncherCompactIcon = "KSE Kompaktwerfer"
	MissileLauncherCompactDesc = "Ein gut geschützter, durastahl-verstärkter automatisierter Startbucht, der verschiedene Raketentypen abfeuern kann, darunter <color r='255' g='69' b='0' a='255'>Cluster</color>, <color r='255' g='165' b='0' a='255'>Erschütterung</color>, <color r='30' g='144' b='255' a='255'>Eindringling</color> und <color r='34' g='139' b='34' a='255'>Hex</color>-Raketennutzlasten. \n\nBemerkenswert für seinen Einsatz auf dem <cyan>Kuat Systems Engineering</cyan> Venator-Klasse Sternenzerstörer. \n\n<bad>Limit 20 pro Schiff</bad> <string id='CommonStringModIDSWACD'/>"

	DiscordMissileLauncher = "Discord-Raketenwerfer"
	DiscordMissileLauncherIcon = "Discord-Werfer"
	DiscordMissileLauncherDesc = "<yellow>Verwendet Minenteile</yellow>\n\nDer Discord-Raketenwerfer schickt eine mechanisierte Nutzlast, die in kurzer Entfernung zum Ziel detoniert und einen Schwarm von 5-7 Buzz-Droiden freisetzt, die die Panzerung und wesentliche Komponenten des feindlichen Schiffs zerstören. Buzz-Droiden können mit den meisten Punktverteidigungsgeschützen abgewehrt werden.\n\nUrsprünglich von der <cyan>Konföderation unabhängiger Systeme</cyan> während der Klonkriege eingesetzt, wurden diese Raketen für ihre verheerende Wirkung auf republikanische Sternenjäger berüchtigt.<string id='CommonStringModIDSWACD'/>"

	ProtonLauncher = "Protonentorpedo Abschussrampe"
	ProtonLauncherIcon = "Protonentorpedo"
	ProtonLauncherDesc = "Protonentorpedos sind sehr starke Torpedos die von kleineren Schiffen und Jägern abgefeuert werden können."

	BenchSW1x2 = "Sitz Raum"
	BenchSW1x2Icon = "Sitze"
	BenchSW1x2Desc = "Ein Raum mit Sitzen für Schiffe die normalerweise nicht auf lange Reisen gehen."

	BubbleGeneratorSmall = "Kleiner Innenschild-Generator"
	BubbleGeneratorSmallIcon = "Kleiner Schild-Generator"
	BubbleGeneratorSmallDesc = "Ein kleinerer Schild-Generator, der eine Schild-Blase aus dem Inneren des Schiffes erzeugt."

	BubbleGeneratorMed = "Mittlerer Innenschild-Generator"
	BubbleGeneratorMedIcon = "Mittlerer Schild-Generator"
	BubbleGeneratorMedDesc = "Ein Schild-Generator, der eine Schild-Blase aus dem Inneren des Schiffes erzeugt."

	BubbleGeneratorLarge = "Schwerer Innenschild-Generator"
	BubbleGeneratorLargeIcon = "Schwerer Schild-Generator"
	BubbleGeneratorLargeDesc = "Ein großer Schild-Generator, der eine Schild-Blase aus dem Inneren des Schiffes erzeugt."

	BubbleGeneratorGiga = "Gigantischer Innenschild-Generator"
	BubbleGeneratorGigaIcon = "Gigantischer Schild-Generator"
	BubbleGeneratorGigaDesc = "Ein gigantischer Schild-Generator, der eine Schild-Blase aus dem Inneren des Schiffes erzeugt."

	ImperialProbeDroid = "Viper Sonde-Droid"
	ImperialProbeDroidIcon = "Sonde-Droid"
	ImperialProbeDroidDesc = "Der Viper Sonde-Droid, hergestellt von <green>Arakyd Industries</green>, ist ein selbstständiger Droid, der für die Tiefraumforschung und Aufklärung eingesetzt werden kann."

	R2Armor = "R2-D2"
	R2ArmorIcon = "R2-Panzerung"
	R2ArmorDesc = "<yellow>Entsperrt kleinen Hyperantrieb</yellow> \n\n<green>Beinhaltet Sensoren</green> \n\nVerbessert die Schiffssteuerung und umfasst Reparaturmodule für angrenzende Komponenten. \n\nHergestellt von <cyan>Industrial Automaton</cyan>, sind Astromech-Droiden für effiziente Raumschiffoperationen in der ganzen Galaxie unerlässlich."
	R2Armor2 = "R3 Einheit"
	R2Armor2Desc = "Diese nützlichen kleinen Astromechs können die Sensorreichweite deines Schiffes erhöhen."
	R2Armor2Icon = "R3-CD"
	R2Armor3 = "R2 Einheit"
	R2Armor3Desc = "Diese nützlichen kleinen Astromechs können die Sensorreichweite deines Schiffes erhöhen."
	R2Armor3Icon = "R2-Q3"
	R4 = "R4 Einheit"
	R4Desc = "Diese nützlichen kleinen Astromechs können die Sensorreichweite deines Schiffes erhöhen."
	R4Icon = "R4-A22"
	R5 = "R5 Einheit"
	R5Desc = "Diese nützlichen kleinen Astromechs können die Sensorreichweite deines Schiffes erhöhen."
	R5Icon = "R5-K6"

