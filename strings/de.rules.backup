	GalvenningBarrelSection = "Galvenning-Rohrabschnitt"
	GalvenningBarrelSectionIcon = "Galvenning-Rohrabschnitt"
	GalvenningBarrelSectionDesc = "Galvenning-Rohrabschnitt. Verwenden mit Orbitaler Partikelkanone für Bombardierung und Überschwerer Verbundstrahl-Turbolaser, um sie zu verstärken."

	TurbolaserTiny01 = "Punktverteidigungsturbolaser 1"
	TurbolaserTiny01Icon = "Kompakter Turbolaser 1"
	TurbolaserTiny01Desc = "Kann umgeschaltet werden, um Projektile abzuwehren oder feindliche Schiffe anzugreifen"

	TurbolaserTiny02 = "Punktverteidigungsturbolaser 2"
