	Structure1x1_RoundSmall = "Strukturrahmen 1x1 kleine Rundung"
	Structure1x1_RoundSmallIcon = &Structure1x1_RoundSmall
	Structure1x1_RoundSmallDesc = "Der unterliegende Strukturrahmen der alles zusammenhält.\nStruktuhrrahmen sind in Räumen und Korridoren enthalten.\n\n<color r='255' g='196' b='0'><b>Hull</b></color>\nHit points: 250\nPen. Resistance: 0\nWeight (Tons): 0.1"

	Structure1x1_RoundBig = "Strukture 1x1 Round Big"
	Structure1x1_RoundBigIcon = &Structure1x1_RoundBig
	Structure1x1_RoundBigDesc = "Der unterliegende Strukturrahmen der alles zusammenhält.\nStruktuhrrahmen sind in Räumen und Korridoren enthalten.\n\n<color r='255' g='196' b='0'><b>Hull</b></color>\nHit points: 720\nPen. Resistance: 0\nWeight (Tons): 0.24"

	Structure1x1_Triangle = "Strukture 1x1 Triangle"
	Structure1x1_TriangleIcon = &Structure1x1_Triangle
	Structure1x1_TriangleDesc = "Der unterliegende Strukturrahmen der alles zusammenhält.\nStruktuhrrahmen sind in Räumen und Korridoren enthalten.\n\n<color r='255' g='196' b='0'><b>Hull</b></color>\nHit points: 250\nPen. Resistance: 0\nWeight (Tons): 0.1"

	Structure1x1_TriangleBig = "Großes Strukturdreieck 1x1"
	Structure1x1_TriangleBigIcon = &Structure1x1_TriangleBig
	Structure1x1_TriangleBigDesc = "Der unterliegende Strukturrahmen der alles zusammenhält.\nStruktuhrrahmen sind in Räumen und Korridoren enthalten.\n\n<color r='255' g='196' b='0'><b>Hull</b></color>\nHit points: 500\nPen. Resistance: 0\nWeight (Tons): 0.16"

	Structure1x1_RoundWedge = "Strukture 1x1 Rundkeil"
	Structure1x1_RoundWedgeIcon = &Structure1x1_RoundWedge
	Structure1x1_RoundWedgeDesc = "Der unterliegende Strukturrahmen der alles zusammenhält.\nStruktuhrrahmen sind in Räumen und Korridoren enthalten.\n\n<color r='255' g='196' b='0'><b>Hull</b></color>\nHit points: 800\nPen. Resistance: 0\nWeight (Tons): 0.27"

