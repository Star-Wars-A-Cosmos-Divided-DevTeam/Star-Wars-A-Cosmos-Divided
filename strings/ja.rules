MissileTypes
{
	SW_Cluster = "<color r='255' g='69' b='0' a='255'>Cluster Missile</color>"
	SW_Cluster_alt = "Cluster Missile"
	SW_ClusterDesc = "Rapid-deployment guided missiles that disperse multiple warheads, each causing significant damage over a small area. \n\nInspired by various attack crafts' capability to fire off these missiles rapidly, they excel in breaking through concentrated enemy defenses.\n\n <gray>Uses HE Missile Parts</gray>"

	SW_Intruder = "<color r='30' g='144' b='255' a='255'>Intruder Missile</color>"
	SW_Intruder_alt = "Intruder Missile"
	SW_IntruderDesc = "A sophisticated guided missile designed to emit a potent electromagnetic pulse upon impact, specifically targeting and draining power from enemy systems. \n\nCrafted by <cyan>Slayn &amp; Korpil</cyan> for the Rebel Alliance, these missiles specialize in crippling large ships by overloading shield generators, leading to subsequent damage.\n\n <gray>Uses EMP Missile Parts</gray>"

	SW_Concussion = "<color r='255' g='165' b='0' a='255'>Concussion Missile</color>"
	SW_Concussion_alt = "Concussion Missile"
	SW_ConcussionDesc = "A high-yield, slow-moving missile that delivers a devastating explosion, causing massive damage over a wide area. \n\nA standard in military arsenals, manufactured by <cyan>Dymek</cyan>, and used for a variety of roles from planetary bombardment to anti-capital ship engagements, showcasing versatility and power.\n\n <gray>Uses HE Missile Parts</gray>"

	SW_HEX = "<color r='34' g='139' b='34' a='255'>Hex Missile</color>"
	SW_HEX_alt = "Hex Missile"
	SW_HEXDesc = "Armed with a deadly trihexalon payload, these guided missiles are capable of inflicting catastrophic damage and casualties. \n\nFirst deployed in the attack on Maramere, these missiles embody the terrifying potential of chemical warfare in space, making them a feared weapon across the galaxy.\n\n <gray>Uses Nuke Parts</gray>"

	SW_Discord = "<color r='211' g='211' b='211' a='255'>Discord Missile</color>"
	SW_Discord_alt = "Discord Missile"
	SW_DiscordDesc = "Launches Discord Missiles \n\nDiscord Missiles detonate within a short distance of their target and releases a swarm of 5-7 Buzz Droids that eat away the armor and essential components of the enemy craft. Buzz Droids can be countered with Point-Defense turrets.\n\n <gray>Uses Mine Parts</gray>"
}

Tips
{
	SW_LauncherTypes
	{
		Title = "Launcher Types"
		Tip = "You can change what type of missile or mine a Launcher shoots at any time, including during battle. Use this to surprise your enemy with a few unexpected HEX missiles!"
	}
	SW_LaserTypes
	{
		Title = "Launcher Types"
		Tip = "You can change what type of laser color shoots at any time, including during battle. Use this to surprise your enemy with a few unexpected flashy colors!"
	}
}

