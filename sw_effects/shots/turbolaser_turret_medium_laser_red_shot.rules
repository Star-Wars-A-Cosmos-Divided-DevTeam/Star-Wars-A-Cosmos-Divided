ID = SW.turbolaser_turret_medium_laser_red_shot  //TURRET WEAPONSHOT
//OtherIDs = ["red_heavy_laser_shot"]
Range = 400
IdealRange = [120, 400]
IdealRadius = [5, 50]
Speed = 120

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.01
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}
	
	Targetable
	{
		Type = Targetable
		Health = 2000
		TargetCategory = "laser"
	}

	Hit
	{
		Type = PenetratingHit
		Penetration = 5.0
		PenetrationSpeed = 20
		
		CrewCollisions = {Enemies=true; Junk=true}
		SourceShipLowCollisions = false
		FriendlyShipLowCollisions = false
		PenetratesCrew = true

		HitCrew = &HitOperational

		HitShield = &HitOperational

		HitOperational
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]

			HitEffects
			[
				{
					Type = Damage
					Damage = 2000
				}
				{
					Type = Impulse
					Impulse = 50
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Hit/Med/Red
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Red
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Red
	
				&/SW_SOUNDS/SmallLaserHit

				: /BASE_SHAKE
				{
					ShakeAmount = .1
					Duration = .4
				}
			]
		}
		HitStructural
		{
			ReduceEffectsByPenetration = true
			Offset = [0.5, 0]

			HitEffects
			[
				{
					Type = Damage
					Damage = 1000
				}
				{
					Type = Impulse
					Impulse = 25
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/HitStruct/Med/Red

				&/SW_SOUNDS/SmallLaserHit
			]
		}
		PenetratingOperational
		{
			ReduceEffectsByPenetration = true

			HitEffects
			[
				{
					Type = Damage
					Damage = 1000
				}
				{
					Type = Fire
					FireChance = .1
				}
				{
					Type = Impulse
					Impulse = 50
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Red
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Red
			]
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural = &PenetratingStructural
	}

	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Sprite
		{
			Texture
			{
				File = "lasershotred.png"
				SampleMode = Linear
				MipLevels = max
			}
			Size = [2.1, 1.05]//2.4 1.2
		}
	}
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0.5
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [6, 6]
			VertexColor = [255, 0, 0]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.25
		}
	}
}
