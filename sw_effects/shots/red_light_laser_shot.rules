ID = SW.light_turbolaser_shot_Red //TURRET WEAPONSHOT
OtherIDs = ["light_turbolaser_shot_Red"]

Range = 400
IdealRange = [120, 400]
Speed = 180 //100

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.01
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}

	Targetable
	{
		Type = Targetable
		Health = 750
		TargetCategory = "laser"
	}

	Hit
	{
		Type = PenetratingHit
		Penetration = 0.1
		PenetratesOperational = false
		
		CrewCollisions = {Enemies=true; Junk=true}
		SourceShipLowCollisions = false
		PenetratesCrew = true
		HitCrew = &HitOperational

		HitShield
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 450
				}
				{
					Type = Impulse;
					Impulse = 2.5;
				}
			]

			MediaEffects = &../HitOperational/MediaEffects
		}
		HitOperational
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 450
				}
				{
					Type = Impulse;
					Impulse = 2.5;
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Hit/Med/Red
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Red
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Red
	
				&/SW_SOUNDS/SmallLaserHit

				: /BASE_SHAKE
				{
					ShakeAmount = .03
					Duration = .3
				}
			]
		}
		HitStructural
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 225
				}
				{
					Type = Impulse;
					Impulse = 1.25;
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/HitStruct/Med/Red

				&/SW_SOUNDS/SmallLaserHit
			]
		}
		PenetratingOperational
		{
		}
		PenetratingStructural
		{
		}
		FinishedPenetratingOperational
		{
		}
		FinishedPenetratingStructural
		{
		}
	}
	
	Sprite
	{
		Type = Sprite
		//RenderBucket = BulletUpper3
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Sprite
		{
			Texture
			{
				File = "lasershotred.png"
				SampleMode = Linear
				MipLevels = max
			}
			Size = [0.81, 0.36]
		}
	}
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0.5
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [3, 3]
			VertexColor = [255, 0, 0]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.25
		}
	}
}
