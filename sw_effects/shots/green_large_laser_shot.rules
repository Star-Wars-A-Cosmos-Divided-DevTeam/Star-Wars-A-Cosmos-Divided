ID = SW.green_large_laser_shot_common 
OtherIDs = ["green_large_laser_shot"]
Range = 450
IdealRange = [60, 325]
IdealRadius = [5, 50]
Speed = 160 //90

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.01
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}
	
	Targetable
	{
		Type = Targetable
		Health = 1600
		TargetCategory = "laser"
	}

	Hit
	{
		Type = PenetratingHit
		FactorEffectsWith = Targetable
		Penetration = 0 // Enough to get through one shield and lose half penetration.
		PenetratesOperational = false
		SourceShipCollisionDelay = 10
		HitShield
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 750
				}
				{
					Type = Impulse;
					Impulse = 2.5;
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Hit/Med/Green
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Green
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Green
	
				&/SW_SOUNDS/SmallLaserHit

				: /BASE_SHAKE
				{
					ShakeAmount = .03
					Duration = .3
				}
			]
		}
		HitOperational
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 1250
					TreatShieldAsPart = true
				}
				{
					Type = Impulse;
					Impulse = 2.5;
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Hit/Med/Green
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Green
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Green
	
				&/SW_SOUNDS/SmallLaserHit

				: /BASE_SHAKE
				{
					ShakeAmount = .03
					Duration = .3
				}
			]
		}
		HitStructural
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 625
					TreatShieldAsPart = true
				}
				{
					Type = Impulse;
					Impulse = 1.25;
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/HitStruct/Med/Green

				&/SW_SOUNDS/SmallLaserHit
			]
		}
		PenetratingOperational
		{
			// No effect.
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational
		{
			// No effect.
		}
		FinishedPenetratingStructural
		{
			// No effect.
		}
	}

	Sprite
	{
		Type = Sprite
		//RenderBucket = BulletUpper3
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Sprite
		{
			Texture
			{
				File = "lasershotgreen.png"
				SampleMode = Linear
				MipLevels = max
			}
			Size = [2, 1]
		}
	}
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Z = 0
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [9, 9]
			VertexColor = [0, 255, 0]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.25
		}
	}
}

