ID = SW.yellow_small_laser_pdshot_common
OtherIDs = ["small_pointlaser_shot1"]
Range = 250
IdealRange = 150
Speed = 320

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.01
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}
/*
	Targetable
	{
		Type = Targetable
		Health = 100
		TargetCategory = "laser"
	}
*/
	Sprite
	{
		Type = AnimatedSprite
		RenderBucket = BulletLower1
		//ReduceScaleWith = Hit
		//ReduceScaleExponent = 0.5
		Animation
		{
			AtlasSprite
			{
				Texture
				{ 
					File = "yellow_laser.png"
					SampleMode = Linear
					MipLevels = max
				}
				Size = [1.75, 1.75]
			}
			FrameCount = 8
			FrameSize = [128, 128]
			FramesPerRow = 2
			FramesPerSecond = 30
		}
//		NormalsTexture = &Animation/AtlasSprite/Texture
		//DiffuseShader = "./Data/default.shader"
		//NormalsShader = "./Data/no_normals.shader"
	}
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Z = 0.5
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [3, 3]
			VertexColor = [150, 150, 0]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.25
		}
	}
	Hit
	{
		Type = SimpleHit
		SourceShipLowCollisions = false
		BulletCollisions
		{
			Enemies = true
			Junk = true
			Friendlies = false
            //Neutrals = true
			OnlyBulletCategories = [missile, mine, bullet, laser, ion_shot]
		}
		HitBullet
		{
			Offset = [-0.15, 0]

			HitEffects
			[
				{
					Type = Damage
					Damage = 1250 //850
				}
			]

			MediaEffects
			[
				&<./Data/shots/pd_shot/particles/pd_shot_spikes.rules>
				&<./Data/shots/pd_shot/particles/pd_shot_sparks.rules>
				&<./Data/ships/terran/point_defense/particles/point_defense_shoot_flash.rules>
			]
		}

		CrewCollisions = {Enemies=true; Junk=true}
		HitCrew = &HitOperational

		HitShield = &HitOperational
		HitOperational
		{
			Offset = [-0.15, 0]

			HitEffects
			[
				{
					Type = Damage
					Damage = 35
				}
				{
					Type = Impulse;
					Impulse = 1.25;
				}
			]
			MediaEffects = &../HitBullet/MediaEffects
		}
		HitStructural = &HitOperational
	}
}

