ID = SW.green_heavy_laser_shot_common //DIRECT WEAPONSHOT
OtherIDs = ["green_heavy_laser_shot"]
Range = 420
IdealRange = [126, 420]
IdealRadius = [5, 50]
Speed = 160 //80

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.01
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}
	
	Targetable
	{
		Type = Targetable
		Health = 2000
		TargetCategory = "laser"
	}

	Hit
	{
		Type = PenetratingHit
		FactorEffectsWith = Targetable
		
		CrewCollisions = {Enemies=true; Junk=true}
		FriendlyShipLowCollisions = false
		PenetratesCrew = true

		HitCrew = &HitOperational

		HitShield
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 2000
				}
				{
					Type = Impulse;
					Impulse = 3.5;
				}
			]

			MediaEffects = &../HitOperational/MediaEffects
		}
		HitOperational
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 4000
				}
				{
					Type = ExplosiveDamage
					TotalDamage = 2400
					Radius = 3.6
					Filter
					{
						Friendlies = false
					}
				}
				{
					Type = Impulse;
					Impulse = 20
				}
			]
		MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Hit/Med/Green
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Green
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Green
	
				&/SW_SOUNDS/SmallLaserHit

				: /BASE_SHAKE
				{
					ShakeAmount = .03
					Duration = .3
				}
			]
		}
		HitStructural
		{
			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = 3850
					Radius = 6
				}
				{
					Type = Impulse
					Impulse = 10.25
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/HitStruct/Med/Green

				&/SW_SOUNDS/SmallLaserHit
			]
		}
		PenetratingOperational
		{
			// No effect.
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational
		{
			// No effect.
		}
		FinishedPenetratingStructural
		{
			// No effect.
		}
	}

	Sprite
	{
		Type = AnimatedSprite
		//RenderBucket = BulletUpper3
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "heavy_laser_green_shot.png"
					SampleMode = Linear
					MipLevels = max
				}
				Size = [2.1, 1.05]//2.4 1.2
			}
			FrameCount = 8
			FrameSize = [192, 128]
			FramesPerRow = 2
			FramesPerSecond = 24
		}
		//NormalsTexture = &Animation/AtlasSprite/Texture
		//DiffuseShader = "./Data/default.shader"
		//NormalsShader = "./Data/no_normals.shader"
	}
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [9, 9]
			VertexColor = [0, 255, 0]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 6  
			_litAdditiveStrength = 0.02  
			_unlitAdditiveStrength = 0.10  
		}
	}
/*
	MediaEffects
	{
		Type = MediaEffects
		FactorEffectsWith = Hit
		FactorEffectsExponent = 0.5
		MediaEffects
		[
			&/SW_PARTICLES/Shot/Laser/Glow/Large/Green
		]
	}
*/
}
