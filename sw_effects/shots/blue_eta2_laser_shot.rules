ID = SW.eta2_small_laser_shot_common //DIRECT WEAPONSHOT
OtherIDs = ["eta2_small_laser_shot"]
Range = 350
IdealRange = [135, 350]
IdealRadius = [5, 50]
Speed = 200 //120

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.01
		Density = 0.1
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}
	
	Targetable
	{
		Type = Targetable
		Health = 500 //400
		TargetCategory = "ion_shot"
	}

	Hit
	{
		Type = PenetratingHit
		Penetration = 50// 0.1
		PenetratesOperational = false
		FactorEffectsWith = Targetable
		
		CrewCollisions = {Enemies=true; Junk=true}
		SourceShipLowCollisions = false
		PenetratesCrew = true
		HitCrew = &HitOperational

		HitShield
		{
			ReduceEffectsByPenetration = true

/*			HitEffects
			[
				{
					Type = Damage
					Damage = 125
				}
				{
					Type = Impulse;
					Impulse = 2.5;
				}
			]
*/
			HitEffects
			[
				: ../../HitOperational/HitEffects/0
				{
					Amount = 900
					TreatShieldAsPart = true
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Hit/Med/Blue
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Blue
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Blue
	
				&/SW_SOUNDS/SmallLaserHit

				: /BASE_SHAKE
				{
					ShakeAmount = .03
					Duration = .3
				}
			]
		}
		HitOperational
		{
			Offset = [-0.15, 0]
			ReduceEffectsByPenetration = true

			HitEffects
			[
				{
					Type = ResourceDrain
					ResourceType = battery
					Amount = 600

					MediaEffectsOnDrain
					[
						&/SW_PARTICLES/Shot/Ion/Drain/Med/Cyan
						&/SW_PARTICLES/Shot/Ion/Sizzle/Med/Cyan
						&/SW_PARTICLES/Shot/Ion/Lightning/Med/Cyan
						&/SW_SOUNDS/IonDischarge
					]
				}
				{
					Type = Damage
					Damage = 250
				}
			]
/*
			HitEffects
			[
				{
					Type = Damage
					Damage = 85
				}
				{
					Type = Impulse;
					Impulse = 2.5;
				}
			]
*/

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Hit/Med/Blue
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Blue
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Blue
	
				&/SW_SOUNDS/SmallLaserHit

				: /BASE_SHAKE
				{
					ShakeAmount = .03
					Duration = .3
				}
			]
		}
		HitStructural
		{
			ReduceEffectsByPenetration = true
			HitEffects
			[
				{
					Type = Damage
					Damage = 200 // 58
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/HitStruct/Med/Blue

				&/SW_SOUNDS/SmallLaserHit
			]
		}
		PenetratingOperational
		{
			// No effect.
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural = &PenetratingStructural
	}

	Sprite
	{
		Type = AnimatedSprite
		RenderBucket = BulletUpper3
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "laser_ball_blue_shot.png"
					SampleMode = Linear
					MipLevels = max
				}
				Size = [0.64, 0.64]
			}
			FrameCount = 8
			FrameSize = [128, 128]
			FramesPerRow = 2
			FramesPerSecond = 32
		}
//		NormalsTexture = &Animation/AtlasSprite/Texture
		DiffuseShader = "./Data/default.shader"
		NormalsShader = "./Data/no_normals.shader"
	}

	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Z = 0
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [4, 4]
			VertexColor = [0, 0, 255]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.25
		}
	}
/*
	Sprite
	{
		Type = AnimatedSprite
		RenderBucket = BulletUpper3
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Animation
		{
			AtlasSprite
			{
				Texture
				{
					File = "lasershotblue.png"
					SampleMode = Linear
					MipLevels = max
				}
				Size = [1.54, 0.72]
			}
			FrameCount = 2
			FrameSize = [64, 32]
			FramesPerRow = 1
			FramesPerSecond = 24
		}
		NormalsTexture = &Animation/AtlasSprite/Texture
		DiffuseShader = "./Data/default.shader"
		NormalsShader = "./Data/no_normals.shader"
	}

	MediaEffects
	{
		Type = MediaEffects
		FactorEffectsWith = Hit
		FactorEffectsExponent = 0.5
		MediaEffects
		[
			&/SW_PARTICLES/Shot/Laser/Glow/Small/Blue
		]
	}
*/
}
