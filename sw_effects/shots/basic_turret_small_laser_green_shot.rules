ID = SW.basic_turret_small_laser_green_shot
//OtherIDs = ["greensmalllasershot"]
Range = 400
IdealRange = [120, 400]
IdealRadius = [5, 50]
Speed = 200 //120

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.01
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}

	Targetable
	{
		Type = Targetable
		Health = 750
		TargetCategory = "laser"
	}

	Hit
	{
		Type = PenetratingHit
		FactorEffectsWith = Targetable
		
		CrewCollisions = {Enemies=true; Junk=true}
		SourceShipLowCollisions = false
		FriendlyShipLowCollisions = false

		HitCrew = &HitOperational
		HitShield = &HitOperational
		
/*
		HitShield
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 250
				}
				{
					Type = Impulse;
					Impulse = 2.5;
				}
			]

			MediaEffects = &../HitOperational/MediaEffects
		}
*/
		HitOperational
		{
			Offset = [-0.15, 0]

			HitEffects
			[
				{
					Type = Damage
					Damage = 250
				}
				{
					Type = Impulse;
					Impulse = 2.5;
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Hit/Med/Green
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Green
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Green
	
				&/SW_SOUNDS/SmallLaserHit

				: /BASE_SHAKE
				{
					ShakeAmount = .03
					Duration = .3
				}
			]
		}
		HitStructural
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 125
				}
				{
					Type = Impulse;
					Impulse = 1.25;
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/HitStruct/Med/Green

				&/SW_SOUNDS/SmallLaserHit
			]
		}
		PenetratingOperational
		{
			// No effect.
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational
		{
			// No effect.
		}
		FinishedPenetratingStructural
		{
			// No effect.
		}
	}

	Sprite
	{
		Type = Sprite
		RenderBucket = BulletUpper3
		//ReduceScaleWith = Hit
		//ReduceScaleExponent = 0.5
		Sprite
		{
			Texture
			{
				File = "green_laser.png"
				SampleMode = Linear
				MipLevels = max
			}
			Size = [0.64, 0.64]
		}
	}
/*
	MediaEffects
	{
		Type = MediaEffects
		FactorEffectsWith = Hit
		FactorEffectsExponent = 0.5
		MediaEffects
		[
			&/SW_PARTICLES/Shot/Laser/Glow/Small/Green
		]
	}
*/

	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0.5
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [3, 3]
			VertexColor = [0, 255, 0]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 6
			_litAdditiveStrength = 0.02
			_unlitAdditiveStrength = 0.1
		}
	}
}

