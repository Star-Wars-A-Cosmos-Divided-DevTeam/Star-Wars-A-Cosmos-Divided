ID = SW.red_heavy_laser_shot_common //DIRECT WEAPONSHOT
OtherIDs = ["red_heavy_laser_shot"]
Range = 420
IdealRange = [126, 420]
IdealRadius = [5, 50]
Speed = 160 //80

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.01
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}
	
	Targetable
	{
		Type = Targetable
		Health = 2000
		TargetCategory = "laser"
	}

	Hit
	{
		Type = PenetratingHit
		FactorEffectsWith = Targetable
		
		CrewCollisions = {Enemies=true; Junk=true}
		SourceShipLowCollisions = false
		FriendlyShipLowCollisions = true
		PenetratesCrew = true

		HitCrew = &HitOperational

		HitShield
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 2000
				}
				{
					Type = Impulse;
					Impulse = 3.5;
				}
			]

			MediaEffects = &../HitOperational/MediaEffects
		}
		HitOperational
		{
			HitEffects
			[
				{
					Type = Damage
					Damage = 3000
				}
				{
					Type = ExplosiveDamage
					TotalDamage = 1400
					Radius = 3.6
					Filter
					{
						Friendlies = false
					}
				}
				{
					Type = Impulse;
					Impulse = 15
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/Hit/Med/Red
				&/SW_PARTICLES/Shot/Laser/Flash/Med/Red
				&/SW_PARTICLES/Shot/Laser/Sparks/Med/Red
	
				&/SW_SOUNDS/SmallLaserHit

				: /BASE_SHAKE
				{
					ShakeAmount = .08
					Duration = .3
				}
			]
		}
		HitStructural
		{
			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = 3050
					Radius = 6
				}
				{
					Type = ExplosiveDamage
					TotalDamage = 1650
					Radius = 6
					Filter
					{
						Friendlies = false
					}
				}
				{
					Type = Impulse
					Impulse = 12
				}
			]

			MediaEffects
			[
				&/SW_PARTICLES/Shot/Laser/HitStruct/Med/Red

				&/SW_SOUNDS/SmallLaserHit
			]
		}
		PenetratingOperational
		{
			// No effect.
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational
		{
			// No effect.
		}
		FinishedPenetratingStructural
		{
			// No effect.
		}
	}

	Sprite
	{
		Type = Sprite
		//RenderBucket = BulletUpper3
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Sprite
		{
			Texture
			{
				File = "lasershotred.png"
				SampleMode = Linear
				MipLevels = max
			}
			Size = [2.1, 1.05]//2.4 1.2
		}
	}
	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper2
		Z = 0
		IsLight = true
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [9, 9]
			VertexColor = [255, 0, 0]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.25
		}
	}
}
