
// ===========================================================
// Weapon Shots Library (organized)
// Canonical key pattern: shot_<mount>_<family>_<size>_<color>
// ===========================================================

/* ------------------- DIRECT (no pass-thru) ------------------- */
/* I. Light Laser / Laser Cannon — low pen, long range, med-high vel */

    // Small
    shot_direct_laser_sm_red   = &<Shots/red_small_laser_shot.rules>     // Small Red Laser (light, direct)
    shot_direct_laser_sm_green = &<Shots/green_small_laser_shot.rules>   // Small Green Laser (light, direct)
    shot_direct_laser_sm_blue  = &<Shots/blue_small_laser_shot.rules>    // Small Blue Laser (light, direct)

    shot_direct_laser_sm_red_xwing   = &<Shots/red_xwing_laser_shot.rules>      // X-Wing red (light, direct)
    shot_direct_laser_sm_green_xwing = &<Shots/green_xwing_laser_shot.rules>    // X-Wing green (light, direct)
    shot_direct_laser_sm_blue_xwing  = &<Shots/blue_xwing_laser_shot.rules>     // X-Wing blue (light, direct)

    // Medium
    shot_direct_laser_md_red_fixed = &<Shots/red_medfixed_laser_cannon_shot.rules> // Med Red (fixed, direct)

/* II. Heavy Laser / Laser Cannon — high pen, short/med range, fast vel, 50% shield dmg */

    // Small (direct “turbolaser light laser” variants)
    shot_direct_turbolaser_sm_red   = &<Shots/turbolaser_direct_light_laser_red_shot.rules>
    shot_direct_turbolaser_sm_green = &<Shots/turbolaser_direct_light_laser_green_shot.rules>
    shot_direct_turbolaser_sm_blue  = &<Shots/turbolaser_direct_light_laser_blue_shot.rules>

    // Medium
    shot_direct_laser_md_red   = &<Shots/red_med_laser_cannon_shot.rules>
    shot_direct_laser_md_green = &<Shots/green_med_laser_cannon_shot.rules>
    shot_direct_laser_md_blue  = &<Shots/blue_med_laser_cannon_shot.rules>

    shot_direct_turbolaser_md_red   = &<Shots/turbolaser_direct_medium_laser_red_shot.rules>
    shot_direct_turbolaser_md_green = &<Shots/turbolaser_direct_medium_laser_green_shot.rules>
    shot_direct_turbolaser_md_blue  = &<Shots/turbolaser_direct_medium_laser_blue_shot.rules>

    // Large / Heavy
    shot_direct_turbolaser_hv_red   = &<Shots/turbolaser_direct_heavy_laser_red_shot.rules>
    shot_direct_turbolaser_hv_green = &<Shots/turbolaser_direct_heavy_laser_green_shot.rules>
    shot_direct_turbolaser_hv_blue  = &<Shots/turbolaser_direct_heavy_laser_blue_shot.rules>

    shot_direct_laser_lg_red   = &<Shots/red_large_laser_shot.rules>
    shot_direct_laser_lg_green = &<Shots/green_large_laser_shot.rules>
    shot_direct_laser_lg_blue  = &<Shots/blue_large_laser_shot.rules>

    shot_direct_laser_hv_red   = &<Shots/red_heavy_laser_shot.rules>
    shot_direct_laser_hv_green = &<Shots/green_heavy_laser_shot.rules>
    shot_direct_laser_hv_blue  = &<Shots/blue_heavy_laser_shot.rules>

/* III. Concussion Laser — explosive, high fire, short/med range, slow vel */

    // Large / Heavy (direct)
    shot_direct_concussion_hv_red   = &<Shots/concussion_direct_heavy_laser_red_shot.rules>
    shot_direct_concussion_hv_green = &<Shots/concussion_direct_heavy_laser_green_shot.rules>
    shot_direct_concussion_hv_blue  = &<Shots/concussion_direct_heavy_laser_blue_shot.rules>

/* IV. Ion — disrupt/EMP, low fire, med/long range, med vel */

    // Small
    shot_direct_ion_sm_blue = &<Shots/blue_eta2_laser_shot.rules> // small ion(ish) variant per your name
    // (Add md/lg as you create them)



/* -------------------- TURRET (pass-thru) --------------------- */
/* I. Light Laser / Turbolaser — low pen, med/long range, med-fast vel */

    // Small
    shot_turret_laser_sm_red   = &<Shots/basic_turret_small_laser_red_shot.rules>
    shot_turret_laser_sm_green = &<Shots/basic_turret_small_laser_green_shot.rules>
    shot_turret_laser_sm_blue  = &<Shots/basic_turret_small_laser_blue_shot.rules>

    shot_turret_laser_sm_red_rep   = &<Shots/repeater_turret_small_laser_red_shot.rules>
    shot_turret_laser_sm_green_rep = &<Shots/repeater_turret_small_laser_green_shot.rules>
    shot_turret_laser_sm_blue_rep  = &<Shots/repeater_turret_small_laser_blue_shot.rules>

    shot_turret_laser_md_green_long = &<Shots/green_longrange_laser_shot.rules> // long range

    shot_turret_turbolaser_md_red_long   = &<Shots/turbolaser_turret_longrange_laser_red_shot.rules>
    shot_turret_turbolaser_md_green_long = &<Shots/turbolaser_turret_longrange_laser_green_shot.rules>
    shot_turret_turbolaser_md_blue_long  = &<Shots/turbolaser_turret_longrange_laser_blue_shot.rules>

    shot_turret_laser_light_red   = &<Shots/red_light_laser_shot.rules>
    shot_turret_laser_light_green = &<Shots/green_light_laser_shot.rules>
    shot_turret_laser_light_blue  = &<Shots/blue_light_laser_shot.rules>

    // Medium
    shot_turret_laser_md_red   = &<Shots/red_triple_laser_shot.rules>
    shot_turret_laser_md_green = &<Shots/green_triple_laser_shot.rules>
    shot_turret_laser_md_blue  = &<Shots/blue_triple_laser_shot.rules>

/* II. Heavy Laser / Turbolaser — medium pen, short/med range, slow-med vel */

    // Small / specials
    shot_turret_laser_sm_red_falcon = &<Shots/red_falcon_laser_cannon_shot.rules>
    shot_turret_laser_md_red_xx9    = &<Shots/red_xx9_laser_shot.rules>
    shot_turret_laser_md_green_xx9  = &<Shots/green_xx9_laser_shot.rules>

    shot_turret_turbolaser_sm_red   = &<Shots/turbolaser_turret_light_laser_red_shot.rules>
    shot_turret_turbolaser_sm_green = &<Shots/turbolaser_turret_light_laser_green_shot.rules>
    shot_turret_turbolaser_sm_blue  = &<Shots/turbolaser_turret_light_laser_blue_shot.rules>

    // Medium
    shot_turret_laser_md_red   = &<Shots/red_med_laser_shot.rules>
    shot_turret_laser_md_green = &<Shots/green_med_laser_shot.rules>
    shot_turret_laser_md_blue  = &<Shots/blue_med_laser_shot.rules>

    shot_turret_turbolaser_md_red   = &<Shots/turbolaser_turret_medium_laser_red_shot.rules>
    shot_turret_turbolaser_md_green = &<Shots/turbolaser_turret_medium_laser_green_shot.rules>
    shot_turret_turbolaser_md_blue  = &<Shots/turbolaser_turret_medium_laser_blue_shot.rules>

    // Large / Heavy
    shot_turret_turbolaser_hv_red   = &<Shots/turbolaser_turret_heavy_laser_red_shot.rules>
    shot_turret_turbolaser_hv_green = &<Shots/turbolaser_turret_heavy_laser_green_shot.rules>
    shot_turret_turbolaser_hv_blue  = &<Shots/turbolaser_turret_heavy_laser_blue_shot.rules>

    shot_turret_laser_faction_red   = &<Shots/red_cis_laser_shot.rules>      // CIS
    shot_turret_laser_faction_green = &<Shots/green_imperial_laser_shot.rules> // Imperial
    shot_turret_laser_faction_blue  = &<Shots/blue_republic_laser_shot.rules> // Republic

/* III. Concussion (turret) — explosive, high fire, short/med range, slow vel */

    shot_turret_concussion_hv_red   = &<Shots/concussion_turret_heavy_laser_red_shot.rules>
    shot_turret_concussion_hv_green = &<Shots/concussion_turret_heavy_laser_green_shot.rules>
    shot_turret_concussion_hv_blue  = &<Shots/concussion_turret_heavy_laser_blue_shot.rules>

/* IV. Ion (turret) — disrupt/EMP, low fire, med/long range, med vel */

    // Medium / Large
    shot_turret_ion_md_cyan = &<Shots/cyan_medium_ion_cannon_shot.rules>
    shot_turret_ion_hv_cyan = &<Shots/cyan_heavy_ion_cannon_shot.rules>

    shot_turret_ionizing_hv_red   = &<Shots/ionizing_turret_heavy_laser_red_shot.rules>
    shot_turret_ionizing_hv_green = &<Shots/ionizing_turret_heavy_laser_green_shot.rules>
    shot_turret_ionizing_hv_blue  = &<Shots/ionizing_turret_heavy_laser_blue_shot.rules>



/* ---------------------- DEFENSIVE ---------------------- */

    // I. PD bullets/lasers/mines etc.
    shot_def_laser_pd_sm_red   = &<Shots/laser_shot_red_pd.rules>
    shot_def_laser_pd_sm_green = &<Shots/laser_shot_green_pd.rules> // temp stand-in
    shot_def_laser_pd_sm_blue  = &<Shots/laser_shot_blue_pd.rules>

    // II. Laser & Ion PD
    shot_def_laser_pd_sm_yellow = &<Shots/yellow_small_laser_pdshot.rules>

    // III. Combo
    shot_def_flak_lg_sw = &<Shots/sw_flak_large.rules> // Heavy flak


/* ----------------------- UTILITY ----------------------- */

    // Mining, tractor, etc.
    shot_util_mining_beam_huge_pink = &<Shots/mining_beam_huge_pink.rules>



