Shot
{
	Laser
	{
		Glow
		{
			Small
			{
				Red = &<glow/red_laser_shot_glow_small.rules>
				Blue = &<glow/blue_laser_shot_glow_small.rules>
				Green = &<glow/green_laser_shot_glow_small.rules>
				Yellow = &<glow/yellow_laser_shot_glow_small.rules>
				Violet = &<glow/violet_laser_shot_glow_small.rules>
				White = &<glow/white_laser_shot_glow_small.rules>
			}
			Med
			{
				Red = &<glow/red_laser_shot_glow_med.rules>
				Blue = &<glow/blue_laser_shot_glow_med.rules>
				Green = &<glow/green_laser_shot_glow_med.rules>
				Yellow = &<glow/yellow_laser_shot_glow_med.rules>
				Orange = &<glow/orange_laser_shot_glow_med.rules>
				Violet = &<glow/violet_laser_shot_glow_med.rules>
				White = &<glow/white_laser_shot_glow_med.rules>
			}
			Large
			{
				Red = &<glow/red_laser_shot_glow_large.rules>
				Blue = &<glow/blue_laser_shot_glow_large.rules>
				Green = &<glow/green_laser_shot_glow_large.rules>
				Yellow = &<glow/yellow_laser_shot_glow_large.rules>
				Violet = &<glow/violet_laser_shot_glow_large.rules>
				White = &<glow/white_laser_shot_glow_large.rules>
			}
			Orbital
			{
				Orange = &<glow/orange_orbital_shot_glow.rules>
			}
		}
		Shoot
		{
			Small
			{
				Red = &<shoot/red_laser_shoot_small.rules>
				Blue = &<shoot/blue_laser_shoot_small.rules>
				Green = &<shoot/green_laser_shoot_small.rules>
			}
			Med
			{
				Red = &<shoot/red_laser_shoot_med.rules>
				Blue = &<shoot/blue_laser_shoot_med.rules>
				Green = &<shoot/green_laser_shoot_med.rules>
			}
			Large
			{
				Red = &<shoot/red_laser_shoot_large.rules>
				Blue = &<shoot/blue_laser_shoot_large.rules>
				Green = &<shoot/green_laser_shoot_large.rules>
			}
		}
		Hit
		{
			Med
			{
				Red = &<hit_effects/red_laser_hit.rules>
				Blue = &<hit_effects/blue_laser_hit.rules>
				Green = &<hit_effects/green_laser_hit.rules>
				Orange = &<hit_effects/orange_hit.rules>
			}
		}
		HitStruct
		{
			Med
			{
				Red = &<hit_effects/red_laser_hit_struct.rules>
				Blue = &<hit_effects/blue_laser_hit_struct.rules>
				Green = &<hit_effects/green_laser_hit_struct.rules>
				Orange = &<hit_effects/orange_hit_struct.rules>
			}
		}
		Flash
		{
			Med
			{
				Red = &<flash/red_laser_flash.rules>
				Blue = &<flash/blue_laser_flash.rules>
				Green = &<flash/green_laser_flash.rules>
				Orange = &<flash/orange_flash.rules>
				Purple = &<flash/purple_flash.rules>
			}
			Large
			{
				Red = &<flash/lg_turret_flash_red.rules>
				Green = &<flash/lg_turret_flash_green.rules>
				Blue = &<flash/lg_turret_flash_blue.rules>
			}
		}
		Flare
		{
			Large
			{
				Red = &<flash/lg_turret_flare_red.rules>
				Green = &<flash/lg_turret_flare_green.rules>
				Blue = &<flash/lg_turret_flare_blue.rules>
			}
		}
		Sparks
		{
			Med
			{
				Red = &<sparks/red_laser_sparks.rules>
				Blue = &<sparks/blue_laser_sparks.rules>
				Green = &<sparks/green_laser_sparks.rules>
