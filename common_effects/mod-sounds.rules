MODIFIERS
{
	OVERCLOCK_TO_ONE
	{
		Type = BuffRemap
		BuffType = Overclock
		RemapFrom = [0, 1]
		RemapTo = [0, 1]
		ModificationMode = Replace
	}
	OVERCLOCK_TO_ZERO : OVERCLOCK_TO_ONE
	{
		RemapTo = [1, 0]
	}
}