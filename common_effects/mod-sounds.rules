
//Vanilla Doubles for Safety

CrewEnterEffects : /BASE_SOUNDS/AudioInterior // &/SW_SOUNDS/CrewEnterEffects
{
	RandomSounds = ["crew_enter/crew_enter_01.wav", "crew_enter/crew_enter_02.wav", "crew_enter/crew_enter_03.wav", "crew_enter/crew_enter_03.wav", "crew_enter/crew_enter_04.wav", "crew_enter/crew_enter_05.wav"]
	SpeedVariation = .1
}
CrewLeaveEffects : /BASE_SOUNDS/AudioInterior // &/SW_SOUNDS/CrewLeaveEffects
{
	RandomSounds = ["crew_leave/crew_leave_01.wav", "crew_leave/crew_leave_02.wav", "crew_leave/crew_leave_03.wav"]
	SpeedVariation = .1
}

ThrusterBurst // &/SW_SOUNDS/ThrusterBurst
{
	Type = Audio
	DynamicVolume
	{
		MinDistance = 0
		MaxDistance = 1.5
		DistanceFalloff = 1

		MinZoom = 1
		MaxZoom = 12
		ZoomFalloff = 5
	}
	Sound = "sounds/thruster_burst.wav"
	MaxConcurrent = 2
	ConcurrencyDuration = 1
	RampUpTime = .1
	RampDownTime = .1
}



ThrusterRumble  // &/SW_SOUNDS/ThrusterRumble
{
	Type = Audio
	DynamicVolume
	{
		MinDistance = 0
		MaxDistance = 1.5
		DistanceFalloff = 1
		MinZoom = 1
		MaxZoom = 70
		ZoomFalloff = 8
	}
	Sound = "sounds/thruster_rumble.wav" 
	MaxConcurrent = 1
	RampUpTime = 1
	RampDownTime = .1
}

ThrusterHum : /BASE_SOUNDS/AudioInterior // &/SW_SOUNDS/ThrusterHum
{
	Sound = "sounds/thruster_operating.wav"
	MaxConcurrent = 1
}

ShieldHit : /BASE_SOUNDS/AudioExterior // &/SW_SOUNDS/ShieldHit
{
	Type = Audio
	RandomSounds = ["sounds/shield_hit_01.wav", "sounds/shield_hit_02.wav", "sounds/shield_hit_03.wav", "sounds/shield_hit_04.wav", "sounds/shield_hit_05.wav"]
	Volume = 1
	Speed = 1
	IgnoreIntensity = true
	SpeedVariation = .25
	MaxConcurrent = 10
}

Bullet_Create : /BASE_SOUNDS/AudioInterior
{
	Sound = "sounds/bullet_create.wav"
	Volume = .1
	Speed = .5
	SpeedVariation = .05
}

CollectorBeam : /BASE_SOUNDS/AudioExterior
{
	Sound = "sounds/collector_beam.wav"
	Volume = 50%
	Speed = 100%
	RampUpTime = .25
	RampDownTime = .25

	DynamicVolume : ^/0/DynamicVolume
	{
		UseCustomShapeForDistance = true
	}
	DynamicFilter : ^/0/DynamicFilter
	{
		UseCustomShapeForDistance = true
	}
}

MiningBeam : /BASE_SOUNDS/AudioExterior // &/SW_SOUNDS/
{
	Type = Audio
	Sound = "sounds/mining_beam.wav"
	Volume = 1
	Speed = 1
	MaxConcurrent = 1
	RampUpTime = .5
	RampDownTime = .5
	
	DynamicVolume : ^/0/DynamicVolume
	{
		UseCustomShapeForDistance = true
	}
	DynamicFilter : ^/0/DynamicFilter
	{
		UseCustomShapeForDistance = true
	}
}

IonBeam : /BASE_SOUNDS/AudioExterior // &/SW_SOUNDS/
{
	Type = Audio
	Sound = "sounds/ion_beam.wav"
	Volume = 0.75
	Speed = 2
	MaxConcurrent = 1
	MaxConcurrentVolume = 1
	RampUpTime = .25
	RampDownTime = .25
}

TractorBeamEmit : /BASE_SOUNDS/AudioExterior
{
	Sound = "tractor_beam_emit.wav"
	Volume = 1 / (&~/EMITTER/BeamCount)
	MaxConcurrent = 0 // Unlimited
	MaxConcurrentVolume = 1
	RampUpTime = .25
	RampDownTime = .25
	VolumeOverIntensity = 1
	SpeedOverIntensity = [1, 2]
	RampAffectsSpeedIntensity = true
}

TractorBeam : /BASE_SOUNDS/AudioExterior
{
	Sound = "tractor_beam.wav"
	Volume = 1 / (&~/EMITTER/BeamCount)
	MaxConcurrent = 0 // Unlimited
	MaxConcurrentVolume = 1
	RampUpTime = .25
	RampDownTime = .25
	VolumeOverIntensity = 1
	SpeedOverIntensity = [1, 2]
	RampAffectsSpeedIntensity = true

	DynamicVolume : ^/0/DynamicVolume
	{
		UseCustomShapeForDistance = true
	}
	DynamicFilter : ^/0/DynamicFilter
	{
		UseCustomShapeForDistance = true
	}
}


