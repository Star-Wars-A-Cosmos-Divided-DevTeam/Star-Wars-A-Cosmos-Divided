SWBigPartDestroyedDry
[
	&<./data/common_effects/particles/explosions/med_part_explode_dry.rules>
	&<./data/common_effects/particles/explosions/med_part_explode_dry_flash.rules>
	&<./data/common_effects/particles/explosions/med_part_explode_dry_sparks.rules>
	&<./data/common_effects/particles/explosions/big_part_explode_shrapnel.rules>
	&<./data/common_effects/particles/explosions/big_part_explode_debris.rules>

	: /BASE_SOUNDS/AudioExterior
	{
		Sound = "sounds/big_part_destroyed.wav"
		Volume = .75
		SpeedVariation = .25
	}

	: /BASE_SHAKE
	{
		ShakeAmount = .1
		Duration = .75
	}
]

SWHugePartDestroyedDry
[
	&<./data/common_effects/particles/explosions/med_part_explode_dry.rules>
	&<./data/common_effects/particles/explosions/med_part_explode_dry_flash.rules>
	&<./data/common_effects/particles/explosions/med_part_explode_dry_sparks.rules>
	&<./data/common_effects/particles/explosions/big_part_explode_shrapnel.rules>
	&<./data/common_effects/particles/explosions/huge_part_explode_debris.rules>

	: /BASE_SOUNDS/AudioExterior
	{
		Sound = "sounds/big_part_destroyed.wav"
		Volume = 2
		SpeedVariation = .25
	}

	: /BASE_SHAKE
	{
		ShakeAmount = .3
		Duration = 1
	}
]