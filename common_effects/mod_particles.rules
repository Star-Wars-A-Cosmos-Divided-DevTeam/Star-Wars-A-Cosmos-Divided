// = SW_PARTICLES

/**
 * Defines particle effect references for various laser shot glows, 
 * shoots, hits, flashes, and sparks.
 *
 * Includes small, medium, and large glows for red, blue, and green lasers.
 *
 * As well as cyan ion, yellow, violet, and white laser glows. 
 * 
 * And red, blue, and green laser shoot, hit, flash, and spark effects.
 *
 * Also defines cyan, orange, proton, discord missile, mining beam, 
 * and Death Star beam particles.
 *
 * Plus ion thruster glows in 5 colors and sizes.
 * 
 * References the particle effect rules files to enable loading the effects.
 */

Shot
{
    Laser
    {
        Glow
        {
            Small
            {
                Red = &<particles/laser/glow/red_laser_shot_glow_small.rules>
                Blue = &<particles/laser/glow/blue_laser_shot_glow_small.rules>
                Green = &<particles/laser/glow/green_laser_shot_glow_small.rules>
                Yellow = &<particles/laser/glow/yellow_laser_shot_glow_small.rules>
                Violet = &<particles/laser/glow/violet_laser_shot_glow_small.rules>
                White = &<particles/laser/glow/white_laser_shot_glow_small.rules>
            }
            Med
            {
                Red = &<particles/laser/glow/red_laser_shot_glow_med.rules>
                Blue = &<particles/laser/glow/blue_laser_shot_glow_med.rules>
                Green = &<particles/laser/glow/green_laser_shot_glow_med.rules>
                Yellow = &<particles/laser/glow/yellow_laser_shot_glow_med.rules>
                Orange = &<particles/laser/glow/orange_laser_shot_glow_med.rules>
                Violet = &<particles/laser/glow/violet_laser_shot_glow_med.rules>
                White = &<particles/laser/glow/white_laser_shot_glow_med.rules>
            }
            Large
            {
                Red = &<particles/laser/glow/red_laser_shot_glow_large.rules>
                Blue = &<particles/laser/glow/blue_laser_shot_glow_large.rules>
                Green = &<particles/laser/glow/green_laser_shot_glow_large.rules>
                Yellow = &<particles/laser/glow/yellow_laser_shot_glow_large.rules>
                Violet = &<particles/laser/glow/violet_laser_shot_glow_large.rules>
                White = &<particles/laser/glow/white_laser_shot_glow_large.rules>
            }
            Orbital
            {
                Orange = &<particles/laser/glow/orange_orbital_shot_glow.rules>
            }
        }
        Shoot
        {
            Small
            {
                Red = &<particles/laser/shoot/red_laser_shoot_small.rules>
                Blue = &<particles/laser/shoot/blue_laser_shoot_small.rules>
                Green = &<particles/laser/shoot/green_laser_shoot_small.rules>
            }
            Med
            {
                Red = &<particles/laser/shoot/red_laser_shoot_med.rules>
                Blue = &<particles/laser/shoot/blue_laser_shoot_med.rules>
                Green = &<particles/laser/shoot/green_laser_shoot_med.rules>
            }
            Large
            {
                Red = &<particles/laser/shoot/red_laser_shoot_large.rules>
                Blue = &<particles/laser/shoot/blue_laser_shoot_large.rules>
                Green = &<particles/laser/shoot/green_laser_shoot_large.rules>
            }
        }
        Hit
        {
            Med
            {
                Red = &<particles/laser/hit/red_laser_hit.rules>
                Blue = &<particles/laser/hit/blue_laser_hit.rules>
                Green = &<particles/laser/hit/green_laser_hit.rules>
                Orange = &<particles/laser/hit/orange_hit.rules>
            }
        }
        HitStruct
        {
            Med
            {
                Red = &<particles/laser/hit/red_laser_hit_struct.rules>
                Blue = &<particles/laser/hit/blue_laser_hit_struct.rules>
                Green = &<particles/laser/hit/green_laser_hit_struct.rules>
                Orange = &<particles/laser/hit/orange_hit_struct.rules>
            }
        }
        Flash
        {
            Med
            {
                Red = &<particles/laser/flash/red_laser_flash.rules>
                Blue = &<particles/laser/flash/blue_laser_flash.rules>
                Green = &<particles/laser/flash/green_laser_flash.rules>
                Orange = &<particles/laser/flash/orange_flash.rules>
				Purple = &<particles/laser/flash/purple_flash.rules>
			}
			Large
			{
				Red = &<particles/laser/flash/lg_turret_flash_red.rules>
				Green = &<particles/laser/flash/lg_turret_flash_green.rules>
				Blue = &<particles/laser/flash/lg_turret_flash_blue.rules>
			}
		}
		Flare
		{
			Large
			{
				Red = &<particles/laser/flare/lg_turret_flare_red.rules>
				Green = &<particles/laser/flare/lg_turret_flare_green.rules>
				Blue = &<particles/laser/flare/lg_turret_flare_blue.rules>
			}
		}
        Sparks
        {
            Med
            {
                Red = &<particles/laser/sparks/red_laser_sparks.rules>
                Blue = &<particles/laser/sparks/blue_laser_sparks.rules>
                Green = &<particles/laser/sparks/green_laser_sparks.rules>
                Orange = &<particles/laser/sparks/orange_sparks.rules>
            }
        }
    }
    Ion
    {
        Glow
        {
            Small
            {
                Cyan = &<particles/ion/glow/cyan_ion_shot_glow_small.rules>
                Blue = &<particles/ion/glow/blue_ion_shot_glow_small.rules>
            }
            Med
            {
                Cyan = &<particles/ion/glow/cyan_ion_shot_glow_med.rules>
                Blue = &<particles/ion/glow/blue_ion_shot_glow_med.rules>
            }
            Large
            {
                Cyan = &<particles/ion/glow/cyan_ion_shot_glow_large.rules>
                Blue = &<particles/ion/glow/blue_ion_shot_glow_large.rules>
            }
        }
        Trail
        {
            Med
            {
                Red = &<particles/ion/trail/red_ion_shot_trail_lightning.rules>
                Blue = &<particles/ion/trail/blue_ion_shot_trail_lightning.rules>
                Green = &<particles/ion/trail/green_ion_shot_trail_lightning.rules>
                Cyan = &<particles/ion/trail/cyan_ion_shot_trail_lightning.rules>
            }
        }
        Shoot
        {
            Small
            {
                Cyan = &<particles/ion/shoot/cyan_shoot_small.rules>
            }
            Med
            {
                Cyan = &<particles/ion/shoot/cyan_shoot_med.rules>
            }
            Large
            {
                Cyan = &<particles/ion/shoot/cyan_shoot_large.rules>
            }
        }
        Hit
        {
            Small
            {
                Cyan = &<particles/ion/hit/cyan_hit_small.rules>
            }
            Med
            {
                Cyan = &<particles/ion/hit/cyan_hit_med.rules>
            }
        }
        HitStruct
        {
            Med
            {
                Cyan = &<particles/ion/hit/cyan_hit_struct.rules>
            }
        }
        Flash
        {
            Small
            {
                Cyan = &<particles/ion/flash/cyan_flash_small.rules>
            }
            Med
            {
                Cyan = &<particles/ion/flash/cyan_flash.rules>
            }
        }
        Sparks
        {
            Small
            {
                Cyan = &<particles/ion/sparks/cyan_sparks_small.rules>
            }
            Med
            {
                Cyan = &<particles/ion/sparks/cyan_sparks.rules>
            }
        }
        Drain
        {
            Med
            {
                Cyan = &<particles/ion/drain/cyan_ship_drain.rules>
            }
        }
        Sizzle
        {
            Med
            {
                Cyan = &<particles/ion/sizzle/cyan_ion_shot_hit_sizzle.rules>
            }
        }
        Lightning
        {
            Med
            {
                Cyan = &<particles/ion/lightning/cyan_ion_shot_lightning.rules>
            }
        }
        PlumeLight
        {
            Med
            {
                Cyan = &<particles/ion/plume_light/cyan_ion_shot_plume_light.rules>
            }
        } 
    }
}

Beam
{
    Flak
    {
        Shoot
        {
            Large
            {
                Vanilla = &<particles/beam/shoot/flak_cannon_shoot_flash_large.rules>
            }
        }
        Flash
        {
            Large
            {
                Vanilla = &<particles/beam/flash/sw_flak_large_flash.rules>
            }
        }
        Shrapnel
        {
            Med
            {
                Vanilla = &<particles/beam/sharpnel/sw_flak_large_shrapnel.rules>
            }
        }
        Smoke
        {
            Med
            {
                Vanilla = &<particles/beam/smoke/flak_cannon_large_smoke.rules>
            }
            Large
            {
                Vanilla = &<particles/beam/smoke/sw_flak_large_smoke.rules>
            }
        }
    }
    Mining
    {
        Hit
        {
            Sparks
            {
                Pink = &<particles/beam/sparks/mining_beam_pink_hit_sparks.rules>
            }
        }
        RadialHit
        {
            Sparks
            {
                Pink = &<particles/beam/sparks/mining_beam_pink_radial_hit_sparks.rules>
            }
        }
    }
    Deathstar
    {
        Med
        {
            Empty
        }
    }
}
