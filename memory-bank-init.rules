// Memory bank for Star Wars: A Cosmos Divided mod
// This file contains high-level summary information about the mod

// Mod Identification
ID = SW.1.StarWars
Name = "Star Wars: A Cosmos Divided"
Version = 201b.301b
CompatibleGameVersions = ["0.30.1", "0.30.0"]

// Core Purpose
// The mod brings Star Wars elements into Cosmoteer, including:
// - Weapons and technology from Star Wars universe
// - New armor classes and ship shapes
// - Droids and expanded part types
// - Custom effects, particles, sounds, and graphics

// Key Features
// 1. New Content Additions
//    - Weapons and tech from Star Wars
//    - Droids and new armor classes  
//    - Expanded ship shapes (from Kroom's New Armor Expanded)
//    - Ships Pack add-on

// 2. Technical Integration
//    - Custom editor groups for mod parts in GUI
//    - New stat widgets and toggle buttons
//    - Resource management (Zersium, Doonium, Durasteel)
//    - Custom effects, particles, sounds, graphics
//    - Shader effects for visual enhancements

// 3. Gameplay Enhancements
//    - Category limits for parts to balance gameplay
//    - New asteroid resources (Zersium, Doonium)
//    - Career mode integration with new resources and techs
//    - PVP build battle mode support
//    - Custom ship designs and decals

// 4. Visual & Audio Elements
//    - Custom logo and menu screens
//    - New particle effects and visual effects
//    - Custom sound effects
//    - Shader effects for post-processing

// Mod Authors
Author = "ClassicJam, Lafiel, Skipperwraith, Roasted(Art), Rojamahorse"

// Description
Description = "Star Wars: A Cosmos Divided is the definitive Star Wars experience for Cosmoteer."

// File Structure Overview
// The mod uses a complex system of rules files to modify the game:
// - Resources directory contains new resources and materials
// - Ships directory contains new ship parts and designs
// - Effects directories contain particle, sound, and visual effects
// - GUI directories contain user interface modifications
// - Modes directory contains career and PVP mode integrations
// - Buffs and statuses directories contain gameplay modifiers

// Integration Points
// The mod integrates through the cosmoteer.rules file and various sub-rules files
// using AddMany, Add, Overrides, and Replace actions to modify existing game data

// Ship Parts Location Summary
// This section summarizes all the ship parts added to the game by this mod,
// organized by category for easy reference.

// Terran Ship Parts (ships/terran/terran.rules)
// These are the main components added to the game under the Terran faction:
// - Crew: bed_tiny, bench_small
// - Factories: factory_durasteel, factory_doonium
// - Utilities: mining_laser_huge, resource_collector_tiny
// - Missile Weapons: missile_launcher_small, missile_launcher_medium
// - Energy Weapons: proton_launcher, discordmissile
// - Fixed Defensive: turbolaser_light_pd4, turbolaser_flak_cannon01
// - Fixed Weapons: small_blasterlaser, DualFighterGun, fixedlaser, fixedlaser2,
//   fixedmediumlaser, fixedheavylaser, turbolaser_carronade
// - Ion Turrets: medium_ion_cannon_switchable, heavy_ion_cannon_switchable
// - Turrets: small_laser_cannon_switchable, swturret_A, swturret_B, swturret_C,
//   dual_laser_cannon_switchable, falcon_laser_cannon
// - Turbolasers: light_turbolaser_switchable, med_turbolaser_switchable,
//   turbolaser_med_LR01, small_triple_turbolaser, heavy_turbolaser_switchable,
//   xx9_turbolaser_switchable, imperial_turbolaser_switchable,
//   republic_turbolaser_switchable, cis_turbolaser_switchable,
//   medium_turbolaser_quad_switchable, quad_barbette_turbolaser,
//   octuple_barbette_turbolaser, huge_turbolaserx1_switchable,
//   huge_turbolaserx2_switchable, huge_turbolaserx3_switchable,
//   siege_turbolaser12x12
// - Control Rooms: HiddenCockpit, Cockpit, CockpitT85, CockpitTIE, CockpitARC,
//   Eta2cockpit, CockpitTIE2
// - Tech Components: navicomputer, bridge_2x3, bridge_3x2, bridge_6x7_CIS,
//   bridge.rules, WarRoom
// - RCS: rcs_small
// - X-Wing Thrusters: XWingThrusterSmall, XWingThruster
// - Ion Thrusters: Various sizes from IonThruster01_1x1 to IonThruster01_20x26
//   and IonThrusterAccelerator_5x10, IonThrusterAccelerator_10x20
// - Hyperdrives: hyperdrive_small, hyperdrive_med, hypernode_med, hyperdrive_large,
//   hypernode
// - Power Sources: reactor_tiny, reactor_small, reactor_large, hypermatter_reactor_2x2,
//   hypermatter_reactor_4x4, hypermatter_reactor_12x12, hypermatter_reactor_30x30
// - Droids: r2armor (3 variants), R4, R5, imperial_probe_droid
// - Shields: shield_1, shield_2, shield_4, shield_8
// - Storage: Multiple storage sizes from 1x1 to 4x4 hidden and various combinations
// - Structures: Various durasteel and doonium structures with different shapes and
//   configurations including triangles, wedges, rounds, and hybrid designs
// - Armor: Durasteel and Doonium armor with various sizes and shapes including
//   triangles, wedges, rounds, and hybrid designs

// Category Nouns for Custom Categories
// These define the text used in the UI for custom categories:
// - SW_Hyperdrives (Hyperdrives)
// - SW_Hyperdrive_Small (Small Hyperdrives)  
// - SW_Hyperdrive_Medium (Medium Hyperdrives)
// - SW_Hyperdrive_Large (Large Hyperdrives)
// - SW_Hypernode_Medium (Medium Hypernodes)

// Render Layers
// Custom render layers for visual effects:
// - SW.structure_engines: For structure engines with external lighting shader
// - SW.roof_engines: For roof engines with colored roof shader

// Inheritance Summary
// Base part files and their inheritance relationships:
// - base_part_terran_sw.rules: Inherits from ./Data/ships/terran/base_part_terran.rules
//   Purpose: Basic SW part inheritance, minimal modifications to vanilla data
//
// - base_part_terran_sw_armor.rules: Inherits from base_part_terran_sw.rules
//   Purpose: Specific armor-related base part configurations
//
// - base_part_terran_sw_overclock.rules: Inherits from base_part_terran_sw_scorched.rules
//   Purpose: Base for overclockable parts with thermal network components
//   Key Components:
//   - Thermal network port for connecting to heat distribution systems
//   - Heat storage and distribution mechanisms
//   - Overclock toggle and operational state management
//   - Visual indicators for overclock status
//
// - base_part_terran_sw_scorched.rules: Inherits from base_part_terran_sw_operational.rules
//   Purpose: Base for scorched parts with visual effects and status tracking
//   Key Components:
//   - Scorched status toggle and trigger system
//   - Visual effects for scorched state
//   - Indicator sprites for scorched status
//
// - base_part_terran_sw_operational.rules: Inherits from base_part_terran_sw.rules
//   Purpose: Base operational components shared by various SW parts
//   Key Components:
//   - IsOperational toggle management
//   - CommandToggle and CommandConsumptionToggle components
//
// - base_part_terran_sw_operational_overclock.rules: Inherits from base_part_terran_sw_overclock.rules
//   Purpose: Combined operational and overclock base for parts that need both features
//   Key Components:
//   - Operational state management (inherits from base_part_terran_sw_overclock.rules)
//   - CommandToggle components (from base_part_terran_sw_operational.rules)
