//SW Buffs

//Overdrive Buff
SW_Ion_Thruster_Overdrive
{
	CombineMode = Add
	BaseValue = 0%
}

SW_Ion_Thruster_Overdrive_Thrust : SW_Ion_Thruster_Overdrive {}

SW_Ion_Thruster_Boost
{
	CombineMode = Add
	BaseValue = 0%
}

SW_Ion_Thruster_Boost_Thrust : SW_Ion_Thruster_Boost {}

SW_Ion_Thruster_Boost_RampUp : SW_Ion_Thruster_Boost
{
	Exponent = 3
}

SW_Ion_Thruster_Boost_RampUpFinal : SW_Ion_Thruster_Boost {}

SW_Ion_Thruster_Boost_ExtraForce : SW_Ion_Thruster_Boost {}

//Accelerator Buffs
SW_Ion_Thruster_Accelerator
{
	CombineMode = Add

	RectBorderColor = [10, 212, 98, 160]
	RectFillColor = [10, 212, 98, 64]
}

SW_Ion_Thruster_Accelerator_Thrust
{
	CombineMode = Add
	Exponent = 1.0
	BaseValue = 0%

	Icon
	{
		Texture
		{
			File = "buff_speed.png"
			MipLevels = 2
			SampleMode = Linear
		}
		Size = [4, 4]
	}
	IconTextFormatKey = "BuildBox/BuffPercentageFmt"
	IconTextMultiply = 100
	IconTextAdd = -100
	IconPriority = 1 // Override engine room buff icon.
	ShowIconTextForZeroValue = false
}

SW_Ion_Thruster_Accelerator_RampUp
{
	CombineMode = Add
	Exponent = 0.5
	BaseValue = 0%
}
SW_Ion_Thruster_Accelerator_RampUpFinal
{
	CombineMode = Add
	BaseValue = 0%
}

SW_Ion_Thruster_Accelerator_Operation
{
	CombineMode = Add

	RectBorderColor = [10, 212, 98, 160]
	RectFillColor = [10, 212, 98, 64]
}

SW_Ion_Thruster_Accelerator_ExtraForce
{
	CombineMode = Add
	BaseValue = 0
}

SW_Ion_Thruster_Accelerator_BatteryConnection // Only used to show connection in blueprints.
{
	Icon
	{
		Texture
		{
			File = "buff_power.png"
			MipLevels = 2
			SampleMode = Linear
		}
		Size = [2, 2]
	}

	RectBorderColor = [10, 212, 98, 160]
	RectFillColor = [10, 212, 98, 64]
}

SW_Ion_Thruster_To_Accelerator //Provides DoodadAnimationSpeedFactorValue to Attached Accelerators
{
	CombineMode = Add
	BaseValue = 0%

	RectBorderColor = [10, 212, 98, 160]
	RectFillColor = [10, 212, 98, 64]
}

